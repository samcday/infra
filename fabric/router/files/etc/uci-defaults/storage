# BusyBox ash supports pipefail; ShellCheck's generic POSIX mode does not know
# that target-specific extension.
# shellcheck disable=SC3040
set -uexo pipefail

# The router serves immutable, pinned public artifacts from this device. It is
# never an application-data volume and must not become an executable or
# privileged persistence surface.
uci -q batch <<'EOI'
set fstab.mount_storage=mount
set fstab.mount_storage.target='/mnt/data'
set fstab.mount_storage.label='data'
set fstab.mount_storage.fstype='ext4'
set fstab.mount_storage.options='ro,nodev,nosuid,noexec,noatime'
set fstab.mount_storage.enabled='1'
set fstab.mount_storage.enabled_fsck='0'
commit fstab
EOI
