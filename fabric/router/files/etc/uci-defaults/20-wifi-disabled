# BusyBox ash supports pipefail; ShellCheck's generic POSIX mode does not know
# that target-specific extension.
# shellcheck disable=SC3040
set -uexo pipefail

for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
    uci -q set "wireless.${radio}.disabled=1"
done
uci -q commit wireless
wifi down || true
