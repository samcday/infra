set -uexo pipefail

die() {
    echo "ERROR: $*" >&2
    logger -t fabric-system "ERROR: $*"
    exit 1
}

network_sections() {
    { uci -q show network 2>/dev/null || true; } |
        sed -n 's/^network\.\([^.=]*\)=[^=]*$/\1/p'
}

network_option_keys() {
    section=$1
    prefix="network.$section."
    uci -q show "network.$section" |
        while IFS= read -r line; do
            case $line in
                "$prefix"*=*)
                    option=${line#"$prefix"}
                    printf '%s\n' "${option%%=*}"
                    ;;
            esac
        done |
        LC_ALL=C sort
}

assert_network_option_keys() {
    section=$1
    wanted=$2
    actual=$(network_option_keys "$section")
    [ "$actual" = "$wanted" ] ||
        die "unexpected option set in network section $section"
}

assert_network_value() {
    key=$1
    wanted=$2
    actual=$(uci -q get "$key") || die "missing network key $key"
    [ "$actual" = "$wanted" ] || die "unexpected value for network key $key"
}

# This image is intentionally a short-lived router-on-a-stick profile. Refuse
# to activate the second prefix unless the removable migration marker shipped
# with this overlay has the exact reviewed shape.
[ "$(uci -q get fabric.flat_l2)" = 'migration' ]
[ "$(uci -q get fabric.flat_l2.enabled)" = '1' ]
[ "$(uci -q get fabric.flat_l2.profile)" = 'unmanaged-switch-flat-l2' ]
[ "$(uci -q get fabric.flat_l2.physical_device)" = 'eth1' ]
[ "$(uci -q get fabric.flat_l2.root_cidr)" = '10.66.0.0/24' ]
[ "$(uci -q get fabric.flat_l2.service_cidr)" = '10.66.1.0/24' ]
[ "$(uci -q get fabric.flat_l2.removal_gate)" = 'managed-vlan-trunk-ready' ]

# /etc/sysctl.conf is a sysupgrade-preserved conffile and OpenWrt applies it
# after /etc/sysctl.d. Fail closed if an older image left any competing value,
# then apply the image-owned policy now. OpenWrt's normal sysctl service and
# net hotplug hook apply this same file on every later boot/interface add.
flat_l2_sysctl=/etc/sysctl.d/90-fabric-flat-l2.conf
[ -f "$flat_l2_sysctl" ] && [ ! -L "$flat_l2_sysctl" ]
[ "$(stat -c '%u:%a:%h' "$flat_l2_sysctl")" = '0:644:1' ]
[ -f /etc/sysctl.conf ] && [ ! -L /etc/sysctl.conf ]
while IFS= read -r protected_sysctl; do
    if awk -F= -v wanted="$protected_sysctl" '
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        {
            key = $1
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
            if (key == wanted) found = 1
        }
        END { exit !found }
    ' /etc/sysctl.conf; then
        echo "ERROR: preserved /etc/sysctl.conf overrides $protected_sysctl" >&2
        exit 1
    fi
done <<'EOF'
net.ipv4.ip_forward
net.ipv4.conf.all.send_redirects
net.ipv4.conf.default.send_redirects
net.ipv4.conf.br-lan.send_redirects
net.ipv4.conf.all.accept_redirects
net.ipv4.conf.default.accept_redirects
net.ipv4.conf.br-lan.accept_redirects
net.ipv4.conf.all.secure_redirects
net.ipv4.conf.default.secure_redirects
net.ipv4.conf.all.accept_source_route
net.ipv4.conf.default.accept_source_route
net.ipv6.conf.all.accept_redirects
net.ipv6.conf.default.accept_redirects
net.ipv6.conf.all.accept_source_route
net.ipv6.conf.default.accept_source_route
net.ipv6.conf.all.disable_ipv6
net.ipv6.conf.default.disable_ipv6
net.ipv6.conf.br-lan.disable_ipv6
EOF
sysctl -e -p "$flat_l2_sysctl"

# Ordinary sysupgrade preserves /etc/config/network. Rebuild the package from
# zero so an old alias, route, policy rule, bridge VLAN, physical-device
# assignment, or merely an extra option cannot come alive before the later
# firewall and wireless defaults. Re-query after every delete because anonymous
# UCI section indexes are renumbered immediately.
while :; do
    network_section=$(network_sections | sed -n '1p')
    [ -n "$network_section" ] || break
    uci -q delete "network.$network_section"
done

