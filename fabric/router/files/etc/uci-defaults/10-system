set -uexo pipefail

uci -q batch <<'EOI'
set system.@system[0].zonename='Australia/Sydney'
set system.@system[0].hostname='fabric-router'

set system.ntp='timeserver'
set system.ntp.enabled='1'
set system.ntp.enable_server='1'
set system.ntp.use_dhcp='0'
delete system.ntp.server
add_list system.ntp.server='0.openwrt.pool.ntp.org'
add_list system.ntp.server='1.openwrt.pool.ntp.org'
add_list system.ntp.server='2.openwrt.pool.ntp.org'
add_list system.ntp.server='3.openwrt.pool.ntp.org'
commit system

set network.lan.ipaddr='10.66.0.1'
set network.lan.netmask='255.255.255.0'
delete network.lan.ip6assign
set network.wan.proto='dhcp'
delete network.wan.device
set network.wan6.disabled='1'
delete network.wan6.device
commit network

set dhcp.@dnsmasq[0].local='/fabric.internal/'
set dhcp.@dnsmasq[0].domain='fabric.internal'
set dhcp.@dnsmasq[0].localservice='1'
delete dhcp.@dnsmasq[0].address
add_list dhcp.@dnsmasq[0].address='/fabric-az1-cp1.fabric.internal/10.66.0.10'
add_list dhcp.@dnsmasq[0].address='/fabric-az1-cp2.fabric.internal/10.66.0.11'
add_list dhcp.@dnsmasq[0].address='/fabric-az1-cp3.fabric.internal/10.66.0.12'
add_list dhcp.@dnsmasq[0].address='/api.fabric.internal/10.66.0.254'
set dhcp.lan.ignore='1'
delete dhcp.lan.start
delete dhcp.lan.limit
delete dhcp.lan.leasetime
set dhcp.lan.dhcpv6='disabled'
set dhcp.lan.ra='disabled'
set dhcp.lan.ndp='disabled'
commit dhcp

delete uhttpd.main.listen_http
add_list uhttpd.main.listen_http='10.66.0.1:80'
delete uhttpd.main.listen_https
delete uhttpd.main.lua_prefix
set uhttpd.main.no_dirlists='1'
commit uhttpd
EOI

chsh -s /bin/bash || true
