# BusyBox ash supports pipefail; ShellCheck's generic POSIX mode does not know
# that target-specific extension.
# shellcheck disable=SC3040
set -ueo pipefail

die() {
    echo "ERROR: $*" >&2
    logger -t fabric-wifi "ERROR: $*"
    exit 1
}

sections_of_type() {
    uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=$1$/\1/p"
}

psk_file=/etc/fabric/operator-wifi-psk
[ -f "$psk_file" ] || die 'operator Wi-Fi PSK is missing'
[ ! -L "$psk_file" ] || die 'operator Wi-Fi PSK must not be a symlink'
[ "$(stat -c '%u:%a' "$psk_file")" = '0:600' ] ||
    die 'operator Wi-Fi PSK must be root-owned mode 0600'
psk=$(cat "$psk_file")
[ "${#psk}" -ge 16 ] && [ "${#psk}" -le 63 ] ||
    die 'operator Wi-Fi PSK length must be between 16 and 63 characters'
case $psk in
    *[!0-9a-f]*) die 'operator Wi-Fi PSK must be lowercase hexadecimal' ;;
esac

# The radio stays disabled unless the already-applied network and firewall
# policy still has the exact observer-only shape reviewed with this image.
[ "$(uci -q get network.lan.ipaddr)" = '10.66.0.1' ] ||
    die 'unexpected fabric LAN address'
[ "$(uci -q get dhcp.lan.ignore)" = '1' ] ||
    die 'LAN DHCP is not disabled'
[ "$(uci -q get firewall.@defaults[0].forward)" = 'REJECT' ] ||
    die 'global forwarding policy is not reject'
[ "$(uci -q get firewall.fabric_router_ssh.src)" = 'lan' ] ||
    die 'router SSH rule is not LAN-scoped'
[ "$(uci -q get firewall.fabric_router_ssh.src_ip)" = '10.66.0.2/32' ] ||
    die 'router SSH rule is not observer-scoped'
[ "$(uci -q get firewall.fabric_router_ssh.dest_port)" = '22' ] ||
    die 'router SSH rule has an unexpected destination port'

radios=$(sections_of_type wifi-device)
[ -n "$radios" ] || die 'no Wi-Fi radios were discovered'

five_ghz_radio=
for radio in $radios; do
    uci -q set "wireless.${radio}.disabled=1"
    uci -q set "wireless.${radio}.country=AU"
    if [ "$(uci -q get "wireless.${radio}.band")" = '5g' ]; then
        [ -z "$five_ghz_radio" ] || die 'more than one 5 GHz radio was discovered'
        five_ghz_radio=$radio
    fi
done
[ -n "$five_ghz_radio" ] || die 'no 5 GHz radio was discovered'

# Remove every generated/default SSID before creating the sole reviewed AP.
while :; do
    wifi_iface=$(sections_of_type wifi-iface | sed -n '1p')
    [ -n "$wifi_iface" ] || break
    uci -q delete "wireless.${wifi_iface}"
done

uci -q batch <<EOI
set wireless.${five_ghz_radio}.disabled='0'
set wireless.${five_ghz_radio}.country='AU'
set wireless.${five_ghz_radio}.channel='36'
set wireless.${five_ghz_radio}.htmode='HE20'
set wireless.${five_ghz_radio}.txpower='10'

set wireless.fabric_operator='wifi-iface'
set wireless.fabric_operator.device='${five_ghz_radio}'
set wireless.fabric_operator.network='lan'
set wireless.fabric_operator.mode='ap'
set wireless.fabric_operator.ssid='fabric-observer'
set wireless.fabric_operator.encryption='sae'
set wireless.fabric_operator.key='${psk}'
set wireless.fabric_operator.ieee80211w='2'
set wireless.fabric_operator.sae_pwe='2'
set wireless.fabric_operator.isolate='1'
set wireless.fabric_operator.maxassoc='1'
set wireless.fabric_operator.macfilter='allow'
add_list wireless.fabric_operator.maclist='d8:80:83:81:cb:f7'
set wireless.fabric_operator.wps_pushbutton='0'
set wireless.fabric_operator.disabled='0'
commit wireless
EOI

# The UCI database now owns the runtime copy. OpenWrt's boot service invokes
# reload_config after all defaults and starts Wi-Fi later in the boot sequence;
# do not race that lifecycle with an early reload. Whiteout the standalone
# overlay path so it is not exposed as an ordinary file after first boot. The
# firmware artifact remains secret-bearing and must still be handled
# accordingly.
rm -f -- "$psk_file"
