delete firewall.fabric_flat_reject_services_etcd
set firewall.fabric_flat_services_etcd_client='rule'
set firewall.fabric_flat_services_etcd_client.name='Allow-platform-to-root-etcd-client'
set firewall.fabric_flat_services_etcd_client.src='lan'
set firewall.fabric_flat_services_etcd_client.dest='lan'
set firewall.fabric_flat_services_etcd_client.family='ipv4'
add_list firewall.fabric_flat_services_etcd_client.src_ip='10.66.1.10/32'
add_list firewall.fabric_flat_services_etcd_client.src_ip='10.66.1.11/32'
add_list firewall.fabric_flat_services_etcd_client.dest_ip='10.66.0.10/32'
add_list firewall.fabric_flat_services_etcd_client.dest_ip='10.66.0.11/32'
add_list firewall.fabric_flat_services_etcd_client.dest_ip='10.66.0.12/32'
set firewall.fabric_flat_services_etcd_client.proto='tcp'
add_list firewall.fabric_flat_services_etcd_client.dest_port='2379'
set firewall.fabric_flat_services_etcd_client.target='ACCEPT'
set firewall.fabric_flat_reject_services_etcd_internal='rule'
set firewall.fabric_flat_reject_services_etcd_internal.name='Reject-services-to-root-etcd-internal'
set firewall.fabric_flat_reject_services_etcd_internal.src='lan'
set firewall.fabric_flat_reject_services_etcd_internal.dest='lan'
set firewall.fabric_flat_reject_services_etcd_internal.family='ipv4'
add_list firewall.fabric_flat_reject_services_etcd_internal.src_ip='10.66.1.10/32'
add_list firewall.fabric_flat_reject_services_etcd_internal.src_ip='10.66.1.11/32'
add_list firewall.fabric_flat_reject_services_etcd_internal.dest_ip='10.66.0.10/32'
add_list firewall.fabric_flat_reject_services_etcd_internal.dest_ip='10.66.0.11/32'
add_list firewall.fabric_flat_reject_services_etcd_internal.dest_ip='10.66.0.12/32'
set firewall.fabric_flat_reject_services_etcd_internal.proto='tcp'
add_list firewall.fabric_flat_reject_services_etcd_internal.dest_port='2380'
set firewall.fabric_flat_reject_services_etcd_internal.target='REJECT'
