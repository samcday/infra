port=0
user=nginx
group=nginx
interface=wlp95s0
bind-interfaces
pid-file=@FABRIC_WORKER_RUNTIME_DIR@/dnsmasq/dnsmasq.pid
dhcp-leasefile=@FABRIC_WORKER_RUNTIME_DIR@/dnsmasq/dnsmasq.leases
dhcp-authoritative
dhcp-range=10.66.0.100,10.66.0.100,255.255.255.0,15m
dhcp-host=@FABRIC_WORKER_MAC@,set:worker,10.66.0.100,infinite
dhcp-ignore=tag:!worker
dhcp-option=tag:worker,option:router
dhcp-option=tag:worker,option:dns-server
enable-tftp
tftp-root=@FABRIC_WORKER_RUNTIME_DIR@/tftp
dhcp-boot=tag:worker,EFI/BOOT/BOOTX64.EFI,,10.66.0.2
log-dhcp
log-facility=-
