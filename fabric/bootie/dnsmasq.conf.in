port=0
user=nginx
group=nginx
interface=wlp95s0
bind-interfaces
pid-file=/run/fabric-bootie/dnsmasq/dnsmasq.pid
dhcp-leasefile=/run/fabric-bootie/dnsmasq/dnsmasq.leases
dhcp-authoritative
dhcp-range=10.66.0.100,10.66.0.100,255.255.255.0,15m
dhcp-host=@FABRIC_CP3_MAC@,set:cp3,10.66.0.100,infinite
dhcp-ignore=tag:!cp3
dhcp-option=tag:cp3,option:router
dhcp-option=tag:cp3,option:dns-server
enable-tftp
tftp-root=/run/fabric-bootie/tftp
dhcp-boot=tag:cp3,EFI/BOOT/BOOTX64.EFI,,10.66.0.2
log-dhcp
log-facility=-
