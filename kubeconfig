apiVersion: v1
kind: Config
clusters:
  - name: hub
    cluster:
      server: https://hub-apiserver.tailnet.hub.samcday.com:6443
      # The L4 Tailnet proxy preserves the API server certificate. Verify it
      # against the existing kube-vip IP SAN until live K3s certs are rotated.
      tls-server-name: 10.0.1.254
      certificate-authority-data: 
  # Hub embeds certificate-authority-data inline because it is always present in-repo.
  # Child clusters use certificate-authority file paths because their public CAs
  # are fetched from the hosting cluster by `scripts/credhelper --init`.
  - name: cloud
    cluster:
      server: https://cloud-cluster-apiserver.tailnet.hub.samcday.com:6443
      certificate-authority: hub/pki/k8s/cloud-server-ca.crt
  - name: edge-au-east
    cluster:
      server: https://edge-au-east-apiserver.tailnet.hub.samcday.com:6443
      certificate-authority: hub/pki/k8s/edge-au-east-server-ca.crt
  - name: fabric
    cluster:
      server: https://10.66.0.254:6443
      tls-server-name: api.fabric.internal
      certificate-authority: fabric/access/server-ca.crt
  - name: lab
    cluster:
      server: https://lab-apiserver.tailnet.hub.samcday.com:6443
      certificate-authority: fabric/pki/k8s/lab-server-ca.crt
users:
  - name: hub-admin
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1
        command: ./scripts/credhelper
        args: ["hub"]
        interactiveMode: Never
  - name: cloud-admin
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1
        command: ./scripts/credhelper
        args: ["cloud"]
        interactiveMode: Never
  - name: edge-au-east-admin
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1
        command: ./scripts/credhelper
        args: ["edge-au-east"]
        interactiveMode: Never
  - name: fabric-operator
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1
        command: /usr/bin/bash
        args:
          - -c
          - 'exec "${FABRIC_INFRA_ROOT:-$HOME/src/infra}/scripts/fabric-credential"'
        interactiveMode: Never
  - name: lab-admin
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1
        command: ./scripts/credhelper
        args: ["lab"]
        interactiveMode: Never
contexts:
  - name: hub
    context:
      cluster: hub
      user: hub-admin
  - name: cloud
    context:
      cluster: cloud
      user: cloud-admin
  - name: edge-au-east
    context:
      cluster: edge-au-east
      user: edge-au-east-admin
  - name: fabric
    context:
      cluster: fabric
      user: fabric-operator
  - name: lab
    context:
      cluster: lab
      user: lab-admin
current-context: fabric
