apiVersion: v1
kind: Config
clusters:
  - name: hub
    cluster:
      server: https://10.0.1.254:6443
      certificate-authority-data: 
  # Hub embeds certificate-authority-data inline because it is always present in-repo.
  # Cloud uses a certificate-authority file path because its CA is fetched by `kube-credential-helper --init` from the hub API.
  - name: cloud
    cluster:
      server: https://100.64.0.3:6443
      certificate-authority: hub/pki/k8s/cloud-server-ca.crt
  - name: binarylane-demo
    cluster:
      server: https://100.64.0.15:6443
      certificate-authority: hub/pki/k8s/binarylane-demo-server-ca.crt
users:
  - name: hub-admin
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1
        command: ./scripts/credhelper
        args: ["hub"]
        interactiveMode: Never
  - name: cloud-admin
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1
        command: ./scripts/credhelper
        args: ["cloud"]
        interactiveMode: Never
  - name: binarylane-demo-admin
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1
        command: ./scripts/credhelper
        args: ["binarylane-demo"]
        interactiveMode: Never
contexts:
  - name: hub
    context:
      cluster: hub
      user: hub-admin
  - name: cloud
    context:
      cluster: cloud
      user: cloud-admin
  - name: binarylane-demo
    context:
      cluster: binarylane-demo
      user: binarylane-demo-admin
current-context: hub
