# SRV records that the root etcd cluster uses for discovery

set -uexo pipefail

uci -q batch <<EOI
set dhcp.etcd_srv_client_az1_cp1=srvhost=srvhost
set dhcp.etcd_srv_client_az1_cp1.srv='_etcd-client-ssl._tcp.etcd.hub.internal.'
set dhcp.etcd_srv_client_az1_cp1.target='hub-az1-cp1.hub.internal'
set dhcp.etcd_srv_client_az1_cp1.port='2379'

set dhcp.etcd_srv_client_az1_cp2=srvhost
set dhcp.etcd_srv_client_az1_cp2.srv='_etcd-client-ssl._tcp.etcd.hub.internal.'
set dhcp.etcd_srv_client_az1_cp2.target='hub-az1-cp2.hub.internal'
set dhcp.etcd_srv_client_az1_cp2.port='2379'

set dhcp.etcd_srv_client_az1_cp3=srvhost
set dhcp.etcd_srv_client_az1_cp3.srv='_etcd-client-ssl._tcp.etcd.hub.internal.'
set dhcp.etcd_srv_client_az1_cp3.target='hub-az1-cp3.hub.internal'
set dhcp.etcd_srv_client_az1_cp3.port='2379'

set dhcp.etcd_srv_server_az1_cp1=srvhost
set dhcp.etcd_srv_server_az1_cp1.srv='_etcd-server-ssl._tcp.etcd.hub.internal.'
set dhcp.etcd_srv_server_az1_cp1.target='hub-az1-cp1.hub.internal'
set dhcp.etcd_srv_server_az1_cp1.port='2380'

set dhcp.etcd_srv_server_az1_cp2=srvhost
set dhcp.etcd_srv_server_az1_cp2.srv='_etcd-server-ssl._tcp.etcd.hub.internal.'
set dhcp.etcd_srv_server_az1_cp2.target='hub-az1-cp2.hub.internal'
set dhcp.etcd_srv_server_az1_cp2.port='2380'

set dhcp.etcd_srv_server_az1_cp3=srvhost
set dhcp.etcd_srv_server_az1_cp3.srv='_etcd-server-ssl._tcp.etcd.hub.internal.'
set dhcp.etcd_srv_server_az1_cp3.target='hub-az1-cp3.hub.internal'
set dhcp.etcd_srv_server_az1_cp3.port='2380'
commit dhcp
EOI

service dnsmasq restart || true
