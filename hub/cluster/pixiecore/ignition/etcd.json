	"systemd": {
		"units": [
			{
				"contents": "[Unit]\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nExecStartPre=-podman kill etcd\nExecStartPre=-podman rm etcd\nExecStart=podman run --name etcd --volume /var/lib/etcd:/var/lib/etcd:z --net=host quay.io/coreos/etcd:v3.6.4 \\\n    /usr/local/bin/etcd \\\n        --name %H.hub.internal \\\n        --discovery-srv etcd.hub.internal \\\n        --initial-cluster-token hub-etcd \\\n        --data-dir /var/lib/etcd \\\n        --initial-advertise-peer-urls https://%H.hub.internal:2380 \\\n        --listen-peer-urls https://0.0.0.0:2380 \\\n        --advertise-client-urls https://%H.hub.internal:2379 \\\n        --listen-client-urls https://0.0.0.0:2379 \\\n        --client-cert-auth=true \\\n        --peer-client-cert-auth=true \\\n        --cert-file=/var/lib/etcd/peer.pem \\\n        --key-file=/var/lib/etcd/peer-key.pem \\\n        --trusted-ca-file=/var/lib/etcd/ca.pem \\\n        --peer-cert-file=/var/lib/etcd/peer.pem \\\n        --peer-key-file=/var/lib/etcd/peer-key.pem \\\n        --peer-trusted-ca-file=/var/lib/etcd/ca.pem\nExecStop=/bin/podman stop etcd\n\n[Install]\nWantedBy=multi-user.target\n",
				"enabled": true,
				"name": "etcd.service"
			}
