{
    "acls": [
        {
            "action": "accept",
            "src": [
                "sam@"
            ],
            "dst": [
                "*:*"
            ]
        },
        // Allow cloud-cluster nodes to access their apiserver
        {
            "action": "accept",
            "src": ["tag:cloud-cluster-node"],
            "dst": ["tag:cloud-cluster-apiserver:*"]
        },
        // Allow edge-au-east nodes to access only their hosted apiserver.
        {
            "action": "accept",
            "src": ["tag:edge-au-east-node"],
            "dst": [
                "tag:edge-au-east-apiserver:6443",
                "tag:edge-au-east-apiserver:8091"
            ]
        },
        // Lab nodes use only the Tailnet-published hosted control plane.
        {
            "action": "accept",
            "proto": "tcp",
            "src": ["tag:lab-node"],
            "dst": [
                "tag:lab-apiserver:6443",
                "tag:lab-apiserver:8091"
            ]
        },
        // The pre-OS client reaches Fabric Bootie through the Lab router.
        {
            "action": "accept",
            "proto": "tcp",
            "src": ["tag:lab-router"],
            "dst": ["tag:lab-bootie:80"]
        }
    ],
    "tagOwners": {
        "tag:cloud-cluster-apiserver": [],
        "tag:cloud-cluster-metrics-write": [],
        "tag:cloud-cluster-wasmcloud-nats": [],
        "tag:cloud-cluster-node": [],
        "tag:edge-au-east-apiserver": [],
        "tag:edge-au-east-node": [],
        "tag:fabric-subnet-router": ["sam@"],
        "tag:hub-apiserver": [],
        "tag:lab-apiserver": [],
        "tag:lab-bootie": [],
        "tag:lab-node": [],
        "tag:lab-router": ["sam@"],
        "tag:labgrid-coordinator": []
    },
    "autoApprovers": {
        "routes": {
            "10.66.0.0/24": ["tag:fabric-subnet-router"],
            "10.66.1.0/24": ["tag:fabric-subnet-router"]
        }
    }
}
