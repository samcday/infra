{
    "acls": [
        {
            "action": "accept",
            "src": [
                "sam@"
            ],
            "dst": [
                "*:*"
            ]
        },
        {
            "action": "accept",
            "src": [
                "tag:hub-subnet-router"
            ],
            "dst": [
                "10.0.1.0/24:*",
                "10.0.2.0/24:*",
                "172.30.0.0/16:*",
                "172.31.0.0/16:*",
                "tag:hub-subnet-router:*"
            ]
        },
        // Allow simonet to access apiserver+bootie deployed for it in hub cluster.
        {
            "action": "accept",
            "src": ["tag:simonet"],
            "dst": [
                "10.0.2.252/30:*",
                "tag:hub-subnet-router:*"
            ]
        },
        // Allow cloud-cluster nodes and pods to access the apiserver, peer
        // nodes, and pod CIDR. Pod-to-pod traffic rides the tailnet via
        // tailscale-node-controller advertised routes; for headscale's
        // packet filter to accept a podCIDR-sourced packet at the receiver
        // we list 172.28.0.0/16 explicitly as src (headscale doesn't
        // auto-expand advertised subnets into ACL sources).
        {
            "action": "accept",
            "src": ["tag:cloud-cluster-node", "172.28.0.0/16"],
            "dst": [
                "tag:cloud-cluster-apiserver:*",
                "tag:cloud-cluster-node:*",
                "172.28.0.0/16:*"
            ]
        },
        {
            "action": "accept",
            "src": ["tag:edge-node"],
            "dst": ["tag:edge-apiserver:*"]
        }
    ],
    "autoApprovers": {
        "routes": {
            "10.0.1.0/24": [
                "tag:hub-subnet-router"
            ],
            "10.0.2.0/24": [
                "tag:hub-subnet-router"
            ],
            "10.0.6.0/24": [
                "tag:simonet"
            ],
            "172.30.0.0/16": [
                "tag:hub-subnet-router"
            ],
            "172.31.0.0/16": [
                "tag:hub-subnet-router"
            ],
            "172.28.0.0/16": [
                "tag:cloud-cluster-node"
            ]
        }
    },
    "tagOwners": {
        "tag:hub-subnet-router": [],
        "tag:cloud-cluster-apiserver": [],
        "tag:cloud-cluster-node": [],
        "tag:edge-apiserver": [],
        "tag:edge-node": [],
        "tag:simonet": []
    }
}
