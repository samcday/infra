systemd:
    units:
        - name: etcd.service
          enabled: true
          contents: |
            [Unit]
            After=network-online.target
            Wants=network-online.target

            [Service]
            ExecStartPre=-podman kill etcd
            ExecStartPre=-podman rm etcd
            ExecStart=podman run --name etcd --volume /var/lib/etcd:/var/lib/etcd:z --net=host quay.io/coreos/etcd:v3.6.4 \
                /usr/local/bin/etcd \
                    --name %H.hub.internal \
                    --discovery-srv etcd.hub.internal \
                    --initial-cluster-token hub-etcd \
                    --data-dir /var/lib/etcd \
                    --initial-advertise-peer-urls https://%H.hub.internal:2380 \
                    --listen-peer-urls https://0.0.0.0:2380 \
                    --advertise-client-urls https://%H.hub.internal:2379 \
                    --listen-client-urls https://0.0.0.0:2379 \
                    --client-cert-auth=true \
                    --peer-client-cert-auth=true \
                    --cert-file=/var/lib/etcd/peer.pem \
                    --key-file=/var/lib/etcd/peer-key.pem \
                    --trusted-ca-file=/var/lib/etcd/ca.pem \
                    --peer-cert-file=/var/lib/etcd/peer.pem \
                    --peer-key-file=/var/lib/etcd/peer-key.pem \
                    --peer-trusted-ca-file=/var/lib/etcd/ca.pem
            ExecStop=/bin/podman stop etcd

            [Install]
            WantedBy=multi-user.target
