                I1Eo9qGzkj7Io3ZXpJrjIhgoZ64LRc7L1X/99/Bq/NzEbbqXakXflrEn
                -----END CERTIFICATE-----
        - path: /var/lib/rancher/k3s/server/etcd-client.pem
          overwrite: true
          contents:
            inline: |
                -----BEGIN CERTIFICATE-----
                MIIDJzCCAg+gAwIBAgIUFuAG8JTWkI2pZCN5b6tHG3jQ4QkwDQYJKoZIhvcNAQEL
                BQAwEzERMA8GA1UEAxMIaHViLWV0Y2QwHhcNMjUwODAzMDcyODAwWhcNMjYwODAz
