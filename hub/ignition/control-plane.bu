    trees:
        - local: control-plane
          path: /
systemd:
    units:
        - name: k3s.service
          enabled: true
          contents: |
            [Unit]
            After=network-online.target
            Wants=network-online.target

            [Service]
            ExecStartPre=-podman kill k3s
            ExecStartPre=-podman rm k3s
            ExecStart=podman run --rm -it --privileged \
                --volume /etc/rancher:/etc/rancher:z \
                --volume /var/lib/rancher/k3s/server:/var/lib/rancher/k3s/server:z \
                --name k3s \
                --net=host \
                docker.io/rancher/k3s:v1.33.3-k3s1 \
                server \
                  --datastore-endpoint=https://hub-az1-cp1.hub.internal:2379,https://hub-az1-cp2.hub.internal:2379,https://hub-az1-cp3.hub.internal:2379 \
                  --datastore-cafile=/var/lib/rancher/k3s/server/etcd-ca.pem \
                  --datastore-certfile=/var/lib/rancher/k3s/server/etcd-client.pem \
                  --datastore-keyfile=/var/lib/rancher/k3s/server/etcd-client-key.pem \
                  --kube-apiserver-arg=etcd-prefix=/hub-cp \
                  --kube-apiserver-arg=etcd-compaction-interval=0
            ExecStop=/bin/podman stop k3s

            [Install]
            WantedBy=multi-user.target
