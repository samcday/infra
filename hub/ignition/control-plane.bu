variant: fcos
version: 1.5.0
storage:
    directories:
        - path: /etc/rancher/k3s/config.yaml.d
        - path: /var/lib/rancher/k3s/server
    files:
        - path: /etc/rancher/k3s/config.yaml.d/token.yaml
          overwrite: true
          contents:
            # cryptme
            inline: ENC[AES256_GCM,data:NJ5C1dntpANbf3RdUxtbuxwO+9ExSUnHnC/rPbedYTKpfGl3rv6B4g==,iv:fKoz/qqzx2hRFk+RTsLsGtykVuhwJqjnheVzXR9OJn0=,tag:/ZUlO126GnkgzG1/4KWxCA==,type:str]
        - path: /var/lib/rancher/k3s/server/etcd-client-key.pem
          overwrite: true
          contents:
            # cryptme
            inline: ENC[AES256_GCM,data:,iv:hun7xUWrY1rsfgjLXFt6ybYFGVcHd+AJ81CFHumTCKU=,tag:YkSX7XvDLRgtY0kMmRDPXA==,type:str]
        - path: /var/lib/rancher/k3s/server/manifests/flux-age-key.yaml
          overwrite: true
          contents:
            # cryptme
            inline: ENC[AES256_GCM,data:,iv:7uDdYPpwf92LWFMvDW747Vjd2NfFnEa6AHKxSjUTWyA=,tag:AmCh9oxElIdxzvg65koE4w==,type:str]
        - path: /var/lib/rancher/k3s/server/manifests/flux-ssh-key.yaml
          overwrite: true
          contents:
            # cryptme
            inline: ENC[AES256_GCM,data:,iv:AOfWj2AfzmwBWxf5gTROADYi1ilheeQBvt4CkOf1NTU=,tag:bj7nZUc1c99xXb32hzQ+2w==,type:str]
    trees:
        - local: control-plane
          path: /
systemd:
    units:
        - name: k3s.service
          enabled: true
          contents: |
            [Unit]
            After=network-online.target
            Wants=network-online.target

            [Service]
            ExecStartPre=-podman kill k3s
            ExecStartPre=-podman rm k3s
            ExecStart=podman run --rm -it --privileged \
                --volume /etc/rancher:/etc/rancher:z \
                --volume /var/lib/rancher/k3s/server:/var/lib/rancher/k3s/server:z \
                --name k3s \
                --net=host \
                docker.io/rancher/k3s:v1.33.3-k3s1 \
                server
            ExecStop=/bin/podman stop k3s

            [Install]
            WantedBy=multi-user.target
sops:
    kms: []
    gcp_kms: []
    azure_kv: []
    hc_vault: []
    age:
        - recipient: age1jl2wrpps4htmzkfuz2rhtuactm45c5ph3dyu8pxul9nt2scsh4aq36rv56
          enc: |
