variant: fcos
version: 1.5.0
storage:
    directories:
        - path: /etc/rancher/k3s/config.yaml.d
        - path: /var/lib/rancher/k3s/server
    files:
        - path: /etc/rancher/k3s/config.yaml.d/embedded-registry.yaml
          contents:
            inline: |
                embedded-registry: true
          overwrite: true
        - path: /etc/rancher/k3s/config.yaml.d/etcd-client.yaml
          overwrite: true
          contents:
            inline: |
                datastore-endpoint: https://hub-az1-cp1.hub.internal:2379,https://hub-az1-cp2.hub.internal:2379,https://hub-az1-cp3.hub.internal:2379
                datastore-cafile: /var/lib/rancher/k3s/server/etcd-ca.pem
                datastore-certfile: /var/lib/rancher/k3s/server/etcd-client.pem
                datastore-keyfile: /var/lib/rancher/k3s/server/etcd-client-key.pem
                kube-apiserver-arg+:
                  - etcd-prefix=/hub-cp
                  - etcd-compaction-interval=0
        - path: /etc/rancher/k3s/config.yaml.d/network.yaml
          overwrite: true
          contents:
            inline: |
                cluster-cidr: 172.30.0.0/16
                service-cidr: 172.31.0.0/16
                cluster-domain: cluster.hub.internal
        - path: /etc/rancher/k3s/config.yaml.d/no-flannel.yaml
          contents:
            inline: |
                flannel-backend: none
          overwrite: true
        - path: /etc/rancher/k3s/config.yaml.d/no-kube-proxy.yaml
          contents:
            inline: |
                disable-kube-proxy: true
        - path: /etc/rancher/k3s/config.yaml.d/tls-san.yaml
          overwrite: true
          contents:
            inline: |
                tls-san:
                  - 10.0.1.254
        - path: /etc/rancher/k3s/server.token
          overwrite: true
          mode: 384
          contents:
            # cryptme
            inline: ENC[AES256_GCM,data:NX8kol3PpIzftw1v51xKIyWr8yKgmmJBzaNIGy3SHUyCj2PPKABmBg==,iv:k1UqH4YmYDERyi2SpXL9gm07cxU4HAe2Ti3Ya+DZkxg=,tag:1CU5p1wCOl9xYpWOemDOuQ==,type:str]
        - path: /var/lib/rancher/k3s/server/etcd-ca.pem
          overwrite: true
          contents:
            inline: |
                -----BEGIN CERTIFICATE-----
                MIIC9jCCAd6gAwIBAgIUURMTSE40fCjICgNFNkI/O5Dez2kwDQYJKoZIhvcNAQEL
                BQAwEzERMA8GA1UEAxMIaHViLWV0Y2QwHhcNMjUwODAzMDQxODAwWhcNMzAwODAy
                MDQxODAwWjATMREwDwYDVQQDEwhodWItZXRjZDCCASIwDQYJKoZIhvcNAQEBBQAD
