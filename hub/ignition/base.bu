variant: fcos
version: 1.5.0
boot_device:
    luks:
        tang:
            - url: http://10.0.1.1:9090
              thumbprint: l9LDpXvDicxQZF-9DI1CsNPont8ktuU5oIean7gU8iw
        discard: true
kernel_arguments:
    should_exist:
        - mitigations=auto,nosmt=off
        - selinux=0
    should_not_exist:
        - mitigations=auto,nosmt
passwd:
    users:
        - name: sam
          groups:
            - adm
            - wheel
            - sudo
            - systemd-journal
          ssh_authorized_keys:
            - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFwawprQXEkGl38Q7T0PNseL0vpoyr4TbATMkEaZJTWQ
storage:
    files:
        - path: /etc/rancher/k3s/config.yaml.d/embedded-registry.yaml
          contents:
            inline: |
                embedded-registry: true
          overwrite: true
        - path: /etc/rancher/k3s/config.yaml.d/no-flannel.yaml
          contents:
            inline: |
                flannel-backend: none
          overwrite: true
        - path: /etc/rancher/k3s/config.yaml.d/no-kube-proxy.yaml
          contents:
            inline: |
                disable-kube-proxy: true
          overwrite: true
        - path: /etc/rancher/k3s/registries.yaml
          contents:
            inline: |
                mirrors:
                  "*":
          overwrite: true
        - path: /etc/zincati/config.d/90-disable.toml
          contents:
            inline: |
                [updates]
                enabled = false
          overwrite: true
        - path: /usr/local/bin/k3s
          overwrite: true
          contents:
            source: https://github.com/k3s-io/k3s/releases/download/v1.33.3%2Bk3s1/k3s
          mode: 493
        - path: /usr/local/bin/install-k3s
          overwrite: true
          contents:
            source: https://get.k3s.io
          mode: 493
        - path: /var/lib/rancher/k3s/server/manifests/traefik.yaml.skip
          contents:
            inline: ""
          overwrite: true
systemd:
    units:
        - name: install-k3s.service
          enabled: true
          contents: |
            [Unit]
            Description=Run k3s install script
            ConditionPathExists=!/etc/%N.stamp

            [Service]
            Type=oneshot
            RemainAfterExit=yes
            Environment=INSTALL_K3S_SKIP_DOWNLOAD=true
            ExecStart=/usr/local/bin/install-k3s
            ExecStart=/bin/touch /etc/%N.stamp

            [Install]
            WantedBy=multi-user.target
sops:
    kms: []
    gcp_kms: []
    azure_kv: []
    hc_vault: []
    age:
        - recipient: age1jl2wrpps4htmzkfuz2rhtuactm45c5ph3dyu8pxul9nt2scsh4aq36rv56
          enc: |
