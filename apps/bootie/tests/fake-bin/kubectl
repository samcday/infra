#!/bin/bash
set -euo pipefail

joined=$*
if [[ -n ${FAKE_KUBECTL_LOG:-} ]]; then
  printf '%s\n' "$joined" >> "$FAKE_KUBECTL_LOG"
fi
if [[ ${1:-} == annotate || ${1:-} == patch ]]; then
  case ${2:-} in
    node/test-node | node/fabric-az1-cp3) ;;
    *)
      echo "unexpected kubectl mutation target: $joined" >&2
      exit 1
      ;;
  esac
  if [[ ${1:-} == patch && ${FAIL_PATCH:-false} == true ]]; then
    exit 1
  fi
  exit 0
fi
case "$joined" in
  "get node/fabric-az1-cp3 -o json")
    jq -n \
      --arg resource_version "${FAKE_RESOURCE_VERSION:-12345}" \
      --arg uid "${FAKE_NODE_UID:-01234567-89ab-cdef-0123-456789abcdef}" \
      --arg mac "${FAKE_MAC:-00-11-22-33-44-55}" \
      --arg serial "${FAKE_SERIAL:-}" \
      --arg discovery "${FAKE_DISCOVERY:-true}" \
      --arg boot_device "${FAKE_BOOT_DEVICE:-}" \
      --arg install "${FAKE_INSTALL:-}" \
      --arg bootstrap_state "${FAKE_BOOTSTRAP_STATE:-discovery}" \
      --arg ignition_token "${FAKE_IGNITION_TOKEN-}" \
      --arg ignition_mode "${FAKE_IGNITION_MODE-}" \
      '{
        apiVersion: "v1",
        kind: "Node",
        metadata: {
          name: "fabric-az1-cp3",
          uid: $uid,
          resourceVersion: $resource_version,
          labels: {
            "samcday.com/mac": $mac,
            "samcday.com/serial": $serial,
            "samcday.com/discovery": $discovery
          },
          annotations: {
            "samcday.com/boot-device": $boot_device,
            "samcday.com/install": $install,
            "fabric.samcday.com/bootstrap-state": $bootstrap_state,
            "samcday.com/ignition-token": $ignition_token,
            "samcday.com/ignition-mode": $ignition_mode
          }
        }
      }'
    ;;
  "get node -o name fabric-az1-cp3")
    echo node/fabric-az1-cp3
    ;;
  "get node -o name -l samcday.com/mac="*)
    [[ ${FAIL_ON_LIST:-false} != true ]] || exit 1
    echo node/test-node
    ;;
  "get node -o name -l samcday.com/serial="*)
    [[ ${FAIL_ON_LIST:-false} != true ]] || exit 1
    ;;
  *samcday\\.com/mac*)
    printf '%s' "${FAKE_MAC:-00-11-22-33-44-55}"
    ;;
  *samcday\\.com/serial*)
    printf '%s' "${FAKE_SERIAL:-}"
    ;;
  *boot-device*)
    printf '%s' "${FAKE_BOOT_DEVICE:-}"
    ;;
  *bootstrap-state*)
    printf '%s' "${FAKE_BOOTSTRAP_STATE:-discovery}"
    ;;
  *ignition-token*)
    printf '%s' "${FAKE_IGNITION_TOKEN-fixed-token}"
    ;;
  *ignition-mode*)
    printf '%s' "${FAKE_IGNITION_MODE-install}"
    ;;
  *samcday\\.com/install*)
    printf '%s' "${FAKE_INSTALL:-}"
    ;;
  *samcday\\.com/discovery*)
    printf '%s' "${FAKE_DISCOVERY:-true}"
    ;;
  *)
    echo "unexpected kubectl invocation: $joined" >&2
    exit 1
    ;;
esac
