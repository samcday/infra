#!/bin/bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
boot_request=$script_dir/../boot-request.sh
export PATH="$script_dir/fake-bin:$PATH"
export FCOS_VERSION=44.test
export FCOS_BASE=http://192.0.2.1/static
export FCOS_GRUB_BASE='(http,192.0.2.1)/static'
export BOOTIE_PUBLIC_ORIGIN=http://192.0.2.1
export BOOTIE_EXPECTED_NODE_UID=01234567-89ab-cdef-0123-456789abcdef
export QUERY_STRING=mac=00-11-22-33-44-55

fail() {
  echo "bootie test failed: $*" >&2
  exit 1
}

assert_contains() {
  local output=$1
  local expected=$2
  grep -Fq -- "$expected" <<< "$output" ||
    fail "output does not contain: $expected"
}

assert_not_contains() {
  local output=$1
  local rejected=$2
  if grep -Fq -- "$rejected" <<< "$output"; then
    fail "output unexpectedly contains: $rejected"
  fi
}

live_grub=$(
  BOOT_FORMAT=grub \
    FAKE_BOOT_DEVICE='' \
    FAKE_DISCOVERY=true \
    FAKE_INSTALL='' \
    "$boot_request"
)
assert_contains "$live_grub" \
  'linux (http,192.0.2.1)/static/fedora-coreos-44.test-live-kernel.x86_64'
assert_contains "$live_grub" 'ignition.config.url=http://192.0.2.1/ignition/test-node?token='
assert_contains "$live_grub" \
  'initrd (http,192.0.2.1)/static/fedora-coreos-44.test-live-initramfs.x86_64.img'
assert_not_contains "$live_grub" '#!ipxe'
assert_not_contains "$live_grub" 'coreos.inst.install_dev='

fixed_node=$(
  BOOT_FORMAT=grub \
    BOOTIE_ALLOW_NODE_CREATE=false \
    BOOTIE_NODE_NAME=test-node \
    FAIL_ON_LIST=true \
    FAKE_BOOT_DEVICE='' \
    FAKE_DISCOVERY=true \
    FAKE_INSTALL='' \
    "$boot_request"
)
assert_contains "$fixed_node" \
  'ignition.config.url=http://192.0.2.1/ignition/test-node?token='

wrong_fixed_mac=$(
  BOOT_FORMAT=grub \
    BOOTIE_ALLOW_NODE_CREATE=false \
    BOOTIE_NODE_NAME=test-node \
    FAIL_ON_LIST=true \
    FAKE_MAC=00-11-22-33-44-66 \
    FAKE_BOOT_DEVICE='' \
    FAKE_DISCOVERY=true \
    FAKE_INSTALL='' \
    "$boot_request" 2>&1
)
assert_contains "$wrong_fixed_mac" 'Status: 409 Conflict'
assert_contains "$wrong_fixed_mac" 'the request MAC does not match node/test-node'

live_ipxe=$(
  BOOT_FORMAT=ipxe \
    FAKE_BOOT_DEVICE='' \
    FAKE_DISCOVERY=true \
    FAKE_INSTALL='' \
    "$boot_request"
)
assert_contains "$live_ipxe" '#!ipxe'
assert_contains "$live_ipxe" \
  'kernel http://192.0.2.1/static/fedora-coreos-44.test-live-kernel.x86_64 initrd=main'

not_armed=$(
  BOOT_FORMAT=grub \
    FAKE_BOOT_DEVICE=/dev/disk/by-id/ata-approved \
    FAKE_DISCOVERY=false \
    FAKE_INSTALL='' \
    "$boot_request"
)
assert_contains "$not_armed" '# Installation is not armed.'
assert_not_contains "$not_armed" 'coreos.inst.install_dev='

install_grub=$(
  BOOT_FORMAT=grub \
    BOOTIE_INSTALL_POLICY_FILE="$script_dir/install-policy" \
    BOOTIE_REQUIRE_INSTALL_POLICY=true \
    FAKE_BOOT_DEVICE=/dev/disk/by-id/ata-approved \
    FAKE_DISCOVERY=false \
    FAKE_INSTALL=true \
    "$boot_request"
)
assert_contains "$install_grub" \
  'coreos.inst.install_dev=/dev/disk/by-id/ata-approved'
assert_contains "$install_grub" '\&install=1'

grep -Fqx '    location ~ "^/static/[0-9a-f]{32,64}\.img$" {' \
  "$script_dir/../nginx-http.conf" ||
  fail 'Nginx no longer denies capability-shaped files through /static'
[[ $(grep -Fc 'fastcgi_pass unix:/run/bootie/fcgi.sock;' \
  "$script_dir/../nginx-http.conf") == 3 ]] ||
  fail 'Nginx does not route all three CGI endpoints through the pod-local Unix socket'
! grep -Fq '127.0.0.1:9000' "$script_dir/../nginx-http.conf" ||
  fail 'Nginx still depends on the restart-sensitive host-network FastCGI TCP port'
# The runner must pass the literal shell variable to fcgiwrap at runtime.
# shellcheck disable=SC2016
grep -Fq 'exec fcgiwrap -s "unix:$fcgi_socket"' "$script_dir/../run.sh" ||
  fail 'run.sh does not bind fcgiwrap to the pod-local Unix socket'
# shellcheck disable=SC2016
grep -Fq 'chown root:nginx "$fcgi_socket"' "$script_dir/../run.sh" ||
  fail 'run.sh does not make the Unix socket accessible to the Nginx worker'

for grub_response in "$live_grub" "$fixed_node" "$install_grub"; do
  grub_body=${grub_response#*$'\n\n'}
  grub2-script-check /dev/stdin <<< "$grub_body"
done

wrong_device=$(
  BOOT_FORMAT=grub \
    BOOTIE_INSTALL_POLICY_FILE="$script_dir/install-policy" \
    BOOTIE_REQUIRE_INSTALL_POLICY=true \
    FAKE_BOOT_DEVICE=/dev/disk/by-id/ata-wrong \
    FAKE_DISCOVERY=false \
    FAKE_INSTALL=true \
    "$boot_request" 2>&1
)
assert_contains "$wrong_device" 'Status: 409 Conflict'
assert_contains "$wrong_device" 'the declared boot device does not match install policy'
assert_not_contains "$wrong_device" 'coreos.inst.install_dev='

missing_policy=$(
  BOOT_FORMAT=grub \
    BOOTIE_REQUIRE_INSTALL_POLICY=true \
    FAKE_BOOT_DEVICE=/dev/disk/by-id/ata-approved \
    FAKE_DISCOVERY=false \
    FAKE_INSTALL=true \
    "$boot_request" 2>&1
)
assert_contains "$missing_policy" 'Status: 409 Conflict'
assert_contains "$missing_policy" 'the required install policy is unavailable'

uid_bound_log=$(mktemp)
uid_bound_install=$(
  BOOT_FORMAT=grub \
    BOOTIE_ALLOW_NODE_CREATE=false \
    BOOTIE_EXPECTED_NODE_UID=01234567-89ab-cdef-0123-456789abcdef \
    BOOTIE_INSTALL_POLICY_FILE="$script_dir/install-policy" \
    BOOTIE_NODE_NAME=test-node \
    BOOTIE_REQUIRE_INSTALL_POLICY=true \
    FAKE_BOOT_DEVICE=/dev/disk/by-id/ata-approved \
    FAKE_DISCOVERY=false \
    FAKE_INSTALL=true \
    FAKE_KUBECTL_LOG="$uid_bound_log" \
    "$boot_request"
)
assert_contains "$uid_bound_install" 'coreos.inst.install_dev=/dev/disk/by-id/ata-approved'
grep -Fq '"path":"/metadata/uid","value":"01234567-89ab-cdef-0123-456789abcdef"' \
  "$uid_bound_log" || fail 'fixed-Ignition install consumption was not Node-UID bound'
grep -Fq '"path":"/metadata/resourceVersion","value":"12345"' \
  "$uid_bound_log" || fail 'fixed-Ignition install consumption was not version bound'
grep -Fq '"op":"remove","path":"/metadata/annotations/samcday.com~1install"' \
  "$uid_bound_log" || fail 'install authorization was not consumed'
grep -Fq '"path":"/metadata/annotations/samcday.com~1ignition-mode","value":"install"' \
  "$uid_bound_log" || fail 'install token was not mode bound'
rm -f -- "$uid_bound_log"

uid_mismatch=$(
  BOOT_FORMAT=grub \
    BOOTIE_ALLOW_NODE_CREATE=false \
    BOOTIE_EXPECTED_NODE_UID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee \
    BOOTIE_INSTALL_POLICY_FILE="$script_dir/install-policy" \
    BOOTIE_NODE_NAME=test-node \
    BOOTIE_REQUIRE_INSTALL_POLICY=true \
    FAKE_BOOT_DEVICE=/dev/disk/by-id/ata-approved \
    FAKE_DISCOVERY=false \
    FAKE_INSTALL=true \
    "$boot_request" 2>&1
)
assert_contains "$uid_mismatch" 'Status: 409 Conflict'
assert_contains "$uid_mismatch" 'Node UID does not match the issued identity'
assert_not_contains "$uid_mismatch" 'coreos.inst.install_dev='

invalid_format=$(
  BOOT_FORMAT=pxelinux \
    FAKE_BOOT_DEVICE='' \
    FAKE_DISCOVERY=true \
    FAKE_INSTALL='' \
    "$boot_request" 2>&1
)
assert_contains "$invalid_format" 'Status: 500 Internal Server Error'

fixed_dir=$(mktemp -d)
trap 'rm -rf -- "$fixed_dir"' EXIT
install -m 0600 "$script_dir/fixtures/fixed-ignition.ign" \
  "$fixed_dir/test-node.ign"
mutation_log=$fixed_dir/kubectl-mutations.log
fixed_ignition=$(
  BOOTIE_FIXED_IGNITION_FILE="$fixed_dir/test-node.ign" \
    BOOTIE_NODE_NAME=test-node \
    FAKE_KUBECTL_LOG="$mutation_log" \
    FAKE_DISCOVERY=false \
    FAKE_IGNITION_MODE=install \
    FAKE_IGNITION_TOKEN=fixed-token \
    QUERY_STRING='token=fixed-token&install=1' \
    REQUEST_URI=/ignition/test-node \
    "$script_dir/../generate-ignition.sh"
)
assert_contains "$fixed_ignition" 'content-type: application/json'
grep -Fq 'patch node/test-node --type=json --patch' "$mutation_log" ||
  fail 'fixed Ignition request did not consume its one-use token'
fixed_body=${fixed_ignition#*$'\n\n'}
jq -e '
  .ignition.version == "3.4.0" and
  .storage.files[0].path == "/etc/bootie-fixed-profile"
' <<< "$fixed_body" >/dev/null || fail 'fixed Ignition response changed'

fixed_live_refusal=$(
  BOOTIE_FIXED_IGNITION_FILE="$fixed_dir/test-node.ign" \
    BOOTIE_NODE_NAME=test-node \
    FAKE_DISCOVERY=false \
    FAKE_IGNITION_MODE=live \
    FAKE_IGNITION_TOKEN=fixed-token \
    QUERY_STRING='token=fixed-token' \
    REQUEST_URI=/ignition/test-node \
    "$script_dir/../generate-ignition.sh" 2>&1
)
assert_contains "$fixed_live_refusal" 'Status: 403 Forbidden'
assert_not_contains "$fixed_live_refusal" '/etc/bootie-fixed-profile'

failed_consumption=$(
  BOOTIE_FIXED_IGNITION_FILE="$fixed_dir/test-node.ign" \
    BOOTIE_NODE_NAME=test-node \
    FAIL_PATCH=true \
    FAKE_DISCOVERY=false \
    FAKE_IGNITION_MODE=install \
    FAKE_IGNITION_TOKEN=fixed-token \
    QUERY_STRING='token=fixed-token&install=1' \
    REQUEST_URI=/ignition/test-node \
    "$script_dir/../generate-ignition.sh" 2>&1
)
assert_contains "$failed_consumption" 'Status: 409 Conflict'
assert_contains "$failed_consumption" 'ignition token was already consumed'
assert_not_contains "$failed_consumption" '/etc/bootie-fixed-profile'

# An old deployment must fail closed, not fall through to the ordinary installer.
for retired_setting in BOOTIE_DAY2_MODE=true \
    BOOTIE_REQUIRE_BOOTSTRAP_STATE=true BOOTIE_INSTALL_DELIVERY=custom-initramfs; do
  for handler in "$boot_request" "$script_dir/../generate-ignition.sh"; do
    : > "$mutation_log"
    refused=$(env "$retired_setting" FAKE_KUBECTL_LOG="$mutation_log" \
      "$handler" 2>&1)
    assert_contains "$refused" 'Status: 409 Conflict'
    assert_contains "$refused" 'unsupported provisioning mode'
    [[ ! -s "$mutation_log" ]] || fail 'retired mode contacted Kubernetes'
  done
done

failed_install=$(
  FAIL_PATCH=true FAKE_DISCOVERY=false FAKE_INSTALL=true \
    FAKE_BOOT_DEVICE=/dev/disk/by-id/ata-approved "$boot_request" 2>&1
)
assert_contains "$failed_install" 'Status: 409 Conflict'
assert_not_contains "$failed_install" 'coreos.inst.install_dev='

discovery_install=$(
  FAKE_DISCOVERY=true FAKE_INSTALL=true \
    FAKE_BOOT_DEVICE=/dev/disk/by-id/ata-approved "$boot_request" 2>&1
)
assert_contains "$discovery_install" 'Status: 409 Conflict'
assert_not_contains "$discovery_install" 'coreos.inst.install_dev='

echo 'bootie request tests passed'
