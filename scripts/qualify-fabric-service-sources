#!/usr/bin/env bash

set -euo pipefail
umask 077

readonly namespace=fabric-policy-probe
readonly interface=enp9s0u1u2
readonly interface_serial=00154000F
readonly interface_mac=98:fd:b4:9a:7a:d7
readonly service_gateway=10.66.1.1
readonly router_address=10.66.0.1
readonly api_address=10.66.0.254
readonly root_subnet=10.66.0.0/24
readonly fabric_network_lock=/run/lock/fabric-network-operation.lock
readonly confirmation="QUALIFY-FABRIC-SERVICE-SOURCES:$interface:$interface_serial:$interface_mac"
readonly -a service_addresses=(10.66.1.10 10.66.1.11)
readonly unauthorized_address=10.66.1.100
readonly -a root_nodes=(cp1 cp2 cp3)
readonly -a root_addresses=(10.66.0.10 10.66.0.11 10.66.0.12)
readonly -a etcd_ports=(2379 2380 2381)
declare -A initial_interface_sysctls=()
declare -a interface_sysctl_keys=()

usage() {
  cat <<EOF
Qualify the fabric-source policy needed before the first service-node install.

Read-only admission check:
  sudo scripts/qualify-fabric-service-sources \\
    --check \\
    --serial-ed25519-fingerprint SHA256:VALUE_FROM_ROUTER_SERIAL \\
    --identity /var/home/sam/.ssh/id_ed25519

Attended qualification (copy the confirmation printed by --check):
  sudo scripts/qualify-fabric-service-sources \\
    --run \\
    --serial-ed25519-fingerprint SHA256:VALUE_FROM_ROUTER_SERIAL \\
    --identity /var/home/sam/.ssh/id_ed25519 \\
    --confirm '$confirmation'

The live run temporarily moves only the identity-pinned Realtek USB NIC into
the $namespace network namespace. It tests 10.66.1.10 and .11 against the
CA-pinned Kubernetes API and every root etcd port, then tests unauthorized
10.66.1.100 against the API. Named router and current VIP-holder nftables
counter deltas must agree with every result.

This is a narrow pre-install gate, not the complete attended source-role
matrix documented in fabric/router/README.md. It does not start Bootie, issue
a credential, arm an installer, or write a candidate disk.
EOF
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*"
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

valid_fingerprint() {
  [[ $1 =~ ^SHA256:[A-Za-z0-9+/]{43}$ ]]
}

require_root_namespace() {
  local current initial
  current=$(readlink -- /proc/self/ns/net) || die 'cannot identify current network namespace'
  initial=$(readlink -- /proc/1/ns/net) || die 'cannot identify initial network namespace'
  [[ $current == "$initial" ]] || die 'run from the initial/root network namespace'
}

namespace_exists() {
  local listing
  listing=$(ip netns list) || die 'cannot enumerate network namespaces'
  awk -v wanted="$namespace" '$1 == wanted { found = 1 } END { exit !found }' \
    <<<"$listing"
}

single_root_default() {
  local output
  output=$(ip -o -4 route show table all default) ||
    die 'cannot inspect root IPv4 default routes'
  [[ $(awk 'NF { count++ } END { print count + 0 }' <<<"$output") -eq 1 ]] ||
    die 'root namespace must have exactly one IPv4 default route'
  [[ $output == *' dev eno1 '* ]] ||
    die 'the sole root IPv4 default route must use eno1'
  [[ $output != *' nexthop '* ]] || die 'the root IPv4 default route must not be ECMP'
  printf '%s\n' "$output"
}

interface_serial_value() {
  udevadm info --query=property --path="/sys/class/net/$interface" |
    awk -F= '$1 == "ID_SERIAL_SHORT" { print $2 }'
}

interface_permanent_mac() {
  local output
  output=$(ethtool -P "$interface") || die "cannot read permanent MAC for $interface"
  output=${output#Permanent address: }
  printf '%s\n' "${output,,}"
}

validate_probe_interface() {
  local current_mac permanent_mac serial
  [[ -e /sys/class/net/$interface ]] || die "probe interface is absent: $interface"
  [[ -e /sys/class/net/$interface/device ]] || die 'probe interface is not physical'
  [[ $(<"/sys/class/net/$interface/type") == 1 ]] || die 'probe interface is not Ethernet-like'
  [[ ! -e /sys/class/net/$interface/phy80211 ]] || die 'probe interface must not be Wi-Fi'
  serial=$(interface_serial_value)
  [[ $serial == "$interface_serial" ]] ||
    die "probe interface USB serial mismatch: expected $interface_serial"
  permanent_mac=$(interface_permanent_mac)
  [[ $permanent_mac == "$interface_mac" ]] ||
    die "probe interface permanent MAC mismatch: expected $interface_mac"
  current_mac=$(<"/sys/class/net/$interface/address")
  [[ ${current_mac,,} == "$interface_mac" ]] || die 'probe interface MAC has been changed'
  [[ ! -e /sys/class/net/$interface/master ]] || die 'probe interface is enslaved to another link'
  [[ -z $(ip -o -4 address show dev "$interface") ]] ||
    die 'probe interface already has an IPv4 address'
  [[ -z $(ip -o -6 address show dev "$interface") ]] ||
    die 'probe interface already has an IPv6 address'
  [[ -z $(ip -o -4 route show table all dev "$interface") ]] ||
    die 'probe interface already has an IPv4 route'
  [[ -z $(ip -o -6 route show table all dev "$interface") ]] ||
    die 'probe interface already has an IPv6 route'
}

validate_networkmanager_boundary() {
  local connection managed state
  managed=$(nmcli -g GENERAL.NM-MANAGED device show "$interface") ||
    die 'cannot inspect NetworkManager ownership of probe interface'
  connection=$(nmcli -g GENERAL.CONNECTION device show "$interface") ||
    die 'cannot inspect NetworkManager connection on probe interface'
  state=$(nmcli -g GENERAL.STATE device show "$interface") ||
    die 'cannot inspect NetworkManager state of probe interface'
  [[ $managed == no && -z $connection && $state == '10 '* ]] ||
    die 'probe interface must be persistently unmanaged by NetworkManager with no active connection'
}

capture_interface_state() {
  local basename directory family flags key path value
  flags=$(<"/sys/class/net/$interface/flags") || die 'cannot read probe-interface flags'
  [[ $flags =~ ^0x[0-9a-fA-F]+$ ]] || die 'probe interface has invalid flags'
  initial_admin_up=false
  if ((flags & 1)); then
    initial_admin_up=true
  fi
  initial_mtu=$(<"/sys/class/net/$interface/mtu") || die 'cannot read probe-interface MTU'
  [[ $initial_mtu =~ ^[0-9]+$ ]] || die 'probe interface has invalid MTU'
  initial_addrgenmode=$(ip -j -d link show dev "$interface" |
    jq -er '.[0].inet6_addr_gen_mode | select(type == "string")') ||
    die 'cannot read probe-interface IPv6 address-generation mode'
  case $initial_addrgenmode in
    none|eui64|stable_secret|random) ;;
    *) die 'probe interface has an unexpected IPv6 address-generation mode' ;;
  esac

  for family in ipv4 ipv6; do
    directory=/proc/sys/net/$family/conf/$interface
    for path in "$directory"/*; do
      [[ -f $path ]] || die "probe-interface sysctl path is unsafe: $path"
      basename=${path##*/}
      [[ $basename =~ ^[a-z0-9_]+$ ]] || die 'probe-interface sysctl has an unsafe name'
      if ! value=$(cat -- "$path" 2>/dev/null); then
        [[ $family == ipv6 && $basename == stable_secret ]] ||
          die "cannot read probe-interface sysctl: $path"
        continue
      fi
      [[ $value =~ ^-?[0-9]+$ ]] || die "probe-interface sysctl is not scalar: $path"
      key=net.$family.conf.$interface.$basename
      interface_sysctl_keys+=("$key")
      initial_interface_sysctls[$key]=$value
    done
  done
  ((${#interface_sysctl_keys[@]} >= 80)) ||
    die 'probe-interface sysctl capture is unexpectedly incomplete'
}

restore_interface_state() {
  local _ current key value
  ip link set dev "$interface" down || return 1
  ip link set dev "$interface" mtu "$initial_mtu" || return 1
  ip link set dev "$interface" addrgenmode "$initial_addrgenmode" || return 1

  # Enabling IPv6 can derive an address immediately. Restore addr_gen_mode
  # first, then disable_ipv6, before settling every other captured scalar.
  for key in \
    "net.ipv6.conf.$interface.addr_gen_mode" \
    "net.ipv6.conf.$interface.disable_ipv6"; do
    value=${initial_interface_sysctls[$key]:-}
    [[ $value =~ ^-?[0-9]+$ ]] || return 1
    sysctl -qw "$key=$value" || return 1
  done
  for _ in 1 2; do
    for key in "${interface_sysctl_keys[@]}"; do
      case $key in
        "net.ipv6.conf.$interface.addr_gen_mode" | \
          "net.ipv6.conf.$interface.disable_ipv6") continue ;;
      esac
      value=${initial_interface_sysctls[$key]}
      current=$(sysctl -n "$key") || return 1
      [[ $current == "$value" ]] || sysctl -qw "$key=$value" || return 1
    done
  done
  for key in "${interface_sysctl_keys[@]}"; do
    current=$(sysctl -n "$key") || return 1
    [[ $current == "${initial_interface_sysctls[$key]}" ]] || return 1
  done
  [[ $(<"/sys/class/net/$interface/mtu") == "$initial_mtu" ]] || return 1
  [[ $(ip -j -d link show dev "$interface" |
    jq -er '.[0].inet6_addr_gen_mode') == \
    "$initial_addrgenmode" ]] || return 1
}

write_interface_baseline() {
  local key
  {
    printf 'interface\t%s\n' "$interface"
    printf 'usb_serial\t%s\n' "$interface_serial"
    printf 'permanent_mac\t%s\n' "$interface_mac"
    printf 'admin_up\t%s\n' "$initial_admin_up"
    printf 'mtu\t%s\n' "$initial_mtu"
    printf 'inet6_addr_gen_mode\t%s\n' "$initial_addrgenmode"
    printf 'networkmanager_managed\tno\n'
    for key in "${interface_sysctl_keys[@]}"; do
      printf 'sysctl\t%s\t%s\n' "$key" "${initial_interface_sysctls[$key]}"
    done
  } >"$evidence_dir/interface-baseline.tsv"
  chmod 0600 -- "$evidence_dir/interface-baseline.tsv"
}

validate_identity() {
  local metadata
  [[ -f $identity && ! -L $identity && -r $identity ]] ||
    die 'router SSH identity must be a readable regular, non-symlink file'
  identity=$(realpath -e -- "$identity") || die 'cannot resolve router SSH identity'
  metadata=$(stat -Lc '%a:%F:%h' -- "$identity") || die 'cannot inspect router SSH identity'
  [[ $metadata == '600:regular file:1' ]] ||
    die 'router SSH identity must be a mode-0600, single-link regular file'
}

validate_operator_credential() {
  local cert_key key_key metadata subject
  for path in "$client_ca" "$server_ca" "$client_cert" "$client_key"; do
    [[ -f $path && ! -L $path && -r $path ]] ||
      die "credential input is missing or unsafe: $path"
  done
  for path in "$client_cert" "$client_key"; do
    metadata=$(stat -Lc '%u:%a:%F:%h' -- "$path") ||
      die "cannot inspect operator credential input: $path"
    [[ $metadata == "$operator_uid:600:regular file:1" ]] ||
      die 'operator certificate and key must be operator-owned mode-0600 single-link files'
  done
  openssl x509 -in "$client_cert" -noout -checkend 120 >/dev/null 2>&1 ||
    die 'operator certificate has expired or has less than two minutes remaining; refresh it with scripts/ik --context=fabric'
  openssl verify -CAfile "$client_ca" "$client_cert" >/dev/null 2>&1 ||
    die 'operator certificate does not verify against the pinned fabric client CA'
  subject=$(openssl x509 -in "$client_cert" -noout -subject -nameopt RFC2253) ||
    die 'cannot read operator certificate subject'
  [[ $subject == 'subject=O=system:masters,CN=sam-fabric-operator' ]] ||
    die 'operator certificate has an unexpected subject'
  cert_key=$(openssl x509 -in "$client_cert" -pubkey -noout |
    openssl pkey -pubin -outform DER 2>/dev/null | sha256sum | awk '{print $1}') ||
    die 'cannot derive operator certificate public key'
  key_key=$(openssl pkey -in "$client_key" -pubout -outform DER 2>/dev/null |
    sha256sum | awk '{print $1}') || die 'cannot derive operator private-key public key'
  [[ $cert_key == "$key_key" ]] || die 'operator certificate and key do not match'
}

acquire_network_lock() {
  local metadata parent_metadata resolved
  parent_metadata=$(stat -Lc '%F:%u:%g:%a' -- /run/lock) ||
    die 'cannot inspect fabric network lock directory'
  [[ $parent_metadata == 'directory:0:0:755' ]] ||
    die 'fabric network lock directory has unsafe ownership or mode'
  [[ ! -L $fabric_network_lock ]] || die 'fabric network lock is a symlink'
  if [[ -e $fabric_network_lock ]]; then
    metadata=$(stat -Lc '%F:%u:%g:%a:%h' -- "$fabric_network_lock") ||
      die 'cannot inspect fabric network lock'
    [[ $metadata == 'regular file:0:0:600:1' ]] ||
      die 'fabric network lock has unsafe ownership or mode'
  fi
  exec {network_lock_fd}>>"$fabric_network_lock" || die 'cannot open fabric network lock'
  chmod 0600 -- "/proc/self/fd/$network_lock_fd"
  resolved=$(readlink -e -- "/proc/self/fd/$network_lock_fd") ||
    die 'cannot resolve opened fabric network lock'
  [[ $resolved == "$fabric_network_lock" ]] || die 'opened an unexpected fabric network lock'
  metadata=$(stat -Lc '%F:%u:%g:%a:%h' -- "/proc/self/fd/$network_lock_fd") ||
    die 'cannot inspect opened fabric network lock'
  [[ $metadata == 'regular file:0:0:600:1' ]] ||
    die 'opened fabric network lock has unsafe ownership or mode'
  flock --exclusive --nonblock "$network_lock_fd" ||
    die 'another fabric network operation is active'
}

observer_verify() {
  timeout --kill-after=2s 15s \
    "$repo_root/fabric/observer/fabric-observer-netns" verify-isolation >/dev/null
}

prepare_router_ssh() {
  local extra scanned_fingerprint scanned_host scanned_key scanned_type
  if ! timeout --kill-after=2s 10s \
      ip netns exec fabric-observer ssh-keyscan -4 -T 5 -t ed25519 \
      "$router_address" >"$router_known_hosts" 2>"$evidence_dir/router-keyscan.stderr"; then
    die 'router ED25519 host-key scan failed'
  fi
  chmod 0600 -- "$router_known_hosts" "$evidence_dir/router-keyscan.stderr"
  mapfile -t scanned_keys < <(grep -Ev '^[[:space:]]*(#|$)' "$router_known_hosts")
  [[ ${#scanned_keys[@]} -eq 1 ]] || die 'router scan did not return exactly one ED25519 key'
  read -r scanned_host scanned_type scanned_key extra <<<"${scanned_keys[0]}"
  [[ $scanned_host == "$router_address" && $scanned_type == ssh-ed25519 &&
     -n $scanned_key && -z ${extra:-} ]] || die 'router key scan returned an unexpected record'
  scanned_fingerprint=$(ssh-keygen -E sha256 -lf "$router_known_hosts" |
    awk 'NR == 1 { print $2 }')
  [[ $scanned_fingerprint == "$serial_fingerprint" ]] ||
    die 'router key scan does not match the attended serial fingerprint'

  router_ssh_options=(
    -F none
    -o BatchMode=yes
    -o StrictHostKeyChecking=yes
    -o HostKeyAlgorithms=ssh-ed25519
    -o UpdateHostKeys=no
    -o AddressFamily=inet
    -o GlobalKnownHostsFile=/dev/null
    -o "UserKnownHostsFile=$router_known_hosts"
    -o KnownHostsCommand=none
    -o ForwardAgent=no
    -o ClearAllForwardings=yes
    -o ProxyCommand=none
    -o ProxyJump=none
    -o ControlMaster=no
    -o ControlPath=none
    -o IdentityAgent=none
    -o IdentitiesOnly=yes
    -o PasswordAuthentication=no
    -o KbdInteractiveAuthentication=no
    -o PreferredAuthentications=publickey
    -o RequestTTY=no
    -o PermitLocalCommand=no
    -o ConnectTimeout=5
    -o LogLevel=ERROR
    -i "$identity"
  )
}

router_snapshot() {
  local output=$1
  timeout --kill-after=2s 15s \
    ip netns exec fabric-observer ssh "${router_ssh_options[@]}" \
    "root@$router_address" /usr/sbin/nft -j list table inet fw4 >"$output"
  jq -e '.nftables | type == "array"' "$output" >/dev/null ||
    die 'router nftables snapshot is not valid JSON'
}

root_ssh() {
  local node=$1
  shift
  HOME=$operator_home FABRIC_SSH_IDENTITY=$identity \
    timeout --kill-after=2s 20s \
      "$repo_root/scripts/fabric-ssh" "$node" "$@"
}

vip_holder() {
  local index line node holder=
  for index in "${!root_nodes[@]}"; do
    node=${root_nodes[$index]}
    line=$(root_ssh "$node" /usr/sbin/ip -o -4 address show to "$api_address/32") ||
      die "cannot inspect VIP state on $node"
    if [[ -n $line ]]; then
      [[ -z $holder ]] || die 'more than one root currently holds the API VIP'
      [[ $line == *" inet $api_address/32 "* ]] || die "$node returned an unexpected VIP record"
      holder=$node
    fi
  done
  [[ -n $holder ]] || die 'no root currently holds the API VIP'
  printf '%s\n' "$holder"
}

root_snapshot() {
  local node=$1 output=$2
  root_ssh "$node" sudo --non-interactive /usr/sbin/nft -j \
    list table inet fabric_guard >"$output"
  jq -e '.nftables | type == "array"' "$output" >/dev/null ||
    die 'root nftables snapshot is not valid JSON'
}

write_counter_specs() {
  cat >"$router_service_spec" <<'EOF'
{
  "version": 1,
  "rules": {
    "api_allow": {
      "family": "inet", "table": "fw4", "chain": "forward_lan",
      "comment": "!fw4: Allow-services-to-fabric-API", "expected_matches": 1
    },
    "etcd_reject": {
      "family": "inet", "table": "fw4", "chain": "forward_lan",
      "comment": "!fw4: Reject-services-to-root-etcd", "expected_matches": 1
    },
    "other_service_reject": {
      "family": "inet", "table": "fw4", "chain": "forward_lan",
      "comment": "!fw4: Reject-other-services-to-roots", "expected_matches": 1
    }
  },
  "require_increase": ["api_allow", "etcd_reject"],
  "require_unchanged": ["other_service_reject"]
}
EOF
  cat >"$router_unauthorized_spec" <<'EOF'
{
  "version": 1,
  "rules": {
    "api_allow": {
      "family": "inet", "table": "fw4", "chain": "forward_lan",
      "comment": "!fw4: Allow-services-to-fabric-API", "expected_matches": 1
    },
    "etcd_reject": {
      "family": "inet", "table": "fw4", "chain": "forward_lan",
      "comment": "!fw4: Reject-services-to-root-etcd", "expected_matches": 1
    },
    "other_service_reject": {
      "family": "inet", "table": "fw4", "chain": "forward_lan",
      "comment": "!fw4: Reject-other-services-to-roots", "expected_matches": 1
    }
  },
  "require_increase": ["other_service_reject"],
  "require_unchanged": ["api_allow", "etcd_reject"]
}
EOF
  cat >"$root_increase_spec" <<'EOF'
{
  "version": 1,
  "rules": {
    "service_api_host_guard": {
      "family": "inet", "table": "fabric_guard", "chain": "input",
      "comment": "service agents to API and root kubelets", "expected_matches": 1
    }
  },
  "require_increase": ["service_api_host_guard"],
  "require_unchanged": []
}
EOF
  cat >"$root_unchanged_spec" <<'EOF'
{
  "version": 1,
  "rules": {
    "service_api_host_guard": {
      "family": "inet", "table": "fabric_guard", "chain": "input",
      "comment": "service agents to API and root kubelets", "expected_matches": 1
    }
  },
  "require_increase": [],
  "require_unchanged": ["service_api_host_guard"]
}
EOF
  chmod 0600 -- "$router_service_spec" "$router_unauthorized_spec" \
    "$root_increase_spec" "$root_unchanged_spec"
}

set_probe_source() {
  local address=$1 routes
  ip -n "$namespace" -4 address flush dev "$interface"
  ip -n "$namespace" -4 neigh flush dev "$interface" >/dev/null 2>&1 || true
  ip -n "$namespace" -4 address add "$address/24" dev "$interface"
  ip -n "$namespace" -4 route replace "$root_subnet" via "$service_gateway" \
    dev "$interface" src "$address"
  [[ -z $(ip -n "$namespace" -o -4 route show table main default) ]] ||
    die 'probe namespace unexpectedly has an IPv4 default route'
  [[ -z $(ip -n "$namespace" -o -6 route show table all default) ]] ||
    die 'probe namespace unexpectedly has an IPv6 default route'
  [[ -z $(ip -n "$namespace" -o -6 address show scope global) ]] ||
    die 'probe namespace unexpectedly has a global IPv6 address'
  routes=$(ip -n "$namespace" -o -4 route get "$api_address") ||
    die 'probe namespace has no API route'
  [[ $routes == *"$api_address via $service_gateway dev $interface src $address"* ]] ||
    die "API route does not select the reviewed gateway/source for $address"
}

probe_api_success() {
  local address=$1 output=$2
  ip netns exec "$namespace" curl --disable \
    --fail --silent --show-error \
    --noproxy '*' --proto '=https' --tlsv1.2 \
    --connect-timeout 4 --max-time 8 --retry 0 \
    --cacert "$server_ca" --cert "$client_cert" --key "$client_key" \
    --resolve "api.fabric.internal:6443:$api_address" \
    'https://api.fabric.internal:6443/readyz?verbose' >"$output"
  [[ $(tail -n 1 "$output") == 'readyz check passed' ]] ||
    die "authenticated API readiness did not pass from $address"
}

probe_api_rejected() {
  local output=$1
  if ip netns exec "$namespace" curl --disable \
      --fail --silent --show-error \
      --noproxy '*' --proto '=https' --tlsv1.2 \
      --connect-timeout 3 --max-time 5 --retry 0 \
      --cacert "$server_ca" --cert "$client_cert" --key "$client_key" \
      --resolve "api.fabric.internal:6443:$api_address" \
      'https://api.fabric.internal:6443/readyz?verbose' >"$output" 2>&1; then
    die "$unauthorized_address unexpectedly reached the fabric API"
  fi
}

probe_etcd_rejected() {
  local address=$1 root=$2 port=$3 output=$4
  ip netns exec "$namespace" nping --tcp --send-ip --flags syn --count 1 \
    --delay 50ms --source-ip "$address" --dest-port "$port" \
    --interface "$interface" "$root" >"$output" 2>&1
  grep -Fq 'Raw packets sent: 1 ' "$output" ||
    die "nping did not send exactly one SYN to $root:$port from $address"
  if grep -Eq '^RCVD .* TCP .* SA( |$)' "$output"; then
    die "$address unexpectedly received SYN-ACK from root etcd $root:$port"
  fi
}

compare_counters() {
  local before=$1 after=$2 spec=$3 output=$4
  "$repo_root/scripts/compare-fabric-nft-counters" \
    --before "$before" --after "$after" --spec "$spec" >"$output"
}

require_counter_packet_delta() {
  local minimum=$1 logical_name=$2 result_file=$3 actual
  actual=$(jq -er --arg name "$logical_name" \
    '.results[] | select(.logical_name == $name) | .delta.packets' \
    "$result_file") || die "counter result lacks $logical_name packet delta"
  [[ $actual =~ ^[0-9]+$ && $actual -ge $minimum ]] ||
    die "$logical_name counter increased by $actual packets; expected at least $minimum"
}

qualify_service_source() {
  local address=$1 label holder_before holder_after root_before root_after
  local router_before router_after
  label=${address##*.}
  router_before="$evidence_dir/service-$label-router-before.json"
  router_after="$evidence_dir/service-$label-router-after.json"
  root_before="$evidence_dir/service-$label-root-before.json"
  root_after="$evidence_dir/service-$label-root-after.json"

  set_probe_source "$address"
  router_snapshot "$router_before"
  holder_before=$(vip_holder)
  root_snapshot "$holder_before" "$root_before"
  printf '%s\n' "$holder_before" >"$evidence_dir/service-$label-vip-holder.txt"

  probe_api_success "$address" "$evidence_dir/service-$label-readyz.txt"
  for root in "${root_addresses[@]}"; do
    for port in "${etcd_ports[@]}"; do
      probe_etcd_rejected "$address" "$root" "$port" \
        "$evidence_dir/service-$label-etcd-${root##*.}-$port.txt"
    done
  done

  holder_after=$(vip_holder)
  [[ $holder_after == "$holder_before" ]] ||
    die "API VIP moved from $holder_before to $holder_after during $address qualification"
  root_snapshot "$holder_after" "$root_after"
  router_snapshot "$router_after"
  compare_counters "$router_before" "$router_after" "$router_service_spec" \
    "$evidence_dir/service-$label-router-counter-result.json"
  compare_counters "$root_before" "$root_after" "$root_increase_spec" \
    "$evidence_dir/service-$label-root-counter-result.json"
  require_counter_packet_delta 1 api_allow \
    "$evidence_dir/service-$label-router-counter-result.json"
  require_counter_packet_delta 9 etcd_reject \
    "$evidence_dir/service-$label-router-counter-result.json"
  require_counter_packet_delta 1 service_api_host_guard \
    "$evidence_dir/service-$label-root-counter-result.json"
  note "SERVICE_SOURCE_PASS address=$address vip_holder=$holder_before"
}

qualify_unauthorized_source() {
  local holder_before holder_after
  set_probe_source "$unauthorized_address"
  router_snapshot "$evidence_dir/unauthorized-router-before.json"
  holder_before=$(vip_holder)
  root_snapshot "$holder_before" "$evidence_dir/unauthorized-root-before.json"
  probe_api_rejected "$evidence_dir/unauthorized-api.txt"
  holder_after=$(vip_holder)
  [[ $holder_after == "$holder_before" ]] ||
    die 'API VIP moved during unauthorized-source qualification'
  root_snapshot "$holder_after" "$evidence_dir/unauthorized-root-after.json"
  router_snapshot "$evidence_dir/unauthorized-router-after.json"
  compare_counters \
    "$evidence_dir/unauthorized-router-before.json" \
    "$evidence_dir/unauthorized-router-after.json" \
    "$router_unauthorized_spec" \
    "$evidence_dir/unauthorized-router-counter-result.json"
  compare_counters \
    "$evidence_dir/unauthorized-root-before.json" \
    "$evidence_dir/unauthorized-root-after.json" \
    "$root_unchanged_spec" \
    "$evidence_dir/unauthorized-root-counter-result.json"
  require_counter_packet_delta 1 other_service_reject \
    "$evidence_dir/unauthorized-router-counter-result.json"
  note "UNAUTHORIZED_SOURCE_PASS address=$unauthorized_address vip_holder=$holder_before"
}

mode=
serial_fingerprint=
identity=/var/home/sam/.ssh/id_ed25519
confirm=

while (($#)); do
  case $1 in
    --check|--run)
      [[ -z $mode ]] || die 'choose exactly one of --check or --run'
      mode=${1#--}
      shift
      ;;
    --serial-ed25519-fingerprint)
      (($# >= 2)) || die '--serial-ed25519-fingerprint requires a value'
      [[ -z $serial_fingerprint ]] || die 'serial fingerprint may be specified only once'
      serial_fingerprint=$2
      shift 2
      ;;
    --identity)
      (($# >= 2)) || die '--identity requires a path'
      identity=$2
      shift 2
      ;;
    --confirm)
      (($# >= 2)) || die '--confirm requires a value'
      [[ -z $confirm ]] || die '--confirm may be specified only once'
      confirm=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -n $mode ]] || {
  usage >&2
  exit 2
}
[[ -n $serial_fingerprint ]] || die '--serial-ed25519-fingerprint is required'
valid_fingerprint "$serial_fingerprint" || die 'serial fingerprint has an invalid shape'
[[ $EUID -eq 0 ]] || die 'run this helper with sudo'
require_root_namespace

for command in awk cat chmod curl ethtool flock getent grep id ip jq nft nmcli \
  nping openssl readlink realpath sha256sum sleep ssh ssh-keygen ssh-keyscan stat \
  sysctl tail timeout udevadm; do
  need_command "$command"
done

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repo_root=$(realpath -- "$script_dir/..")
client_ca=$repo_root/fabric/access/client-ca.crt
server_ca=$repo_root/fabric/access/server-ca.crt
operator_user=sam
operator_home=$(getent passwd "$operator_user" | awk -F: 'NR == 1 { print $6 }')
[[ -n $operator_home && -d $operator_home ]] || die 'cannot resolve operator home directory'
operator_uid=$(id -u "$operator_user") || die 'cannot resolve operator UID'
operator_runtime=/run/user/$operator_uid/infra-fabric-operator
client_cert=$operator_runtime/client.pem
client_key=$operator_runtime/client-key.pem

validate_identity
validate_networkmanager_boundary
validate_probe_interface
single_root_default >/dev/null
observer_verify || die 'fabric observer isolation verification failed'
if namespace_exists; then
  die "$namespace already exists; refuse to adopt or remove it"
fi

if [[ $mode == check ]]; then
  [[ -z $confirm ]] || die '--confirm is invalid with --check'
  capture_interface_state
  validate_operator_credential
  note 'Read-only admission check passed.'
  note 'Electrical carrier will be required only after the NIC enters its isolated namespace.'
  note "Exact live confirmation: $confirmation"
  exit 0
fi

[[ $confirm == "$confirmation" ]] || die "exact --confirm '$confirmation' is required"
validate_operator_credential
acquire_network_lock
observer_verify || die 'fabric observer isolation changed before qualification'
validate_probe_interface
capture_interface_state
root_default_before=$(single_root_default)

# shellcheck source=scripts/lib/fabric-secure-tempdir.sh
source "$repo_root/scripts/lib/fabric-secure-tempdir.sh"
evidence_dir=$(fabric_secure_tmpdir fabric-service-source-qualification 33554432) ||
  die 'cannot create protected tmpfs evidence directory'
chmod 0700 -- "$evidence_dir"
router_known_hosts=$evidence_dir/router-known_hosts
router_service_spec=$evidence_dir/router-service-spec.json
router_unauthorized_spec=$evidence_dir/router-unauthorized-spec.json
root_increase_spec=$evidence_dir/root-increase-spec.json
root_unchanged_spec=$evidence_dir/root-unchanged-spec.json
network_lock_fd=${network_lock_fd:-}
namespace_created=false
interface_moved=false
complete=false

cleanup() {
  local status=$? restore_failed=false
  trap - EXIT
  trap '' INT TERM
  set +e
  if $interface_moved; then
    if ip -n "$namespace" link show dev "$interface" >/dev/null 2>&1; then
      ip -n "$namespace" -4 address flush dev "$interface" >/dev/null 2>&1 || restore_failed=true
      ip -n "$namespace" -6 address flush dev "$interface" >/dev/null 2>&1 || restore_failed=true
      ip -n "$namespace" link set dev "$interface" down >/dev/null 2>&1 || restore_failed=true
      if ip netns exec "$namespace" ip link set dev "$interface" netns 1 \
          >/dev/null 2>&1; then
        interface_moved=false
      else
        restore_failed=true
      fi
    elif [[ -e /sys/class/net/$interface ]] &&
        ! ip -n "$namespace" link show dev "$interface" >/dev/null 2>&1; then
      # A signal can arrive after the move succeeds but before the state flag
      # is updated. Accept only the exact identity after full validation below.
      interface_moved=false
    else
      restore_failed=true
    fi
  fi
  if $namespace_created && ! $interface_moved; then
    if ! ip netns list | awk -v wanted="$namespace" \
        '$1 == wanted { found = 1 } END { exit !found }'; then
      namespace_created=false
    elif ip netns delete "$namespace" >/dev/null 2>&1; then
      namespace_created=false
    else
      restore_failed=true
    fi
  elif $namespace_created; then
    restore_failed=true
  fi
  if [[ -e /sys/class/net/$interface ]]; then
    restore_interface_state >/dev/null 2>"$evidence_dir/restoration-sysctls.stderr" ||
      restore_failed=true
    if $initial_admin_up; then
      ip link set dev "$interface" up >/dev/null 2>&1 || restore_failed=true
    else
      ip link set dev "$interface" down >/dev/null 2>&1 || restore_failed=true
    fi
  else
    restore_failed=true
  fi
  if ! (validate_probe_interface) >/dev/null \
      2>"$evidence_dir/restoration-interface.stderr"; then
    restore_failed=true
  fi
  if ! (validate_networkmanager_boundary) >/dev/null \
      2>"$evidence_dir/restoration-networkmanager.stderr"; then
    restore_failed=true
  fi
  root_default_after=$(single_root_default 2>"$evidence_dir/restoration-default.stderr") ||
    restore_failed=true
  printf '%s\n' "${root_default_after:-}" >"$evidence_dir/root-default-after.txt"
  [[ ${root_default_after:-} == "$root_default_before" ]] || restore_failed=true
  observer_verify >"$evidence_dir/restoration-observer.txt" 2>&1 || restore_failed=true
  if $restore_failed; then
    status=1
    printf 'ERROR: probe-network restoration verification failed\n' >&2
  fi
  if $complete && ((status == 0)); then
    if jq -n \
        --arg interface "$interface" \
        --arg serial "$interface_serial" \
        --arg mac "$interface_mac" \
        --arg result pass \
        --arg scope pre-svc1-arm-fabric-source-policy \
        '{version: 1, result: $result, scope: $scope,
          restoration: "verified",
          interface: $interface, serial: $serial, permanent_mac: $mac,
          tested_sources: ["10.66.1.10", "10.66.1.11", "10.66.1.100"]}' \
        >"$evidence_dir/result.json"; then
      chmod 0600 -- "$evidence_dir/result.json" || status=1
    else
      status=1
    fi
    if ((status == 0)); then
      printf 'FABRIC_SERVICE_SOURCE_QUALIFICATION=pass\n'
      printf 'EVIDENCE_DIR=%s\n' "$evidence_dir"
    else
      printf 'ERROR: could not finalize qualification evidence\n' >&2
    fi
  fi
  if ! $complete || ((status != 0)); then
    printf 'Qualification did not complete; protected evidence remains at %s\n' \
      "$evidence_dir" >&2
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

printf '%s\n' "$root_default_before" >"$evidence_dir/root-default-before.txt"
write_interface_baseline
write_counter_specs
prepare_router_ssh

trap '' INT TERM
ip netns add "$namespace"
namespace_created=true
trap 'exit 130' INT
trap 'exit 143' TERM
ip link set dev "$interface" down
trap '' INT TERM
ip link set dev "$interface" netns "$namespace"
interface_moved=true
trap 'exit 130' INT
trap 'exit 143' TERM
ip -n "$namespace" link set lo up
ip netns exec "$namespace" sysctl -qw \
  net.ipv4.ip_forward=0 \
  net.ipv4.conf.all.accept_redirects=0 \
  net.ipv4.conf.default.accept_redirects=0 \
  net.ipv4.conf.all.secure_redirects=0 \
  net.ipv4.conf.default.secure_redirects=0 \
  net.ipv6.conf.all.disable_ipv6=1 \
  net.ipv6.conf.default.disable_ipv6=1
ip netns exec "$namespace" sysctl -qw \
  "net.ipv4.conf.$interface.accept_redirects=0" \
  "net.ipv4.conf.$interface.secure_redirects=0"
ip -n "$namespace" link set dev "$interface" up
for _ in {1..50}; do
  if ip -n "$namespace" -o link show dev "$interface" | grep -q '<[^>]*LOWER_UP[,>]' ; then
    break
  fi
  sleep 0.1
done
ip -n "$namespace" -o link show dev "$interface" | grep -q '<[^>]*LOWER_UP[,>]' ||
  die 'probe interface has no fabric-switch carrier inside the isolated namespace'
[[ $(ip -n "$namespace" -o link show | awk 'NF { count++ } END { print count + 0 }') -eq 2 ]] ||
  die 'probe namespace contains an unexpected network interface'
ip netns exec "$namespace" nft -j list ruleset |
  jq -e '[.nftables[] | select(has("table"))] | length == 0' >/dev/null ||
  die 'probe namespace unexpectedly inherited an nftables table'

for address in "${service_addresses[@]}"; do
  qualify_service_source "$address"
done
qualify_unauthorized_source
complete=true
