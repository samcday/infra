#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
This pre-service-node source simulator is retired.

Both Fabric service nodes are now admitted, and the desired router policy
allows their exact addresses to root TCP/2379. Re-running the historical
simulator would incorrectly require that desired client port to remain
rejected and could therefore produce phase-invalid evidence.

Use the replacement while the live router is still in its deny phase:

  sudo scripts/qualify-fabric-etcd-pod-sources --check \
    --serial-ed25519-fingerprint SHA256:VALUE_FROM_ROUTER_SERIAL \
    --identity /var/home/sam/.ssh/id_ed25519

The replacement observes real, non-hostNetwork Pods pinned one per service
node and accepts only the exact node addresses as post-SNAT policy inputs.
EOF
}

case ${1:-} in
  -h|--help)
    usage
    exit 0
    ;;
esac

usage >&2
printf '%s\n' \
  'qualify-fabric-service-sources: retired; use scripts/qualify-fabric-etcd-pod-sources' \
  >&2
exit 1
