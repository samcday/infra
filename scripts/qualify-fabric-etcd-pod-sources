[[ -d $operator_runtime && ! -L $operator_runtime ]] ||
  die 'operator runtime directory is missing or unsafe'
[[ $(stat -Lc '%u:%a' -- "$operator_runtime") == "$operator_uid:700" ]] ||
  die 'operator runtime directory has unsafe ownership or mode'
