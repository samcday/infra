preflight_cleanup() {
  local status=$?
  trap - EXIT INT TERM
  if [[ $mode == check && $status -eq 0 ]]; then
    rm -rf -- "$evidence_dir"
  else
    printf 'Preflight did not complete; protected evidence remains at %s\n' \
      "$evidence_dir" >&2
  fi
  exit "$status"
}
trap preflight_cleanup EXIT
