IFS= read -r router_table_token </proc/sys/kernel/random/uuid ||
  die 'cannot obtain a per-run router observer owner token'
[[ $router_table_token =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] ||
  die 'per-run router observer owner token is malformed'
router_table_comment="fabric etcd Pod-source observer owner $router_table_token"
