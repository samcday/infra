trap - EXIT INT TERM

cleanup() {
  local current_lock current_resource_version current_uid deleted remaining
  local namespace_identity namespace_state status=$? tables
  local restore_failed=false
  trap - EXIT INT TERM
  trap '' HUP INT TERM
  set +e

  if $namespace_created || $namespace_creation_attempted; then
    if namespace_state=$(probe_namespace_state); then
      if [[ $namespace_state == present:* ]]; then
        namespace_identity=${namespace_state#present:}
        current_uid=${namespace_identity%%:*}
        current_resource_version=${namespace_identity#*:}
        if [[ -z $namespace_uid || $current_uid != "$namespace_uid" ]]; then
          restore_failed=true
          printf 'ERROR: probe Namespace UID changed; refusing conditional deletion\n' >&2
        elif deleted=$(jq -cn \
            --arg uid "$current_uid" \
            --arg resource_version "$current_resource_version" '{
              apiVersion: "v1", kind: "DeleteOptions",
              preconditions: {uid: $uid, resourceVersion: $resource_version}
            }' |
            operator_kubectl delete \
              --raw="/api/v1/namespaces/$namespace" --filename=- 2>/dev/null) &&
            jq -e --arg uid "$current_uid" '
              (.kind == "Status" and .status == "Success") or
              (.kind == "Namespace" and .metadata.uid == $uid and
               .metadata.deletionTimestamp != null)
            ' <<<"$deleted" >/dev/null; then
          namespace_state=
          for _cleanup_attempt in {1..60}; do
            namespace_state=$(probe_namespace_state) || break
            [[ $namespace_state == absent ]] && break
            if [[ $namespace_state != present:"$current_uid":* ]]; then
              break
            fi
            sleep 1
          done
          if [[ $namespace_state == absent ]]; then
            namespace_created=false
            namespace_creation_attempted=false
          else
            restore_failed=true
            printf 'ERROR: exact probe Namespace deletion did not reach absence\n' >&2
          fi
        else
          restore_failed=true
          printf 'ERROR: exact probe Namespace conditional deletion failed\n' >&2
        fi
      elif [[ $namespace_state == absent ]]; then
        namespace_created=false
        namespace_creation_attempted=false
      else
        restore_failed=true
      fi
    else
      restore_failed=true
    fi
  fi

  if $router_table_owned; then
    tables=$(router_tables 2>/dev/null)
    if grep -Fxq "table inet $router_probe_table" <<<"$tables"; then
      if router_ssh /usr/sbin/nft -j list table inet "$router_probe_table" \
          >"$evidence_dir/router-probe-before-cleanup.json" 2>/dev/null &&
          jq -e \
            --arg table "$router_probe_table" \
            --arg comment "$router_table_comment" '
              ([.nftables[] | .table? | select(
                .family == "inet" and .name == $table and .comment == $comment
              )] | length) == 1
            ' "$evidence_dir/router-probe-before-cleanup.json" >/dev/null; then
        router_ssh /usr/sbin/nft delete table inet "$router_probe_table" \
          >/dev/null 2>&1 || restore_failed=true
      else
        restore_failed=true
        printf 'ERROR: router observer ownership changed; refusing name-only deletion\n' >&2
      fi
    fi
    tables=$(router_tables 2>/dev/null) || restore_failed=true
    if grep -Fxq "table inet $router_probe_table" <<<"${tables:-}"; then
      restore_failed=true
    else
      router_table_owned=false
    fi
  fi

  if ! namespace_state=$(probe_namespace_state) || [[ $namespace_state != absent ]]; then
    restore_failed=true
  fi
  observer_verify >"$evidence_dir/restoration-observer.txt" 2>&1 || restore_failed=true

  if $parent_lock_mode && ! parent_locks_unchanged; then
    restore_failed=true
    printf 'ERROR: parent-owned Fabric locks changed during source qualification\n' >&2
  fi

  if $cluster_lock_held; then
    if $complete && ((status == 0)) && ! $restore_failed; then
      current_lock=$(operator_kubectl --namespace kube-system get configmap \
        "$fabric_network_cluster_lock" --output=json 2>/dev/null) ||
        current_lock=
      if ! jq -e \
          --arg holder "$cluster_lock_holder" \
          --arg uid "$cluster_lock_uid" \
          --arg resource_version "$cluster_lock_resource_version" '
            .metadata.uid == $uid and
            .metadata.resourceVersion == $resource_version and
            .metadata.deletionTimestamp == null and
            .data == {holder: $holder}
          ' <<<"$current_lock" >/dev/null 2>&1; then
        restore_failed=true
        printf 'ERROR: global Fabric maintenance lock identity changed\n' >&2
      elif deleted=$(jq -cn \
          --arg uid "$cluster_lock_uid" \
          --arg resource_version "$cluster_lock_resource_version" '{
            apiVersion: "v1", kind: "DeleteOptions",
            preconditions: {uid: $uid, resourceVersion: $resource_version}
          }' |
          operator_kubectl delete \
            --raw="/api/v1/namespaces/kube-system/configmaps/$fabric_network_cluster_lock" \
            --filename=- 2>/dev/null) &&
          jq -e '
            (.kind == "Status" and .status == "Success") or
            (.kind == "ConfigMap" and
             .metadata.name == "fabric-maintenance-lock")
          ' <<<"$deleted" >/dev/null; then
        remaining=$(operator_kubectl --namespace kube-system get configmap \
          "$fabric_network_cluster_lock" --ignore-not-found --output=name \
          2>/dev/null) || remaining=error
        if [[ -z $remaining ]]; then
          cluster_lock_held=false
        else
          restore_failed=true
          printf 'ERROR: global Fabric maintenance lock remains after deletion\n' >&2
        fi
      else
        restore_failed=true
        printf 'ERROR: global Fabric maintenance lock conditional deletion failed\n' >&2
      fi
    else
      printf 'Global Fabric maintenance lock remains held by %s for inspection\n' \
        "$cluster_lock_holder" >&2
    fi
  fi

  if $restore_failed; then
    status=1
    printf 'ERROR: ephemeral Fabric source-probe cleanup did not verify\n' >&2
  fi
  if $complete && ((status == 0)); then
    jq -n \
      --arg result pass \
      --arg revision "$head" \
      --arg image "$probe_image" \
      --arg lock_scope "$($parent_lock_mode && printf router-parent || printf self)" \
      --arg parent_holder "$parent_cluster_lock_holder" \
      --arg parent_uid "$parent_cluster_lock_uid" \
      --arg parent_resource_version "$parent_cluster_lock_resource_version" \
      '{
        version: 1, result: $result, revision: $revision,
        scope: "pre-etcd-client-policy-pod-snat",
        liveVerdict: "unchanged-reject",
        ephemeralCleanup: "verified",
        probeImage: $image,
        observations: {
          "fabric-az1-svc1": "10.66.1.10",
          "fabric-az1-svc2": "10.66.1.11"
        },
        qualifiedRootDestinations: [
          "10.66.0.10", "10.66.0.11", "10.66.0.12"
        ],
        qualifiedPathCount: 6,
        policyInput: "exact-node-addresses-only"
      } + (if $lock_scope == "router-parent" then {
        parentLock: {
          scope: $lock_scope,
          holder: $parent_holder,
          uid: $parent_uid,
          resourceVersion: $parent_resource_version
        }
      } else {lockScope: $lock_scope} end)' >"$evidence_dir/result.json" || status=1
    chmod 0600 -- "$evidence_dir/result.json" || status=1
    if ((status == 0)); then
      printf 'FABRIC_ETCD_POD_SOURCE_QUALIFICATION=pass\n'
      printf 'EVIDENCE_DIR=%s\n' "$evidence_dir"
    fi
  fi
  if ! $complete || ((status != 0)); then
    printf 'Qualification did not complete; protected evidence remains at %s\n' \
      "$evidence_dir" >&2
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if $parent_lock_mode; then
  parent_locks_unchanged || die 'parent-owned Fabric locks changed before probe mutation'
else
  acquire_cluster_network_lock
fi
observer_verify || die 'fabric observer isolation changed after shared lock acquisition'
assert_router_probe_table_absent
router_snapshot "$router_before"
validate_live_reject_phase "$router_before"
[[ $(operator_kubectl get --raw=/readyz) == ok ]] ||
  die 'Fabric Kubernetes API changed after shared lock acquisition'
validate_service_nodes
assert_probe_namespace_absent
write_counter_spec
install_probe_table
create_probe_namespace
for index in "${!service_nodes[@]}"; do
  create_probe_pod "$index"
done
for index in "${!service_nodes[@]}"; do
  wait_probe_pod "$index"
done
for service_index in "${!service_nodes[@]}"; do
  for target_index in "${!target_addresses[@]}"; do
    validate_observed_source "$service_index" "$target_index"
  done
done

router_snapshot "$router_after"
validate_live_reject_phase "$router_after"
normalize_router_fw4 "$router_before" "$router_before_semantic"
normalize_router_fw4 "$router_after" "$router_after_semantic"
cmp -s -- "$router_before_semantic" "$router_after_semantic" ||
  die 'live fw4 semantics changed during source qualification'
"$repo_root/scripts/compare-fabric-nft-counters" \
  --before "$router_before" --after "$router_after" --spec "$counter_spec" \
  >"$counter_result"
reject_delta=$(jq -er \
  '.results[] | select(.logical_name == "current_etcd_reject") | .delta.packets' \
  "$counter_result") || die 'router counter result lacks the current etcd reject delta'
[[ $reject_delta =~ ^[0-9]+$ && $reject_delta -ge 6 ]] ||
  die "named current etcd reject saw only $reject_delta packets; expected at least six"

complete=true
