[ -f /var/run/fw4.state ] && [ ! -L /var/run/fw4.state ] ||
  fail 'live fw4 state is missing or unsafe'
for state_field in ubus_rules includes; do
  state_value=$(jsonfilter -i /var/run/fw4.state -e "@.$state_field") ||
    fail "could not inspect live fw4 state field: $state_field"
  state_value=$(printf '%s' "$state_value" | tr -d '[:space:]')
  case $state_field:$state_value in
    ubus_rules:'[]'|includes:'[]'|includes:null) ;;
    *) fail "live fw4 state contains unexpected $state_field" ;;
  esac
done

# firewall4 always includes top-level /etc/nftables.d/*.nft files. Retain the
# stock comment-only example, but reject any executable statement or any other
# automatic include source. The runtime state checks above independently catch
# UCI and /usr/share auto-includes actually loaded by fw4.
[ -d /etc/nftables.d ] && [ -d /usr/share/nftables.d ] ||
  fail 'pinned firewall4 nftables include directories are absent'
etc_nft_files=$(find /etc/nftables.d -mindepth 1 -maxdepth 1 \
  -name '*.nft' -print | LC_ALL=C sort)
[ "$etc_nft_files" = '/etc/nftables.d/10-custom-filter-chains.nft' ] ||
  fail 'unexpected top-level /etc nftables include membership'
[ -f /etc/nftables.d/10-custom-filter-chains.nft ] &&
  [ ! -L /etc/nftables.d/10-custom-filter-chains.nft ] ||
  fail 'stock nftables include template is missing or unsafe'
active_etc_nft=$(sed \
  -e '/^[[:space:]]*#/d' \
  -e '/^[[:space:]]*$/d' \
  /etc/nftables.d/10-custom-filter-chains.nft)
[ -z "$active_etc_nft" ] ||
  fail 'stock /etc nftables include template contains an active statement'
share_nft_files=$(find /usr/share/nftables.d -name '*.nft' -print)
[ -z "$share_nft_files" ] ||
  fail 'an unexpected /usr/share automatic nftables include is present'

assert_live_fw4_rule() {
  expected_chain=$1
  live_rule_name=$2
  expected_count=$3
  expected_ipv4_match=$4
  expected_verdict=$5
  live_rule_marker="comment \"!fw4: $live_rule_name\""
  matching_global_rules=$(printf '%s\n' "$live_fw4" |
    grep -F "$live_rule_marker") ||
    fail "reviewed rule is absent from the live fw4 table: $live_rule_name"
  global_count=$(printf '%s\n' "$matching_global_rules" |
    awk 'NF { count++ } END { print count + 0 }')
  [ "$global_count" -eq "$expected_count" ] ||
    fail "unexpected compiled-rule count for live fw4 rule: $live_rule_name"

  live_chain_rules=$(nft -a list chain inet fw4 "$expected_chain") ||
    fail "could not inspect live fw4 chain: $expected_chain"
  matching_live_rules=$(printf '%s\n' "$live_chain_rules" |
    grep -F "$live_rule_marker") ||
    fail "reviewed rule is absent from expected live chain: $live_rule_name"
  matching_count=$(printf '%s\n' "$matching_live_rules" |
    awk 'NF { count++ } END { print count + 0 }')
  [ "$matching_count" -eq "$expected_count" ] ||
    fail "reviewed rule is in an unexpected live chain: $live_rule_name"
  if printf '%s\n' "$matching_live_rules" |
      grep -Ev 'counter packets [0-9]+ bytes [0-9]+' >/dev/null; then
    fail "live fw4 rule lacks an anonymous packet/byte counter: $live_rule_name"
  fi
  if printf '%s\n' "$matching_live_rules" |
      grep -Fv "$expected_ipv4_match" >/dev/null; then
    fail "live fw4 rule lacks its expected IPv4 match: $live_rule_name"
  fi
  while IFS= read -r live_rule_line; do
    normalized_live_rule=$(printf '%s\n' "$live_rule_line" | sed \
      -e 's/^[[:space:]]*//' \
      -e 's/[[:space:]][[:space:]]*/ /g' \
      -e 's/counter packets [0-9][0-9]* bytes [0-9][0-9]*/counter/' \
      -e 's/ # handle [0-9][0-9]*$//')
    case $normalized_live_rule in
      *" counter $expected_verdict $live_rule_marker") ;;
      *) fail "live fw4 rule has an unexpected verdict: $live_rule_name" ;;
    esac
  done <<EOF
$matching_live_rules
EOF
  printf 'FIREWALL_LIVE_RULE chain=%s name=%s compiled=%s ipv4=%s verdict=%s counter=anonymous\n' \
    "$expected_chain" "$live_rule_name" "$matching_count" \
    "$expected_ipv4_match" "$expected_verdict"
}

assert_live_fw4_chain() {
  expected_chain=$1
  expected_rule_count=$2
  expected_terminal=$3
  expected_comment_order=$4
  live_chain_rules=$(nft -a list chain inet fw4 "$expected_chain") ||
    fail "could not inspect live fw4 chain shape: $expected_chain"
  actual_rule_count=$(printf '%s\n' "$live_chain_rules" | awk \
    -v wanted="$expected_chain" '
      $1 == "chain" && $2 == wanted && $3 == "{" { in_chain = 1; next }
      in_chain && $1 == "}" { in_chain = 0 }
      in_chain && /# handle [0-9]+$/ { count++ }
      END { print count + 0 }
    ')
  [ "$actual_rule_count" -eq "$expected_rule_count" ] ||
    fail "live fw4 chain contains an unexpected rule: $expected_chain"
  actual_terminal=$(printf '%s\n' "$live_chain_rules" | awk \
    -v wanted="$expected_chain" '
      $1 == "chain" && $2 == wanted && $3 == "{" { in_chain = 1; next }
      in_chain && $1 == "}" { in_chain = 0 }
      in_chain && /# handle [0-9]+$/ { terminal = $0 }
      END { print terminal }
    ' | sed \
      -e 's/^[[:space:]]*//' \
      -e 's/[[:space:]][[:space:]]*/ /g' \
      -e 's/ # handle [0-9][0-9]*$//')
  [ "$actual_terminal" = "$expected_terminal" ] ||
    fail "live fw4 chain has an unexpected terminal verdict: $expected_chain"
  actual_comment_order=$(printf '%s\n' "$live_chain_rules" |
    sed -n 's/.*comment "!fw4: \([^"]*\)".*/\1/p')
  [ "$actual_comment_order" = "$expected_comment_order" ] ||
    fail "live fw4 chain rule order differs from policy: $expected_chain"
  printf 'FIREWALL_LIVE_CHAIN name=%s rules=%s terminal=%s order=exact\n' \
    "$expected_chain" "$actual_rule_count" "$actual_terminal"
}

assert_live_fw4_rule input_wan Allow-WAN-DHCPv4-replies 1 \
  'meta nfproto ipv4' accept
assert_live_fw4_rule input_wan Reject-other-WAN-input 1 \
