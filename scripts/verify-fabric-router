strict_ssh /bin/sh -s > "$remote_records" <<'REMOTE_ASSETS'
set -eu
export LC_ALL=C
cd /mnt/data/www
found_asset=false
for path in ./* ./.[!.]* ./..?*; do
  [ -e "$path" ] || [ -L "$path" ] || continue
  found_asset=true
  filename=${path#./}
  case $filename in
    *[!A-Za-z0-9._-]*|'')
      printf 'unsafe router asset filename\n' >&2
      exit 1
      ;;
  esac
  [ -f "$filename" ] && [ ! -L "$filename" ] || {
    printf 'router asset is not a regular non-symlink file: %s\n' "$filename" >&2
    exit 1
  }
  digest=$(sha256sum "$filename") || exit 1
  digest=${digest%% *}
  printf '%s\t%s\n' "$filename" "$digest"
done
$found_asset || {
  printf 'router asset directory is empty\n' >&2
  exit 1
}
REMOTE_ASSETS
chmod 0600 -- "$remote_records"

LC_ALL=C sort -o "$remote_records" "$remote_records"
cmp --silent -- "$expected_records" "$remote_records" ||
  die 'router asset membership or bytes differ from the locally derived manifest'

strict_ssh exec cat /mnt/data/www/SHASUMS.txt > "$remote_shasums"
chmod 0600 -- "$remote_shasums"
cmp --silent -- "$expected_shasums" "$remote_shasums" ||
  die 'router SHASUMS.txt differs from the locally derived manifest'

for ((dns_index = 0; dns_index < ${#expected_dns_names[@]}; dns_index++)); do
  expected_dns_name=${expected_dns_names[$dns_index]}
  expected_dns_answer=${expected_dns_answers[$dns_index]}
  dns_udp=$(dig -r +short +time=3 +tries=1 \
    "@$router_address" "$expected_dns_name" A) ||
    die "router UDP DNS query failed: $expected_dns_name"
  [[ $dns_udp == "$expected_dns_answer" ]] ||
    die "router UDP DNS answer for $expected_dns_name is not exactly $expected_dns_answer"
  dns_tcp=$(dig -r +tcp +short +time=3 +tries=1 \
    "@$router_address" "$expected_dns_name" A) ||
    die "router TCP DNS query failed: $expected_dns_name"
  [[ $dns_tcp == "$expected_dns_answer" ]] ||
    die "router TCP DNS answer for $expected_dns_name is not exactly $expected_dns_answer"
  printf 'DNS UDP/TCP %s -> %s: PASS\n' "$expected_dns_name" "$expected_dns_answer"
done

