printf 'NTP sample from %s: PASS\n' "$router_address"
printf 'Streaming and hashing %d HTTP assets from the router:\n' \
  "$(wc -l < "$expected_records")"
while IFS=$'\t' read -r filename expected_sha; do
  [[ -n $filename && $expected_sha =~ ^[0-9a-f]{64}$ ]] ||
    die 'internal expected HTTP asset record is invalid'
  http_status_file=$evidence_dir/http-$filename.status
  http_sha=$(
    curl --disable --fail --silent --show-error \
      --proto '=http' --proto-redir '=http' --noproxy '*' \
      --connect-timeout 5 --max-time 1800 \
      --write-out '%{stderr}HTTP_STATUS=%{http_code}\n' \
      "http://$router_address/static/$filename" 2> "$http_status_file" |
      sha256sum
  ) || die "HTTP retrieval failed for pinned asset: $filename"
  chmod 0600 -- "$http_status_file"
  [[ $(< "$http_status_file") == HTTP_STATUS=200 ]] ||
    die "HTTP status is not exactly 200 for pinned asset: $filename"
  http_sha=${http_sha%% *}
  [[ $http_sha == "$expected_sha" ]] ||
    die "HTTP bytes differ from the local manifest: $filename"
  printf '  %s: PASS\n' "$filename"
done < "$expected_records"

# This active negative probe is supplementary to the mandatory route checks
# above. Explicitly bypass proxy environment variables so a shared pathname
# socket or inherited proxy cannot turn success into a false network result.
if curl --disable --fail --silent --show-error --noproxy '*' \
    --connect-timeout 2 --max-time 3 http://1.1.1.1/ \
    >/dev/null 2> "$evidence_dir/public-probe.stderr"; then
  die 'observer namespace unexpectedly reached a public IPv4 endpoint'
fi
chmod 0600 -- "$evidence_dir/public-probe.stderr"

printf '%s\n' \
  'result=pass' \
  "router=$router_address" \
  "observer=$observer_address" \
  "serial_ed25519_fingerprint=$serial_fingerprint" \
  "boot_id=$router_boot_id" \
  "stable_invariants_sha256=$stable_sha" \
  'snapshot_gate=complete' \
  'attended_source_role_matrix=not_run_separate_gate' \
  'reboot_persistence_comparison=not_run_separate_gate' \
  > "$evidence_dir/scope.txt"
chmod 0600 -- "$evidence_dir/scope.txt"

complete=true
printf '\nFabric router read-only commissioning snapshot: PASS\n'
printf 'Protected evidence: %s\n' "$evidence_dir"
printf 'Separate attended gates still required:\n'
printf '  - source-role traffic matrix (.2, .10-.12, .20, and WAN)\n'
printf '  - reboot persistence and stable-invariant/host-key comparison\n'
