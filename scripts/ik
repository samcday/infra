#!/bin/bash
# ik - infra kubectl
# Runs kubectl against the multi-cluster infra kubeconfig.
# Works from any directory. Contexts: hub, cloud, edge-au-east, fabric
#
# Usage:
#   ik --context=hub get nodes
#   ik --context=cloud get pods -n fastboop
#   ik --context=edge-au-east get nodes
#   ik --context=fabric get nodes
#   ik get pods -A   (uses current-context, defaults to hub)
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

fabric_context=false
arguments=()
while (($#)); do
  case $1 in
    --context=fabric)
      fabric_context=true
      shift
      ;;
    --context)
      if [[ ${2:-} == fabric ]]; then
        fabric_context=true
        shift 2
      else
        arguments+=("$1")
        shift
      fi
      ;;
    --)
      arguments+=("$@")
      break
      ;;
    *)
      arguments+=("$1")
      shift
      ;;
  esac
done

if $fabric_context; then
  exec "$REPO_ROOT/scripts/fk" "${arguments[@]}"
fi

exec kubectl --kubeconfig="$REPO_ROOT/kubeconfig" "${arguments[@]}"
