#!/usr/bin/env bash
set -euo pipefail

export LC_ALL=C
umask 077

script_path=$(realpath -e -- "${BASH_SOURCE[0]}")
script_dir=$(dirname -- "$script_path")
repo_root=$(realpath -e -- "$script_dir/..")
# shellcheck disable=SC1091
source "$script_dir/lib/fabric-node-inventory.sh"

readonly namespace=bootie
readonly secret_name=bootie-session

usage() {
  cat >&2 <<'EOF'
Usage:
  scripts/fabric-node-bootie-session --check
  scripts/fabric-node-bootie-session arm \
    --node fabric-az1-svc1 \
    --lock-receipt /dev/shm/fabric-az1-svc1-day2-lock \
    --handoff-dir /dev/shm/fabric-az1-svc1-bootie-handoff \
    --output-dir /dev/shm/fabric-az1-svc1-bootie-session \
    --confirm ARM-BOOTIE:<node>:<disk>:<ignition-sha256>
  scripts/fabric-node-bootie-session status \
    --receipt-dir /dev/shm/fabric-az1-svc1-bootie-session
  scripts/fabric-node-bootie-session record \
    --node fabric-az1-svc1 \
    --lock-receipt /dev/shm/fabric-az1-svc1-day2-lock \
    --handoff-dir /dev/shm/fabric-az1-svc1-bootie-handoff \
    --output-dir /dev/shm/fabric-az1-svc1-bootie-session \
    --confirm RECORD-BOOTIE-SESSION:<node>:<node-uid>:<secret-uid>
  scripts/fabric-node-bootie-session close \
    --lock-receipt /dev/shm/fabric-az1-svc1-day2-lock \
    --receipt-dir /dev/shm/fabric-az1-svc1-bootie-session \
    --confirm CLOSE-BOOTIE-SESSION:<node>:<secret-uid>

arm requires the stopped old Node to have been retired. It creates one exact
cordoned placeholder, one immutable bootie/bootie-session Secret, and then
atomically arms that placeholder. Bootie consumes the install response and
Ignition token once. close is allowed only after the token was consumed; it
UID/resourceVersion-deletes the Secret while retaining the non-secret receipt
for finalization. Rerunning the same confirmed arm adopts only its exact safe
discovery placeholder, immutable Secret bytes, or armed/consumed session and
finishes the missing step or receipt. record remains available to reconstruct
only the non-secret local receipt after a fully matching arm. There is no
name-only deletion or automatic re-arm.
EOF
}

die() {
  printf 'fabric-node-bootie-session: %s\n' "$*" >&2
  exit 1
}

mode=
node=
lock_receipt=
handoff_dir=
output_dir=
receipt_dir=
confirmation=
case ${1:-} in
  --check) mode=check; shift ;;
  arm | record | status | close) mode=$1; shift ;;
  -h | --help) usage; exit 0 ;;
  *) usage; exit 2 ;;
esac
while (($#)); do
  case $1 in
    --node) (($# >= 2)) || die '--node requires a value'; node=$2; shift 2 ;;
    --lock-receipt) (($# >= 2)) || die '--lock-receipt requires a value'; lock_receipt=$2; shift 2 ;;
    --handoff-dir) (($# >= 2)) || die '--handoff-dir requires a value'; handoff_dir=$2; shift 2 ;;
    --output-dir) (($# >= 2)) || die '--output-dir requires a value'; output_dir=$2; shift 2 ;;
    --receipt-dir) (($# >= 2)) || die '--receipt-dir requires a value'; receipt_dir=$2; shift 2 ;;
    --confirm) (($# >= 2)) || die '--confirm requires a value'; confirmation=$2; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done

for command in base64 bash chmod curl date find git id jq kubectl mktemp mv \
  realpath rmdir sha256sum sleep stat wc yq; do
  command -v "$command" >/dev/null || die "missing required command: $command"
done
fabric_validate_node_inventory || die 'five-node inventory validation failed'
if [[ $mode == check ]]; then
  [[ -z $node && -z $lock_receipt && -z $handoff_dir && -z $output_dir &&
     -z $receipt_dir && -z $confirmation ]] || die '--check accepts no other arguments'
  bash -n "$script_path"
  printf 'validated the UID-bound, one-use in-cluster Bootie session helper\n'
  exit 0
fi

ik=("$repo_root/scripts/ik" --context=fabric --request-timeout=15s)

validate_receipt() {
  receipt_dir=$(realpath -e -- "$receipt_dir")
  [[ -d $receipt_dir && ! -L $receipt_dir &&
     $(stat --file-system --format=%T -- "$receipt_dir") == tmpfs &&
     $(stat -Lc '%u:%g:%a' "$receipt_dir") == "$(id -u):$(id -g):700" ]] ||
    die 'session receipt directory must be caller-owned mode-0700 tmpfs'
  [[ -f $receipt_dir/session.json && ! -L $receipt_dir/session.json &&
     $(stat -Lc '%u:%g:%a:%h' "$receipt_dir/session.json") == "$(id -u):$(id -g):600:1" &&
     $(find "$receipt_dir" -mindepth 1 -maxdepth 1 | wc -l) == 1 ]] ||
    die 'session receipt must contain one safe session.json'
  jq -e '
    .schema == 1 and .purpose == "fabric-node-day-two-session-receipt" and
    (.session.nodeUid | test("^[0-9a-f-]{36}$")) and
    (.secret.uid | test("^[0-9a-f-]{36}$")) and
    (.secret.resourceVersion | type == "string" and length > 0)
  ' "$receipt_dir/session.json" >/dev/null || die 'session receipt is malformed'
}

if [[ $mode == arm ]]; then
  [[ -n $node && -n $lock_receipt && -n $handoff_dir && -n $output_dir &&
     -n $confirmation && -z $receipt_dir ]] || { usage; exit 2; }
  fabric_load_node_inventory "$node" || die '--node is not in exact Fabric inventory'
  role=$FABRIC_NODE_ROLE
  address=$FABRIC_NODE_ADDRESS
  mac=$FABRIC_NODE_MAC
  mac_label=${mac//:/-}
  disk=$FABRIC_NODE_DISK
  lock_receipt=$(realpath -e -- "$lock_receipt")
  "$repo_root/scripts/fabric-node-day2-lock" verify --receipt-dir "$lock_receipt" >/dev/null
  lock_json=$lock_receipt/lock.json
  repo_commit=$(jq -r '.repoCommit' "$lock_json")
  lock_uid=$(jq -r '.lock.uid' "$lock_json")
  [[ $(jq -r '.node' "$lock_json") == "$node" &&
     $(jq -r '.role' "$lock_json") == "$role" ]] ||
    die 'maintenance lock receipt belongs to another node or role'

  handoff_dir=$(realpath -e -- "$handoff_dir")
  [[ -d $handoff_dir && ! -L $handoff_dir &&
     $(stat --file-system --format=%T -- "$handoff_dir") == tmpfs &&
     $(stat -Lc '%u:%g:%a' "$handoff_dir") == "$(id -u):$(id -g):700" ]] ||
    die 'handoff must be a caller-owned mode-0700 tmpfs directory'
  for file in "$node.ign" install-policy handoff.json; do
    [[ -f $handoff_dir/$file && ! -L $handoff_dir/$file &&
       $(stat -Lc '%u:%g:%a:%h' "$handoff_dir/$file") == "$(id -u):$(id -g):600:1" ]] ||
      die "handoff file is unsafe: $file"
  done
  [[ $(find "$handoff_dir" -mindepth 1 -maxdepth 1 | wc -l) == 3 ]] ||
    die 'handoff contains an unexpected entry'
  ignition_sha=$(sha256sum "$handoff_dir/$node.ign" | awk '{print $1}')
  policy_sha=$(sha256sum "$handoff_dir/install-policy" | awk '{print $1}')
  inventory_sha=$(sha256sum "$repo_root/fabric/inventory/nodes.yaml" | awk '{print $1}')
  [[ $(<"$handoff_dir/install-policy") == "$node $disk" ]] ||
    die 'install policy differs from the exact inventoried destination'
  jq -e --arg node "$node" --arg role "$role" --arg address "$address" \
    --arg mac "$mac" --arg disk "$disk" --arg repo "$repo_commit" \
    --arg lock_uid "$lock_uid" --arg ignition_sha "$ignition_sha" \
    --arg policy_sha "$policy_sha" --arg inventory_sha "$inventory_sha" '
    .schema == 1 and .purpose == "fabric-node-day-two-handoff" and
    .node == $node and .role == $role and .address == $address and .mac == $mac and
    .bootDevice == $disk and .repoCommit == $repo and .lockUid == $lock_uid and
    .ignition.file == ($node + ".ign") and .ignition.sha256 == $ignition_sha and
    .installPolicy == {file:"install-policy", sha256:$policy_sha} and
    .inventorySha256 == $inventory_sha and
    (if $role == "control-plane" then .clusterState == "existing" else .clusterState == null end)
  ' "$handoff_dir/handoff.json" >/dev/null || die 'handoff does not match the live lock and inventory'
  [[ $confirmation == "ARM-BOOTIE:$node:$disk:$ignition_sha" ]] ||
    die "exact --confirm ARM-BOOTIE:$node:$disk:$ignition_sha is required"

  deployment_file=$repo_root/fabric/cluster/bootie/deployment.yaml
  image=$(yq -er '.spec.template.spec.containers[] | select(.name == "bootie") | .image' "$deployment_file")
  image_digest=${image##*@}
  image_revision=$(yq -er '.spec.template.spec.containers[] | select(.name == "bootie") |
    .env[] | select(.name == "BOOTIE_IMAGE_REVISION") | .value' "$deployment_file")
  declared_digest=$(yq -er '.spec.template.spec.containers[] | select(.name == "bootie") |
    .env[] | select(.name == "BOOTIE_IMAGE_DIGEST") | .value' "$deployment_file")
  [[ $image_digest == "$declared_digest" && $image_digest =~ ^sha256:[0-9a-f]{64}$ &&
     $image_revision =~ ^[0-9a-f]{40}$ ]] || die 'committed Bootie image pin is inconsistent'
  git -C "$repo_root" merge-base --is-ancestor "$image_revision" "$repo_commit" ||
    die 'Bootie source revision is not an ancestor of the held configuration revision'
  deployment=$("${ik[@]}" --namespace "$namespace" get deployment bootie --output=json) ||
    die 'in-cluster Bootie Deployment is absent'
  jq -e --arg image "$image" '
    .metadata.generation == .status.observedGeneration and
    .status.availableReplicas == 1 and .status.readyReplicas == 1 and
    ([.spec.template.spec.containers[] | select(.name == "bootie") | .image] == [$image])
  ' <<<"$deployment" >/dev/null || die 'in-cluster Bootie is not exactly Ready at the pinned image'
  [[ -z $("${ik[@]}" --namespace kube-system get secret "$node.node-password.k3s" \
    --ignore-not-found --output=name) ]] ||
    die 'target K3s node-password Secret remains; complete exact retirement first'
  output_dir=$(realpath -m -- "$output_dir")
  case $output_dir in "$repo_root" | "$repo_root"/*) die 'session receipt must remain outside Git' ;; esac
  [[ ! -e $output_dir && ! -L $output_dir ]] || die 'session receipt output already exists'
  output_parent=$(dirname -- "$output_dir")
  [[ -d $output_parent && ! -L $output_parent &&
     $(stat --file-system --format=%T -- "$output_parent") == tmpfs ]] ||
    die 'session receipt parent must be an existing tmpfs directory'

  work=$(mktemp -d -- "$output_parent/.fabric-bootie-session.XXXXXXXX")
  chmod 0700 "$work"
  arm_complete=false
  # shellcheck disable=SC2329 # Invoked by the EXIT trap below.
  cleanup_arm_work() {
    local status=$?
    trap - EXIT
    if [[ $arm_complete != true && -d ${work:-} ]]; then
      find "$work" -xdev -mindepth 1 -delete 2>/dev/null || true
      rmdir "$work" 2>/dev/null || status=1
    fi
    exit "$status"
  }
  trap cleanup_arm_work EXIT

  taints='[{"key":"fabric.samcday.com/platform","value":"true","effect":"NoSchedule"}]'
  labels=$(jq -cn --arg mac "$mac_label" '{
    "fabric.samcday.com/bootstrap-placeholder":"true",
    "samcday.com/discovery":"true", "samcday.com/mac":$mac,
    "fabric.samcday.com/platform":"true"
  }')
  if [[ $role == control-plane ]]; then
    taints='[{"key":"fabric.samcday.com/root-consensus","value":"true","effect":"NoSchedule"},{"key":"node-role.kubernetes.io/control-plane","value":"true","effect":"NoSchedule"}]'
    labels=$(jq -cn --arg mac "$mac_label" '{
      "fabric.samcday.com/bootstrap-placeholder":"true",
      "samcday.com/discovery":"true", "samcday.com/mac":$mac,
      "fabric.samcday.com/root-consensus":"true",
      "node-role.kubernetes.io/control-plane":"true"
    }')
  fi
  placeholder=$(jq -cn --arg node "$node" --argjson labels "$labels" --argjson taints "$taints" '{
    apiVersion:"v1", kind:"Node", metadata:{name:$node, labels:$labels,
      annotations:{"fabric.samcday.com/bootstrap-state":"discovery"}},
    spec:{unschedulable:true, taints:$taints}
  }')
  live_node=$("${ik[@]}" get node "$node" --ignore-not-found --output=json) ||
    die 'could not inspect target placeholder state'
  live_secret=$("${ik[@]}" --namespace "$namespace" get secret "$secret_name" \
    --ignore-not-found --output=json) || die 'could not inspect Bootie session state'
  if [[ -z $live_node ]]; then
    [[ -z $live_secret ]] ||
      die 'an orphan Bootie session exists without its receipt-bound placeholder'
    created_node=$(printf '%s' "$placeholder" | "${ik[@]}" create --filename=- --output=json) ||
      die 'exact bootstrap placeholder creation failed'
    node_uid=$(jq -er '.metadata.uid' <<<"$created_node")
  else
    jq -e --arg mac "$mac_label" --arg role "$role" '
      .metadata.deletionTimestamp == null and
      .metadata.labels["fabric.samcday.com/bootstrap-placeholder"] == "true" and
      .metadata.labels["samcday.com/mac"] == $mac and
      (.metadata.annotations["fabric.samcday.com/bootstrap-state"] as $state |
        $state == "discovery" or $state == "install-armed" or
        $state == "install-response-issued") and
      (.spec.unschedulable // false) == true and
      ((.status.nodeInfo.machineID // "") == "") and
      ([.status.addresses[]? | select(.type == "InternalIP")] | length) == 0 and
      ([.status.conditions[]? | select(.type == "Ready" and .status == "True")] |
        length) == 0 and
      if $role == "service" then
        .metadata.labels["fabric.samcday.com/platform"] == "true" and
        (.metadata.labels | has("fabric.samcday.com/root-consensus") | not) and
        (.metadata.labels | has("node-role.kubernetes.io/control-plane") | not) and
        ([.spec.taints[]? | select(.key == "fabric.samcday.com/platform" and
          .value == "true" and .effect == "NoSchedule")] | length) == 1 and
        ([.spec.taints[]? | select(.key == "fabric.samcday.com/root-consensus" or
          .key == "node-role.kubernetes.io/control-plane")] | length) == 0
      else
        .metadata.labels["fabric.samcday.com/root-consensus"] == "true" and
        (.metadata.labels | has("node-role.kubernetes.io/control-plane")) and
        (.metadata.labels | has("fabric.samcday.com/platform") | not) and
        ([.spec.taints[]? | select(.key == "fabric.samcday.com/root-consensus" and
          .value == "true" and .effect == "NoSchedule")] | length) == 1 and
        ([.spec.taints[]? | select(.key == "node-role.kubernetes.io/control-plane" and
          .value == "true" and .effect == "NoSchedule")] | length) == 1 and
        ([.spec.taints[]? | select(.key == "fabric.samcday.com/platform")] | length) == 0
      end
    ' <<<"$live_node" >/dev/null ||
      die 'same-name Node is not an exact resumable Bootie placeholder'
    node_uid=$(jq -er '.metadata.uid' <<<"$live_node")
  fi
  [[ $node_uid =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] ||
    die 'placeholder Node UID is malformed'

  session_payload=$(jq -cn --arg node "$node" --arg role "$role" --arg address "$address" \
    --arg mac "$mac" --arg disk "$disk" --arg node_uid "$node_uid" \
    --arg repo "$repo_commit" --arg ignition_sha "$ignition_sha" \
    --arg policy_sha "$policy_sha" --arg image_digest "$image_digest" \
    --arg image_revision "$image_revision" --arg lock_uid "$lock_uid" '{
      schema:1, purpose:"fabric-node-day-two-session", node:$node, role:$role,
      address:$address, mac:$mac, bootDevice:$disk, nodeUid:$node_uid,
      repoCommit:$repo, ignitionSha256:$ignition_sha,
      installPolicySha256:$policy_sha, bootieImageDigest:$image_digest,
      bootieImageRevision:$image_revision, lockUid:$lock_uid
    }')
  printf '%s\n' "$session_payload" >"$work/payload.json"
  secret_manifest=$(jq -n --arg node "$node" \
    --arg session "$(base64 -w0 "$work/payload.json")" \
    --arg policy "$(base64 -w0 "$handoff_dir/install-policy")" \
    --arg ignition "$(base64 -w0 "$handoff_dir/$node.ign")" '{
      apiVersion:"v1", kind:"Secret", immutable:true,
      metadata:{name:"bootie-session", namespace:"bootie", labels:{
        "fabric.samcday.com/purpose":"node-day-two", "fabric.samcday.com/node":$node}},
      type:"Opaque", data:{"session.json":$session, "install-policy":$policy} +
        {($node + ".ign"):$ignition}
    }')
  if [[ -z $live_secret ]]; then
    expected_discovery_identity="$node_uid"$'\t'discovery
    [[ $("${ik[@]}" get node "$node" \
      -o jsonpath='{.metadata.uid}{"\t"}{.metadata.annotations.fabric\.samcday\.com/bootstrap-state}') == \
      "$expected_discovery_identity" ]] ||
      die 'armed, replaced, or consumed placeholder cannot receive a new session Secret'
    created_secret=$(printf '%s' "$secret_manifest" | "${ik[@]}" create --filename=- --output=json) ||
      die 'immutable Bootie session Secret creation failed; rerun the same arm command'
    secret_uid=$(jq -er '.metadata.uid' <<<"$created_secret")
    secret_rv=$(jq -er '.metadata.resourceVersion' <<<"$created_secret")
  else
    jq -e --arg node "$node" '
      .metadata.deletionTimestamp == null and .immutable == true and .type == "Opaque" and
      .metadata.labels["fabric.samcday.com/purpose"] == "node-day-two" and
      .metadata.labels["fabric.samcday.com/node"] == $node and
      ([.data | keys[]] | sort) == (["install-policy","session.json",($node + ".ign")] | sort) and
      (.metadata.uid | test("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")) and
      (.metadata.resourceVersion | test("^[1-9][0-9]*$"))
    ' <<<"$live_secret" >/dev/null || die 'live Bootie session Secret has an unsafe shape'
    live_payload=$(jq -er '.data["session.json"] | @base64d | fromjson | @json' \
      <<<"$live_secret") || die 'live Bootie session payload is malformed'
    [[ $(jq -cS . <<<"$live_payload") == $(jq -cS . <<<"$session_payload") ]] ||
      die 'live Bootie session payload differs from the exact resumable arm'
    jq -er '.data["install-policy"]' <<<"$live_secret" | base64 --decode >"$work/live-policy"
    jq -er --arg node "$node" '.data[$node + ".ign"]' <<<"$live_secret" |
      base64 --decode >"$work/live-ignition"
    [[ $(sha256sum "$work/live-policy" | awk '{print $1}') == "$policy_sha" &&
       $(sha256sum "$work/live-ignition" | awk '{print $1}') == "$ignition_sha" ]] ||
      die 'live Bootie session bytes differ from the exact resumable handoff'
    rm -f -- "$work/live-policy" "$work/live-ignition"
    secret_uid=$(jq -er '.metadata.uid' <<<"$live_secret")
    secret_rv=$(jq -er '.metadata.resourceVersion' <<<"$live_secret")
  fi
  # Node lifecycle controllers immediately add TTL/status/taints and can advance
  # resourceVersion between creation and Secret publication. Re-read and bind
  # the same safe placeholder UID immediately before the atomic arm.
  live_node=$("${ik[@]}" get node "$node" --output=json) ||
    die 'placeholder disappeared before the exact arm'
  bootstrap_state=$(jq -r '.metadata.annotations["fabric.samcday.com/bootstrap-state"]' \
    <<<"$live_node")
  if [[ $bootstrap_state == discovery ]]; then
    jq -e --arg uid "$node_uid" --arg mac "$mac_label" '
    .metadata.uid == $uid and
    .metadata.labels["fabric.samcday.com/bootstrap-placeholder"] == "true" and
    .metadata.labels["samcday.com/discovery"] == "true" and
    .metadata.labels["samcday.com/mac"] == $mac and
    .metadata.annotations["fabric.samcday.com/bootstrap-state"] == "discovery" and
    (.spec.unschedulable // false) == true and
    ((.metadata.annotations["fabric.samcday.com/bootie-session-uid"] // "") == "") and
    ((.metadata.annotations["samcday.com/boot-device"] // "") == "") and
    ((.metadata.annotations["samcday.com/install"] // "") == "") and
    ((.metadata.annotations["samcday.com/ignition-token"] // "") == "") and
    ((.metadata.annotations["samcday.com/ignition-mode"] // "") == "") and
    ((.status.nodeInfo.machineID // "") == "")
    ' <<<"$live_node" >/dev/null ||
      die 'discovery placeholder changed before the exact resumable arm'
    node_rv=$(jq -r '.metadata.resourceVersion' <<<"$live_node")
    patch=$(jq -cn --arg rv "$node_rv" --arg uid "$node_uid" --arg session_uid "$secret_uid" \
      --arg disk "$disk" '[
        {"op":"test","path":"/metadata/resourceVersion","value":$rv},
        {"op":"test","path":"/metadata/uid","value":$uid},
        {"op":"test","path":"/metadata/labels/samcday.com~1discovery","value":"true"},
        {"op":"test","path":"/metadata/annotations/fabric.samcday.com~1bootstrap-state","value":"discovery"},
        {"op":"replace","path":"/metadata/labels/samcday.com~1discovery","value":"false"},
        {"op":"replace","path":"/metadata/annotations/fabric.samcday.com~1bootstrap-state","value":"install-armed"},
        {"op":"add","path":"/metadata/annotations/fabric.samcday.com~1bootie-session-uid","value":$session_uid},
        {"op":"add","path":"/metadata/annotations/samcday.com~1boot-device","value":$disk},
        {"op":"add","path":"/metadata/annotations/samcday.com~1install","value":"true"}
      ]')
    "${ik[@]}" patch node "$node" --type=json --patch "$patch" >/dev/null ||
      die 'exact Node arm raced; rerun the same arm command'
  elif [[ $bootstrap_state != install-armed && $bootstrap_state != install-response-issued ]]; then
    die 'placeholder entered a non-resumable state before the exact arm'
  fi

  live_node=$("${ik[@]}" get node "$node" --output=json) ||
    die 'placeholder disappeared after the exact arm'
  jq -e --arg uid "$node_uid" --arg mac "$mac_label" --arg role "$role" \
    --arg session_uid "$secret_uid" --arg disk "$disk" \
    --arg repo "$repo_commit" --arg ignition "$ignition_sha" \
    --arg image_digest "$image_digest" --arg image_revision "$image_revision" '
    .metadata.uid == $uid and .metadata.deletionTimestamp == null and
    .metadata.labels["fabric.samcday.com/bootstrap-placeholder"] == "true" and
    .metadata.labels["samcday.com/discovery"] == "false" and
    .metadata.labels["samcday.com/mac"] == $mac and
    .metadata.annotations["fabric.samcday.com/bootie-session-uid"] == $session_uid and
    (.spec.unschedulable // false) == true and
    (if $role == "service" then
      .metadata.labels["fabric.samcday.com/platform"] == "true" and
      (.metadata.labels | has("fabric.samcday.com/root-consensus") | not)
    else
      .metadata.labels["fabric.samcday.com/root-consensus"] == "true" and
      (.metadata.labels | has("node-role.kubernetes.io/control-plane")) and
      (.metadata.labels | has("fabric.samcday.com/platform") | not)
    end) and
    if .metadata.annotations["fabric.samcday.com/bootstrap-state"] == "install-armed" then
      .metadata.annotations["samcday.com/boot-device"] == $disk and
      .metadata.annotations["samcday.com/install"] == "true" and
      ((.metadata.annotations["samcday.com/ignition-token"] // "") == "") and
      ((.metadata.annotations["samcday.com/ignition-mode"] // "") == "")
    elif .metadata.annotations["fabric.samcday.com/bootstrap-state"] ==
      "install-response-issued" then
      .metadata.annotations["fabric.samcday.com/config-revision"] == $repo and
      .metadata.annotations["fabric.samcday.com/ignition-sha256"] == $ignition and
      .metadata.annotations["fabric.samcday.com/bootie-image-digest"] == $image_digest and
      .metadata.annotations["fabric.samcday.com/bootie-image-revision"] == $image_revision and
      ((.metadata.annotations["samcday.com/boot-device"] // "") == "") and
      ((.metadata.annotations["samcday.com/install"] // "") == "") and
      ((.metadata.annotations["samcday.com/ignition-token"] // "") == "") and
      ((.metadata.annotations["samcday.com/ignition-mode"] // "") == "")
    else false end
  ' <<<"$live_node" >/dev/null ||
    die 'placeholder does not match the exact armed or consumed session'
  jq -n --argjson session "$session_payload" --arg uid "$secret_uid" --arg rv "$secret_rv" \
    --arg created "$(date --utc --iso-8601=seconds)" '{
      schema:1, purpose:"fabric-node-day-two-session-receipt", session:$session,
      secret:{namespace:"bootie", name:"bootie-session", uid:$uid, resourceVersion:$rv},
      createdAt:$created
    }' >"$work/session.json"
  chmod 0600 "$work/session.json"
  rm -f -- "$work/payload.json"
  mv -T -- "$work" "$output_dir"
  arm_complete=true
  trap - EXIT
  printf 'ARMED %s placeholder-uid=%s session-uid=%s\n' "$node" "$node_uid" "$secret_uid"
  printf 'Bootie will issue one install response for %s and otherwise exits to local disk.\n' "$disk"
  exit 0
fi

if [[ $mode == record ]]; then
  [[ -n $node && -n $lock_receipt && -n $handoff_dir && -n $output_dir &&
     -n $confirmation && -z $receipt_dir ]] || { usage; exit 2; }
  fabric_load_node_inventory "$node" || die '--node is not in exact Fabric inventory'
  lock_receipt=$(realpath -e -- "$lock_receipt")
  "$repo_root/scripts/fabric-node-day2-lock" verify --receipt-dir "$lock_receipt" >/dev/null
  lock_uid=$(jq -r '.lock.uid' "$lock_receipt/lock.json")
  repo_commit=$(jq -r '.repoCommit' "$lock_receipt/lock.json")
  [[ $(jq -r '.node' "$lock_receipt/lock.json") == "$node" ]] ||
    die 'maintenance lock belongs to another node'
  handoff_dir=$(realpath -e -- "$handoff_dir")
  [[ -d $handoff_dir && ! -L $handoff_dir &&
     $(stat --file-system --format=%T -- "$handoff_dir") == tmpfs ]] ||
    die 'handoff must remain on tmpfs'
  secret_json=$("${ik[@]}" --namespace "$namespace" get secret "$secret_name" --output=json) ||
    die 'live Bootie session Secret is absent'
  node_json=$("${ik[@]}" get node "$node" --output=json) || die 'live placeholder is absent'
  session_payload=$(jq -er '.data["session.json"] | @base64d | fromjson' <<<"$secret_json") ||
    die 'live session payload is malformed'
  secret_uid=$(jq -r '.metadata.uid' <<<"$secret_json")
  secret_rv=$(jq -r '.metadata.resourceVersion' <<<"$secret_json")
  node_uid=$(jq -r '.metadata.uid' <<<"$node_json")
  ignition_sha=$(sha256sum "$handoff_dir/$node.ign" | awk '{print $1}')
  policy_sha=$(sha256sum "$handoff_dir/install-policy" | awk '{print $1}')
  jq -e --arg node "$node" --arg role "$FABRIC_NODE_ROLE" \
    --arg address "$FABRIC_NODE_ADDRESS" --arg mac "$FABRIC_NODE_MAC" \
    --arg disk "$FABRIC_NODE_DISK" --arg node_uid "$node_uid" \
    --arg repo "$repo_commit" --arg lock_uid "$lock_uid" \
    --arg ignition_sha "$ignition_sha" --arg policy_sha "$policy_sha" '
    .schema == 1 and .purpose == "fabric-node-day-two-session" and
    .node == $node and .role == $role and .address == $address and .mac == $mac and
    .bootDevice == $disk and .nodeUid == $node_uid and .repoCommit == $repo and
    .lockUid == $lock_uid and .ignitionSha256 == $ignition_sha and
    .installPolicySha256 == $policy_sha
  ' <<<"$session_payload" >/dev/null || die 'live session differs from handoff, lock, or inventory'
  jq -e --arg uid "$node_uid" --arg session_uid "$secret_uid" '
    .metadata.uid == $uid and
    .metadata.annotations["fabric.samcday.com/bootie-session-uid"] == $session_uid and
    (.metadata.annotations["fabric.samcday.com/bootstrap-state"] as $state |
      $state == "install-armed" or $state == "install-response-issued")
  ' <<<"$node_json" >/dev/null ||
    die 'live placeholder is not the exact armed or response-issued session'
  [[ $(jq -r '.immutable' <<<"$secret_json") == true &&
     $confirmation == "RECORD-BOOTIE-SESSION:$node:$node_uid:$secret_uid" ]] ||
    die "exact --confirm RECORD-BOOTIE-SESSION:$node:$node_uid:$secret_uid is required"
  output_dir=$(realpath -m -- "$output_dir")
  [[ ! -e $output_dir && ! -L $output_dir ]] || die 'session receipt output already exists'
  output_parent=$(dirname -- "$output_dir")
  [[ -d $output_parent && ! -L $output_parent &&
     $(stat --file-system --format=%T -- "$output_parent") == tmpfs ]] ||
    die 'session receipt parent must be tmpfs'
  work=$(mktemp -d -- "$output_parent/.fabric-bootie-record.XXXXXXXX")
  chmod 0700 "$work"
  jq -n --argjson session "$session_payload" --arg uid "$secret_uid" --arg rv "$secret_rv" \
    --arg created "$(date --utc --iso-8601=seconds)" '{
      schema:1, purpose:"fabric-node-day-two-session-receipt", session:$session,
      secret:{namespace:"bootie", name:"bootie-session", uid:$uid, resourceVersion:$rv},
      createdAt:$created
    }' >"$work/session.json"
  chmod 0600 "$work/session.json"
  mv -T -- "$work" "$output_dir"
  printf 'RECORDED %s placeholder-uid=%s session-uid=%s\n' "$node" "$node_uid" "$secret_uid"
  exit 0
fi

[[ -n $receipt_dir && -z $node && -z $handoff_dir && -z $output_dir ]] || { usage; exit 2; }
validate_receipt
receipt=$receipt_dir/session.json
node=$(jq -r '.session.node' "$receipt")
fabric_load_node_inventory "$node" || die 'session receipt node is outside exact inventory'
node_uid=$(jq -r '.session.nodeUid' "$receipt")
secret_uid=$(jq -r '.secret.uid' "$receipt")
secret_rv=$(jq -r '.secret.resourceVersion' "$receipt")

node_json=$("${ik[@]}" get node "$node" --output=json 2>/dev/null || true)
secret_json=$("${ik[@]}" --namespace "$namespace" get secret "$secret_name" --output=json 2>/dev/null || true)
[[ -n $node_json ]] || node_json='{}'
[[ -n $secret_json ]] || secret_json='{}'
state=$(jq -r '.metadata.annotations["fabric.samcday.com/bootstrap-state"] // "absent"' <<<"$node_json")
token=$(jq -r '.metadata.annotations["samcday.com/ignition-token"] // ""' <<<"$node_json")
boot_device=$(jq -r '.metadata.annotations["samcday.com/boot-device"] // ""' <<<"$node_json")
live_secret_uid=$(jq -r '.metadata.uid // "absent"' <<<"$secret_json")
if [[ $mode == status ]]; then
  [[ -z $lock_receipt && -z $confirmation ]] || die 'status accepts only --receipt-dir'
  printf 'SESSION node=%s node-uid=%s state=%s secret=%s token=%s boot-device=%s\n' \
    "$node" "$node_uid" "$state" "$live_secret_uid" \
    "$([[ -n $token ]] && printf present || printf absent)" \
    "$([[ -n $boot_device ]] && printf present || printf absent)"
  exit 0
fi

[[ -n $lock_receipt && -n $confirmation ]] || { usage; exit 2; }
lock_receipt=$(realpath -e -- "$lock_receipt")
"$repo_root/scripts/fabric-node-day2-lock" verify --receipt-dir "$lock_receipt" >/dev/null
[[ $(jq -r '.node' "$lock_receipt/lock.json") == "$node" &&
   $(jq -r '.lock.uid' "$lock_receipt/lock.json") == "$(jq -r '.session.lockUid' "$receipt")" ]] ||
  die 'maintenance lock and session receipt do not match'
[[ $confirmation == "CLOSE-BOOTIE-SESSION:$node:$secret_uid" ]] ||
  die "exact --confirm CLOSE-BOOTIE-SESSION:$node:$secret_uid is required"
jq -e --arg uid "$node_uid" --arg session_uid "$secret_uid" '
  .metadata.uid == $uid and
  .metadata.annotations["fabric.samcday.com/bootie-session-uid"] == $session_uid and
  .metadata.annotations["fabric.samcday.com/bootstrap-state"] == "install-response-issued" and
  ((.metadata.annotations["samcday.com/ignition-token"] // "") == "") and
  ((.metadata.annotations["samcday.com/ignition-mode"] // "") == "") and
  ((.metadata.annotations["samcday.com/boot-device"] // "") == "") and
  ((.metadata.annotations["samcday.com/install"] // "") == "")
' <<<"$node_json" >/dev/null || die 'one-use Ignition has not been fully consumed'

if jq -e '.closedAt | type == "string" and length > 0' "$receipt" >/dev/null; then
  [[ $live_secret_uid == absent ]] || die 'closed receipt has a live same-name Bootie Secret'
  printf 'ALREADY CLOSED %s session-uid=%s; immutable Secret is absent\n' \
    "$node" "$secret_uid"
  exit 0
fi
if [[ $live_secret_uid != absent ]]; then
  [[ $live_secret_uid == "$secret_uid" ]] || die 'live Secret UID differs from the session receipt'
  proxy_dir=$(mktemp -d -- /dev/shm/.fabric-bootie-session-delete.XXXXXXXX)
  chmod 0700 "$proxy_dir"
  proxy_socket=$proxy_dir/kube-api.sock
  proxy_pid=
  # shellcheck disable=SC2329 # Invoked by the EXIT trap below.
  cleanup_proxy() {
    if [[ ${proxy_pid:-} =~ ^[1-9][0-9]*$ ]]; then
      kill -TERM "$proxy_pid" 2>/dev/null || true
      wait "$proxy_pid" 2>/dev/null || true
    fi
    find "$proxy_dir" -xdev -mindepth 1 -delete 2>/dev/null || true
    rmdir "$proxy_dir" 2>/dev/null || true
  }
  trap cleanup_proxy EXIT
  path=/api/v1/namespaces/$namespace/secrets/$secret_name
  "${ik[@]}" proxy --unix-socket="$proxy_socket" --accept-hosts='^localhost$' \
    --accept-paths="^$path\$" --reject-methods='^(GET|POST|PUT|PATCH|HEAD|OPTIONS|CONNECT|TRACE)$' \
    >"$proxy_dir/proxy.log" 2>&1 &
  proxy_pid=$!
  for _attempt in {1..40}; do
    [[ -S $proxy_socket ]] && break
    kill -0 "$proxy_pid" 2>/dev/null || break
    sleep 0.1
  done
  [[ -S $proxy_socket ]] || die 'conditional-delete API proxy did not start'
  options=$(jq -cn --arg uid "$secret_uid" --arg rv "$secret_rv" '{
    apiVersion:"v1", kind:"DeleteOptions", preconditions:{uid:$uid, resourceVersion:$rv}
  }')
  response=$(curl --fail-with-body --silent --show-error --max-time 10 \
    --unix-socket "$proxy_socket" --request DELETE --header 'Content-Type: application/json' \
    --data-binary "$options" "http://localhost$path") || die 'preconditioned session deletion failed'
  jq -e --arg uid "$secret_uid" '
    (.kind == "Status" and .status == "Success") or .metadata.uid == $uid
  ' <<<"$response" >/dev/null || die 'session deletion returned an unexpected object'
  for _attempt in {1..20}; do
    [[ -z $("${ik[@]}" --namespace "$namespace" get secret "$secret_name" \
      --ignore-not-found --output=name) ]] && break
    sleep 0.25
  done
  [[ -z $("${ik[@]}" --namespace "$namespace" get secret "$secret_name" \
    --ignore-not-found --output=name) ]] || die 'Bootie session Secret remains'
fi
tmp=$(mktemp -- "$receipt_dir/.session.json.XXXXXXXX")
chmod 0600 "$tmp"
jq --arg closed "$(date --utc --iso-8601=seconds)" '.closedAt = $closed' "$receipt" >"$tmp"
mv -f -- "$tmp" "$receipt"
printf 'CLOSED %s session-uid=%s; immutable Secret deleted after one-use consumption\n' \
  "$node" "$secret_uid"
