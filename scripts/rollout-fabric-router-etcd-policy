#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C
umask 077

readonly router_address=10.66.0.1
readonly observer_namespace=fabric-observer
readonly fabric_network_lock=/run/lock/fabric-network-operation.lock
readonly fabric_network_cluster_lock=fabric-maintenance-lock
readonly confirmation_prefix=ROLLOUT-FABRIC-ROUTER-ETCD-POLICY
readonly pod_source_confirmation_prefix=QUALIFY-FABRIC-ETCD-POD-SOURCES
readonly transition_sha256=4dd1fb38e38da18054149bc42d470e744b4c10ac8cd8f8cd169d12046975041a
readonly remote_work=/etc/fabric-router-etcd-policy-rollback
readonly remote_init=/etc/init.d/fabric-router-etcd-policy-rollback
readonly rollback_seconds=300
readonly fence_confirmation_prefix=FENCE-FABRIC-ROUTER-ETCD-POLICY
readonly fence_transition_sha256=fc14d132f13d0c46b47df5746d347f68e0bf626737eaf780b63824bba05b8e82
readonly fence_guard_sha256=d5af6bff9ede7dc47bf13f41c9717a4af9886380a85a5b6b91e6e831f13f77f7
readonly fence_contract_sha256=a0325d3badd5c2241425716a53e7e553f904d49fb3edf0cf6cb3bb44f31a5982
readonly fence_remote_work=/etc/fabric-router-etcd-policy-fence
readonly fence_remote_init=/etc/init.d/fabric-router-etcd-policy-fence
readonly fence_remote_guard=/usr/share/nftables.d/chain-pre/forward/10-fabric-etcd-fence.nft
readonly fence_remote_operation_lock=/tmp/fabric-router-etcd-policy-fence.operation
readonly post_open_probe_table=fabric_etcd_post_open_probe
readonly -a root_nodes=(fabric-az1-cp1 fabric-az1-cp2 fabric-az1-cp3)

usage() {
  cat <<EOF
Move the live Fabric router through the one-time etcd-client policy transition.

Read-only preflight (prints the exact revision-and-payload confirmation):
  sudo scripts/rollout-fabric-router-etcd-policy \
    --check \
    --serial-ed25519-fingerprint SHA256:VALUE_FROM_ROUTER_SERIAL \
    --identity /var/home/sam/.ssh/id_ed25519

Attended transition:
  sudo scripts/rollout-fabric-router-etcd-policy \
    --run \
    --serial-ed25519-fingerprint SHA256:VALUE_FROM_ROUTER_SERIAL \
    --identity /var/home/sam/.ssh/id_ed25519 \
    --confirm '$confirmation_prefix:<pushed-main-commit>:$transition_sha256'

Read-only emergency-fence preflight from the exact opened state:
  sudo scripts/rollout-fabric-router-etcd-policy \
    --fence-check \
    --serial-ed25519-fingerprint SHA256:VALUE_FROM_ROUTER_SERIAL \
    --identity /var/home/sam/.ssh/id_ed25519

Attended persistent emergency fence:
  sudo scripts/rollout-fabric-router-etcd-policy \
    --fence-run \
    --serial-ed25519-fingerprint SHA256:VALUE_FROM_ROUTER_SERIAL \
    --identity /var/home/sam/.ssh/id_ed25519 \
    --confirm '$fence_confirmation_prefix:<pushed-main-commit>:$fence_contract_sha256'

The helper accepts only the exact old Reject-services-to-root-etcd state. It
replaces that rule with an exact-node TCP/2379 allow followed by a TCP/2380-2381
reject. It holds the Fabric network-operation lock, stages and syntax-checks an
exact UCI candidate, installs a persistent early-drop guard, and arms a
reboot-surviving procd watchdog before any opening UCI mutation. The guard
remains live and in the automatic nftables include through commit, reload, and
all acceptance proofs. Only after durable token-bound acceptance may the
watchdog, as the sole packet-opening writer, remove the guard, reload the exact
candidate, and record exact-open completion. The caller then re-proves the
complete forward_lan order, target UCI sections, counters, observer isolation,
and Fabric API health before stopping and removing the watchdog.

Deadline or failure atomically selects the fenced terminal state; the watchdog
keeps or reloads the persistent guard and restores the old reject. A failed run
deliberately leaves persistent rollback evidence for attended inspection.
Never remove a stale rollback path, include, or init script until serial access
has proved which policy and terminal state are live.

The fence modes accept only the exact opened policy and restore the canonical
Reject-services-to-root-etcd rule. They also install exact bidirectional
service-to-root TCP/2379 drops in fw4's chain-pre/forward include point, before
its established/related accept, so already-established gRPC cannot bypass the
fence. A router-local reboot-persistent enforcer keeps both layers present.
The persistent include, enforcer, and evidence deliberately remain after
success. There is no in-place unfence mode: recovery requires an explicitly
reviewed serial/reprovision procedure before the normal opening gate is run
again. The FENCE confirmation also authorizes break-glass progress when the
Fabric API is unavailable or any existing global maintenance-lock holder must
be preserved. A volatile, exact-owner router-local operation lock serializes
actual staging, and complete staging is hash-validated before atomic promotion.
Failure never restores the open policy. Artifacts that were safely staged and
any global lock acquired by this run remain for inspection; an existing holder
is never deleted or adopted.
EOF
}

die() {
  printf 'rollout-fabric-router-etcd-policy: %s\n' "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*"
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

valid_fingerprint() {
  [[ $1 =~ ^SHA256:[A-Za-z0-9+/]{43}$ ]]
}

require_root_namespace() {
  local current initial
  current=$(readlink -- /proc/self/ns/net) || die 'cannot identify current network namespace'
  initial=$(readlink -- /proc/1/ns/net) || die 'cannot identify initial network namespace'
  [[ $current == "$initial" ]] || die 'run from the initial/root network namespace'
}

validate_identity() {
  local metadata
  [[ -f $identity && ! -L $identity && -r $identity ]] ||
    die 'router SSH identity must be a readable regular, non-symlink file'
  identity=$(realpath -e -- "$identity") || die 'cannot resolve router SSH identity'
  metadata=$(stat -Lc '%u:%a:%F:%h' -- "$identity") ||
    die 'cannot inspect router SSH identity'
  [[ $metadata == "$operator_uid:600:regular file:1" ]] ||
    die 'router SSH identity must be operator-owned mode-0600 single-link file'
}

operator_git() {
  sudo --non-interactive --user "$operator_user" -- \
    env HOME="$operator_home" USER="$operator_user" LOGNAME="$operator_user" \
      git -C "$repo_root" "$@"
}

operator_kubectl() {
  sudo --non-interactive --user "$operator_user" -- \
    env \
      HOME="$operator_home" \
      USER="$operator_user" \
      LOGNAME="$operator_user" \
      XDG_RUNTIME_DIR="$operator_runtime" \
      FABRIC_INFRA_ROOT="$repo_root" \
      "$repo_root/scripts/ik" --context=fabric --request-timeout=10s "$@"
}

operator_hub_kubectl() {
  sudo --non-interactive --user "$operator_user" -- \
    env \
      HOME="$operator_home" \
      USER="$operator_user" \
      LOGNAME="$operator_user" \
      XDG_RUNTIME_DIR="$operator_runtime" \
      FABRIC_INFRA_ROOT="$repo_root" \
      "$repo_root/scripts/ik" --context=hub --request-timeout=10s "$@"
}

operator_root_ssh() {
  local node=$1
  shift
  sudo --non-interactive --user "$operator_user" -- \
    env \
      HOME="$operator_home" \
      USER="$operator_user" \
      LOGNAME="$operator_user" \
      FABRIC_SSH_IDENTITY="$identity" \
      "$repo_root/scripts/fabric-ssh" "$node" "$@"
}

operator_pre_open() {
  sudo --non-interactive --user "$operator_user" -- \
    env \
      HOME="$operator_home" \
      USER="$operator_user" \
      LOGNAME="$operator_user" \
      XDG_RUNTIME_DIR="$operator_runtime" \
      FABRIC_INFRA_ROOT="$repo_root" \
      FABRIC_SSH_IDENTITY="$identity" \
      "$repo_root/scripts/verify-fabric-etcd-pre-open" "$@"
}

acquire_network_lock() {
  local metadata parent_metadata resolved
  parent_metadata=$(stat -Lc '%F:%u:%g:%a' -- /run/lock) ||
    die 'cannot inspect fabric network lock directory'
  [[ $parent_metadata == 'directory:0:0:755' ]] ||
    die 'fabric network lock directory has unsafe ownership or mode'
  [[ ! -L $fabric_network_lock ]] || die 'fabric network lock is a symlink'
  if [[ -e $fabric_network_lock ]]; then
    [[ -f $fabric_network_lock ]] || die 'fabric network lock is not a regular file'
    metadata=$(stat -Lc '%u:%g:%a:%h' -- "$fabric_network_lock") ||
      die 'cannot inspect fabric network lock'
    [[ $metadata == '0:0:600:1' ]] ||
      die 'fabric network lock has unsafe ownership or mode'
  fi
  exec {network_lock_fd}>>"$fabric_network_lock" || die 'cannot open fabric network lock'
  chmod 0600 -- "/proc/self/fd/$network_lock_fd"
  resolved=$(readlink -e -- "/proc/self/fd/$network_lock_fd") ||
    die 'cannot resolve opened fabric network lock'
  [[ $resolved == "$fabric_network_lock" ]] || die 'opened an unexpected fabric network lock'
  [[ -f /proc/self/fd/$network_lock_fd ]] || die 'opened fabric network lock is not regular'
  metadata=$(stat -Lc '%u:%g:%a:%h' -- "/proc/self/fd/$network_lock_fd") ||
    die 'cannot inspect opened fabric network lock'
  [[ $metadata == '0:0:600:1' ]] ||
    die 'opened fabric network lock has unsafe ownership or mode'
  flock --exclusive --nonblock "$network_lock_fd" ||
    die 'another fabric network operation is active'
}

acquire_cluster_network_lock() {
  local created current_holder
  if ! created=$(operator_kubectl --namespace kube-system create configmap \
      "$fabric_network_cluster_lock" \
      --from-literal="holder=$cluster_lock_holder" --output=json); then
    current_holder=$(operator_kubectl --namespace kube-system get configmap \
      "$fabric_network_cluster_lock" --output=jsonpath='{.data.holder}' \
      2>/dev/null || true)
    die "another or stale global Fabric maintenance lock exists: ${current_holder:-unknown}"
  fi
  jq -e --arg holder "$cluster_lock_holder" '
    .apiVersion == "v1" and
    .kind == "ConfigMap" and
    .metadata.name == "fabric-maintenance-lock" and
    .metadata.namespace == "kube-system" and
    .metadata.deletionTimestamp == null and
    (.metadata.uid | type == "string" and length > 0) and
    (.metadata.resourceVersion | type == "string" and test("^[0-9]+$")) and
    .data == {holder: $holder}
  ' <<<"$created" >/dev/null ||
    die 'created global Fabric maintenance lock has an unexpected identity or shape'
  cluster_lock_uid=$(jq -er '.metadata.uid' <<<"$created") ||
    die 'cannot record global Fabric maintenance lock UID'
  cluster_lock_resource_version=$(jq -er '.metadata.resourceVersion' <<<"$created") ||
    die 'cannot record global Fabric maintenance lock resourceVersion'
  cluster_lock_held=true
}

assert_cluster_network_lock_exact() {
  local current
  $cluster_lock_held || die 'global Fabric maintenance lock is not recorded as held'
  [[ -n $cluster_lock_uid && -n $cluster_lock_resource_version ]] ||
    die 'global Fabric maintenance lock identity was not recorded'
  current=$(operator_kubectl --namespace kube-system get configmap \
    "$fabric_network_cluster_lock" --output=json) ||
    die 'cannot read the exact global Fabric maintenance lock'
  jq -e \
    --arg holder "$cluster_lock_holder" \
    --arg uid "$cluster_lock_uid" \
    --arg resource_version "$cluster_lock_resource_version" '
      .apiVersion == "v1" and
      .kind == "ConfigMap" and
      .metadata.name == "fabric-maintenance-lock" and
      .metadata.namespace == "kube-system" and
      .metadata.uid == $uid and
      .metadata.resourceVersion == $resource_version and
      .metadata.deletionTimestamp == null and
      .data == {holder: $holder}
    ' <<<"$current" >/dev/null ||
    die 'global Fabric maintenance lock identity, version, or ownership changed'
}

release_cluster_network_lock() {
  local deleted remaining
  assert_cluster_network_lock_exact
  deleted=$(jq -cn \
    --arg uid "$cluster_lock_uid" \
    --arg resource_version "$cluster_lock_resource_version" '{
      apiVersion: "v1",
      kind: "DeleteOptions",
      preconditions: {uid: $uid, resourceVersion: $resource_version}
    }' |
    operator_kubectl delete \
      --raw="/api/v1/namespaces/kube-system/configmaps/$fabric_network_cluster_lock" \
      --filename=-) ||
    die 'exact global Fabric maintenance lock could not be conditionally released'
  jq -e '
    (.kind == "Status" and .status == "Success") or
    (.kind == "ConfigMap" and .metadata.name == "fabric-maintenance-lock")
  ' <<<"$deleted" >/dev/null ||
    die 'global Fabric maintenance lock delete returned an unexpected response'
  remaining=$(operator_kubectl --namespace kube-system get configmap \
    "$fabric_network_cluster_lock" --ignore-not-found --output=name) ||
    die 'cannot prove the global Fabric maintenance lock is absent after release'
  [[ -z $remaining ]] ||
    die 'a global Fabric maintenance lock exists after conditional release'
  cluster_lock_held=false
  cluster_lock_uid=
  cluster_lock_resource_version=
}

qualify_pod_sources_under_parent_locks() {
  local current_lock evidence_metadata exact_confirmation parent_resource_version
  local parent_uid pass_count pod_source_evidence pod_source_result resolved_evidence
  local -a evidence_records

  exact_confirmation="$pod_source_confirmation_prefix:$head:svc1=10.66.1.10:svc2=10.66.1.11"
  "$repo_root/scripts/qualify-fabric-etcd-pod-sources" \
    --run \
    --serial-ed25519-fingerprint "$serial_fingerprint" \
    --identity "$identity" \
    --confirm "$exact_confirmation" \
    --internal-parent-network-lock-fd "$network_lock_fd" \
    --internal-parent-cluster-lock-holder "$cluster_lock_holder" \
    >"$evidence_dir/pod-source-qualification.stdout" \
    2>"$evidence_dir/pod-source-qualification.stderr" ||
    die 'fresh parent-locked Pod-source qualification failed'
  chmod 0600 -- \
    "$evidence_dir/pod-source-qualification.stdout" \
    "$evidence_dir/pod-source-qualification.stderr"

  pass_count=$(grep -Fxc 'FABRIC_ETCD_POD_SOURCE_QUALIFICATION=pass' \
    "$evidence_dir/pod-source-qualification.stdout" || true)
  [[ $pass_count == 1 ]] ||
    die 'fresh Pod-source qualification did not report exactly one PASS'
  mapfile -t evidence_records < <(
    sed -n 's/^EVIDENCE_DIR=//p' "$evidence_dir/pod-source-qualification.stdout"
  )
  [[ ${#evidence_records[@]} -eq 1 ]] ||
    die 'fresh Pod-source qualification did not report exactly one evidence directory'
  pod_source_evidence=${evidence_records[0]}
  [[ $pod_source_evidence == /* && -d $pod_source_evidence &&
     ! -L $pod_source_evidence ]] ||
    die 'fresh Pod-source qualification reported an unsafe evidence directory'
  resolved_evidence=$(realpath -e -- "$pod_source_evidence") ||
    die 'cannot resolve fresh Pod-source qualification evidence directory'
  [[ $resolved_evidence == "$pod_source_evidence" ]] ||
    die 'fresh Pod-source qualification evidence directory did not resolve exactly'
  evidence_metadata=$(stat -Lc '%u:%g:%a:%F' -- "$pod_source_evidence") ||
    die 'cannot inspect fresh Pod-source qualification evidence directory'
  [[ $evidence_metadata == '0:0:700:directory' ]] ||
    die 'fresh Pod-source qualification evidence directory has unsafe metadata'
  [[ $(stat --file-system --format=%T -- "$pod_source_evidence") == tmpfs ]] ||
    die 'fresh Pod-source qualification evidence is not on tmpfs'

  pod_source_result=$pod_source_evidence/result.json
  [[ -f $pod_source_result && ! -L $pod_source_result ]] ||
    die 'fresh Pod-source qualification result is missing or unsafe'
  evidence_metadata=$(stat -Lc '%u:%g:%a:%h:%F' -- "$pod_source_result") ||
    die 'cannot inspect fresh Pod-source qualification result'
  [[ $evidence_metadata == '0:0:600:1:regular file' ]] ||
    die 'fresh Pod-source qualification result has unsafe metadata'
  jq -e \
    --arg revision "$head" \
    --arg holder "$cluster_lock_holder" '
      .version == 1 and
      .result == "pass" and
      .revision == $revision and
      .ephemeralCleanup == "verified" and
      .parentLock.scope == "router-parent" and
      .parentLock.holder == $holder and
      (.parentLock.uid | type == "string" and length > 0) and
      (.parentLock.resourceVersion | type == "string" and test("^[0-9]+$"))
    ' "$pod_source_result" >/dev/null ||
    die 'fresh Pod-source qualification result is not bound to the parent locks'
  parent_uid=$(jq -er '.parentLock.uid' "$pod_source_result") ||
    die 'cannot read fresh Pod-source qualification lock UID'
  parent_resource_version=$(jq -er '.parentLock.resourceVersion' "$pod_source_result") ||
    die 'cannot read fresh Pod-source qualification lock resourceVersion'
  [[ $parent_uid == "$cluster_lock_uid" &&
     $parent_resource_version == "$cluster_lock_resource_version" ]] ||
    die 'fresh Pod-source qualification observed a different parent lock identity'

  current_lock=$evidence_dir/pod-source-parent-lock-after.json
  operator_kubectl --namespace kube-system get configmap \
    "$fabric_network_cluster_lock" --output=json >"$current_lock" ||
    die 'cannot re-read parent Fabric maintenance lock after source qualification'
  chmod 0600 -- "$current_lock"
  jq -e \
    --arg holder "$cluster_lock_holder" \
    --arg uid "$parent_uid" \
    --arg resource_version "$parent_resource_version" '
      .apiVersion == "v1" and
      .kind == "ConfigMap" and
      .metadata.name == "fabric-maintenance-lock" and
      .metadata.namespace == "kube-system" and
      .metadata.uid == $uid and
      .metadata.resourceVersion == $resource_version and
      (.metadata.deletionTimestamp? == null) and
      .data == {holder: $holder}
    ' "$current_lock" >/dev/null ||
    die 'parent Fabric maintenance lock changed after source qualification'
  resolved_evidence=$(readlink -e -- "/proc/self/fd/$network_lock_fd") ||
    die 'cannot resolve parent Fabric host lock fd after source qualification'
  [[ $resolved_evidence == "$fabric_network_lock" ]] ||
    die 'parent Fabric host lock fd changed after source qualification'
  flock --exclusive --nonblock "$network_lock_fd" ||
    die 'parent Fabric host lock was lost after source qualification'
  note "FRESH_POD_SOURCE_QUALIFICATION=pass revision=$head"
}

verify_pre_open_contract() {
  local expected output stage=$1 stderr
  shift
  case $stage in
    preflight | locked-before-source | locked-after-source | locked-final) ;;
    *) die "invalid pre-open verification evidence stage: $stage" ;;
  esac
  output=$evidence_dir/pre-open-$stage.stdout
  stderr=$evidence_dir/pre-open-$stage.stderr
  if [[ $stage != preflight ]]; then
    assert_cluster_network_lock_exact
  fi
  if ! operator_pre_open "$@" >"$output" 2>"$stderr"; then
    chmod 0600 -- "$output" "$stderr" 2>/dev/null || true
    die "Fabric etcdetcetc pre-open verification failed at $stage"
  fi
  chmod 0600 -- "$output" "$stderr"
  expected="FABRIC_ETCDETCETC_PRE_OPEN=pass revision=$head"
  [[ $(<"$output") == "$expected" ]] ||
    die "Fabric etcdetcetc pre-open verification returned unexpected output at $stage"
  if [[ $stage != preflight ]]; then
    assert_cluster_network_lock_exact
  fi
}

verify_activation_fence() {
  local cloud_legacy crd hub_chart hub_kustomizations hub_legacy hub_release
  local hub_source inventory
  local kustomizations object_name resource smoke_inventory smoke_namespace
  local smoke_network_policies source stage=$1
  local suffix
  assert_cluster_network_lock_exact
  operator_git fetch --quiet origin main ||
    die "cannot refresh origin/main at the $stage activation fence"
  [[ $(operator_git rev-parse HEAD) == "$head" &&
     $(operator_git rev-parse origin/main) == "$head" ]] ||
    die "HEAD or origin/main moved away from the confirmed activation revision at $stage"
  [[ -z $(operator_git status --porcelain) ]] ||
    die "worktree changed during the attended activation at $stage"
  for suffix in before after; do
    source=$evidence_dir/activation-fence-$stage-source-$suffix.json
    kustomizations=$evidence_dir/activation-fence-$stage-kustomizations-$suffix.json
    operator_kubectl --namespace flux-system get gitrepository infra \
      --output=json >"$source" ||
      die "cannot read the Fabric source at the $stage activation fence"
    operator_kubectl --namespace flux-system get kustomization \
      fabric-root fabric-foundation fabric-platform \
      fabric-etcdetcetc-policy fabric-etcdetcetc-config \
      fabric-etcdetcetc-controller fabric-etcdetcetc-runtime \
      --output=json >"$kustomizations" ||
      die "cannot read Fabric activation Kustomizations at the $stage fence"
    hub_legacy=$evidence_dir/activation-fence-$stage-hub-legacy-$suffix.json
    cloud_legacy=$evidence_dir/activation-fence-$stage-cloud-legacy-$suffix.json
    operator_hub_kubectl --namespace etcdetcetc get helmrelease etcdetcetc \
      --output=json >"$hub_legacy" ||
      die "cannot read the Hub legacy controller at the $stage activation fence"
    operator_hub_kubectl --namespace cloud-cluster get helmrelease \
      etcdetcetc etcdetcetc-cloud-etcd --output=json >"$cloud_legacy" ||
      die "cannot read Cloud legacy releases at the $stage activation fence"
    hub_source=$evidence_dir/activation-fence-$stage-hub-source-$suffix.json
    hub_kustomizations=$evidence_dir/activation-fence-$stage-hub-kustomizations-$suffix.json
    hub_release=$evidence_dir/activation-fence-$stage-hub-fanout-release-$suffix.json
    hub_chart=$evidence_dir/activation-fence-$stage-hub-fanout-chart-$suffix.json
    operator_hub_kubectl --namespace flux-system get gitrepository infra \
      --output=json >"$hub_source" ||
      die "cannot read the Hub source at the $stage activation fence"
    operator_hub_kubectl --namespace flux-system get kustomization \
      infra etcdetcetc cloud-cluster --output=json >"$hub_kustomizations" ||
      die "cannot read Hub owner Kustomizations at the $stage activation fence"
    operator_hub_kubectl --namespace flux-system get helmrelease kustomizations \
      --output=json >"$hub_release" ||
      die "cannot read the Hub fan-out HelmRelease at the $stage activation fence"
    operator_hub_kubectl --namespace flux-system get \
      helmcharts.source.toolkit.fluxcd.io flux-system-kustomizations \
      --output=json >"$hub_chart" ||
      die "cannot read the Hub fan-out HelmChart at the $stage activation fence"
    chmod 0600 -- "$source" "$kustomizations" "$hub_legacy" "$cloud_legacy" \
      "$hub_source" "$hub_kustomizations" "$hub_release" "$hub_chart"
    jq -e --arg revision "main@sha1:$head" '
      .metadata.generation as $generation |
      .metadata.deletionTimestamp == null and
      (.spec.suspend // false) == false and
      .status.observedGeneration == $generation and
      .status.artifact.revision == $revision and
      any(.status.conditions[]?;
        .type == "Ready" and .status == "True" and
        .observedGeneration == $generation
      )
    ' "$source" >/dev/null ||
      die "Fabric Git source moved away from the activation revision at $stage/$suffix"
    jq -e --arg revision "main@sha1:$head" '
      def ready_names: [
        "fabric-root",
        "fabric-foundation",
        "fabric-platform",
        "fabric-etcdetcetc-policy",
        "fabric-etcdetcetc-config"
      ];
      def suspended_names: [
        "fabric-etcdetcetc-controller",
        "fabric-etcdetcetc-runtime"
      ];
      ([.items[].metadata.name] | sort) ==
        ((ready_names + suspended_names) | sort) and
      all(.items[] | select(.metadata.name as $name | ready_names | index($name));
        .metadata.generation as $generation |
        .metadata.deletionTimestamp == null and
        (.spec.suspend // false) == false and
        .status.observedGeneration == $generation and
        .status.lastAppliedRevision == $revision and
        any(.status.conditions[]?;
          .type == "Ready" and .status == "True" and
          .observedGeneration == $generation
        )
      ) and
      all(.items[] | select(.metadata.name as $name | suspended_names | index($name));
        .metadata.deletionTimestamp == null and .spec.suspend == true
      )
    ' "$kustomizations" >/dev/null ||
      die "Fabric activation Kustomizations changed at $stage/$suffix"
    jq -e --arg revision "main@sha1:$head" '
      .metadata.generation as $generation |
      .metadata.deletionTimestamp == null and
      (.spec.suspend // false) == false and
      .spec.ref == {branch: "main"} and
      .status.observedGeneration == $generation and
      .status.artifact.revision == $revision and
      any(.status.conditions[]?;
        .type == "Ready" and .status == "True" and
        .observedGeneration == $generation
      )
    ' "$hub_source" >/dev/null ||
      die "Hub Git source moved away from the activation revision at $stage/$suffix"
    jq -e --arg revision "main@sha1:$head" '
      def expected_path($name):
        if $name == "infra" then "hub/cluster/flux-system"
        elif $name == "etcdetcetc" then "hub/cluster/etcdetcetc"
        elif $name == "cloud-cluster" then "hub/cluster/cloud-cluster"
        else null end;
      ([.items[].metadata.name] | sort) ==
        ["cloud-cluster", "etcdetcetc", "infra"] and
      all(.items[];
        .metadata.generation as $generation |
        .metadata.deletionTimestamp == null and
        (.spec.suspend // false) == false and
        .spec.path == expected_path(.metadata.name) and
        .spec.sourceRef == {
          kind: "GitRepository", name: "infra", namespace: "flux-system"
        } and
        .status.observedGeneration == $generation and
        .status.lastAppliedRevision == $revision and
        any(.status.conditions[]?;
          .type == "Ready" and .status == "True" and
          .observedGeneration == $generation
        )
      )
    ' "$hub_kustomizations" >/dev/null ||
      die "Hub owner Kustomizations changed at $stage/$suffix"
    jq -e --arg revision "0.0.0+${head:0:12}" '
      .metadata.generation as $generation |
      .metadata.deletionTimestamp == null and
      (.spec.suspend // false) == false and
      .spec.chart.spec.chart == "charts/resources" and
      .spec.chart.spec.reconcileStrategy == "Revision" and
      .spec.chart.spec.sourceRef == {
        kind: "GitRepository", name: "infra", namespace: "flux-system"
      } and
      .status.observedGeneration == $generation and
      .status.lastAttemptedRevision == $revision and
      any(.status.conditions[]?;
        .type == "Ready" and .status == "True" and
        .observedGeneration == $generation
      ) and
      all(.status.conditions[]?;
        if .type == "Reconciling" or .type == "Stalled" then .status != "True"
        else true end
      )
    ' "$hub_release" >/dev/null ||
      die "Hub fan-out HelmRelease changed at $stage/$suffix"
    jq -e --arg revision "0.0.0+${head:0:12}" '
      .metadata.generation as $generation |
      .metadata.deletionTimestamp == null and
      .spec.chart == "charts/resources" and
      .spec.reconcileStrategy == "Revision" and
      .spec.sourceRef == {kind: "GitRepository", name: "infra"} and
      .status.observedGeneration == $generation and
      .status.artifact.revision == $revision and
      any(.status.conditions[]?;
        .type == "Ready" and .status == "True" and
        .observedGeneration == $generation
      )
    ' "$hub_chart" >/dev/null ||
      die "Hub fan-out HelmChart changed at $stage/$suffix"
    jq -e '
      .metadata.name == "etcdetcetc" and
      .metadata.namespace == "etcdetcetc" and
      .metadata.deletionTimestamp == null and .spec.suspend == true
    ' "$hub_legacy" >/dev/null ||
      die "Hub legacy controller changed at $stage/$suffix"
    jq -e '
      ([.items[].metadata.name] | sort) == [
        "etcdetcetc", "etcdetcetc-cloud-etcd"
      ] and
      all(.items[];
        .metadata.namespace == "cloud-cluster" and
        .metadata.deletionTimestamp == null and .spec.suspend == true
      )
    ' "$cloud_legacy" >/dev/null ||
      die "Cloud legacy releases changed at $stage/$suffix"

    object_name=$(operator_kubectl --namespace etcdetcetc get helmrelease \
      etcdetcetc --ignore-not-found --output=name) ||
      die "cannot prove the controller HelmRelease absent at the $stage/$suffix fence"
    [[ -z $object_name ]] ||
      die "controller HelmRelease appeared at the $stage/$suffix activation fence"
    inventory=$evidence_dir/activation-fence-$stage-workloads-$suffix.json
    operator_kubectl --namespace etcdetcetc get \
      deployments,replicasets,statefulsets,daemonsets,jobs,cronjobs,replicationcontrollers,pods \
      --output=json >"$inventory" ||
      die "cannot inventory controller workloads at the $stage/$suffix activation fence"
    chmod 0600 -- "$inventory"
    jq -e '.items == []' "$inventory" >/dev/null ||
      die "controller workload appeared at the $stage/$suffix activation fence"
    smoke_inventory=$evidence_dir/activation-fence-$stage-smoke-workloads-$suffix.json
    operator_kubectl --namespace etcdetcetc-smoke get \
      deployments,replicasets,statefulsets,daemonsets,jobs,cronjobs,replicationcontrollers,pods \
      --output=json >"$smoke_inventory" ||
      die "cannot inventory smoke workloads at the $stage/$suffix activation fence"
    chmod 0600 -- "$smoke_inventory"
    jq -e '.items == []' "$smoke_inventory" >/dev/null ||
      die "smoke workload appeared at the $stage/$suffix activation fence"
    smoke_namespace=$evidence_dir/activation-fence-$stage-smoke-namespace-$suffix.json
    smoke_network_policies=$evidence_dir/activation-fence-$stage-smoke-network-policies-$suffix.json
    operator_kubectl get namespace etcdetcetc-smoke --output=json \
      >"$smoke_namespace" ||
      die "cannot read the smoke Namespace at the $stage/$suffix activation fence"
    operator_kubectl --namespace etcdetcetc-smoke get networkpolicy --output=json \
      >"$smoke_network_policies" ||
      die "cannot inventory smoke NetworkPolicies at the $stage/$suffix activation fence"
    chmod 0600 -- "$smoke_namespace" "$smoke_network_policies"
    jq -e '
      .metadata.name == "etcdetcetc-smoke" and
      .metadata.deletionTimestamp == null
    ' "$smoke_namespace" >/dev/null ||
      die "smoke Namespace is absent or terminating at the $stage/$suffix activation fence"
    jq -e '
      (.items | length) == 1 and
      .items[0].metadata.name == "default-deny" and
      .items[0].metadata.namespace == "etcdetcetc-smoke" and
      .items[0].metadata.deletionTimestamp == null and
      .items[0].spec == {
        podSelector: {}, policyTypes: ["Egress", "Ingress"]
      }
    ' "$smoke_network_policies" >/dev/null ||
      die "smoke NetworkPolicy set changed at the $stage/$suffix activation fence"
    for resource in \
      secret/fabric-smoke-etcd \
      configmap/fabric-smoke-etcd; do
      object_name=$(operator_kubectl --namespace etcdetcetc-smoke get "$resource" \
        --ignore-not-found --output=name) ||
        die "cannot prove smoke artifact absent at the $stage/$suffix fence: $resource"
      [[ -z $object_name ]] ||
        die "smoke artifact appeared at the $stage/$suffix activation fence: $resource"
    done
    for crd in \
      etcdclusters.etcdetcetc.samcday.com \
      etcdtenants.etcdetcetc.samcday.com; do
      object_name=$(operator_kubectl get customresourcedefinition "$crd" \
        --ignore-not-found --output=name) ||
        die "cannot prove runtime CRD absent at the $stage/$suffix fence: $crd"
      [[ -z $object_name ]] ||
        die "runtime CRD appeared at the $stage/$suffix activation fence: $crd"
    done
  done
  assert_cluster_network_lock_exact
}

check_committed_root_firewall() {
  local output=$evidence_dir/committed-root-firewall.txt
  local stderr=$evidence_dir/committed-root-firewall.stderr
  if ! "$repo_root/scripts/rollout-fabric-root-firewall" --check \
      >"$output" 2>"$stderr"; then
    chmod 0600 -- "$output" "$stderr" 2>/dev/null || true
    die 'committed root firewall contract is invalid'
  fi
  chmod 0600 -- "$output" "$stderr"
}

probe_fabric_api() {
  local stage=$1 output=$evidence_dir/fabric-readyz-$1
  if operator_kubectl get --raw=/readyz >"$output" 2>"$output.stderr" &&
      [[ $(<"$output") == ok ]]; then
    chmod 0600 -- "$output" "$output.stderr"
    printf 'FABRIC_API_%s=ready\n' "$stage" >>"$evidence_dir/fence-api-state.txt"
    return 0
  fi
  chmod 0600 -- "$output" "$output.stderr" 2>/dev/null || true
  printf 'FABRIC_API_%s=unavailable\n' "$stage" >>"$evidence_dir/fence-api-state.txt"
  return 1
}

try_acquire_fence_cluster_lock() {
  local created current_holder
  if created=$(operator_kubectl --namespace kube-system create configmap \
      "$fabric_network_cluster_lock" \
      --from-literal="holder=$cluster_lock_holder" --output=json \
      2>"$evidence_dir/fence-cluster-lock-create.stderr"); then
    chmod 0600 -- "$evidence_dir/fence-cluster-lock-create.stderr"
    if ! jq -e --arg holder "$cluster_lock_holder" '
        .apiVersion == "v1" and
        .kind == "ConfigMap" and
        .metadata.name == "fabric-maintenance-lock" and
        .metadata.namespace == "kube-system" and
        .metadata.deletionTimestamp == null and
        (.metadata.uid | type == "string" and length > 0) and
        (.metadata.resourceVersion | type == "string" and test("^[0-9]+$")) and
        .data == {holder: $holder}
      ' <<<"$created" >/dev/null; then
      die 'created fence maintenance lock has an unexpected identity or shape'
    fi
    cluster_lock_uid=$(jq -er '.metadata.uid' <<<"$created") ||
      die 'cannot record fence maintenance lock UID'
    cluster_lock_resource_version=$(jq -er '.metadata.resourceVersion' <<<"$created") ||
      die 'cannot record fence maintenance lock resourceVersion'
    cluster_lock_held=true
    printf 'FENCE_CLUSTER_LOCK=acquired\n' \
      >"$evidence_dir/fence-cluster-lock-state.txt"
    return 0
  fi
  chmod 0600 -- "$evidence_dir/fence-cluster-lock-create.stderr" 2>/dev/null || true
  current_holder=$(operator_kubectl --namespace kube-system get configmap \
    "$fabric_network_cluster_lock" --output=jsonpath='{.data.holder}' \
    2>/dev/null || true)
  [[ -n $current_holder ]] || current_holder=unavailable
  printf 'FENCE_CLUSTER_LOCK=not-acquired\nEXISTING_HOLDER=%s\n' \
    "$current_holder" >"$evidence_dir/fence-cluster-lock-state.txt"
  chmod 0600 -- "$evidence_dir/fence-cluster-lock-state.txt"
  cluster_lock_held=false
  cluster_lock_uid=
  cluster_lock_resource_version=
  return 1
}

observer_verify() {
  timeout --kill-after=2s 15s \
    "$repo_root/fabric/observer/fabric-observer-netns" verify-isolation >/dev/null
}

prepare_router_ssh() {
  local extra scanned_fingerprint scanned_host scanned_key scanned_type
  if ! timeout --kill-after=2s 10s \
      ip netns exec "$observer_namespace" ssh-keyscan -4 -T 5 -t ed25519 \
      "$router_address" >"$router_known_hosts" 2>"$evidence_dir/router-keyscan.stderr"; then
    die 'router ED25519 host-key scan failed'
  fi
  chmod 0600 -- "$router_known_hosts" "$evidence_dir/router-keyscan.stderr"
  mapfile -t scanned_keys < <(grep -Ev '^[[:space:]]*(#|$)' "$router_known_hosts")
  [[ ${#scanned_keys[@]} -eq 1 ]] || die 'router scan did not return exactly one ED25519 key'
  read -r scanned_host scanned_type scanned_key extra <<<"${scanned_keys[0]}"
  [[ $scanned_host == "$router_address" && $scanned_type == ssh-ed25519 &&
     -n $scanned_key && -z ${extra:-} ]] || die 'router key scan returned an unexpected record'
  scanned_fingerprint=$(ssh-keygen -E sha256 -lf "$router_known_hosts" |
    awk 'NR == 1 { print $2 }')
  [[ $scanned_fingerprint == "$serial_fingerprint" ]] ||
    die 'router key scan does not match the attended serial fingerprint'

  router_ssh_options=(
    -F none
    -o BatchMode=yes
    -o StrictHostKeyChecking=yes
    -o HostKeyAlgorithms=ssh-ed25519
    -o UpdateHostKeys=no
    -o AddressFamily=inet
    -o GlobalKnownHostsFile=/dev/null
    -o "UserKnownHostsFile=$router_known_hosts"
    -o KnownHostsCommand=none
    -o ForwardAgent=no
    -o ClearAllForwardings=yes
    -o ProxyCommand=none
    -o ProxyJump=none
    -o ControlMaster=no
    -o ControlPath=none
    -o IdentityAgent=none
    -o IdentitiesOnly=yes
    -o PasswordAuthentication=no
    -o KbdInteractiveAuthentication=no
    -o PreferredAuthentications=publickey
    -o RequestTTY=no
    -o PermitLocalCommand=no
    -o ConnectTimeout=5
    -o LogLevel=ERROR
    -i "$identity"
  )
}

router_ssh() {
  timeout --kill-after=3s 30s \
    ip netns exec "$observer_namespace" ssh "${router_ssh_options[@]}" \
    "root@$router_address" "$@"
}

inspect_post_open_probe() {
  local output=$evidence_dir/router-tables-$1.txt tables
  router_ssh /usr/sbin/nft list tables >"$output" ||
    die 'cannot enumerate router nftables tables while checking post-open observer residue'
  chmod 0600 -- "$output"
  tables=$(LC_ALL=C sort <"$output")
  case $tables in
    'table inet fw4')
      post_open_probe_present=false
      return 0
      ;;
    "table inet $post_open_probe_table
table inet fw4")
      ;;
    *) die 'router has an unknown nftables table; refuse emergency cleanup' ;;
  esac

  router_ssh /bin/sh -s -- "$post_open_probe_table" \
    >"$evidence_dir/post-open-probe-$1.txt" <<'REMOTE_VALIDATE_POST_OPEN_PROBE'
set -eu
table=$1

fail() {
  printf 'post-open observer residue validation failed: %s\n' "$*" >&2
  exit 1
}

[ "$table" = fabric_etcd_post_open_probe ] || fail 'unexpected table name'
live=$(nft -a list table inet "$table") || fail 'observer table is absent'
[ "$(printf '%s\n' "$live" | awk 'NF { n++ } END { print n + 0 }')" -eq 11 ] ||
  fail 'observer table contains an extra table-level object or line'
[ "$(printf '%s\n' "$live" | sed -n '1{s/ # handle [0-9][0-9]*$//;p}')" = \
  'table inet fabric_etcd_post_open_probe {' ] ||
  fail 'observer table header is not exact'
chains=$(printf '%s\n' "$live" |
  sed -n 's/^[[:space:]]*chain \([^[:space:]]*\) {.*/\1/p')
[ "$chains" = observe_forward ] || fail 'observer chain membership is not exact'
base=$(printf '%s\n' "$live" | sed -n \
  's/^[[:space:]]*\(type filter hook forward priority .*; policy accept;\).*$/\1/p')
case $base in
  'type filter hook forward priority -10; policy accept;'|'type filter hook forward priority filter - 10; policy accept;') ;;
  *) fail 'observer base-chain hook or priority is not exact' ;;
esac
rules=$(printf '%s\n' "$live" | awk '
  $1 == "chain" && $2 == "observe_forward" && $3 == "{" { inside = 1; next }
  inside && $1 == "}" { inside = 0 }
  inside && $0 !~ /^[[:space:]]*type / && /# handle [0-9]+$/ { print }
')
[ "$(printf '%s\n' "$rules" | awk 'NF { n++ } END { print n + 0 }')" -eq 6 ] ||
  fail 'observer rule membership is not exactly six'

assert_rule() {
  source=$1
  port=$2
  marker=$3
  matches=$(printf '%s\n' "$rules" | grep -F "comment \"$marker\"") ||
    fail "observer rule is absent: $marker"
  [ "$(printf '%s\n' "$matches" | awk 'NF { n++ } END { print n + 0 }')" -eq 1 ] ||
    fail "observer rule count is not one: $marker"
  normalized=$(printf '%s\n' "$matches" | sed \
    -e 's/^[[:space:]]*//' \
    -e 's/[[:space:]][[:space:]]*/ /g' \
    -e 's/counter packets [0-9][0-9]* bytes [0-9][0-9]*/counter/' \
    -e 's/ # handle [0-9][0-9]*$//')
  destinations=$(printf '%s\n' "$normalized" |
    sed -n 's/.* ip daddr { \([^}]*\) } tcp .*/\1/p' | tr ',' '\n' |
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | LC_ALL=C sort |
    awk 'NF { value = value separator $0; separator = "," } END { print value }')
  [ "$destinations" = '10.66.0.10,10.66.0.11,10.66.0.12' ] ||
    fail "observer destinations are not exact: $marker"
  shape=$(printf '%s\n' "$normalized" |
    sed 's/ip daddr { [^}]* }/ip daddr { ROOTS }/')
  [ "$shape" = "ip saddr $source ip daddr { ROOTS } tcp dport $port counter comment \"$marker\"" ] ||
    fail "observer rule contains a verdict or unexpected expression: $marker"
}

assert_rule 10.66.1.10 2379 'observe svc1 etcd client; no verdict'
assert_rule 10.66.1.10 2380 'observe svc1 etcd peer; no verdict'
assert_rule 10.66.1.10 2381 'observe svc1 etcd metrics; no verdict'
assert_rule 10.66.1.11 2379 'observe svc2 etcd client; no verdict'
assert_rule 10.66.1.11 2380 'observe svc2 etcd peer; no verdict'
assert_rule 10.66.1.11 2381 'observe svc2 etcd metrics; no verdict'
printf 'POST_OPEN_PROBE_RESIDUE=exact-no-verdict\n'
REMOTE_VALIDATE_POST_OPEN_PROBE
  chmod 0600 -- "$evidence_dir/post-open-probe-$1.txt"
  post_open_probe_present=true
}

remove_exact_post_open_probe() {
  inspect_post_open_probe before-removal
  if $post_open_probe_present; then
    if ! router_ssh /usr/sbin/nft delete table inet "$post_open_probe_table"; then
      inspect_post_open_probe removal-race
      $post_open_probe_present &&
        die 'cannot remove exact failed post-open observer after fencing'
    fi
    inspect_post_open_probe after-removal
    $post_open_probe_present &&
      die 'exact failed post-open observer survived attended removal'
    note 'Removed or observed concurrent removal of the exact verdict-free failed post-open observer.'
  fi
}

validate_committed_transition() {
  local actual_hash allow_line api_line internal_line line
  [[ -f $transition_file && ! -L $transition_file ]] ||
    die 'committed router transition must be a regular, non-symlink file'
  [[ $(stat -Lc '%a:%F:%h' -- "$transition_file") == '644:regular file:1' ]] ||
    die 'committed router transition must be mode-0644 and single-link'
  actual_hash=$(sha256sum -- "$transition_file" | awk '{print $1}')
  [[ $actual_hash == "$transition_sha256" ]] ||
    die 'committed router transition differs from the reviewed exact payload'
  [[ $(wc -l <"$transition_file") -eq 28 ]] ||
    die 'committed router transition has an unexpected command count'
  [[ $(sed -n '1p' "$transition_file") == \
      'delete firewall.fabric_flat_reject_services_etcd' ]] ||
    die 'router transition must begin by deleting the exact legacy reject'
  while IFS= read -r line; do
    [[ -n $line ]] || die 'router transition contains a blank command'
    if [[ $line == 'delete firewall.fabric_flat_reject_services_etcd' ]]; then
      continue
    fi
    [[ $line == set\ firewall.* || $line == add_list\ firewall.* ]] ||
      die 'router transition contains an operation outside the firewall package'
    [[ $(grep -Fxc -- "$line" "$desired_overlay") -eq 1 ]] ||
      die "router transition command is not unique in the desired overlay: $line"
  done <"$transition_file"
  ! grep -Fq 'firewall.fabric_flat_reject_services_etcd.' "$desired_overlay" ||
    die 'desired router overlay still contains the legacy all-port reject'
  allow_line=$(grep -nF \
    "set firewall.fabric_flat_services_etcd_client='rule'" "$desired_overlay" |
    awk -F: 'NR == 1 { print $1 }')
  internal_line=$(grep -nF \
    "set firewall.fabric_flat_reject_services_etcd_internal='rule'" "$desired_overlay" |
    awk -F: 'NR == 1 { print $1 }')
  api_line=$(grep -nF "set firewall.fabric_flat_services_api='rule'" "$desired_overlay" |
    awk -F: 'NR == 1 { print $1 }')
  [[ $allow_line =~ ^[0-9]+$ && $internal_line =~ ^[0-9]+$ && $api_line =~ ^[0-9]+$ &&
     $allow_line -lt $internal_line && $internal_line -lt $api_line ]] ||
    die 'desired router etcd allow/reject ordering is not exact'
}

validate_remote_phase() {
  local phase=$1 output=$2 allow_probe=false
  case $mode:$phase in
    fence-*:open-live) allow_probe=true ;;
  esac
  router_ssh /bin/sh -s -- "$phase" "$fence_remote_guard" \
    "$fence_guard_sha256" "$fence_remote_work" "$fence_remote_init" \
    "$fence_remote_operation_lock" "$allow_probe" "$remote_work" "$remote_init" \
    >"$output" <<'REMOTE_VALIDATE'
set -eu

phase=$1
fence_guard=$2
fence_guard_sha=$3
fence_work=$4
fence_init=$5
fence_operation_lock=$6
allow_post_open_probe=$7
rollback_work=$8
rollback_init=$9

fail() {
  printf 'remote router phase validation failed: %s\n' "$*" >&2
  exit 1
}

[ "$fence_operation_lock" = /tmp/fabric-router-etcd-policy-fence.operation ] ||
  fail 'router-local fence operation-lock path is not exact'

assert_uci() {
  key=$1
  wanted=$2
  actual=$(uci -q get "$key") || fail "missing UCI key $key"
  [ "$actual" = "$wanted" ] || fail "unexpected UCI value for $key"
}

assert_uci_absent() {
  key=$1
  if uci -q get "$key" >/dev/null 2>&1; then
    fail "UCI key must be absent: $key"
  fi
}

assert_option_keys() {
  section=$1
  wanted=$2
  actual=$(uci -q show firewall |
    sed -n "s/^firewall\\.$section\\.\\([^=]*\\)=.*/\\1/p" |
    LC_ALL=C sort | tr '\n' ' ' | sed 's/ $//')
  [ "$actual" = "$wanted" ] || fail "unexpected option keys for $section: $actual"
}

sections_of_type() {
  uci -q show firewall | sed -n "s/^firewall\\.\\([^.=]*\\)=$1$/\\1/p"
}

assert_target_section() {
  section=$1
  name=$2
  ports=$3
  target=$4
  assert_uci "firewall.$section" rule
  assert_option_keys "$section" 'dest dest_ip dest_port family name proto src src_ip target'
  assert_uci "firewall.$section.name" "$name"
  assert_uci "firewall.$section.src" lan
  assert_uci "firewall.$section.dest" lan
  assert_uci "firewall.$section.family" ipv4
  assert_uci "firewall.$section.src_ip" '10.66.1.10/32 10.66.1.11/32'
  assert_uci "firewall.$section.dest_ip" '10.66.0.10/32 10.66.0.11/32 10.66.0.12/32'
  assert_uci "firewall.$section.proto" tcp
  assert_uci "firewall.$section.dest_port" "$ports"
  assert_uci "firewall.$section.target" "$target"
}

assert_live_rule() {
  rule_name=$1
  verdict=$2
  require_zero=$3
  marker="comment \"!fw4: $rule_name\""
  matches=$(printf '%s\n' "$live_chain" | grep -F "$marker") ||
    fail "live target rule is absent: $rule_name"
  count=$(printf '%s\n' "$matches" | awk 'NF { n++ } END { print n + 0 }')
  [ "$count" -eq 1 ] || fail "live target rule count is not one: $rule_name"
  printf '%s\n' "$matches" | grep -F 'ip saddr' >/dev/null ||
    fail "live target rule lacks source match: $rule_name"
  printf '%s\n' "$matches" | grep -F 'ip daddr' >/dev/null ||
    fail "live target rule lacks destination match: $rule_name"
  printf '%s\n' "$matches" | grep -E 'counter packets [0-9]+ bytes [0-9]+' >/dev/null ||
    fail "live target rule lacks an anonymous counter: $rule_name"
  normalized=$(printf '%s\n' "$matches" | sed \
    -e 's/^[[:space:]]*//' \
    -e 's/[[:space:]][[:space:]]*/ /g' \
    -e 's/counter packets [0-9][0-9]* bytes [0-9][0-9]*/counter/' \
    -e 's/ # handle [0-9][0-9]*$//')
  case $normalized in
    *" counter $verdict $marker") ;;
    *) fail "live target rule has unexpected verdict: $rule_name" ;;
  esac
  packets=$(printf '%s\n' "$matches" |
    sed -n 's/.*counter packets \([0-9][0-9]*\) bytes [0-9][0-9]*.*/\1/p')
  bytes=$(printf '%s\n' "$matches" |
    sed -n 's/.*counter packets [0-9][0-9]* bytes \([0-9][0-9]*\).*/\1/p')
  [ -n "$packets" ] && [ -n "$bytes" ] || fail "cannot parse target counter: $rule_name"
  if [ "$require_zero" = yes ]; then
    [ "$packets" -eq 0 ] && [ "$bytes" -eq 0 ] ||
      fail "new target rule saw traffic before acceptance: $rule_name"
  fi
  printf 'TARGET_COUNTER name=%s packets=%s bytes=%s\n' "$rule_name" "$packets" "$bytes"
}

assert_live_absent() {
  rule_name=$1
  if printf '%s\n' "$live_table" | grep -F "comment \"!fw4: $rule_name\"" >/dev/null; then
    fail "obsolete live target rule is present: $rule_name"
  fi
}

assert_fence_guard_absent() {
  [ ! -e "$fence_guard" ] && [ ! -L "$fence_guard" ] ||
    fail 'persistent fence guard is present outside the fenced phase'
  share_nft_files=$(find /usr/share/nftables.d -name '*.nft' -print | LC_ALL=C sort)
  [ -z "$share_nft_files" ] || fail 'unexpected automatic nftables include is present'
  if printf '%s\n' "$live_table" |
      grep -F 'comment "fabric etcd fence ' >/dev/null; then
    fail 'live early fence rule is present outside the fenced phase'
  fi
}

assert_stock_top_level_includes() {
  etc_nft_files=$(find /etc/nftables.d -mindepth 1 -maxdepth 1 \
    -name '*.nft' -print | LC_ALL=C sort)
  [ "$etc_nft_files" = '/etc/nftables.d/10-custom-filter-chains.nft' ] ||
    fail 'top-level nftables include membership is not the stock template only'
  [ -f /etc/nftables.d/10-custom-filter-chains.nft ] &&
    [ ! -L /etc/nftables.d/10-custom-filter-chains.nft ] ||
    fail 'stock top-level nftables include is missing or unsafe'
  active_etc_nft=$(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' \
    /etc/nftables.d/10-custom-filter-chains.nft)
  [ -z "$active_etc_nft" ] || fail 'stock top-level nftables include is executable'
}

assert_fence_artifacts_absent() {
  [ ! -e "$fence_work" ] && [ ! -L "$fence_work" ] ||
    fail 'persistent fence work path is present outside the fenced phase'
  [ ! -e "$fence_work.staging" ] && [ ! -L "$fence_work.staging" ] ||
    fail 'persistent fence staging path is present outside the fenced phase'
  [ ! -e "$fence_init" ] && [ ! -L "$fence_init" ] ||
    fail 'persistent fence init path is present outside the fenced phase'
  [ ! -e "$fence_init.next" ] && [ ! -L "$fence_init.next" ] ||
    fail 'persistent fence init staging path is present outside the fenced phase'
  [ ! -e "$fence_operation_lock" ] && [ ! -L "$fence_operation_lock" ] ||
    fail 'router-local fence operation lock is present outside the fenced phase'
  if find /etc/rc.d -maxdepth 1 -type l \
      -name '*fabric-router-etcd-policy-fence' | grep . >/dev/null; then
    fail 'persistent fence service is enabled outside the fenced phase'
  fi
}

assert_fence_guard_rule() {
  marker=$1
  port_field=$2
  wanted_sources=$3
  wanted_destinations=$4
  matches=$(printf '%s\n' "$live_forward" | grep -F "comment \"$marker\"") ||
    fail "live early fence rule is absent: $marker"
  count=$(printf '%s\n' "$matches" | awk 'NF { n++ } END { print n + 0 }')
  [ "$count" -eq 1 ] || fail "live early fence rule count is not one: $marker"
  normalized=$(printf '%s\n' "$matches" | sed \
    -e 's/^[[:space:]]*//' \
    -e 's/[[:space:]][[:space:]]*/ /g' \
    -e 's/counter packets [0-9][0-9]* bytes [0-9][0-9]*/counter/' \
    -e 's/ # handle [0-9][0-9]*$//')
  source_members=$(printf '%s\n' "$normalized" |
    sed -n 's/^ip saddr { \([^}]*\) } ip daddr.*/\1/p')
  destination_members=$(printf '%s\n' "$normalized" |
    sed -n 's/.* ip daddr { \([^}]*\) } tcp .*/\1/p')
  [ -n "$source_members" ] && [ -n "$destination_members" ] ||
    fail "cannot parse live early fence endpoint sets: $marker"
  source_members=$(printf '%s\n' "$source_members" | tr ',' '\n' |
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | LC_ALL=C sort |
    awk 'NF { value = value separator $0; separator = "," } END { print value }')
  destination_members=$(printf '%s\n' "$destination_members" | tr ',' '\n' |
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | LC_ALL=C sort |
    awk 'NF { value = value separator $0; separator = "," } END { print value }')
  [ "$source_members" = "$wanted_sources" ] ||
    fail "live early fence source set is not exact: $marker"
  [ "$destination_members" = "$wanted_destinations" ] ||
    fail "live early fence destination set is not exact: $marker"
  shape=$(printf '%s\n' "$normalized" | sed \
    -e 's/ip saddr { [^}]* }/ip saddr { SOURCE }/' \
    -e 's/ip daddr { [^}]* }/ip daddr { DESTINATION }/')
  [ "$shape" = "ip saddr { SOURCE } ip daddr { DESTINATION } tcp $port_field 2379 counter drop comment \"$marker\"" ] ||
    fail "live early fence rule shape or verdict is not exact: $marker"
}

assert_fence_guard() {
  [ -f "$fence_guard" ] && [ ! -L "$fence_guard" ] ||
    fail 'persistent fence guard is missing or unsafe'
  [ "$(stat -c '%u:%g:%a:%h:%F' "$fence_guard")" = \
    '0:0:600:1:regular file' ] || fail 'persistent fence guard metadata is unsafe'
  [ "$(sha256sum "$fence_guard" | awk '{print $1}')" = "$fence_guard_sha" ] ||
    fail 'persistent fence guard differs from the reviewed payload'
  share_nft_files=$(find /usr/share/nftables.d -name '*.nft' -print | LC_ALL=C sort)
  [ "$share_nft_files" = "$fence_guard" ] ||
    fail 'automatic nftables include membership is not exactly the fence guard'
  [ -d "$fence_work" ] && [ ! -L "$fence_work" ] ||
    fail 'persistent fence work path is missing or unsafe'
  [ ! -e "$fence_work.staging" ] && [ ! -L "$fence_work.staging" ] ||
    fail 'persistent fence staging path survived promotion'
  [ -f "$fence_init" ] && [ ! -L "$fence_init" ] ||
    fail 'persistent fence init path is missing or unsafe'
  [ ! -e "$fence_init.next" ] && [ ! -L "$fence_init.next" ] ||
    fail 'persistent fence init staging path survived installation'
  [ ! -e "$fence_operation_lock" ] && [ ! -L "$fence_operation_lock" ] ||
    fail 'router-local fence operation lock survived staging'
  live_fence_rules=$(printf '%s\n' "$live_table" |
    grep -F 'comment "fabric etcd fence ' || true)
  [ "$(printf '%s\n' "$live_fence_rules" | awk 'NF { n++ } END { print n + 0 }')" -eq 2 ] ||
    fail 'live early fence rule membership is not exactly two'
  service_members='10.66.1.10,10.66.1.11'
  root_members='10.66.0.10,10.66.0.11,10.66.0.12'
  assert_fence_guard_rule 'fabric etcd fence client requests' dport \
    "$service_members" "$root_members"
  assert_fence_guard_rule 'fabric etcd fence server replies' sport \
    "$root_members" "$service_members"
  request_line=$(printf '%s\n' "$live_forward" |
    grep -nF 'comment "fabric etcd fence client requests"' | cut -d: -f1)
  reply_line=$(printf '%s\n' "$live_forward" |
    grep -nF 'comment "fabric etcd fence server replies"' | cut -d: -f1)
  executable_lines=$(printf '%s\n' "$live_forward" | awk '
    $1 == "chain" && $2 == "forward" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && $0 !~ /^[[:space:]]*type / && /# handle [0-9]+$/ { print NR ":" $0 }
  ')
  first_rule_line=$(printf '%s\n' "$executable_lines" | sed -n '1s/:.*//p')
  second_rule_line=$(printf '%s\n' "$executable_lines" | sed -n '2s/:.*//p')
  first_accept_line=$(printf '%s\n' "$executable_lines" |
    grep 'accept.*# handle [0-9][0-9]*$' | sed -n '1s/:.*//p')
  case "$request_line:$reply_line:$first_rule_line:$second_rule_line:$first_accept_line" in
    *[!0-9:]*|*::*|:*|*:) fail 'cannot resolve exact early fence rule order' ;;
  esac
  [ "$request_line" -eq "$first_rule_line" ] &&
    [ "$reply_line" -eq "$second_rule_line" ] ||
    fail 'fence drops are not the first two executable forward rules'
  [ "$request_line" -lt "$first_accept_line" ] &&
    [ "$reply_line" -lt "$first_accept_line" ] ||
    fail 'fence drops do not precede every forward accept'
}

assert_rollback_guard() {
  [ -f "$fence_guard" ] && [ ! -L "$fence_guard" ] ||
    fail 'rollback guard is missing or unsafe'
  [ "$(stat -c '%u:%g:%a:%h:%F' "$fence_guard")" = \
    '0:0:600:1:regular file' ] || fail 'rollback guard metadata is unsafe'
  [ "$(sha256sum "$fence_guard" | awk '{print $1}')" = "$fence_guard_sha" ] ||
    fail 'rollback guard differs from the reviewed payload'
  share_nft_files=$(find /usr/share/nftables.d -name '*.nft' -print | LC_ALL=C sort)
  [ "$share_nft_files" = "$fence_guard" ] ||
    fail 'automatic nftables include membership is not exactly the rollback guard'
  [ -d "$rollback_work" ] && [ ! -L "$rollback_work" ] ||
    fail 'rollback work path is missing or unsafe'
  [ -f "$rollback_init" ] && [ ! -L "$rollback_init" ] ||
    fail 'rollback init path is missing or unsafe'
  [ -f "$rollback_work/owner" ] && [ ! -L "$rollback_work/owner" ] &&
    [ "$(cat "$rollback_work/owner")" = fabric-router-etcd-policy-rollout ] ||
    fail 'rollback owner marker is unsafe'
  [ -f "$rollback_work/expected-token" ] &&
    [ -f "$rollback_work/armed" ] &&
    [ "$(cat "$rollback_work/expected-token")" = \
      "$(cat "$rollback_work/armed")" ] || fail 'rollback token is unsafe'
  token=$(cat "$rollback_work/expected-token")
  for marker in apply-started apply-finished; do
    [ -f "$rollback_work/$marker" ] && [ ! -L "$rollback_work/$marker" ] &&
      [ "$(cat "$rollback_work/$marker")" = "$token" ] ||
      fail "rollback marker is unsafe: $marker"
  done
  [ ! -e "$rollback_work/terminal" ] && [ ! -L "$rollback_work/terminal" ] ||
    fail 'rollback watchdog already chose a terminal state'
  [ ! -e "$rollback_work/fenced" ] && [ ! -L "$rollback_work/fenced" ] ||
    fail 'rollback watchdog already acknowledged a fence'
  cmp -s "$rollback_work/early-guard.nft" "$fence_guard" ||
    fail 'installed rollback guard differs from its staged source'
  "$rollback_init" enabled || fail 'rollback watchdog is not enabled'
  "$rollback_init" running || fail 'rollback watchdog is not running'
  assert_fence_artifacts_absent
  live_fence_rules=$(printf '%s\n' "$live_table" |
    grep -F 'comment "fabric etcd fence ' || true)
  [ "$(printf '%s\n' "$live_fence_rules" | awk 'NF { n++ } END { print n + 0 }')" -eq 2 ] ||
    fail 'live rollback guard rule membership is not exactly two'
  service_members='10.66.1.10,10.66.1.11'
  root_members='10.66.0.10,10.66.0.11,10.66.0.12'
  assert_fence_guard_rule 'fabric etcd fence client requests' dport \
    "$service_members" "$root_members"
  assert_fence_guard_rule 'fabric etcd fence server replies' sport \
    "$root_members" "$service_members"
  request_line=$(printf '%s\n' "$live_forward" |
    grep -nF 'comment "fabric etcd fence client requests"' | cut -d: -f1)
  reply_line=$(printf '%s\n' "$live_forward" |
    grep -nF 'comment "fabric etcd fence server replies"' | cut -d: -f1)
  executable_lines=$(printf '%s\n' "$live_forward" | awk '
    $1 == "chain" && $2 == "forward" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && $0 !~ /^[[:space:]]*type / && /# handle [0-9]+$/ { print NR ":" $0 }
  ')
  first_rule_line=$(printf '%s\n' "$executable_lines" | sed -n '1s/:.*//p')
  second_rule_line=$(printf '%s\n' "$executable_lines" | sed -n '2s/:.*//p')
  first_accept_line=$(printf '%s\n' "$executable_lines" |
    grep 'accept.*# handle [0-9][0-9]*$' | sed -n '1s/:.*//p')
  case "$request_line:$reply_line:$first_rule_line:$second_rule_line:$first_accept_line" in
    *[!0-9:]*|*::*|:*|*:) fail 'cannot resolve exact rollback guard rule order' ;;
  esac
  [ "$request_line" -eq "$first_rule_line" ] &&
    [ "$reply_line" -eq "$second_rule_line" ] ||
    fail 'rollback drops are not the first two executable forward rules'
  [ "$request_line" -lt "$first_accept_line" ] &&
    [ "$reply_line" -lt "$first_accept_line" ] ||
    fail 'rollback drops do not precede every forward accept'
}

assert_exact_post_open_probe() {
  probe=$(nft -a list table inet fabric_etcd_post_open_probe) ||
    fail 'failed post-open observer disappeared during exact validation'
  [ "$(printf '%s\n' "$probe" | awk 'NF { n++ } END { print n + 0 }')" -eq 11 ] ||
    fail 'failed post-open observer has an extra table-level object or line'
  [ "$(printf '%s\n' "$probe" |
    sed -n '1{s/ # handle [0-9][0-9]*$//;p}')" = \
    'table inet fabric_etcd_post_open_probe {' ] ||
    fail 'failed post-open observer table header is not exact'
  probe_chains=$(printf '%s\n' "$probe" |
    sed -n 's/^[[:space:]]*chain \([^[:space:]]*\) {.*/\1/p')
  [ "$probe_chains" = observe_forward ] ||
    fail 'failed post-open observer chain membership is not exact'
  probe_base=$(printf '%s\n' "$probe" | sed -n \
    's/^[[:space:]]*\(type filter hook forward priority .*; policy accept;\).*$/\1/p')
  case $probe_base in
    'type filter hook forward priority -10; policy accept;'|'type filter hook forward priority filter - 10; policy accept;') ;;
    *) fail 'failed post-open observer hook or priority is not exact' ;;
  esac
  probe_rules=$(printf '%s\n' "$probe" | awk '
    $1 == "chain" && $2 == "observe_forward" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && $0 !~ /^[[:space:]]*type / && /# handle [0-9]+$/ { print }
  ')
  [ "$(printf '%s\n' "$probe_rules" |
    awk 'NF { n++ } END { print n + 0 }')" -eq 6 ] ||
    fail 'failed post-open observer rule membership is not exactly six'

  assert_probe_rule() {
    source=$1
    port=$2
    marker=$3
    matches=$(printf '%s\n' "$probe_rules" | grep -F "comment \"$marker\"") ||
      fail "failed post-open observer rule is absent: $marker"
    [ "$(printf '%s\n' "$matches" |
      awk 'NF { n++ } END { print n + 0 }')" -eq 1 ] ||
      fail "failed post-open observer rule count is not one: $marker"
    normalized=$(printf '%s\n' "$matches" | sed \
      -e 's/^[[:space:]]*//' \
      -e 's/[[:space:]][[:space:]]*/ /g' \
      -e 's/counter packets [0-9][0-9]* bytes [0-9][0-9]*/counter/' \
      -e 's/ # handle [0-9][0-9]*$//')
    destinations=$(printf '%s\n' "$normalized" |
      sed -n 's/.* ip daddr { \([^}]*\) } tcp .*/\1/p' | tr ',' '\n' |
      sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | LC_ALL=C sort |
      awk 'NF { value = value separator $0; separator = "," } END { print value }')
    [ "$destinations" = '10.66.0.10,10.66.0.11,10.66.0.12' ] ||
      fail "failed post-open observer destinations are not exact: $marker"
    shape=$(printf '%s\n' "$normalized" |
      sed 's/ip daddr { [^}]* }/ip daddr { ROOTS }/')
    [ "$shape" = "ip saddr $source ip daddr { ROOTS } tcp dport $port counter comment \"$marker\"" ] ||
      fail "failed post-open observer contains a verdict or unexpected expression: $marker"
  }

  assert_probe_rule 10.66.1.10 2379 'observe svc1 etcd client; no verdict'
  assert_probe_rule 10.66.1.10 2380 'observe svc1 etcd peer; no verdict'
  assert_probe_rule 10.66.1.10 2381 'observe svc1 etcd metrics; no verdict'
  assert_probe_rule 10.66.1.11 2379 'observe svc2 etcd client; no verdict'
  assert_probe_rule 10.66.1.11 2380 'observe svc2 etcd peer; no verdict'
  assert_probe_rule 10.66.1.11 2381 'observe svc2 etcd metrics; no verdict'
}

pending=$(uci -q changes firewall || true)
[ -z "$pending" ] || fail 'firewall has pending uncommitted UCI changes'
fw4 check >/dev/null || fail 'fw4 rejects the current UCI configuration'
assert_stock_top_level_includes
live_tables=$(nft list tables | LC_ALL=C sort)
if [ "$allow_post_open_probe" = true ] && [ "$phase" = open-live ]; then
  case $live_tables in
    'table inet fw4') ;;
    'table inet fabric_etcd_post_open_probe
table inet fw4') assert_exact_post_open_probe ;;
    *) fail 'live nftables table membership is not exact' ;;
  esac
else
  [ "$live_tables" = 'table inet fw4' ] ||
    fail 'live nftables table membership is not exact'
fi
live_table=$(nft -a list table inet fw4) || fail 'live inet fw4 table is absent'
live_chain=$(nft -a list chain inet fw4 forward_lan) || fail 'live forward_lan chain is absent'
live_forward=$(nft -a list chain inet fw4 forward) || fail 'live forward chain is absent'

common_prefix='fabric_wan_dhcp_reply
fabric_reject_other_wan_input
fabric_block_private
fabric_root_egress
fabric_services_egress
fabric_reject_other_fabric_to_wan
fabric_reject_wan_to_fabric'
common_suffix='fabric_flat_services_api
fabric_flat_services_vxlan
fabric_flat_roots_vxlan
fabric_flat_services_kubelet
fabric_flat_roots_kubelet
fabric_flat_observer_services_ssh
fabric_flat_services_bootie_rootfs
fabric_flat_reject_services_roots
fabric_flat_reject_roots_services
fabric_router_dns
fabric_router_ntp
fabric_router_http
fabric_router_services_dns
fabric_router_services_ntp
fabric_router_services_http
fabric_router_ssh
fabric_reject_other_fabric_router_input'
forward_prefix='Block-fabric-to-private-WAN
Allow-roots-to-public-WAN
Allow-services-to-public-Web
Reject-other-fabric-to-WAN'
forward_suffix='Allow-services-to-fabric-API
Allow-services-to-root-VXLAN
Allow-roots-to-services-VXLAN
Allow-services-to-root-kubelets
Allow-roots-to-service-kubelets
Allow-observer-to-services-SSH
Allow-services-to-Bootie-rootfs
Reject-other-services-to-roots
Reject-other-roots-to-services'

case $phase in
  pre | fenced)
    expected_rules="$common_prefix
fabric_flat_reject_services_etcd
$common_suffix"
    expected_forward="$forward_prefix
Reject-services-to-root-etcd
$forward_suffix"
    expected_rule_count=25
    expected_chain_count=15
    assert_target_section fabric_flat_reject_services_etcd \
      Reject-services-to-root-etcd '2379 2380 2381' REJECT
    assert_uci_absent firewall.fabric_flat_services_etcd_client
    assert_uci_absent firewall.fabric_flat_reject_services_etcd_internal
    assert_live_rule Reject-services-to-root-etcd 'jump reject_to_lan' no
    assert_live_absent Allow-platform-to-root-etcd-client
    assert_live_absent Reject-services-to-root-etcd-internal
    ;;
  post | guarded-post | open-live | open-staged)
    expected_rules="$common_prefix
fabric_flat_services_etcd_client
fabric_flat_reject_services_etcd_internal
$common_suffix"
    expected_forward="$forward_prefix
Allow-platform-to-root-etcd-client
Reject-services-to-root-etcd-internal
$forward_suffix"
    expected_rule_count=26
    expected_chain_count=16
    assert_target_section fabric_flat_services_etcd_client \
      Allow-platform-to-root-etcd-client 2379 ACCEPT
    assert_target_section fabric_flat_reject_services_etcd_internal \
      Reject-services-to-root-etcd-internal '2380 2381' REJECT
    assert_uci_absent firewall.fabric_flat_reject_services_etcd
    if [ "$phase" = post ] || [ "$phase" = guarded-post ]; then
      require_zero=yes
    else
      require_zero=no
    fi
    assert_live_rule Allow-platform-to-root-etcd-client 'jump accept_to_lan' "$require_zero"
    assert_live_rule Reject-services-to-root-etcd-internal 'jump reject_to_lan' "$require_zero"
    assert_live_absent Reject-services-to-root-etcd
    ;;
  *) fail 'unknown validation phase' ;;
esac

case $phase in
  fenced)
    assert_fence_guard
    ;;
  guarded-post)
    assert_rollback_guard
    ;;
  open-staged)
    assert_fence_guard_absent
    ;;
  pre | post | open-live)
    assert_fence_guard_absent
    assert_fence_artifacts_absent
    ;;
esac

actual_rules=$(sections_of_type rule)
[ "$actual_rules" = "$expected_rules" ] || fail 'firewall rule set or ordering is not exact'
rule_count=$(printf '%s\n' "$actual_rules" | awk 'NF { n++ } END { print n + 0 }')
[ "$rule_count" -eq "$expected_rule_count" ] || fail 'firewall rule count is not exact'
total_count=$(uci -q show firewall |
  awk -F= '$1 ~ /^firewall\.[^.]+$/ { n++ } END { print n + 0 }')
[ "$total_count" -eq $((expected_rule_count + 3)) ] ||
  fail 'firewall contains an unexpected non-rule section'

actual_chain_count=$(printf '%s\n' "$live_chain" | awk '
  $1 == "chain" && $2 == "forward_lan" && $3 == "{" { inside = 1; next }
  inside && $1 == "}" { inside = 0 }
  inside && /# handle [0-9]+$/ { n++ }
  END { print n + 0 }
')
[ "$actual_chain_count" -eq "$expected_chain_count" ] ||
  fail 'live forward_lan rule count is not exact'
actual_forward=$(printf '%s\n' "$live_chain" |
  sed -n 's/.*comment "!fw4: \([^"]*\)".*/\1/p')
[ "$actual_forward" = "$expected_forward" ] || fail 'live forward_lan rule order is not exact'
terminal=$(printf '%s\n' "$live_chain" | awk '
  $1 == "chain" && $2 == "forward_lan" && $3 == "{" { inside = 1; next }
  inside && $1 == "}" { inside = 0 }
  inside && /# handle [0-9]+$/ { terminal = $0 }
  END { print terminal }
' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]][[:space:]]*/ /g' \
  -e 's/ # handle [0-9][0-9]*$//')
[ "$terminal" = 'jump reject_to_lan' ] || fail 'live forward_lan terminal verdict is not exact'

printf 'ROUTER_ETCD_POLICY_PHASE=%s\n' "$phase"
printf 'FIREWALL_RULE_COUNT=%s\n' "$rule_count"
printf 'FORWARD_LAN_RULE_COUNT=%s\n' "$actual_chain_count"
printf '%s\n' "$live_chain"
REMOTE_VALIDATE
}

write_fence_transition() {
  cat >"$1" <<'FENCE_TRANSITION'
delete firewall.fabric_flat_services_etcd_client
delete firewall.fabric_flat_reject_services_etcd_internal
set firewall.fabric_flat_reject_services_etcd='rule'
set firewall.fabric_flat_reject_services_etcd.name='Reject-services-to-root-etcd'
set firewall.fabric_flat_reject_services_etcd.src='lan'
set firewall.fabric_flat_reject_services_etcd.dest='lan'
set firewall.fabric_flat_reject_services_etcd.family='ipv4'
add_list firewall.fabric_flat_reject_services_etcd.src_ip='10.66.1.10/32'
add_list firewall.fabric_flat_reject_services_etcd.src_ip='10.66.1.11/32'
add_list firewall.fabric_flat_reject_services_etcd.dest_ip='10.66.0.10/32'
add_list firewall.fabric_flat_reject_services_etcd.dest_ip='10.66.0.11/32'
add_list firewall.fabric_flat_reject_services_etcd.dest_ip='10.66.0.12/32'
set firewall.fabric_flat_reject_services_etcd.proto='tcp'
add_list firewall.fabric_flat_reject_services_etcd.dest_port='2379'
add_list firewall.fabric_flat_reject_services_etcd.dest_port='2380'
add_list firewall.fabric_flat_reject_services_etcd.dest_port='2381'
set firewall.fabric_flat_reject_services_etcd.target='REJECT'
reorder firewall.fabric_flat_reject_services_etcd='7'
FENCE_TRANSITION
  chmod 0600 -- "$1"
}

validate_fence_transition() {
  local payload=$1 actual_hash
  actual_hash=$(sha256sum -- "$payload" | awk '{print $1}')
  [[ $actual_hash == "$fence_transition_sha256" ]] ||
    die 'embedded fence transition differs from the reviewed exact payload'
  [[ $(wc -l <"$payload") -eq 18 ]] ||
    die 'embedded fence transition has an unexpected command count'
  [[ $(sed -n '1p' "$payload") == \
      'delete firewall.fabric_flat_services_etcd_client' &&
     $(sed -n '2p' "$payload") == \
      'delete firewall.fabric_flat_reject_services_etcd_internal' ]] ||
    die 'fence transition must first remove the two exact opened sections'
  [[ $(sed -n '$p' "$payload") == \
      "reorder firewall.fabric_flat_reject_services_etcd='7'" ]] ||
    die 'fence transition must restore the reject at the reviewed rule position'
  ! grep -Eq "target='(ACCEPT|DNAT|SNAT|MASQUERADE)'" "$payload" ||
    die 'fence transition contains a packet-opening verdict'
}

validate_committed_fence_guard() {
  local actual_hash actual_contract
  [[ -f $fence_guard_file && ! -L $fence_guard_file ]] ||
    die 'committed fence guard must be a regular, non-symlink file'
  [[ $(stat -Lc '%a:%F:%h' -- "$fence_guard_file") == '644:regular file:1' ]] ||
    die 'committed fence guard must be mode-0644 and single-link'
  actual_hash=$(sha256sum -- "$fence_guard_file" | awk '{print $1}')
  [[ $actual_hash == "$fence_guard_sha256" ]] ||
    die 'committed fence guard differs from the reviewed exact payload'
  [[ $(wc -l <"$fence_guard_file") -eq 2 ]] ||
    die 'committed fence guard must contain exactly two rules'
  [[ $(sed -n '1p' "$fence_guard_file") == \
      'ip saddr { 10.66.1.10, 10.66.1.11 } ip daddr { 10.66.0.10, 10.66.0.11, 10.66.0.12 } tcp dport 2379 counter drop comment "fabric etcd fence client requests"' &&
     $(sed -n '2p' "$fence_guard_file") == \
      'ip saddr { 10.66.0.10, 10.66.0.11, 10.66.0.12 } ip daddr { 10.66.1.10, 10.66.1.11 } tcp sport 2379 counter drop comment "fabric etcd fence server replies"' ]] ||
    die 'committed fence guard directions or endpoint sets are not exact'
  actual_contract=$(printf 'uci:%s\nguard:%s\n' \
    "$fence_transition_sha256" "$fence_guard_sha256" | sha256sum | awk '{print $1}')
  [[ $actual_contract == "$fence_contract_sha256" ]] ||
    die 'embedded fence contract digest does not bind the reviewed UCI and nft payloads'
}

normalize_root_guard() {
  local input=$1 output=$2
  sed -E \
    -e 's/counter packets [0-9]+ bytes [0-9]+/counter/g' \
    -e 's/[[:space:]]+# handle [0-9]+$//' \
    -e 's/^[[:space:]]+//' \
    -e 's/[[:space:]]+$//' \
    -e '/^$/d' \
    "$input" >"$output"
  chmod 0600 -- "$output"
}

capture_exact_root_guards() {
  local stage=$1 index node snapshot normalized compact service_elements live_rules
  local json_snapshot live_forward_rules
  local expected_live_rules expected_live_forward_rules
  expected_live_rules='iifname "lo" counter accept comment "local host traffic"
meta nfproto ipv6 counter drop comment "no physical IPv6 input"
ct state invalid counter drop comment "invalid conntrack state"
ip saddr @root_nodes_v4 tcp dport 2379 counter accept comment "root etcd clients"
ip saddr @etcd_maintenance_v4 tcp dport 2379 counter accept comment "attended etcd maintenance"
ip saddr @service_nodes_v4 tcp dport 2379 counter accept comment "trusted platform etcd clients"
tcp dport 2379 counter drop comment "deny all other etcd clients including stale flows"
ct state { established, related } counter accept comment "reply traffic"
ip protocol icmp counter accept comment "IPv4 diagnostics and errors"
ip saddr @root_nodes_v4 tcp dport { 2380, 6443 } counter accept comment "root peer and API traffic"
ip saddr @root_nodes_v4 udp dport 8472 counter accept comment "root Flannel VXLAN"
ip saddr @service_nodes_v4 tcp dport { 6443, 10250 } counter accept comment "service agents to API and root kubelets"
ip saddr @service_nodes_v4 udp dport 8472 counter accept comment "service-agent Flannel VXLAN"
ip saddr @observer_v4 tcp dport { 22, 2112, 2381, 6443, 9100 } counter accept comment "attended observer access"
counter drop comment "deny all remaining input"'
  expected_live_forward_rules='ct state invalid counter drop comment "invalid conntrack state"
ct state { established, related } counter accept comment "forwarded replies"
counter drop comment "deny all new forwarding"'

  for index in "${!root_nodes[@]}"; do
    node=${root_nodes[$index]}
    snapshot=$evidence_dir/root-$((index + 1))-guard.$stage
    normalized=$snapshot.normalized
    json_snapshot=$snapshot.json
    operator_root_ssh "$node" sudo --non-interactive /usr/sbin/nft -a \
      list table inet fabric_guard >"$snapshot" ||
      die "cannot read live fabric_guard on $node"
    operator_root_ssh "$node" sudo --non-interactive /usr/sbin/nft -j \
      list table inet fabric_guard >"$json_snapshot" ||
      die "cannot read live fabric_guard JSON on $node"
    chmod 0600 -- "$snapshot" "$json_snapshot"
    jq -e '
      ([.nftables[] | .table? |
        select(.family == "inet" and .name == "fabric_guard")] | length) == 1 and
      ([.nftables[] | .chain? |
        select(.family == "inet" and .table == "fabric_guard") |
        del(.handle)] | sort_by(.name)) == [
          {family: "inet", table: "fabric_guard", name: "forward",
           type: "filter", hook: "forward", prio: 10, policy: "drop"},
          {family: "inet", table: "fabric_guard", name: "input",
           type: "filter", hook: "input", prio: 10, policy: "drop"}
        ] and
      ([.nftables[] | .set? |
        select(.family == "inet" and .table == "fabric_guard") |
        del(.handle) |
        .elem = (.elem // [])] | sort_by(.name)) == [
          {family: "inet", name: "etcd_maintenance_v4", table: "fabric_guard",
           type: "ipv4_addr", flags: ["timeout"], timeout: 900,
           "gc-interval": 60, elem: []},
          {family: "inet", name: "observer_v4", table: "fabric_guard",
           type: "ipv4_addr", flags: ["constant"], elem: ["10.66.0.2"]},
          {family: "inet", name: "root_nodes_v4", table: "fabric_guard",
           type: "ipv4_addr", flags: ["constant"],
           elem: ["10.66.0.10", "10.66.0.11", "10.66.0.12"]},
          {family: "inet", name: "service_nodes_v4", table: "fabric_guard",
           type: "ipv4_addr", flags: ["constant"],
           elem: ["10.66.1.10", "10.66.1.11"]}
        ]
    ' "$json_snapshot" >/dev/null ||
      die "$node fabric_guard base chains or identity sets are not exact"
    normalize_root_guard "$snapshot" "$normalized"
    compact=$(tr -d '[:space:]' <"$snapshot")
    service_elements=$(sed -n 's/.*setservice_nodes_v4{[^}]*elements={\([^}]*\)}.*/\1/p' \
      <<<"$compact")
    [[ $service_elements == '10.66.1.10,10.66.1.11' ]] ||
      die "$node service-node set is not exactly the two reviewed addresses"
    live_rules=$(awk '
      $0 == "chain input {" { inside = 1; next }
      inside && $0 == "}" { inside = 0; next }
      inside && $0 != "" && $0 !~ /^type filter hook input / { print }
    ' "$normalized")
    [[ $live_rules == "$expected_live_rules" ]] ||
      die "$node live fabric_guard input chain differs from the exact reviewed policy"
    live_forward_rules=$(awk '
      $0 == "chain forward {" { inside = 1; next }
      inside && $0 == "}" { inside = 0; next }
      inside && $0 != "" && $0 !~ /^type filter hook forward / { print }
    ' "$normalized")
    [[ $live_forward_rules == "$expected_live_forward_rules" ]] ||
      die "$node live fabric_guard forward chain differs from the exact deny policy"
  done
}

mode=
