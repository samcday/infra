  [ "$(stat -c '%d:%i' "$work/terminal")" = \
    "$(stat -c '%d:%i' "$work/accept-state")" ]
[ -f "$work/accepted" ] && [ ! -L "$work/accepted" ] &&
  [ "$(cat "$work/accepted")" = "$token" ] &&
  [ "$(stat -c '%d:%i' "$work/accepted")" = \
    "$(stat -c '%d:%i' "$work/accepted-state")" ]
[ -f "$work/accept-complete" ] && [ ! -L "$work/accept-complete" ] &&
  [ "$(cat "$work/accept-complete")" = "$token" ] &&
  [ "$(stat -c '%d:%i' "$work/accept-complete")" = \
    "$(stat -c '%d:%i' "$work/accepted-state")" ]
[ ! -e "$guard" ] && [ ! -L "$guard" ]
[ -z "$(find /usr/share/nftables.d -name '*.nft' -print)" ]
cmp -s "$firewall" "$work/candidate/firewall"
[ -z "$(uci -q changes firewall || true)" ]
[ "$(nft list tables)" = 'table inet fw4' ]
if nft -a list table inet fw4 |
    grep -F 'comment "fabric etcd fence ' >/dev/null; then
  exit 1
fi
if "$init" running >/dev/null 2>&1 || "$init" enabled >/dev/null 2>&1; then
  exit 1
fi
if find /etc/rc.d -maxdepth 1 -type l -name '*fabric-router-etcd-policy-rollback' | grep . >/dev/null; then
  exit 1
fi
rm -f -- "$init"
rm -rf -- "$work"
[ ! -e "$init" ] && [ ! -L "$init" ]
[ ! -e "$work" ] && [ ! -L "$work" ]
printf 'ROLLBACK_CLEANED=pass\n'
REMOTE_ROLLBACK_CLEANUP
[[ $(<"$evidence_dir/router-rollback-cleanup.txt") == ROLLBACK_CLEANED=pass ]] ||
  die 'router returned an unexpected rollback cleanup acknowledgement'
rollback_armed=false
remote_staged=false

release_cluster_network_lock
success=true
note "FABRIC_ROUTER_ETCD_POLICY_ROLLOUT=pass revision=$head payload=$transition_sha256"
note "Protected evidence retained at $evidence_dir"
