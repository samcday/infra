payload_b64=$(base64 -w0 -- "$transition_file")
guard_b64=$(base64 -w0 -- "$fence_guard_file")
read -r -d '' rollback_program <<'REMOTE_ROLLBACK' || true
#!/bin/sh
set -eu
umask 077

work=/etc/fabric-router-etcd-policy-rollback
init=/etc/init.d/fabric-router-etcd-policy-rollback
firewall=/etc/config/firewall
guard_source=$work/early-guard.nft
guard=/usr/share/nftables.d/chain-pre/forward/10-fabric-etcd-fence.nft
boot_id_path=/proc/sys/kernel/random/boot_id
expected_guard_sha=d5af6bff9ede7dc47bf13f41c9717a4af9886380a85a5b6b91e6e831f13f77f7

fail() {
  logger -t fabric-router-etcd-policy-rollback "ERROR: $*"
  exit 1
}

contract_safe() {
  [ -d "$work" ] && [ ! -L "$work" ] || return 1
  for file in owner expected-token armed deadline armed-boot-id firewall.before \
      firewall.before.sha256 candidate/firewall firewall.candidate.sha256 \
      early-guard.nft early-guard.nft.sha256 \
      rollback rollback.sha256 init init.sha256 fence-state accept-state \
      accepted-state; do
    [ -f "$work/$file" ] && [ ! -L "$work/$file" ] || return 1
  done
  token=$(cat "$work/expected-token") || return 1
  [ "$(cat "$work/owner")" = fabric-router-etcd-policy-rollout ] || return 1
  [ "$(cat "$work/armed")" = "$token" ] || return 1
  [ "$(cat "$work/fence-state")" = "fence:$token" ] || return 1
  [ "$(cat "$work/accept-state")" = "accept:$token" ] || return 1
  [ "$(cat "$work/accepted-state")" = "$token" ] || return 1
  (cd "$work" && sha256sum -c firewall.before.sha256 >/dev/null) || return 1
  (cd "$work" && sha256sum -c firewall.candidate.sha256 >/dev/null) || return 1
  (cd "$work" && sha256sum -c early-guard.nft.sha256 >/dev/null) || return 1
  [ "$(sha256sum "$guard_source" | awk '{print $1}')" = "$expected_guard_sha" ] ||
    return 1
  (cd "$work" && sha256sum -c rollback.sha256 >/dev/null) || return 1
  (cd "$work" && sha256sum -c init.sha256 >/dev/null) || return 1
  [ -f "$init" ] && [ ! -L "$init" ] || return 1
  cmp -s "$work/init" "$init" || return 1
  deadline=$(cat "$work/deadline") || return 1
  case $deadline in *[!0-9]*|'') return 1 ;; esac
  armed_boot_id=$(cat "$work/armed-boot-id") || return 1
  case $armed_boot_id in *[!0-9a-f-]*|'') return 1 ;; esac
  [ "$(printf '%s' "$armed_boot_id" | wc -c)" -eq 36 ] || return 1
}

terminal_state() {
  if [ ! -e "$work/terminal" ] && [ ! -L "$work/terminal" ]; then
    printf 'none\n'
    return 0
  fi
  [ -f "$work/terminal" ] && [ ! -L "$work/terminal" ] || {
    printf 'invalid\n'
    return 0
  }
  value=$(cat "$work/terminal" 2>/dev/null || true)
  terminal_inode=$(stat -c '%d:%i' "$work/terminal" 2>/dev/null || true)
  if [ "$value" = "fence:$token" ] &&
      [ "$terminal_inode" = "$(stat -c '%d:%i' "$work/fence-state")" ]; then
    printf 'fence\n'
  elif [ "$value" = "accept:$token" ] &&
      [ "$terminal_inode" = "$(stat -c '%d:%i' "$work/accept-state")" ]; then
    printf 'accept\n'
  else
    printf 'invalid\n'
  fi
}

claim_fence() {
  state=$(terminal_state)
  if [ "$state" = none ]; then
    ln "$work/fence-state" "$work/terminal" 2>/dev/null || true
    state=$(terminal_state)
  fi
  [ "$state" = fence ]
}

accepted_exact() {
  [ -f "$work/accepted" ] && [ ! -L "$work/accepted" ] &&
    [ "$(cat "$work/accepted")" = "$token" ] &&
    [ "$(stat -c '%d:%i' "$work/accepted")" = \
      "$(stat -c '%d:%i' "$work/accepted-state")" ]
}

accept_window_valid() {
  [ -f "$work/accept-boot-id" ] && [ ! -L "$work/accept-boot-id" ] || return 1
  [ -f "$work/accept-deadline" ] && [ ! -L "$work/accept-deadline" ] || return 1
  accept_boot_id=$(cat "$work/accept-boot-id") || return 1
  current_boot_id=$(cat "$boot_id_path" 2>/dev/null || true)
  [ "$accept_boot_id" = "$armed_boot_id" ] &&
    [ "$current_boot_id" = "$armed_boot_id" ] || return 1
  accept_deadline=$(cat "$work/accept-deadline") || return 1
  now=$(date +%s)
  case "$accept_deadline:$now" in *[!0-9:]*|*::*|:*|*:) return 1 ;; esac
  [ "$accept_deadline" -lt "$deadline" ] || return 1
  [ "$now" -lt "$accept_deadline" ] || return 1
  [ ! -e "$work/force-rollback" ] && [ ! -L "$work/force-rollback" ]
}

claim_acceptance_fence() {
  ln "$work/fence-state" "$work/accepted" 2>/dev/null || true
  accepted_exact && return 1
  [ -f "$work/accepted" ] && [ ! -L "$work/accepted" ] &&
    [ "$(cat "$work/accepted")" = "fence:$token" ] &&
    [ "$(stat -c '%d:%i' "$work/accepted")" = \
      "$(stat -c '%d:%i' "$work/fence-state")" ]
}

fence_obligation() {
  state=$(terminal_state)
  [ "$state" = fence ] || {
    [ "$state" = accept ] && ! accepted_exact
  }
}

ensure_guard_directory() {
  [ -d /usr/share/nftables.d ] && [ ! -L /usr/share/nftables.d ] || return 1
  [ "$(stat -c '%u:%g:%a:%F' /usr/share/nftables.d)" = \
    '0:0:755:directory' ] || return 1
  for directory in /usr/share/nftables.d/chain-pre \
      /usr/share/nftables.d/chain-pre/forward; do
    if [ -e "$directory" ] || [ -L "$directory" ]; then
      [ -d "$directory" ] && [ ! -L "$directory" ] || return 1
      [ "$(stat -c '%u:%g:%a:%F' "$directory")" = \
        '0:0:755:directory' ] || return 1
    else
      mkdir "$directory" || return 1
      chmod 0755 "$directory" || return 1
    fi
  done
  share_nft_files=$(find /usr/share/nftables.d -name '*.nft' -print | LC_ALL=C sort)
  [ -z "$share_nft_files" ] || [ "$share_nft_files" = "$guard" ]
}

install_guard_file() {
  ensure_guard_directory || return 1
  if [ -e "$guard.next" ] || [ -L "$guard.next" ]; then
    [ -f "$guard.next" ] && [ ! -L "$guard.next" ] || return 1
    rm -f "$guard.next" || return 1
  fi
  cp "$guard_source" "$guard.next" || return 1
  chown 0:0 "$guard.next" || return 1
  chmod 0600 "$guard.next" || return 1
  mv "$guard.next" "$guard" || return 1
  [ -f "$guard" ] && [ ! -L "$guard" ] || return 1
  cmp -s "$guard_source" "$guard" || return 1
  sync
}

insert_immediate_guard() {
  nft list chain inet fw4 forward >/dev/null 2>&1 || return 0
  {
    printf 'insert rule inet fw4 forward '
    sed -n '2p' "$guard_source"
    printf 'insert rule inet fw4 forward '
    sed -n '1p' "$guard_source"
  } | nft -f - >/dev/null 2>&1
}

assert_closed_lan() {
  [ "$(uci -q get firewall.fabric_flat_reject_services_etcd.name)" = \
    Reject-services-to-root-etcd ] || return 1
  [ "$(uci -q get firewall.fabric_flat_reject_services_etcd.dest_port)" = \
    '2379 2380 2381' ] || return 1
  [ "$(uci -q get firewall.fabric_flat_reject_services_etcd.target)" = REJECT ] ||
    return 1
  ! uci -q get firewall.fabric_flat_services_etcd_client >/dev/null 2>&1 || return 1
  ! uci -q get firewall.fabric_flat_reject_services_etcd_internal >/dev/null 2>&1 ||
    return 1
  live_lan=$(nft -a list chain inet fw4 forward_lan) || return 1
  [ "$(printf '%s\n' "$live_lan" | grep -Fc 'comment "!fw4: Reject-services-to-root-etcd"')" -eq 1 ] ||
    return 1
  ! printf '%s\n' "$live_lan" | grep -F \
    'comment "!fw4: Allow-platform-to-root-etcd-client"' >/dev/null || return 1
  ! printf '%s\n' "$live_lan" | grep -F \
    'comment "!fw4: Reject-services-to-root-etcd-internal"' >/dev/null || return 1
  expected_order='Block-fabric-to-private-WAN
Allow-roots-to-public-WAN
Allow-services-to-public-Web
Reject-other-fabric-to-WAN
Reject-services-to-root-etcd
Allow-services-to-fabric-API
Allow-services-to-root-VXLAN
Allow-roots-to-services-VXLAN
Allow-services-to-root-kubelets
Allow-roots-to-service-kubelets
Allow-observer-to-services-SSH
Allow-services-to-Bootie-rootfs
Reject-other-services-to-roots
Reject-other-roots-to-services'
  actual_order=$(printf '%s\n' "$live_lan" |
    sed -n 's/.*comment "!fw4: \([^"]*\)".*/\1/p')
  [ "$actual_order" = "$expected_order" ] || return 1
  rule_count=$(printf '%s\n' "$live_lan" | awk '
    $1 == "chain" && $2 == "forward_lan" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && /# handle [0-9]+$/ { n++ }
    END { print n + 0 }
  ')
  [ "$rule_count" -eq 15 ] || return 1
  terminal_rule=$(printf '%s\n' "$live_lan" | awk '
    $1 == "chain" && $2 == "forward_lan" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && /# handle [0-9]+$/ { terminal = $0 }
    END { print terminal }
  ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]][[:space:]]*/ /g' \
    -e 's/ # handle [0-9][0-9]*$//')
  [ "$terminal_rule" = 'jump reject_to_lan' ]
}

guard_rule_exact() {
  rule=$1
  marker=$2
  port_field=$3
  wanted_sources=$4
  wanted_destinations=$5
  normalized=$(printf '%s\n' "$rule" | sed \
    -e 's/^[[:space:]]*//' \
    -e 's/[[:space:]][[:space:]]*/ /g' \
    -e 's/counter packets [0-9][0-9]* bytes [0-9][0-9]*/counter/' \
    -e 's/ # handle [0-9][0-9]*$//')
  source_members=$(printf '%s\n' "$normalized" |
    sed -n 's/^ip saddr { \([^}]*\) } ip daddr.*/\1/p')
  destination_members=$(printf '%s\n' "$normalized" |
    sed -n 's/.* ip daddr { \([^}]*\) } tcp .*/\1/p')
  [ -n "$source_members" ] && [ -n "$destination_members" ] || return 1
  source_members=$(printf '%s\n' "$source_members" | tr ',' '\n' |
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | LC_ALL=C sort |
    awk 'NF { value = value separator $0; separator = "," } END { print value }')
  destination_members=$(printf '%s\n' "$destination_members" | tr ',' '\n' |
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | LC_ALL=C sort |
    awk 'NF { value = value separator $0; separator = "," } END { print value }')
  [ "$source_members" = "$wanted_sources" ] || return 1
  [ "$destination_members" = "$wanted_destinations" ] || return 1
  shape=$(printf '%s\n' "$normalized" | sed \
    -e 's/ip saddr { [^}]* }/ip saddr { SOURCE }/' \
    -e 's/ip daddr { [^}]* }/ip daddr { DESTINATION }/')
  [ "$shape" = "ip saddr { SOURCE } ip daddr { DESTINATION } tcp $port_field 2379 counter drop comment \"$marker\"" ]
}

guard_live() {
  [ -f "$guard" ] && [ ! -L "$guard" ] || return 1
  cmp -s "$guard_source" "$guard" || return 1
  share_nft_files=$(find /usr/share/nftables.d -name '*.nft' -print | LC_ALL=C sort)
  [ "$share_nft_files" = "$guard" ] || return 1
  live_forward=$(nft -a list chain inet fw4 forward) || return 1
  request=$(printf '%s\n' "$live_forward" |
    grep -F 'comment "fabric etcd fence client requests"' || true)
  reply=$(printf '%s\n' "$live_forward" |
    grep -F 'comment "fabric etcd fence server replies"' || true)
  [ "$(printf '%s\n' "$request" | awk 'NF { n++ } END { print n + 0 }')" -eq 1 ] ||
    return 1
  [ "$(printf '%s\n' "$reply" | awk 'NF { n++ } END { print n + 0 }')" -eq 1 ] ||
    return 1
  guard_rule_exact "$request" 'fabric etcd fence client requests' dport \
    '10.66.1.10,10.66.1.11' '10.66.0.10,10.66.0.11,10.66.0.12' || return 1
  guard_rule_exact "$reply" 'fabric etcd fence server replies' sport \
    '10.66.0.10,10.66.0.11,10.66.0.12' '10.66.1.10,10.66.1.11' || return 1
  executable=$(printf '%s\n' "$live_forward" | awk '
    $1 == "chain" && $2 == "forward" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && $0 !~ /^[[:space:]]*type / && /# handle [0-9]+$/ { print }
  ')
  first=$(printf '%s\n' "$executable" | sed -n '1p')
  second=$(printf '%s\n' "$executable" | sed -n '2p')
  printf '%s\n' "$first" | grep -F \
    'comment "fabric etcd fence client requests"' >/dev/null || return 1
  printf '%s\n' "$second" | grep -F \
    'comment "fabric etcd fence server replies"' >/dev/null || return 1
  first_accept=$(printf '%s\n' "$executable" |
    grep -n 'accept.*# handle [0-9][0-9]*$' | sed -n '1s/:.*//p')
  case $first_accept in *[!0-9]*|'') return 1 ;; esac
  [ "$first_accept" -gt 2 ]
}

accept_complete_exact() {
  accepted_exact &&
    [ -f "$work/accept-complete" ] && [ ! -L "$work/accept-complete" ] &&
    [ "$(cat "$work/accept-complete")" = "$token" ] &&
    [ "$(stat -c '%d:%i' "$work/accept-complete")" = \
      "$(stat -c '%d:%i' "$work/accepted-state")" ]
}

assert_open_lan() {
  [ "$(uci -q get firewall.fabric_flat_services_etcd_client.name)" = \
    Allow-platform-to-root-etcd-client ] || return 1
  [ "$(uci -q get firewall.fabric_flat_services_etcd_client.dest_port)" = 2379 ] ||
    return 1
  [ "$(uci -q get firewall.fabric_flat_services_etcd_client.target)" = ACCEPT ] ||
    return 1
  [ "$(uci -q get firewall.fabric_flat_reject_services_etcd_internal.name)" = \
    Reject-services-to-root-etcd-internal ] || return 1
  [ "$(uci -q get firewall.fabric_flat_reject_services_etcd_internal.dest_port)" = \
    '2380 2381' ] || return 1
  [ "$(uci -q get firewall.fabric_flat_reject_services_etcd_internal.target)" = \
    REJECT ] || return 1
  ! uci -q get firewall.fabric_flat_reject_services_etcd >/dev/null 2>&1 ||
    return 1
  live_lan=$(nft -a list chain inet fw4 forward_lan) || return 1
  expected_order='Block-fabric-to-private-WAN
Allow-roots-to-public-WAN
Allow-services-to-public-Web
Reject-other-fabric-to-WAN
Allow-platform-to-root-etcd-client
Reject-services-to-root-etcd-internal
Allow-services-to-fabric-API
Allow-services-to-root-VXLAN
Allow-roots-to-services-VXLAN
Allow-services-to-root-kubelets
Allow-roots-to-service-kubelets
Allow-observer-to-services-SSH
Allow-services-to-Bootie-rootfs
Reject-other-services-to-roots
Reject-other-roots-to-services'
  actual_order=$(printf '%s\n' "$live_lan" |
    sed -n 's/.*comment "!fw4: \([^"]*\)".*/\1/p')
  [ "$actual_order" = "$expected_order" ] || return 1
  rule_count=$(printf '%s\n' "$live_lan" | awk '
    $1 == "chain" && $2 == "forward_lan" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && /# handle [0-9]+$/ { n++ }
    END { print n + 0 }
  ')
  [ "$rule_count" -eq 16 ] || return 1
  terminal_rule=$(printf '%s\n' "$live_lan" | awk '
    $1 == "chain" && $2 == "forward_lan" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && /# handle [0-9]+$/ { terminal = $0 }
    END { print terminal }
  ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]][[:space:]]*/ /g' \
    -e 's/ # handle [0-9][0-9]*$//')
  [ "$terminal_rule" = 'jump reject_to_lan' ]
}

acceptance_open_base() {
  contract_safe || return 1
  [ "$(terminal_state)" = accept ] || return 1
  accepted_exact || return 1
  [ -f "$firewall" ] && [ ! -L "$firewall" ] || return 1
  cmp -s "$work/candidate/firewall" "$firewall" || return 1
  [ -z "$(uci -q changes firewall || true)" ] || return 1
  [ ! -e "$guard" ] && [ ! -L "$guard" ] || return 1
  [ -z "$(find /usr/share/nftables.d -name '*.nft' -print)" ] || return 1
  fw4 check >/dev/null || return 1
  [ "$(nft list tables)" = 'table inet fw4' ] || return 1
  live_table=$(nft -a list table inet fw4) || return 1
  ! printf '%s\n' "$live_table" |
    grep -F 'comment "fabric etcd fence ' >/dev/null || return 1
  assert_open_lan
}

acceptance_open() {
  accept_complete_exact || return 1
  acceptance_open_base
}

apply_acceptance() {
  contract_safe || return 1
  [ "$(terminal_state)" = accept ] || return 1
  accepted_exact || return 1
  sync
  contract_safe || return 1
  [ "$(terminal_state)" = accept ] || return 1
  accepted_exact || return 1
  [ -f "$firewall" ] && [ ! -L "$firewall" ] || return 1
  cmp -s "$work/candidate/firewall" "$firewall" || return 1
  [ -z "$(uci -q changes firewall || true)" ] || return 1
  if [ -e "$guard" ] || [ -L "$guard" ]; then
    [ -f "$guard" ] && [ ! -L "$guard" ] || return 1
    cmp -s "$guard_source" "$guard" || return 1
  fi
  share_nft_files=$(find /usr/share/nftables.d -name '*.nft' -print | LC_ALL=C sort)
  [ -z "$share_nft_files" ] || [ "$share_nft_files" = "$guard" ] || return 1
  rm -f -- "$guard" || return 1
  sync
  fw4 check >/dev/null || return 1
  /etc/init.d/firewall reload >/dev/null || return 1
  acceptance_open_base || return 1
  ln "$work/accepted-state" "$work/accept-complete" 2>/dev/null || true
  sync
  accept_complete_exact || return 1
  acceptance_open
}

hold_incomplete_acceptance_closed() {
  contract_safe || return 1
  [ "$(terminal_state)" = accept ] || return 1
  accepted_exact || return 1
  insert_immediate_guard || true
  install_guard_file || return 1
  fw4 check >/dev/null || return 1
  /etc/init.d/firewall reload >/dev/null || return 1
  guard_live
}

reconcile_acceptance_forever() {
  while :; do
    contract_safe || fail 'rollback contract changed after terminal acceptance'
    [ "$(terminal_state)" = accept ] ||
      fail 'terminal acceptance changed during reconciliation'
    accepted_exact || fail 'accepted outcome changed during reconciliation'
    if acceptance_open || apply_acceptance; then
      logger -t fabric-router-etcd-policy-rollback \
        'terminal acceptance is exact; continuing to guard against boot-time reload drift'
    elif hold_incomplete_acceptance_closed; then
      logger -t fabric-router-etcd-policy-rollback \
        'terminal acceptance could not be made exact; holding persistent early drops before retry'
    else
      logger -t fabric-router-etcd-policy-rollback \
        'terminal acceptance repair and fail-closed guard both failed; retrying'
    fi
    sleep 2
  done
}

is_fenced() {
  contract_safe || return 1
  fence_obligation || return 1
  [ -f "$firewall" ] && [ ! -L "$firewall" ] || return 1
  cmp -s "$work/firewall.before" "$firewall" || return 1
  [ -z "$(uci -q changes firewall || true)" ] || return 1
  fw4 check >/dev/null || return 1
  [ "$(nft list tables)" = 'table inet fw4' ] || return 1
  assert_closed_lan || return 1
  guard_live
}

apply_fence() {
  contract_safe || return 1
  fence_obligation || return 1
  insert_immediate_guard || logger -t fabric-router-etcd-policy-rollback \
    'immediate live guard insertion failed; continuing with persistent guarded reload'
  install_guard_file || return 1
  uci -q revert firewall || true
  if fw4 check >/dev/null 2>&1; then
    /etc/init.d/firewall reload >/dev/null 2>&1 || true
  fi
  if [ -e /etc/config/.firewall.fabric-etcd-rollback.next ] ||
      [ -L /etc/config/.firewall.fabric-etcd-rollback.next ]; then
    [ -f /etc/config/.firewall.fabric-etcd-rollback.next ] &&
      [ ! -L /etc/config/.firewall.fabric-etcd-rollback.next ] || return 1
    rm -f /etc/config/.firewall.fabric-etcd-rollback.next || return 1
  fi
  cp "$work/firewall.before" /etc/config/.firewall.fabric-etcd-rollback.next ||
    return 1
  chown 0:0 /etc/config/.firewall.fabric-etcd-rollback.next || return 1
  chmod 0600 /etc/config/.firewall.fabric-etcd-rollback.next || return 1
  mv /etc/config/.firewall.fabric-etcd-rollback.next "$firewall" || return 1
  sync
  [ -z "$(uci -q changes firewall || true)" ] || return 1
  fw4 check >/dev/null || return 1
  /etc/init.d/firewall reload >/dev/null || return 1
  is_fenced
}

ack_fenced() {
  printf '%s\n' "$token" >"$work/fenced.next" || return 1
  chmod 0600 "$work/fenced.next" || return 1
  mv "$work/fenced.next" "$work/fenced" || return 1
  sync
}

contract_safe || fail 'rollback contract is unsafe'
state=$(terminal_state)
while :; do
  case $state in
    accept)
      accepted_exact && reconcile_acceptance_forever
      if accept_window_valid; then
        sleep 1
        contract_safe || fail 'rollback contract changed during terminal acceptance'
        state=$(terminal_state)
        continue
      fi
      claim_acceptance_fence || {
        accepted_exact && reconcile_acceptance_forever
        fail 'cannot atomically close an incomplete terminal acceptance'
      }
      break
      ;;
    fence)
      break
      ;;
    invalid)
      fail 'terminal rollback state is invalid'
      ;;
    none)
      current_boot_id=$(cat "$boot_id_path" 2>/dev/null || true)
      trigger=false
      [ "$current_boot_id" = "$armed_boot_id" ] || trigger=true
      if [ -e "$work/force-rollback" ] || [ -L "$work/force-rollback" ]; then
        trigger=true
      fi
      now=$(date +%s)
      case $now in *[!0-9]*|'') trigger=true ;; esac
      [ "$trigger" = true ] || [ "$now" -lt "$deadline" ] || trigger=true
      if [ "$trigger" = true ]; then
        claim_fence || true
      else
        sleep 1
        contract_safe || fail 'rollback contract changed while armed'
      fi
      state=$(terminal_state)
      ;;
  esac
done

state=$(terminal_state)
if [ "$state" = accept ]; then
  accepted_exact && reconcile_acceptance_forever
elif [ "$state" != fence ]; then
  fail 'cannot establish a terminal rollback fence obligation'
fi

while :; do
  if is_fenced || apply_fence; then
    ack_fenced || logger -t fabric-router-etcd-policy-rollback \
      'persistent fence is live but its acknowledgement could not be written'
  else
    logger -t fabric-router-etcd-policy-rollback \
      'persistent rollback fence application failed; retrying without restoring open policy'
  fi
  sleep 2
done
REMOTE_ROLLBACK
rollback_b64=$(printf '%s' "$rollback_program" | base64 -w0)

read -r -d '' init_program <<'REMOTE_INIT' || true
#!/bin/sh /etc/rc.common
USE_PROCD=1
START=15
STOP=01

start_service() {
  procd_open_instance
  procd_set_param command /bin/sh /etc/fabric-router-etcd-policy-rollback/rollback
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param term_timeout 5
  procd_set_param respawn 3600 5 0
  procd_close_instance
}
REMOTE_INIT
init_b64=$(printf '%s' "$init_program" | base64 -w0)
rollback_sha=$(printf '%s' "$rollback_program" | sha256sum | awk '{print $1}')
init_sha=$(printf '%s' "$init_program" | sha256sum | awk '{print $1}')
rollout_token="$head:$transition_sha256"

remote_staged=true
router_ssh /bin/sh -s -- \
  "$remote_work" "$remote_init" "$transition_sha256" "$rollout_token" \
  "$payload_b64" "$rollback_b64" "$init_b64" "$rollback_sha" "$init_sha" \
  "$guard_b64" "$fence_guard_sha256" \
  >"$evidence_dir/router-stage.txt" <<'REMOTE_STAGE'
set -eu
umask 077

work=$1
init=$2
payload_sha=$3
token=$4
payload_b64=$5
rollback_b64=$6
init_b64=$7
rollback_sha=$8
init_sha=$9
guard_b64=${10}
guard_sha=${11}
firewall=/etc/config/firewall

fail() {
  printf 'remote router staging failed: %s\n' "$*" >&2
  exit 1
}

case $payload_sha:$rollback_sha:$init_sha:$guard_sha in
  *[!0-9a-f:]*|'') fail 'staged hash argument has an invalid shape' ;;
esac
case $token in *[!0-9a-f:]*) fail 'rollout token has an invalid shape' ;; esac
[ -f "$firewall" ] && [ ! -L "$firewall" ] || fail 'live firewall config is unsafe'
[ "$(stat -c '%u:%g:%a:%h:%F' "$firewall")" = '0:0:600:1:regular file' ] ||
  fail 'live firewall config metadata is unsafe'
[ ! -e "$work" ] && [ ! -L "$work" ] || fail 'stale rollback work path requires inspection'
[ ! -e "$init" ] && [ ! -L "$init" ] || fail 'stale rollback init path requires inspection'
if find /etc/rc.d -maxdepth 1 -type l -name '*fabric-router-etcd-policy-rollback' | grep . >/dev/null; then
  fail 'stale enabled rollback link requires inspection'
fi

mkdir "$work"
chmod 0700 "$work"
printf '%s\n' fabric-router-etcd-policy-rollout >"$work/owner"
printf '%s' "$payload_b64" | base64 -d >"$work/transition.uci"
printf '%s' "$guard_b64" | base64 -d >"$work/early-guard.nft"
printf '%s' "$rollback_b64" | base64 -d >"$work/rollback"
printf '%s' "$init_b64" | base64 -d >"$work/init"
printf 'fence:%s\n' "$token" >"$work/fence-state"
printf 'accept:%s\n' "$token" >"$work/accept-state"
printf '%s\n' "$token" >"$work/accepted-state"
chmod 0600 "$work/owner" "$work/transition.uci" "$work/early-guard.nft" \
  "$work/fence-state" "$work/accept-state" "$work/accepted-state"
chmod 0700 "$work/rollback" "$work/init"
[ "$(sha256sum "$work/transition.uci" | awk '{print $1}')" = "$payload_sha" ] ||
  fail 'transition payload changed in transport'
[ "$(sha256sum "$work/rollback" | awk '{print $1}')" = "$rollback_sha" ] ||
  fail 'rollback program changed in transport'
[ "$(sha256sum "$work/init" | awk '{print $1}')" = "$init_sha" ] ||
  fail 'rollback init changed in transport'
[ "$(sha256sum "$work/early-guard.nft" | awk '{print $1}')" = "$guard_sha" ] ||
  fail 'rollback early-drop payload changed in transport'

cp -p "$firewall" "$work/firewall.before"
mkdir "$work/candidate"
chmod 0700 "$work/candidate"
mkdir "$work/candidate-save"
chmod 0700 "$work/candidate-save"
cp -p "$firewall" "$work/candidate/firewall"
uci -q -c "$work/candidate" -t "$work/candidate-save" batch \
  <"$work/transition.uci" || fail 'candidate UCI batch failed'
uci -q -c "$work/candidate" -t "$work/candidate-save" commit firewall ||
  fail 'candidate UCI commit failed'
[ "$(uci -q -c "$work/candidate" -t "$work/candidate-save" get firewall.fabric_flat_services_etcd_client.name)" = \
  Allow-platform-to-root-etcd-client ] || fail 'candidate allow is absent'
[ "$(uci -q -c "$work/candidate" -t "$work/candidate-save" get firewall.fabric_flat_services_etcd_client.dest_port)" = 2379 ] ||
  fail 'candidate allow port is not exact'
[ "$(uci -q -c "$work/candidate" -t "$work/candidate-save" get firewall.fabric_flat_reject_services_etcd_internal.name)" = \
  Reject-services-to-root-etcd-internal ] || fail 'candidate internal reject is absent'
[ "$(uci -q -c "$work/candidate" -t "$work/candidate-save" get firewall.fabric_flat_reject_services_etcd_internal.dest_port)" = \
  '2380 2381' ] || fail 'candidate internal ports are not exact'
if uci -q -c "$work/candidate" -t "$work/candidate-save" \
    get firewall.fabric_flat_reject_services_etcd >/dev/null 2>&1; then
  fail 'candidate retained the legacy reject'
fi
[ -z "$(uci -q changes firewall || true)" ] ||
  fail 'candidate validation leaked a live UCI delta'

cd "$work"
sha256sum firewall.before >firewall.before.sha256
sha256sum candidate/firewall >firewall.candidate.sha256
sha256sum early-guard.nft >early-guard.nft.sha256
sha256sum rollback >rollback.sha256
sha256sum init >init.sha256
chmod 0600 firewall.before firewall.before.sha256 firewall.candidate.sha256 \
  early-guard.nft.sha256 rollback.sha256 init.sha256 candidate/firewall
printf '%s\n' "$token" >expected-token
chmod 0600 expected-token
cp "$work/init" "$init"
chmod 0700 "$init"
[ -f "$init" ] && [ ! -L "$init" ] || fail 'rollback init installation is unsafe'
cmp -s "$work/init" "$init" || fail 'installed rollback init changed'
printf 'BACKUP_SHA256=%s\n' "$(awk '{print $1}' firewall.before.sha256)"
printf 'CANDIDATE_SHA256=%s\n' "$(awk '{print $1}' firewall.candidate.sha256)"
printf 'EARLY_GUARD_SHA256=%s\n' "$(awk '{print $1}' early-guard.nft.sha256)"
REMOTE_STAGE

validate_remote_phase pre "$evidence_dir/router-before-arm.txt"
verify_pre_open_contract locked-final \
  --expected-lock-holder "$cluster_lock_holder"
verify_activation_fence before-arm
validate_remote_phase pre "$evidence_dir/router-final-before-arm.txt"

rollback_armed=true
router_ssh /bin/sh -s -- "$remote_work" "$remote_init" "$rollout_token" \
  "$rollback_seconds" >"$evidence_dir/router-arm.txt" <<'REMOTE_ARM'
set -eu
umask 077
work=$1
init=$2
token=$3
seconds=$4
[ -d "$work" ] && [ ! -L "$work" ]
[ -f "$work/expected-token" ] && [ "$(cat "$work/expected-token")" = "$token" ]
[ -f "$work/fence-state" ] && [ ! -L "$work/fence-state" ] &&
  [ "$(cat "$work/fence-state")" = "fence:$token" ]
[ -f "$work/accept-state" ] && [ ! -L "$work/accept-state" ] &&
  [ "$(cat "$work/accept-state")" = "accept:$token" ]
[ -f "$work/accepted-state" ] && [ ! -L "$work/accepted-state" ] &&
  [ "$(cat "$work/accepted-state")" = "$token" ]
(cd "$work" && sha256sum -c firewall.before.sha256 >/dev/null)
(cd "$work" && sha256sum -c early-guard.nft.sha256 >/dev/null)
(cd "$work" && sha256sum -c rollback.sha256 >/dev/null)
(cd "$work" && sha256sum -c init.sha256 >/dev/null)
for marker in terminal force-rollback apply-started apply-finished fenced accepted \
    accept-boot-id accept-deadline accept-complete; do
  [ ! -e "$work/$marker" ] && [ ! -L "$work/$marker" ]
done
case $seconds in *[!0-9]*|'') exit 1 ;; esac
deadline=$(( $(date +%s) + seconds ))
boot_id=$(cat /proc/sys/kernel/random/boot_id)
case $boot_id in *[!0-9a-f-]*|'') exit 1 ;; esac
[ "$(printf '%s' "$boot_id" | wc -c)" -eq 36 ]
printf '%s\n' "$deadline" >"$work/deadline"
printf '%s\n' "$boot_id" >"$work/armed-boot-id.next"
printf '%s\n' "$token" >"$work/armed.next"
chmod 0600 "$work/deadline" "$work/armed-boot-id.next" "$work/armed.next"
mv "$work/armed-boot-id.next" "$work/armed-boot-id"
mv "$work/armed.next" "$work/armed"
sync
"$init" enable
"$init" enabled
"$init" start
"$init" running
printf 'ROLLBACK_DEADLINE_EPOCH=%s\n' "$deadline"
REMOTE_ARM

verify_activation_fence before-apply
router_ssh /bin/sh -s -- "$remote_work" "$remote_init" "$rollout_token" \
  "$fence_remote_guard" "$fence_guard_sha256" \
  >"$evidence_dir/router-apply.txt" <<'REMOTE_APPLY'
set -eu
work=$1
init=$2
token=$3
guard=$4
guard_sha=$5
firewall=/etc/config/firewall
guard_source=$work/early-guard.nft
[ -d "$work" ] && [ ! -L "$work" ]
[ "$(cat "$work/armed")" = "$token" ]
"$init" running
