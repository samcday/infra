guard_rule_handle() {
  gr_rule=$1
  gr_marker=$2
  gr_port_field=$3
  gr_wanted_sources=$4
  gr_wanted_destinations=$5
  gr_normalized=$(printf '%s\n' "$gr_rule" | sed \
    -e 's/^[[:space:]]*//' \
    -e 's/[[:space:]][[:space:]]*/ /g' \
    -e 's/counter packets [0-9][0-9]* bytes [0-9][0-9]*/counter/' \
    -e 's/ # handle [0-9][0-9]*$//')
  gr_sources=$(printf '%s\n' "$gr_normalized" |
    sed -n 's/^ip saddr { \([^}]*\) } ip daddr.*/\1/p')
  gr_destinations=$(printf '%s\n' "$gr_normalized" |
    sed -n 's/.* ip daddr { \([^}]*\) } tcp .*/\1/p')
  [ -n "$gr_sources" ] && [ -n "$gr_destinations" ] || return 1
  gr_sources=$(printf '%s\n' "$gr_sources" | tr ',' '\n' |
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | LC_ALL=C sort |
    awk 'NF { value = value separator $0; separator = "," } END { print value }')
  gr_destinations=$(printf '%s\n' "$gr_destinations" | tr ',' '\n' |
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | LC_ALL=C sort |
    awk 'NF { value = value separator $0; separator = "," } END { print value }')
  [ "$gr_sources" = "$gr_wanted_sources" ] || return 1
  [ "$gr_destinations" = "$gr_wanted_destinations" ] || return 1
  gr_shape=$(printf '%s\n' "$gr_normalized" | sed \
    -e 's/ip saddr { [^}]* }/ip saddr { SOURCE }/' \
    -e 's/ip daddr { [^}]* }/ip daddr { DESTINATION }/')
  [ "$gr_shape" = "ip saddr { SOURCE } ip daddr { DESTINATION } tcp $gr_port_field 2379 counter drop comment \"$gr_marker\"" ] ||
    return 1
  gr_handle=$(printf '%s\n' "$gr_rule" |
    sed -n 's/.* # handle \([0-9][0-9]*\)$/\1/p')
  case $gr_handle in *[!0-9]*|'') return 1 ;; esac
  printf '%s\n' "$gr_handle"
}

resolve_guard_handles() {
  rg_live_table=$(nft -a list table inet fw4) || return 1
  rg_guard_rules=$(printf '%s\n' "$rg_live_table" |
    grep -F 'comment "fabric etcd fence ' || true)
  [ "$(printf '%s\n' "$rg_guard_rules" |
    awk 'NF { n++ } END { print n + 0 }')" -eq 2 ] || return 1
  rg_live_forward=$(nft -a list chain inet fw4 forward) || return 1
  rg_request=$(printf '%s\n' "$rg_live_forward" |
    grep -F 'comment "fabric etcd fence client requests"' || true)
  rg_reply=$(printf '%s\n' "$rg_live_forward" |
    grep -F 'comment "fabric etcd fence server replies"' || true)
  [ "$(printf '%s\n' "$rg_request" |
    awk 'NF { n++ } END { print n + 0 }')" -eq 1 ] || return 1
  [ "$(printf '%s\n' "$rg_reply" |
    awk 'NF { n++ } END { print n + 0 }')" -eq 1 ] || return 1
  rg_request_handle=$(guard_rule_handle "$rg_request" \
    'fabric etcd fence client requests' dport \
    '10.66.1.10,10.66.1.11' '10.66.0.10,10.66.0.11,10.66.0.12') || return 1
  rg_reply_handle=$(guard_rule_handle "$rg_reply" \
    'fabric etcd fence server replies' sport \
    '10.66.0.10,10.66.0.11,10.66.0.12' '10.66.1.10,10.66.1.11') || return 1
  [ "$rg_request_handle" != "$rg_reply_handle" ] || return 1
  rg_executable=$(printf '%s\n' "$rg_live_forward" | awk '
    $1 == "chain" && $2 == "forward" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && $0 !~ /^[[:space:]]*type / && /# handle [0-9]+$/ { print }
  ')
  [ "$(printf '%s\n' "$rg_executable" | sed -n '1p')" = "$rg_request" ] ||
    return 1
  [ "$(printf '%s\n' "$rg_executable" | sed -n '2p')" = "$rg_reply" ] ||
    return 1
  rg_first_accept=$(printf '%s\n' "$rg_executable" |
    grep -n 'accept.*# handle [0-9][0-9]*$' | sed -n '1s/:.*//p')
  case $rg_first_accept in *[!0-9]*|'') return 1 ;; esac
  [ "$rg_first_accept" -gt 2 ] || return 1
  printf '%s %s\n' "$rg_request_handle" "$rg_reply_handle"
}

