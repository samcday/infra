restart_watchdog_on_failure() {
  accept_status=$?
  trap - EXIT HUP INT TERM
  if [ "$accept_success" != true ]; then
    set +e
    "$init" enable >/dev/null 2>&1
    if ! "$init" running >/dev/null 2>&1; then
      "$init" start >/dev/null 2>&1
    fi
    "$init" running >/dev/null 2>&1
  fi
  exit "$accept_status"
}
