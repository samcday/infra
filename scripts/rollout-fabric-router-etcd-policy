run_fence() {
  fence_check=false
  [[ $mode == fence-check ]] && fence_check=true

  cluster_lock_holder="$(hostname):$$:router-etcd-fence:$head:$fence_contract_sha256"
  cluster_lock_held=false
  cluster_lock_uid=
  cluster_lock_resource_version=
  fence_remote_staged=false
  fence_armed=false
  success=false

  # shellcheck disable=SC2329 # Invoked indirectly by the EXIT trap below.
  fence_cleanup() {
    local status=$?
    trap - EXIT HUP INT TERM
    trap '' HUP INT TERM
    set +e
    if ! $fence_check && ! $success; then
      if $fence_armed || $fence_remote_staged; then
        if router_ssh /bin/sh -s -- "$fence_remote_work" "$fence_remote_init" \
            "$fence_token" "$fence_remote_operation_lock" "$fence_operation_id" \
            "$fence_transition_sha256" "$fence_guard_sha256" \
            "$enforcer_sha" "$init_sha" \
            >/dev/null 2>&1 <<'REMOTE_FORCE_FENCE'
set -eu
work=$1
init=$2
firewall=/etc/config/firewall
guard=/usr/share/nftables.d/chain-pre/forward/10-fabric-etcd-fence.nft
token=$3
operation_lock=$4
operation_id=$5
payload_sha=$6
guard_sha=$7
enforcer_sha=$8
init_sha=$9
[ "$operation_lock" = /tmp/fabric-router-etcd-policy-fence.operation ]
case $operation_id in ''|*[!0-9a-f]*) exit 1 ;; esac
[ "$(printf '%s' "$operation_id" | wc -c)" -eq 64 ]
case "$payload_sha:$guard_sha:$enforcer_sha:$init_sha" in
  *[!0-9a-f:]*|'') exit 1 ;;
esac
[ -d /tmp ] && [ ! -L /tmp ]
[ "$(stat -c '%u:%g:%a:%F' /tmp)" = '0:0:1777:directory' ]
mkdir "$operation_lock"
chmod 0700 "$operation_lock"
printf '%s\n' "$operation_id" >"$operation_lock/owner"
chmod 0600 "$operation_lock/owner"
release_operation_lock() {
  status=$?
  entries=
  trap - EXIT HUP INT TERM
  if [ -d "$operation_lock" ] && [ ! -L "$operation_lock" ] &&
      [ "$(stat -c '%u:%g:%a:%F' "$operation_lock")" = '0:0:700:directory' ] &&
      [ -f "$operation_lock/owner" ] && [ ! -L "$operation_lock/owner" ] &&
      [ "$(stat -c '%u:%g:%a:%h:%F' "$operation_lock/owner")" = \
        '0:0:600:1:regular file' ] &&
      [ "$(cat "$operation_lock/owner")" = "$operation_id" ]; then
    entries=$(find "$operation_lock" -mindepth 1 -maxdepth 1 -print | LC_ALL=C sort)
    if [ "$entries" = "$operation_lock/owner" ]; then
      rm -- "$operation_lock/owner" && rmdir -- "$operation_lock" || status=98
    else
      status=98
    fi
  else
    status=98
  fi
  exit "$status"
}
trap release_operation_lock EXIT
trap '' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
if [ ! -e "$work" ] && [ ! -L "$work" ]; then
  staging=$work.staging
  [ -d "$staging" ] && [ ! -L "$staging" ]
  [ "$(stat -c '%u:%g:%a:%F' "$staging")" = '0:0:700:directory' ]
  [ -f "$staging/owner" ] && [ ! -L "$staging/owner" ]
  [ "$(cat "$staging/owner")" = fabric-router-etcd-policy-fence ]
  [ -f "$staging/expected-token" ] && [ ! -L "$staging/expected-token" ]
  [ "$(cat "$staging/expected-token")" = "$token" ]
  [ -f "$staging/operation-id" ] && [ ! -L "$staging/operation-id" ]
  staging_operation_id=$(cat "$staging/operation-id")
  case $staging_operation_id in ''|*[!0-9a-f]*) exit 1 ;; esac
  [ "$(printf '%s' "$staging_operation_id" | wc -c)" -eq 64 ]
  [ -f "$staging/armed" ] && [ ! -L "$staging/armed" ]
  [ "$(cat "$staging/armed")" = "$token" ]
  for manifest in firewall.fenced.sha256 early-guard.nft.sha256 enforce.sha256 \
      init.sha256; do
    [ -f "$staging/$manifest" ] && [ ! -L "$staging/$manifest" ]
    (cd "$staging" && sha256sum -c "$manifest" >/dev/null)
  done
  [ "$(sha256sum "$staging/transition.uci" | awk '{print $1}')" = "$payload_sha" ]
  [ "$(sha256sum "$staging/early-guard.nft" | awk '{print $1}')" = "$guard_sha" ]
  [ "$(sha256sum "$staging/enforce" | awk '{print $1}')" = "$enforcer_sha" ]
  [ "$(sha256sum "$staging/init" | awk '{print $1}')" = "$init_sha" ]
  [ -f "$init" ] && [ ! -L "$init" ]
  [ "$(stat -c '%u:%g:%a:%h:%F' "$init")" = '0:0:700:1:regular file' ]
  cmp -s "$staging/init" "$init"
  "$init" enable
  if ! "$init" running >/dev/null 2>&1; then
    "$init" start
  fi
  "$init" running
fi
[ -d "$work" ] && [ ! -L "$work" ]
[ -f "$work/owner" ] && [ "$(cat "$work/owner")" = fabric-router-etcd-policy-fence ]
[ -f "$work/expected-token" ] && [ "$(cat "$work/expected-token")" = "$token" ]
[ -f "$work/operation-id" ] && [ ! -L "$work/operation-id" ]
work_operation_id=$(cat "$work/operation-id")
case $work_operation_id in ''|*[!0-9a-f]*) exit 1 ;; esac
[ "$(printf '%s' "$work_operation_id" | wc -c)" -eq 64 ]
for manifest in firewall.fenced.sha256 early-guard.nft.sha256 enforce.sha256 \
    init.sha256; do
  [ -f "$work/$manifest" ] && [ ! -L "$work/$manifest" ]
  (cd "$work" && sha256sum -c "$manifest" >/dev/null)
done
[ "$(sha256sum "$work/transition.uci" | awk '{print $1}')" = "$payload_sha" ]
[ "$(sha256sum "$work/early-guard.nft" | awk '{print $1}')" = "$guard_sha" ]
[ "$(sha256sum "$work/enforce" | awk '{print $1}')" = "$enforcer_sha" ]
[ "$(sha256sum "$work/init" | awk '{print $1}')" = "$init_sha" ]
[ -f "$init" ] && [ ! -L "$init" ]
[ "$(stat -c '%u:%g:%a:%h:%F' "$init")" = '0:0:700:1:regular file' ]
cmp -s "$work/init" "$init"
if [ -e "$work/armed" ]; then
  [ -f "$work/armed" ] && [ ! -L "$work/armed" ]
  [ "$(cat "$work/armed")" = "$token" ]
else
  printf '%s\n' "$token" >"$work/armed.next"
  chmod 0600 "$work/armed.next"
  mv "$work/armed.next" "$work/armed"
fi
if [ -e "$work/disarmed" ]; then
  [ -f "$work/disarmed" ] && [ ! -L "$work/disarmed" ]
  [ "$(cat "$work/disarmed")" = "$token" ]
  "$init" stop >/dev/null 2>&1 || true
  rm -f "$work/disarmed"
fi
"$init" enable
if ! "$init" running >/dev/null 2>&1; then
  "$init" start
fi
"$init" running
REMOTE_FORCE_FENCE
        then
          printf 'Fence verification stopped; exact completed staging was armed if necessary and the persistent router-local reject enforcer remains active. Inspect %s and %s over serial.\n' \
            "$fence_remote_work" "$fence_remote_init" >&2
        else
          printf 'WARNING: fence verification stopped and exact staged router-local enforcement could not be validated and armed. Inspect the live router and %s/%s over serial immediately; the opened policy may still be live.\n' \
            "$fence_remote_work" "$fence_remote_init" >&2
        fi
      fi
      if $cluster_lock_held; then
        printf 'Global Fabric maintenance lock remains held by %s for fenced-state inspection.\n' \
          "$cluster_lock_holder" >&2
      fi
    fi
    if $fence_check && ((status == 0)); then
      rm -rf -- "$evidence_dir"
    else
      printf 'Protected router fence evidence: %s\n' "$evidence_dir" >&2
    fi
    exit "$status"
  }
  trap fence_cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  "$repo_root/scripts/rollout-fabric-root-firewall" --check \
    >"$evidence_dir/committed-root-firewall.txt" ||
    die 'committed root firewall contract is invalid'
  chmod 0600 -- "$evidence_dir/committed-root-firewall.txt"
  observer_verify || die 'fabric observer isolation verification failed before fencing'
  prepare_router_ssh
  if ! probe_fabric_api preflight; then
    note 'WARNING: Fabric API is unavailable; fence confirmation remains valid for break-glass containment.'
  fi
  inspect_post_open_probe preflight
  validate_remote_phase open-live "$evidence_dir/router-open-preflight.txt"

  if $fence_check; then
    capture_exact_root_guards check
    note 'Read-only fence preflight passed: the router is exactly open and all three root guards are exact.'
    note "Fence UCI SHA-256: $fence_transition_sha256"
    note "Fence early-drop SHA-256: $fence_guard_sha256"
    note "Fence contract SHA-256: $fence_contract_sha256"
    if $post_open_probe_present; then
      note 'Exact verdict-free failed post-open observer is present and will be removed only by --fence-run.'
    fi
    note "Exact live confirmation: $expected_confirmation"
    success=true
    return 0
  fi

  acquire_network_lock
  if probe_fabric_api before-lock; then
    if ! try_acquire_fence_cluster_lock; then
      note 'WARNING: global maintenance lock was not acquired; preserving its existing holder and proceeding with the persistent fence.'
    fi
  else
    printf 'FENCE_CLUSTER_LOCK=skipped-api-unavailable\n' \
      >"$evidence_dir/fence-cluster-lock-state.txt"
    chmod 0600 -- "$evidence_dir/fence-cluster-lock-state.txt"
    note 'WARNING: Fabric API remains unavailable; proceeding with the persistent fence under the host lock.'
  fi
  observer_verify || die 'fabric observer isolation changed before fencing'
  validate_remote_phase open-live "$evidence_dir/router-open-before-fence.txt"

  fence_token="$head:$fence_contract_sha256"
  fence_operation_id=$(printf '%s\n' \
    "$(hostname):$$:$evidence_dir:$fence_token:fence-operation" | \
    sha256sum | awk '{print $1}')
  payload_b64=$(base64 -w0 -- "$fence_transition_file")
  guard_b64=$(base64 -w0 -- "$fence_guard_file")
  read -r -d '' fence_enforcer <<'REMOTE_FENCE_ENFORCER' || true
#!/bin/sh
set -u
umask 077

work=/etc/fabric-router-etcd-policy-fence
firewall=/etc/config/firewall
candidate=$work/firewall.fenced
guard_source=$work/early-guard.nft
guard=/usr/share/nftables.d/chain-pre/forward/10-fabric-etcd-fence.nft

safe_contract() {
  [ -d "$work" ] && [ ! -L "$work" ] || return 1
  for file in owner expected-token operation-id armed firewall.fenced firewall.fenced.sha256 \
      early-guard.nft early-guard.nft.sha256 enforce enforce.sha256 init \
      init.sha256; do
    [ -f "$work/$file" ] && [ ! -L "$work/$file" ] || return 1
  done
  [ "$(cat "$work/owner")" = fabric-router-etcd-policy-fence ] || return 1
  [ "$(cat "$work/armed")" = "$(cat "$work/expected-token")" ] || return 1
  operation_id=$(cat "$work/operation-id")
  case $operation_id in ''|*[!0-9a-f]*) return 1 ;; esac
  [ "$(printf '%s' "$operation_id" | wc -c)" -eq 64 ] || return 1
  (cd "$work" && sha256sum -c firewall.fenced.sha256 >/dev/null) || return 1
  (cd "$work" && sha256sum -c early-guard.nft.sha256 >/dev/null) || return 1
  (cd "$work" && sha256sum -c enforce.sha256 >/dev/null) || return 1
  (cd "$work" && sha256sum -c init.sha256 >/dev/null) || return 1
  cmp -s "$work/init" /etc/init.d/fabric-router-etcd-policy-fence || return 1
  [ -d /etc/config ] && [ ! -L /etc/config ] || return 1
  [ -f "$firewall" ] && [ ! -L "$firewall" ] || return 1
  [ -d /usr/share/nftables.d/chain-pre/forward ] || return 1
  [ ! -L /usr/share/nftables.d/chain-pre ] || return 1
  [ ! -L /usr/share/nftables.d/chain-pre/forward ] || return 1
}

guard_rule_exact() {
  rule=$1
  marker=$2
  port_field=$3
  wanted_sources=$4
  wanted_destinations=$5
  normalized=$(printf '%s\n' "$rule" | sed \
    -e 's/^[[:space:]]*//' \
    -e 's/[[:space:]][[:space:]]*/ /g' \
    -e 's/counter packets [0-9][0-9]* bytes [0-9][0-9]*/counter/' \
    -e 's/ # handle [0-9][0-9]*$//')
  source_members=$(printf '%s\n' "$normalized" |
    sed -n 's/^ip saddr { \([^}]*\) } ip daddr.*/\1/p')
  destination_members=$(printf '%s\n' "$normalized" |
    sed -n 's/.* ip daddr { \([^}]*\) } tcp .*/\1/p')
  [ -n "$source_members" ] && [ -n "$destination_members" ] || return 1
  source_members=$(printf '%s\n' "$source_members" | tr ',' '\n' |
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | LC_ALL=C sort |
    awk 'NF { value = value separator $0; separator = "," } END { print value }')
  destination_members=$(printf '%s\n' "$destination_members" | tr ',' '\n' |
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | LC_ALL=C sort |
    awk 'NF { value = value separator $0; separator = "," } END { print value }')
  [ "$source_members" = "$wanted_sources" ] || return 1
  [ "$destination_members" = "$wanted_destinations" ] || return 1
  shape=$(printf '%s\n' "$normalized" | sed \
    -e 's/ip saddr { [^}]* }/ip saddr { SOURCE }/' \
    -e 's/ip daddr { [^}]* }/ip daddr { DESTINATION }/')
  [ "$shape" = "ip saddr { SOURCE } ip daddr { DESTINATION } tcp $port_field 2379 counter drop comment \"$marker\"" ]
}

guard_live() {
  [ -f "$guard" ] && [ ! -L "$guard" ] || return 1
  cmp -s "$guard_source" "$guard" || return 1
  share_nft_files=$(find /usr/share/nftables.d -name '*.nft' -print | LC_ALL=C sort)
  [ "$share_nft_files" = "$guard" ] || return 1
  etc_nft_files=$(find /etc/nftables.d -mindepth 1 -maxdepth 1 \
    -name '*.nft' -print | LC_ALL=C sort)
  [ "$etc_nft_files" = '/etc/nftables.d/10-custom-filter-chains.nft' ] || return 1
  [ -f /etc/nftables.d/10-custom-filter-chains.nft ] &&
    [ ! -L /etc/nftables.d/10-custom-filter-chains.nft ] || return 1
  active_etc_nft=$(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' \
    /etc/nftables.d/10-custom-filter-chains.nft)
  [ -z "$active_etc_nft" ] || return 1
  live=$(nft -a list chain inet fw4 forward) || return 1
  request=$(printf '%s\n' "$live" |
    grep -F 'comment "fabric etcd fence client requests"' || true)
  reply=$(printf '%s\n' "$live" |
    grep -F 'comment "fabric etcd fence server replies"' || true)
  [ "$(printf '%s\n' "$request" | awk 'NF { n++ } END { print n + 0 }')" -eq 1 ] ||
    return 1
  [ "$(printf '%s\n' "$reply" | awk 'NF { n++ } END { print n + 0 }')" -eq 1 ] ||
    return 1
  service_members='10.66.1.10,10.66.1.11'
  root_members='10.66.0.10,10.66.0.11,10.66.0.12'
  guard_rule_exact "$request" 'fabric etcd fence client requests' dport \
    "$service_members" "$root_members" || return 1
  guard_rule_exact "$reply" 'fabric etcd fence server replies' sport \
    "$root_members" "$service_members" || return 1
  request_line=$(printf '%s\n' "$live" |
    grep -nF 'comment "fabric etcd fence client requests"' | cut -d: -f1)
  reply_line=$(printf '%s\n' "$live" |
    grep -nF 'comment "fabric etcd fence server replies"' | cut -d: -f1)
  executable_lines=$(printf '%s\n' "$live" | awk '
    $1 == "chain" && $2 == "forward" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && $0 !~ /^[[:space:]]*type / && /# handle [0-9]+$/ { print NR ":" $0 }
  ')
  first_rule_line=$(printf '%s\n' "$executable_lines" | sed -n '1s/:.*//p')
  second_rule_line=$(printf '%s\n' "$executable_lines" | sed -n '2s/:.*//p')
  first_accept_line=$(printf '%s\n' "$executable_lines" |
    grep 'accept.*# handle [0-9][0-9]*$' | sed -n '1s/:.*//p')
  case "$request_line:$reply_line:$first_rule_line:$second_rule_line:$first_accept_line" in
    *[!0-9:]*|*::*|:*|*:) return 1 ;;
  esac
  [ "$request_line" -eq "$first_rule_line" ] &&
    [ "$reply_line" -eq "$second_rule_line" ] || return 1
  [ "$request_line" -lt "$first_accept_line" ] &&
    [ "$reply_line" -lt "$first_accept_line" ] || return 1
}

is_fenced() {
  safe_contract || return 1
  cmp -s "$candidate" "$firewall" || return 1
  [ -z "$(uci -q changes firewall || true)" ] || return 1
  fw4 check >/dev/null || return 1
  [ "$(uci -q get firewall.fabric_flat_reject_services_etcd.name)" = \
    Reject-services-to-root-etcd ] || return 1
  [ "$(uci -q get firewall.fabric_flat_reject_services_etcd.dest_port)" = \
    '2379 2380 2381' ] || return 1
  [ "$(uci -q get firewall.fabric_flat_reject_services_etcd.target)" = REJECT ] || return 1
  ! uci -q get firewall.fabric_flat_services_etcd_client >/dev/null 2>&1 || return 1
  ! uci -q get firewall.fabric_flat_reject_services_etcd_internal >/dev/null 2>&1 || return 1
  live_lan=$(nft -a list chain inet fw4 forward_lan) || return 1
  [ "$(printf '%s\n' "$live_lan" | grep -Fc 'comment "!fw4: Reject-services-to-root-etcd"')" -eq 1 ] || return 1
  ! printf '%s\n' "$live_lan" | grep -F 'comment "!fw4: Allow-platform-to-root-etcd-client"' >/dev/null || return 1
  ! printf '%s\n' "$live_lan" | grep -F 'comment "!fw4: Reject-services-to-root-etcd-internal"' >/dev/null || return 1
  guard_live
}

apply_fence() {
  safe_contract || return 1
  uci -q revert firewall || true
  cp "$guard_source" "$guard.next" || return 1
  chown 0:0 "$guard.next" || return 1
  chmod 0600 "$guard.next" || return 1
  mv "$guard.next" "$guard" || return 1
  cp "$candidate" /etc/config/.firewall.fabric-etcd-fence.next || return 1
  chown 0:0 /etc/config/.firewall.fabric-etcd-fence.next || return 1
  chmod 0600 /etc/config/.firewall.fabric-etcd-fence.next || return 1
  mv /etc/config/.firewall.fabric-etcd-fence.next "$firewall" || return 1
  fw4 check >/dev/null || return 1
  /etc/init.d/firewall reload >/dev/null || return 1
  is_fenced
}

while :; do
  if safe_contract && { is_fenced || apply_fence; }; then
    token=$(cat "$work/expected-token")
    printf '%s\n' "$token" >"$work/applied.next"
    chmod 0600 "$work/applied.next"
    mv "$work/applied.next" "$work/applied"
  else
    logger -t fabric-router-etcd-policy-fence \
      'fence application failed; retrying without restoring the open policy'
  fi
  sleep 2
done
REMOTE_FENCE_ENFORCER

  read -r -d '' fence_init <<'REMOTE_FENCE_INIT' || true
#!/bin/sh /etc/rc.common
USE_PROCD=1
START=98
STOP=01

promote_staging() {
  work=/etc/fabric-router-etcd-policy-fence
  staging=$work.staging
  if [ ! -e "$work" ] && [ ! -L "$work" ]; then
    [ -d "$staging" ] && [ ! -L "$staging" ] || return 1
    [ -f "$staging/owner" ] && [ ! -L "$staging/owner" ] &&
      [ "$(cat "$staging/owner")" = fabric-router-etcd-policy-fence ] || return 1
    [ -f "$staging/operation-id" ] && [ ! -L "$staging/operation-id" ] ||
      return 1
    operation_id=$(cat "$staging/operation-id")
    case $operation_id in ''|*[!0-9a-f]*) return 1 ;; esac
    [ "$(printf '%s' "$operation_id" | wc -c)" -eq 64 ] || return 1
    [ -f "$staging/expected-token" ] && [ ! -L "$staging/expected-token" ] &&
      [ -f "$staging/armed" ] && [ ! -L "$staging/armed" ] &&
      [ "$(cat "$staging/expected-token")" = "$(cat "$staging/armed")" ] || return 1
    for manifest in firewall.fenced.sha256 early-guard.nft.sha256 \
        enforce.sha256 init.sha256; do
      [ -f "$staging/$manifest" ] && [ ! -L "$staging/$manifest" ] || return 1
      (cd "$staging" && sha256sum -c "$manifest" >/dev/null) || return 1
    done
    cmp -s "$staging/init" /etc/init.d/fabric-router-etcd-policy-fence ||
      return 1
    mv "$staging" "$work" || return 1
  fi
  [ -d "$work" ] && [ ! -L "$work" ] || return 1
  [ ! -e "$staging" ] && [ ! -L "$staging" ] || return 1
}

start_service() {
  promote_staging || return 1
  procd_open_instance
  procd_set_param command /bin/sh /etc/fabric-router-etcd-policy-fence/enforce
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param term_timeout 5
  procd_set_param respawn 3600 5 0
  procd_close_instance
}
REMOTE_FENCE_INIT

  enforcer_b64=$(printf '%s' "$fence_enforcer" | base64 -w0)
  init_b64=$(printf '%s' "$fence_init" | base64 -w0)
  enforcer_sha=$(printf '%s' "$fence_enforcer" | sha256sum | awk '{print $1}')
  init_sha=$(printf '%s' "$fence_init" | sha256sum | awk '{print $1}')
