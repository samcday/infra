success=false

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  trap '' HUP INT TERM
  set +e
  if [[ $mode == run && $success == false ]]; then
    if $rollback_accepted; then
      printf 'Transition was terminally accepted before later bookkeeping failed; no rollback fence was requested. Inspect %s and %s over serial before retrying.\n' \
        "$remote_work" "$remote_init" >&2
    elif $rollback_armed; then
      local force_result force_status
      force_result=$(router_ssh /bin/sh -s -- "$remote_work" "$remote_init" \
        2>/dev/null <<'REMOTE_FORCE_ROLLBACK'
set -eu
work=$1
init=$2
firewall=/etc/config/firewall
guard=/usr/share/nftables.d/chain-pre/forward/10-fabric-etcd-fence.nft
[ -d "$work" ] && [ ! -L "$work" ]
[ -f "$work/owner" ] && [ "$(cat "$work/owner")" = fabric-router-etcd-policy-rollout ]
[ -f "$work/armed" ] && [ ! -L "$work/armed" ]
[ -f "$work/expected-token" ] &&
  [ "$(cat "$work/armed")" = "$(cat "$work/expected-token")" ]
token=$(cat "$work/expected-token")
[ -f "$work/fence-state" ] && [ ! -L "$work/fence-state" ] &&
  [ "$(cat "$work/fence-state")" = "fence:$token" ]
[ -f "$work/accept-state" ] && [ ! -L "$work/accept-state" ] &&
  [ "$(cat "$work/accept-state")" = "accept:$token" ]
[ -f "$work/accepted-state" ] && [ ! -L "$work/accepted-state" ] &&
  [ "$(cat "$work/accepted-state")" = "$token" ]
terminal_state() {
  if [ ! -e "$work/terminal" ] && [ ! -L "$work/terminal" ]; then
    printf 'none\n'
  elif [ -f "$work/terminal" ] && [ ! -L "$work/terminal" ] &&
      [ "$(cat "$work/terminal")" = "fence:$token" ] &&
      [ "$(stat -c '%d:%i' "$work/terminal")" = \
        "$(stat -c '%d:%i' "$work/fence-state")" ]; then
    printf 'fence\n'
  elif [ -f "$work/terminal" ] && [ ! -L "$work/terminal" ] &&
      [ "$(cat "$work/terminal")" = "accept:$token" ] &&
      [ "$(stat -c '%d:%i' "$work/terminal")" = \
        "$(stat -c '%d:%i' "$work/accept-state")" ]; then
    printf 'accept\n'
  else
    printf 'invalid\n'
  fi
}
acceptance_state() {
  if [ ! -e "$work/accepted" ] && [ ! -L "$work/accepted" ]; then
    printf 'none\n'
  elif [ -f "$work/accepted" ] && [ ! -L "$work/accepted" ] &&
      [ "$(cat "$work/accepted")" = "$token" ] &&
      [ "$(stat -c '%d:%i' "$work/accepted")" = \
        "$(stat -c '%d:%i' "$work/accepted-state")" ]; then
    printf 'accept\n'
  elif [ -f "$work/accepted" ] && [ ! -L "$work/accepted" ] &&
      [ "$(cat "$work/accepted")" = "fence:$token" ] &&
      [ "$(stat -c '%d:%i' "$work/accepted")" = \
        "$(stat -c '%d:%i' "$work/fence-state")" ]; then
    printf 'fence\n'
  else
    printf 'invalid\n'
  fi
}
accept_complete_exact() {
  [ -f "$work/accept-complete" ] && [ ! -L "$work/accept-complete" ] &&
    [ "$(cat "$work/accept-complete")" = "$token" ] &&
    [ "$(stat -c '%d:%i' "$work/accept-complete")" = \
      "$(stat -c '%d:%i' "$work/accepted-state")" ]
}
accepted_open_exact() {
  [ "$(terminal_state)" = accept ] || return 1
  [ "$(acceptance_state)" = accept ] || return 1
  accept_complete_exact || return 1
  [ -f "$firewall" ] && [ ! -L "$firewall" ] || return 1
  cmp -s "$firewall" "$work/candidate/firewall" || return 1
  [ -z "$(uci -q changes firewall || true)" ] || return 1
  [ "$(uci -q get firewall.fabric_flat_services_etcd_client.name)" = \
    Allow-platform-to-root-etcd-client ] || return 1
  [ "$(uci -q get firewall.fabric_flat_reject_services_etcd_internal.name)" = \
    Reject-services-to-root-etcd-internal ] || return 1
  ! uci -q get firewall.fabric_flat_reject_services_etcd >/dev/null 2>&1 ||
    return 1
  [ ! -e "$guard" ] && [ ! -L "$guard" ] || return 1
  [ -z "$(find /usr/share/nftables.d -name '*.nft' -print)" ] || return 1
  fw4 check >/dev/null || return 1
  [ "$(nft list tables)" = 'table inet fw4' ] || return 1
  live_table=$(nft -a list table inet fw4) || return 1
  ! printf '%s\n' "$live_table" |
    grep -F 'comment "fabric etcd fence ' >/dev/null || return 1
  live_lan=$(nft -a list chain inet fw4 forward_lan) || return 1
  expected_order='Block-fabric-to-private-WAN
Allow-roots-to-public-WAN
Allow-services-to-public-Web
Reject-other-fabric-to-WAN
Allow-platform-to-root-etcd-client
Reject-services-to-root-etcd-internal
Allow-services-to-fabric-API
Allow-services-to-root-VXLAN
Allow-roots-to-services-VXLAN
Allow-services-to-root-kubelets
Allow-roots-to-service-kubelets
Allow-observer-to-services-SSH
Allow-services-to-Bootie-rootfs
Reject-other-services-to-roots
Reject-other-roots-to-services'
  actual_order=$(printf '%s\n' "$live_lan" |
    sed -n 's/.*comment "!fw4: \([^"]*\)".*/\1/p')
  [ "$actual_order" = "$expected_order" ] || return 1
  [ "$(printf '%s\n' "$live_lan" | awk '
    $1 == "chain" && $2 == "forward_lan" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && /# handle [0-9]+$/ { n++ }
    END { print n + 0 }
  ')" -eq 16 ] || return 1
  terminal_rule=$(printf '%s\n' "$live_lan" | awk '
    $1 == "chain" && $2 == "forward_lan" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && /# handle [0-9]+$/ { terminal = $0 }
    END { print terminal }
  ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]][[:space:]]*/ /g' \
    -e 's/ # handle [0-9][0-9]*$//')
  [ "$terminal_rule" = 'jump reject_to_lan' ]
}
needs_fence=true
state=$(terminal_state)
[ "$state" != invalid ]
if [ "$state" = none ]; then
  ln "$work/fence-state" "$work/terminal" 2>/dev/null || true
  state=$(terminal_state)
  [ "$state" != none ] && [ "$state" != invalid ]
fi
if [ "$state" = accept ]; then
  acceptance=$(acceptance_state)
  [ "$acceptance" != invalid ]
  if [ "$acceptance" = none ]; then
    ln "$work/fence-state" "$work/accepted" 2>/dev/null || true
    acceptance=$(acceptance_state)
    [ "$acceptance" != none ] && [ "$acceptance" != invalid ]
  fi
  if [ "$acceptance" = accept ]; then
    needs_fence=false
  else
    [ "$acceptance" = fence ]
  fi
fi
if [ "$needs_fence" = true ]; then
  if [ -e "$work/force-rollback" ] || [ -L "$work/force-rollback" ]; then
    [ -f "$work/force-rollback" ] && [ ! -L "$work/force-rollback" ] &&
      [ "$(cat "$work/force-rollback")" = "$token" ]
  else
    printf '%s\n' "$token" >"$work/force-rollback.next"
    chmod 0600 "$work/force-rollback.next"
    mv "$work/force-rollback.next" "$work/force-rollback"
    sync
  fi
elif accepted_open_exact; then
  sync
  if accepted_open_exact; then
    printf 'ROLLBACK_ACCEPTED=%s\n' "$token"
    exit 0
  fi
fi
"$init" enable
if ! "$init" running >/dev/null 2>&1; then
  "$init" start
fi
"$init" running
attempt=0
while [ "$attempt" -lt 30 ]; do
  state=$(terminal_state)
  acceptance=none
  if [ "$state" = accept ]; then
    acceptance=$(acceptance_state)
    [ "$acceptance" != invalid ]
    if [ "$acceptance" = accept ] && accepted_open_exact; then
      sync
      if accepted_open_exact; then
        printf 'ROLLBACK_ACCEPTED=%s\n' "$token"
        exit 0
      fi
    fi
  fi
  if { [ "$state" = fence ] ||
       { [ "$state" = accept ] && [ "$acceptance" = fence ]; }; } &&
      [ -f "$work/fenced" ] &&
      [ ! -L "$work/fenced" ] && [ "$(cat "$work/fenced")" = "$token" ] &&
      "$init" enabled >/dev/null 2>&1 && "$init" running >/dev/null 2>&1; then
    printf 'ROLLBACK_FENCED=%s\n' "$token"
    exit 0
  fi
  [ "$state" != invalid ]
  attempt=$((attempt + 1))
  sleep 1
done
exit 1
REMOTE_FORCE_ROLLBACK
      )
      force_status=$?
      if [[ $force_status -eq 0 && $force_result == "ROLLBACK_FENCED=$rollout_token" ]]; then
        printf 'Transition stopped; the router acknowledged the persistent early-drop rollback fence. Inspect %s and %s over serial before retrying.\n' \
          "$remote_work" "$remote_init" >&2
      elif [[ $force_status -eq 0 && $force_result == "ROLLBACK_ACCEPTED=$rollout_token" ]]; then
        rollback_accepted=true
        printf 'Transition stopped after the router had terminally accepted the open state; no rollback fence was requested. Inspect %s and %s over serial before retrying.\n' \
          "$remote_work" "$remote_init" >&2
      else
        printf 'WARNING: transition stopped and the persistent rollback fence was not acknowledged over SSH. The enabled watchdog will retry at its deadline and on reboot; inspect %s and %s over serial immediately.\n' \
          "$remote_work" "$remote_init" >&2
      fi
    elif $remote_staged; then
      router_ssh /bin/sh -s -- "$remote_work" "$remote_init" >/dev/null 2>&1 <<'REMOTE_UNSTAGED_CLEANUP' || true
set -eu
work=$1
init=$2
[ -d "$work" ] && [ ! -L "$work" ]
[ -f "$work/owner" ] && [ "$(cat "$work/owner")" = fabric-router-etcd-policy-rollout ]
[ ! -L "$init" ]
if [ -e "$init" ]; then
  [ -f "$init" ]
  if "$init" running >/dev/null 2>&1 || "$init" enabled >/dev/null 2>&1; then
    exit 1
  fi
fi
if find /etc/rc.d -maxdepth 1 -type l -name '*fabric-router-etcd-policy-rollback' | grep . >/dev/null; then
  exit 1
fi
rm -f -- "$init"
rm -rf -- "$work"
REMOTE_UNSTAGED_CLEANUP
    fi
    if $cluster_lock_held; then
      printf 'Global Fabric maintenance lock remains held by %s for inspection.\n' \
        "$cluster_lock_holder" >&2
    fi
  fi
  if [[ $mode == check && $status -eq 0 ]]; then
    rm -rf -- "$evidence_dir"
  else
    printf 'Protected router transition evidence: %s\n' "$evidence_dir" >&2
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

check_committed_root_firewall
verify_pre_open_contract preflight
observer_verify || die 'fabric observer isolation verification failed'
prepare_router_ssh
operator_kubectl get --raw=/readyz >"$evidence_dir/fabric-readyz-before" ||
  die 'Fabric Kubernetes API is not ready before router transition'
[[ $(<"$evidence_dir/fabric-readyz-before") == ok ]] ||
  die 'Fabric Kubernetes API returned an unexpected readiness response'
validate_remote_phase pre "$evidence_dir/router-preflight.txt"
capture_exact_root_guards preflight

if [[ $mode == check ]]; then
  note 'Read-only preflight passed: the pre-open contract, root guards, and old router reject phase are exact.'
  note "Payload SHA-256: $transition_sha256"
  note "Exact live confirmation: $expected_confirmation"
  success=true
  exit 0
fi

acquire_network_lock
acquire_cluster_network_lock
verify_pre_open_contract locked-before-source \
  --expected-lock-holder "$cluster_lock_holder"
qualify_pod_sources_under_parent_locks
verify_pre_open_contract locked-after-source \
  --expected-lock-holder "$cluster_lock_holder"
capture_exact_root_guards locked
for index in "${!root_nodes[@]}"; do
  cmp -s -- "$evidence_dir/root-$((index + 1))-guard.preflight.normalized" \
    "$evidence_dir/root-$((index + 1))-guard.locked.normalized" ||
    die "${root_nodes[$index]} fabric_guard semantics changed after preflight"
done
observer_verify || die 'fabric observer isolation changed before router transition'
