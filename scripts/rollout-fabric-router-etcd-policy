release_operation_lock() {
  status=$?
  entries=
  trap - EXIT HUP INT TERM
  if [ -d "$operation_lock" ] && [ ! -L "$operation_lock" ] &&
      [ "$(stat -c '%u:%g:%a:%F' "$operation_lock")" = '0:0:700:directory' ] &&
      [ -f "$operation_lock/owner" ] && [ ! -L "$operation_lock/owner" ] &&
      [ "$(stat -c '%u:%g:%a:%h:%F' "$operation_lock/owner")" = \
        '0:0:600:1:regular file' ] &&
      [ "$(cat "$operation_lock/owner")" = "$operation_id" ]; then
    entries=$(find "$operation_lock" -mindepth 1 -maxdepth 1 -print | LC_ALL=C sort)
    if [ "$entries" = "$operation_lock/owner" ]; then
      rm -- "$operation_lock/owner" && rmdir -- "$operation_lock" || status=98
    else
      status=98
    fi
  else
    status=98
  fi
  exit "$status"
}
trap release_operation_lock EXIT
