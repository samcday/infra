accepted_open_exact() {
  [ -f "$work/accepted" ] && [ ! -L "$work/accepted" ] &&
    [ "$(cat "$work/accepted")" = "$token" ] &&
    [ "$(stat -c '%d:%i' "$work/accepted")" = \
      "$(stat -c '%d:%i' "$work/accepted-state")" ] || return 1
  [ -f "$work/accept-complete" ] && [ ! -L "$work/accept-complete" ] &&
    [ "$(cat "$work/accept-complete")" = "$token" ] &&
    [ "$(stat -c '%d:%i' "$work/accept-complete")" = \
      "$(stat -c '%d:%i' "$work/accepted-state")" ] || return 1
  [ -f "$firewall" ] && [ ! -L "$firewall" ] || return 1
  cmp -s "$firewall" "$work/candidate/firewall" || return 1
  [ -z "$(uci -q changes firewall || true)" ] || return 1
  [ "$(uci -q get firewall.fabric_flat_services_etcd_client.name)" = \
    Allow-platform-to-root-etcd-client ] || return 1
  [ "$(uci -q get firewall.fabric_flat_reject_services_etcd_internal.name)" = \
    Reject-services-to-root-etcd-internal ] || return 1
  ! uci -q get firewall.fabric_flat_reject_services_etcd >/dev/null 2>&1 ||
    return 1
  [ ! -e "$guard" ] && [ ! -L "$guard" ] || return 1
  [ -z "$(find /usr/share/nftables.d -name '*.nft' -print)" ] || return 1
  fw4 check >/dev/null || return 1
  [ "$(nft list tables)" = 'table inet fw4' ] || return 1
  aoe_live_table=$(nft -a list table inet fw4) || return 1
  ! printf '%s\n' "$aoe_live_table" |
    grep -F 'comment "fabric etcd fence ' >/dev/null || return 1
  aoe_live=$(nft -a list chain inet fw4 forward_lan) || return 1
  aoe_actual_forward=$(printf '%s\n' "$aoe_live" |
    sed -n 's/.*comment "!fw4: \([^"]*\)".*/\1/p')
  [ "$aoe_actual_forward" = "$expected_forward" ] || return 1
  [ "$(printf '%s\n' "$aoe_live" | awk '
    $1 == "chain" && $2 == "forward_lan" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && /# handle [0-9]+$/ { n++ }
    END { print n + 0 }
  ')" -eq 16 ] || return 1
  aoe_terminal=$(printf '%s\n' "$aoe_live" | awk '
    $1 == "chain" && $2 == "forward_lan" && $3 == "{" { inside = 1; next }
    inside && $1 == "}" { inside = 0 }
    inside && /# handle [0-9]+$/ { terminal = $0 }
    END { print terminal }
  ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]][[:space:]]*/ /g' \
    -e 's/ # handle [0-9][0-9]*$//')
  [ "$aoe_terminal" = 'jump reject_to_lan' ]
}
