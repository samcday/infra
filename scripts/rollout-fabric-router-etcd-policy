  router_ssh /bin/sh -s -- "$fence_remote_work" "$fence_remote_init" \
    "$fence_remote_guard" "$fence_guard_sha256" "$fence_token" \
    >"$evidence_dir/router-fence-persistence.txt" <<'REMOTE_FENCE_PERSISTENCE'
set -eu
work=$1
init=$2
guard=$3
guard_sha=$4
token=$5
firewall=/etc/config/firewall
[ -d "$work" ] && [ ! -L "$work" ]
[ -f "$work/owner" ] && [ "$(cat "$work/owner")" = fabric-router-etcd-policy-fence ]
[ -f "$work/armed" ] && [ "$(cat "$work/armed")" = "$token" ]
[ -f "$work/applied" ] && [ "$(cat "$work/applied")" = "$token" ]
[ ! -e "$work/disarmed" ] && [ ! -L "$work/disarmed" ]
"$init" enabled
"$init" running
(cd "$work" && sha256sum -c firewall.fenced.sha256 >/dev/null)
(cd "$work" && sha256sum -c early-guard.nft.sha256 >/dev/null)
cmp -s "$work/firewall.fenced" "$firewall"
cmp -s "$work/early-guard.nft" "$guard"
[ "$(sha256sum "$guard" | awk '{print $1}')" = "$guard_sha" ]
[ "$(find /etc/rc.d -maxdepth 1 -type l \
  -name '*fabric-router-etcd-policy-fence' | awk 'NF { n++ } END { print n + 0 }')" -eq 1 ]
printf 'FENCE_PERSISTENT=%s\n' "$token"
REMOTE_FENCE_PERSISTENCE

  validate_remote_phase fenced "$evidence_dir/router-fenced-final.txt"
  capture_exact_root_guards final
  for index in "${!root_nodes[@]}"; do
    cmp -s -- "$evidence_dir/root-$((index + 1))-guard.fenced.normalized" \
      "$evidence_dir/root-$((index + 1))-guard.final.normalized" ||
      die "${root_nodes[$index]} fabric_guard semantics changed during persistent fence proof"
  done
  observer_verify || die 'fabric observer isolation changed during persistent fence proof'
  api_ready_final=false
  if probe_fabric_api final; then
    api_ready_final=true
  else
    note 'WARNING: Fabric API remains unavailable at final fence proof.'
  fi
  if $cluster_lock_held; then
    if $api_ready_final; then
      release_cluster_network_lock
    else
      note "WARNING: acquired global maintenance lock remains held by $cluster_lock_holder because the API is unavailable."
    fi
  fi
  success=true
  note "FABRIC_ROUTER_ETCD_POLICY_FENCE=pass revision=$head contract=$fence_contract_sha256"
  note "Persistent router fence remains enabled at $fence_remote_init"
  note "Protected evidence retained at $evidence_dir"
}

case $mode in
  fence-check | fence-run)
    run_fence
    exit 0
    ;;
esac

