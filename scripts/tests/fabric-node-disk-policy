#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/lib/fabric-node-disk-policy.sh
source "$script_dir/../lib/fabric-node-disk-policy.sh"

failures=0

accept() {
  local node=$1
  local disk=$2
  local expected_kind=$3
  local expected_wwn=$4

  if ! fabric_validate_node_disk_destination "$node" "$disk"; then
    echo "expected acceptance: $node $disk" >&2
    ((failures += 1))
    return
  fi
  if [[ $FABRIC_DISK_KIND != "$expected_kind" || $FABRIC_DISK_WWN != "$expected_wwn" ]]; then
    echo "wrong classification for $node $disk: $FABRIC_DISK_KIND $FABRIC_DISK_WWN" >&2
    ((failures += 1))
  fi
}

reject() {
  local node=$1
  local disk=$2

  if fabric_validate_node_disk_destination "$node" "$disk" >/dev/null 2>&1; then
    echo "expected rejection: $node $disk" >&2
    ((failures += 1))
  fi
}

accept fabric-az1-cp1 "$FABRIC_CP1_NVME_DESTINATION" nvme eui.002538839100c827
accept fabric-az1-cp2 "$FABRIC_CP2_NVME_DESTINATION" nvme eui.002538bb71b4bb45
accept fabric-az1-cp3 /dev/disk/by-id/ata-EXACT_INVENTORIED_CP3_DEVICE ata ''

reject fabric-az1-cp1 /dev/disk/by-id/ata-UNRELATED_DEVICE
reject fabric-az1-cp2 /dev/disk/by-id/ata-UNRELATED_DEVICE
reject fabric-az1-cp3 "$FABRIC_CP1_NVME_DESTINATION"
reject fabric-az1-cp3 "$FABRIC_CP2_NVME_DESTINATION"
reject fabric-az1-cp1 "$FABRIC_CP2_NVME_DESTINATION"
reject fabric-az1-cp2 "$FABRIC_CP1_NVME_DESTINATION"
reject fabric-az1-cp2 /dev/disk/by-id/nvme-eui.0123456789abcdef
reject fabric-az1-cp2 /dev/disk/by-id/nvme-S35ENX0JB81948
reject fabric-az1-cp2 /dev/disk/by-id/nvme-eui.002538BB71B4BB45
reject fabric-az1-cp2 "$FABRIC_CP2_NVME_DESTINATION-part1"
reject fabric-az1-cp2 /dev/disk/by-id/nvme-eui.0000000000000000
reject fabric-az1-cp2 /dev/disk/by-id/nvme-eui.ffffffffffffffff
reject fabric-az1-cp4 /dev/disk/by-id/ata-UNRELATED_DEVICE

((failures == 0)) || exit 1
echo 'fabric node disk admission policy passed'
