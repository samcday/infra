#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
control_plane_profile=$repo_root/fabric/butane/control-plane.yaml
node=
confirmation=
check_only=false
verify_live_all=false

readonly k3s_unit_path=/etc/systemd/system/k3s.service
readonly k3s_firewall_dropin_path=/etc/systemd/system/k3s.service.d/10-fabric-guard.conf
readonly k3s_quorum_dropin_path=/etc/systemd/system/k3s.service.d/20-etcd-quorum.conf
readonly k3s_etcd_dropin_path=/etc/systemd/system/k3s.service.d/etcd.conf
readonly api_vip=https://10.66.0.254:6443

usage() {
  cat >&2 <<'EOF'
Roll out the committed fabric root network policy to one consensus member.

Usage:
  scripts/rollout-fabric-root-firewall --node <cp1|cp2|cp3> \
    --confirm ROLLOUT-FABRIC-ROOT-NETWORK-POLICY:<full-node>:<main-commit>:<combined-policy-sha256>

  scripts/rollout-fabric-root-firewall --check

  scripts/rollout-fabric-root-firewall --verify-live-all

The network policy is the exact root nftables guard plus the exact routed-host
sysctl payload. Run one member at a time and prove target-local plus
cluster-wide API/etcd health before proceeding to the next. The helper
acquires the global Fabric maintenance ConfigMap lock, requires a clean
pushed main branch, and arms a target-local, reboot-surviving five-minute
rollback before replacing either policy. Acceptance proves the exact live
nftables input semantics and uses an acknowledged two-phase disarm. A failed
run deliberately leaves the global lock for attended inspection, blocking the
delegated trust/admin, pre-open, router, and post-open operations.
EOF
}

die() {
  echo "rollout-fabric-root-firewall: $*" >&2
  exit 1
}

while (($#)); do
  case $1 in
    --node)
      (($# >= 2)) || die '--node requires a value'
      node=$2
      shift 2
      ;;
    --confirm)
      (($# >= 2)) || die '--confirm requires a value'
      confirmation=$2
      shift 2
      ;;
    --check)
      check_only=true
      shift
      ;;
    --verify-live-all)
      verify_live_all=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if $check_only && $verify_live_all; then
  die 'choose exactly one of --check, --verify-live-all, or --node'
elif $check_only; then
  [[ -z $node && -z $confirmation ]] || die '--check does not accept --node or --confirm'
elif $verify_live_all; then
  [[ -z $node && -z $confirmation ]] ||
    die '--verify-live-all does not accept --node or --confirm'
else
  case $node in
    cp1)
      full_node=fabric-az1-cp1
      root_ip=10.66.0.10
      ;;
    cp2)
      full_node=fabric-az1-cp2
      root_ip=10.66.0.11
      ;;
    cp3)
      full_node=fabric-az1-cp3
      root_ip=10.66.0.12
      ;;
    *) die '--node must be cp1, cp2, or cp3' ;;
  esac
fi

commands=(awk date grep sed sha256sum tr yq)
if ! $check_only; then
  commands+=(git jq kubectl)
fi
if ! $check_only && ! $verify_live_all; then
  commands+=(curl mktemp)
fi
for command in "${commands[@]}"; do
  command -v "$command" >/dev/null || die "required command is unavailable: $command"
done

cd "$repo_root"
[[ -f $control_plane_profile && ! -L $control_plane_profile ]] ||
  die 'Fabric control-plane Butane profile is absent or unsafe'

firewall_path=/etc/nftables/fabric-guard.nft
routing_path=/etc/sysctl.d/90-fabric-root-routing.conf
guard_unit_path=/etc/systemd/system/fabric-guard.service
etcd_guard_dropin_path=/etc/systemd/system/etcd.service.d/10-fabric-guard.conf
systemd_service_dropin_path=/usr/lib/systemd/system/service.d/10-timeout-abort.conf
systemd_service_dropin_hash=ae6b234f92bc22f1201a7572b59b454c9809f33c80d13f361b9674e1801acc37
# shellcheck disable=SC2016 # strenv() belongs to yq, not the shell.
firewall_policy=$(TARGET_PATH="$firewall_path" yq -er \
  '.storage.files[] | select(.path == strenv(TARGET_PATH)) | .contents.inline' \
  fabric/butane/firewall.yaml)
service_set='elements = { 10.66.1.10, 10.66.1.11 }'
service_etcd_allow='ip saddr @service_nodes_v4 tcp dport 2379 counter accept comment "trusted platform etcd clients"'
service_metrics_allow='ip saddr @service_nodes_v4 tcp dport { 2112, 2381, 9100 } counter accept comment "trusted platform monitoring"'
etcd_catchall='tcp dport 2379 counter drop comment "deny all other etcd clients including stale flows"'
expected_etcd_accepts='ip saddr @root_nodes_v4 tcp dport 2379 counter accept comment "root etcd clients"
ip saddr @etcd_maintenance_v4 tcp dport 2379 counter accept comment "attended etcd maintenance"
ip saddr @service_nodes_v4 tcp dport 2379 counter accept comment "trusted platform etcd clients"'
[[ $(grep -Fc "$service_set" <<<"$firewall_policy") -eq 1 ]] ||
  die 'committed firewall policy lacks one exact two-address service set'
[[ $(grep -Fc "$service_etcd_allow" <<<"$firewall_policy") -eq 1 ]] ||
  die 'committed firewall policy lacks one exact service-node TCP/2379 allow'
[[ $(grep -Fc "$service_metrics_allow" <<<"$firewall_policy") -eq 1 ]] ||
  die 'committed firewall policy lacks one exact service-node metrics allow'
[[ $(grep -Fc "$etcd_catchall" <<<"$firewall_policy") -eq 1 ]] ||
  die 'committed firewall policy lacks one TCP/2379 catch-all drop'
service_etcd_allow_line=$(grep -nF "$service_etcd_allow" <<<"$firewall_policy" |
  awk -F: 'NR == 1 { print $1 }')
etcd_catchall_line=$(grep -nF "$etcd_catchall" <<<"$firewall_policy" |
  awk -F: 'NR == 1 { print $1 }')
[[ $service_etcd_allow_line =~ ^[0-9]+$ && $etcd_catchall_line =~ ^[0-9]+$ &&
   $service_etcd_allow_line -lt $etcd_catchall_line ]] ||
  die 'service-node TCP/2379 allow must precede the later catch-all boundary'
actual_etcd_accepts=$(awk '
  /tcp dport 2379 counter accept comment/ {
    sub(/^[[:space:]]+/, "")
    sub(/[[:space:]]+$/, "")
    print
  }
' <<<"$firewall_policy")
[[ $actual_etcd_accepts == "$expected_etcd_accepts" ]] ||
  die 'committed TCP/2379 accepts are not exactly root, maintenance, and service identities'
if grep -Eq '10\.66\.1\.0/24|10\.42\.[0-9]|@service_nodes_v4 tcp dport.*2380' \
    <<<"$firewall_policy"; then
  die 'committed root policy broadens service access to a subnet, PodCIDR, or etcd peer port'
fi
# shellcheck disable=SC2016 # strenv() belongs to yq, not the shell.
routing_policy=$(TARGET_PATH="$routing_path" yq -er \
  '.storage.files[] | select(.path == strenv(TARGET_PATH)) | .contents.inline' \
  fabric/butane/network.yaml)
normalized_routing_policy=$(awk -F '#' '
  {
    line = $1
    gsub(/[[:space:]]/, "", line)
    if (line != "") print line
  }
' <<<"$routing_policy")
expected_routing_policy='net.ipv4.ip_forward=1
net.ipv4.conf.all.accept_redirects=0
net.ipv4.conf.default.accept_redirects=0
net.ipv4.conf.*.accept_redirects=0
net.ipv4.conf.all.secure_redirects=0
net.ipv4.conf.default.secure_redirects=0
net.ipv4.conf.*.secure_redirects=0
net.ipv4.conf.all.send_redirects=0
net.ipv4.conf.default.send_redirects=0
net.ipv4.conf.*.send_redirects=0
net.ipv4.conf.all.accept_source_route=0
net.ipv4.conf.default.accept_source_route=0
net.ipv4.conf.*.accept_source_route=0
net.ipv6.conf.all.accept_redirects=0
net.ipv6.conf.default.accept_redirects=0
net.ipv6.conf.*.accept_redirects=0
net.ipv6.conf.all.accept_source_route=-1
net.ipv6.conf.default.accept_source_route=-1
net.ipv6.conf.*.accept_source_route=-1'
[[ $normalized_routing_policy == "$expected_routing_policy" ]] ||
  die 'committed routed-host sysctl payload differs from the reviewed exact policy'
# shellcheck disable=SC2016 # strenv() belongs to yq, not the shell.
routing_metadata=$(TARGET_PATH="$routing_path" yq -er '
  .storage.files[]
  | select(.path == strenv(TARGET_PATH))
  | [.overwrite, .mode]
  | @tsv
' fabric/butane/network.yaml)
[[ $routing_metadata == $'true\t420' ]] ||
  die 'committed routed-host sysctl payload must overwrite a mode-0644 file'

[[ $(yq -er \
  '[.systemd.units[] | select(.name == "fabric-guard.service")] | length' \
  fabric/butane/firewall.yaml) == 1 &&
   $(yq -er \
  '.systemd.units[] | select(.name == "fabric-guard.service") | .enabled' \
  fabric/butane/firewall.yaml) == true ]] ||
  die 'committed firewall profile lacks one enabled fabric-guard.service'
guard_unit=$(yq -er \
  '.systemd.units[] | select(.name == "fabric-guard.service") | .contents' \
  fabric/butane/firewall.yaml) ||
  die 'cannot extract the committed fabric-guard.service'
[[ $(yq -er \
  '[.systemd.units[] | select(.name == "etcd.service") | .dropins[] | select(.name == "10-fabric-guard.conf")] | length' \
  fabric/butane/firewall.yaml) == 1 ]] ||
  die 'committed firewall profile lacks one etcd fabric-guard drop-in'
etcd_guard_dropin=$(yq -er \
  '.systemd.units[] | select(.name == "etcd.service") | .dropins[] | select(.name == "10-fabric-guard.conf") | .contents' \
  fabric/butane/firewall.yaml) ||
  die 'cannot extract the committed etcd fabric-guard drop-in'
expected_guard_dropin='[Unit]
Requires=fabric-guard.service
After=fabric-guard.service'
[[ $etcd_guard_dropin == "$expected_guard_dropin" ]] ||
  die 'committed etcd fabric-guard drop-in differs from the exact dependency contract'
guard_unit_hash=$(printf '%s\n' "$guard_unit" | sha256sum | awk '{print $1}')
etcd_guard_dropin_hash=$(printf '%s\n' "$etcd_guard_dropin" | sha256sum | awk '{print $1}')

k3s_dropin_hash() {
  local profile=$1 name=$2
  [[ $(DROPIN_NAME="$name" yq -er \
    '[.systemd.units[] | select(.name == "k3s.service") | .dropins[] | select(.name == strenv(DROPIN_NAME))] | length' \
    "$profile") == 1 ]] ||
    die "committed profile lacks exactly one k3s.service $name drop-in"
  DROPIN_NAME="$name" yq -er -0 \
    '.systemd.units[] | select(.name == "k3s.service") | .dropins[] | select(.name == strenv(DROPIN_NAME)) | .contents' \
    "$profile" | tr -d '\000' | sha256sum | awk '{print $1}'
}

k3s_firewall_dropin_hash=$(k3s_dropin_hash fabric/butane/firewall.yaml \
  10-fabric-guard.conf) || die 'cannot hash the committed K3s firewall drop-in'
k3s_quorum_dropin_hash=$(k3s_dropin_hash "$control_plane_profile" \
  20-etcd-quorum.conf) || die 'cannot hash the committed K3s quorum drop-in'
k3s_etcd_dropin_hash=$(k3s_dropin_hash "$control_plane_profile" \
  etcd.conf) || die 'cannot hash the committed K3s etcd drop-in'

policy_hash=$(
  {
    printf '%s\0%s\0' "$firewall_path" "$firewall_policy"
    printf '%s\0%s\0' "$routing_path" "$routing_policy"
  } | sha256sum | awk '{print $1}'
)

if $check_only; then
  echo "validated combined fabric root network policy $policy_hash"
  exit 0
fi

[[ $(git branch --show-current) == main ]] || die 'run only from main'
[[ -z $(git status --porcelain) ]] || die 'worktree must be clean'
git fetch --quiet origin main
head_commit=$(git rev-parse HEAD)
[[ $head_commit == "$(git rev-parse origin/main)" ]] ||
  die 'HEAD must exactly match pushed origin/main'

if ! $verify_live_all; then
  expected="ROLLOUT-FABRIC-ROOT-NETWORK-POLICY:$full_node:$head_commit:$policy_hash"
  [[ $confirmation == "$expected" ]] || die "exact --confirm $expected is required"
fi

ik=("$repo_root/scripts/ik" --context=fabric)
ssh=()
if ! $verify_live_all; then
  ssh=("$repo_root/scripts/fabric-ssh" "$node")
  lock_name=fabric-maintenance-lock
  lock_holder="$(hostname):$$:$full_node:$head_commit:$policy_hash"
  lock_uid=
  lock_rv=
  lock_proxy_pid=
  local_work=$(mktemp --directory --tmpdir rollout-fabric-root-firewall.XXXXXXXX)
  trap 'rm -rf -- "$local_work"' EXIT
  success=false
  rollback_armed=false
  rollback_disarmed=false
fi
service_probes=(10.66.1.10 10.66.1.11)

route_interface=
validate_service_route() {
  local address_evidence destination evidence expected_interface='' gateway
  local interface service_probe source

  for service_probe in "${service_probes[@]}"; do
    evidence=$("${ssh[@]}" /usr/sbin/ip -4 -o route get "$service_probe") ||
      die "$full_node cannot resolve the route to $service_probe"
    [[ $evidence != *$'\n'* ]] ||
      die "$full_node returned an ambiguous route to $service_probe"
    destination=${evidence%% *}
    gateway=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "via") print $(i + 1) }' <<<"$evidence")
    interface=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") print $(i + 1) }' <<<"$evidence")
    source=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "src") print $(i + 1) }' <<<"$evidence")
    [[ $destination == "$service_probe" && $gateway == 10.66.0.1 && -n $interface &&
        $interface != lo && $interface != flannel.1 && $source == "$root_ip" ]] ||
      die "$full_node route to $service_probe is not $root_ip -> 10.66.0.1 on a physical NIC: $evidence"
    if [[ -z $expected_interface ]]; then
      expected_interface=$interface
    elif [[ $interface != "$expected_interface" ]]; then
      die "$full_node service-node routes use different physical interfaces"
    fi
    address_evidence=$("${ssh[@]}" /usr/sbin/ip -4 -o address show \
      dev "$interface" scope global) ||
      die "cannot inspect $full_node routed interface $interface"
    grep -Eq "(^|[[:space:]])inet ${root_ip//./\\.}/24([[:space:]]|$)" \
      <<<"$address_evidence" ||
      die "$full_node routed interface $interface does not carry $root_ip/24"
  done
  [[ -n $expected_interface ]] || die "$full_node service-node route set is empty"
  route_interface=$expected_interface
}

assert_live_etcd_input_policy() {
  local live_set compact_set service_elements live_input normalized_input
  local live_table_json live_forward normalized_forward live_forward_rules
  local live_rules expected_live_rules live_etcd_rules expected_live_etcd_rules
  local live_service_accepts expected_live_service_accepts
  local expected_live_forward_rules
  local allow_line catchall_line

  live_table_json=$("${ssh[@]}" sudo --non-interactive /usr/sbin/nft -j \
    list table inet fabric_guard) ||
    die "$full_node live fabric_guard table cannot be read as JSON"
  jq -e '
    ([.nftables[] | .table? |
      select(.family == "inet" and .name == "fabric_guard")] | length) == 1 and
    ([.nftables[] | .chain? |
      select(.family == "inet" and .table == "fabric_guard") |
      del(.handle)] | sort_by(.name)) == [
        {family: "inet", table: "fabric_guard", name: "forward",
         type: "filter", hook: "forward", prio: 10, policy: "drop"},
        {family: "inet", table: "fabric_guard", name: "input",
         type: "filter", hook: "input", prio: 10, policy: "drop"}
      ] and
    ([.nftables[] | .set? |
      select(.family == "inet" and .table == "fabric_guard") |
      del(.handle) |
      .elem = (.elem // [])] | sort_by(.name)) == [
        {family: "inet", name: "etcd_maintenance_v4", table: "fabric_guard",
         type: "ipv4_addr", flags: ["timeout"], timeout: 900,
         "gc-interval": 60, elem: []},
        {family: "inet", name: "observer_v4", table: "fabric_guard",
         type: "ipv4_addr", flags: ["constant"], elem: ["10.66.0.2"]},
        {family: "inet", name: "root_nodes_v4", table: "fabric_guard",
         type: "ipv4_addr", flags: ["constant"],
         elem: ["10.66.0.10", "10.66.0.11", "10.66.0.12"]},
        {family: "inet", name: "service_nodes_v4", table: "fabric_guard",
         type: "ipv4_addr", flags: ["constant"],
         elem: ["10.66.1.10", "10.66.1.11"]}
      ]
  ' <<<"$live_table_json" >/dev/null ||
    die "$full_node live fabric_guard base chains or identity sets are not exact"

  live_set=$("${ssh[@]}" sudo --non-interactive /usr/sbin/nft \
    list set inet fabric_guard service_nodes_v4) ||
    die "$full_node live service-node set cannot be read"
  compact_set=$(tr -d '[:space:]' <<<"$live_set")
  service_elements=$(sed -n 's/.*elements={\([^}]*\)}.*/\1/p' <<<"$compact_set")
  [[ $service_elements == '10.66.1.10,10.66.1.11' ]] ||
    die "$full_node live service-node set is not exactly the two reviewed addresses"

  live_input=$("${ssh[@]}" sudo --non-interactive /usr/sbin/nft -a \
    list chain inet fabric_guard input) ||
    die "$full_node live fabric_guard input chain cannot be read"
  normalized_input=$(sed -E \
    -e 's/counter packets [0-9]+ bytes [0-9]+/counter/g' \
    -e 's/[[:space:]]+# handle [0-9]+$//' \
    -e 's/^[[:space:]]+//' \
    -e 's/[[:space:]]+$//' \
    <<<"$live_input")
  live_rules=$(awk '
    $0 == "chain input {" { inside = 1; next }
    inside && $0 == "}" { inside = 0; next }
    inside && $0 != "" && $0 !~ /^type filter hook input / { print }
  ' <<<"$normalized_input")
  expected_live_rules='iifname "lo" counter accept comment "local host traffic"
meta nfproto ipv6 counter drop comment "no physical IPv6 input"
ct state invalid counter drop comment "invalid conntrack state"
ip saddr @root_nodes_v4 tcp dport 2379 counter accept comment "root etcd clients"
ip saddr @etcd_maintenance_v4 tcp dport 2379 counter accept comment "attended etcd maintenance"
ip saddr @service_nodes_v4 tcp dport 2379 counter accept comment "trusted platform etcd clients"
tcp dport 2379 counter drop comment "deny all other etcd clients including stale flows"
ct state { established, related } counter accept comment "reply traffic"
ip protocol icmp counter accept comment "IPv4 diagnostics and errors"
ip saddr @root_nodes_v4 tcp dport { 2380, 6443 } counter accept comment "root peer and API traffic"
ip saddr @root_nodes_v4 udp dport 8472 counter accept comment "root Flannel VXLAN"
ip saddr @service_nodes_v4 tcp dport { 6443, 10250 } counter accept comment "service agents to API and root kubelets"
ip saddr @service_nodes_v4 udp dport 8472 counter accept comment "service-agent Flannel VXLAN"
ip saddr @service_nodes_v4 tcp dport { 2112, 2381, 9100 } counter accept comment "trusted platform monitoring"
ip saddr @observer_v4 tcp dport { 22, 2112, 2381, 6443, 9100 } counter accept comment "attended observer access"
counter drop comment "deny all remaining input"'
  [[ $live_rules == "$expected_live_rules" ]] ||
    die "$full_node live fabric_guard input rule set differs from the exact reviewed policy"
  live_service_accepts=$(awk \
    '/ip saddr @service_nodes_v4/ && / accept comment / { print }' \
    <<<"$normalized_input")
  expected_live_service_accepts='ip saddr @service_nodes_v4 tcp dport 2379 counter accept comment "trusted platform etcd clients"
ip saddr @service_nodes_v4 tcp dport { 6443, 10250 } counter accept comment "service agents to API and root kubelets"
ip saddr @service_nodes_v4 udp dport 8472 counter accept comment "service-agent Flannel VXLAN"
ip saddr @service_nodes_v4 tcp dport { 2112, 2381, 9100 } counter accept comment "trusted platform monitoring"'
  [[ $live_service_accepts == "$expected_live_service_accepts" ]] ||
    die "$full_node live service-source accepts are not exactly TCP/2379, API/kubelet, VXLAN, and host metrics"
  live_etcd_rules=$(awk '/tcp dport 2379/ && /comment/ { print }' \
    <<<"$normalized_input")
  expected_live_etcd_rules='ip saddr @root_nodes_v4 tcp dport 2379 counter accept comment "root etcd clients"
ip saddr @etcd_maintenance_v4 tcp dport 2379 counter accept comment "attended etcd maintenance"
ip saddr @service_nodes_v4 tcp dport 2379 counter accept comment "trusted platform etcd clients"
tcp dport 2379 counter drop comment "deny all other etcd clients including stale flows"'
  [[ $live_etcd_rules == "$expected_live_etcd_rules" ]] ||
    die "$full_node live TCP/2379 input semantics or order differ from the exact policy"
  allow_line=$(grep -nFx "$service_etcd_allow" <<<"$normalized_input" | awk -F: '{print $1}')
  catchall_line=$(grep -nFx "$etcd_catchall" <<<"$normalized_input" | awk -F: '{print $1}')
  [[ $allow_line =~ ^[0-9]+$ && $catchall_line =~ ^[0-9]+$ &&
     $allow_line -lt $catchall_line ]] ||
    die "$full_node live service TCP/2379 allow does not precede its catch-all drop"

  live_forward=$("${ssh[@]}" sudo --non-interactive /usr/sbin/nft -a \
    list chain inet fabric_guard forward) ||
    die "$full_node live fabric_guard forward chain cannot be read"
  normalized_forward=$(sed -E \
    -e 's/counter packets [0-9]+ bytes [0-9]+/counter/g' \
    -e 's/[[:space:]]+# handle [0-9]+$//' \
    -e 's/^[[:space:]]+//' \
    -e 's/[[:space:]]+$//' \
    <<<"$live_forward")
  live_forward_rules=$(awk '
    $0 == "chain forward {" { inside = 1; next }
    inside && $0 == "}" { inside = 0; next }
    inside && $0 != "" && $0 !~ /^type filter hook forward / { print }
  ' <<<"$normalized_forward")
  expected_live_forward_rules='ct state invalid counter drop comment "invalid conntrack state"
ct state { established, related } counter accept comment "forwarded replies"
counter drop comment "deny all new forwarding"'
  [[ $live_forward_rules == "$expected_live_forward_rules" ]] ||
    die "$full_node live fabric_guard forward rule set differs from the exact deny policy"
}

assert_maintenance_window_closed() {
  local live_set_json
  live_set_json=$("${ssh[@]}" sudo --non-interactive /usr/sbin/nft -j \
    list set inet fabric_guard etcd_maintenance_v4) ||
    die "$full_node live etcd maintenance set cannot be read"
  jq -e '
    [.nftables[] | .set? |
      select(.family == "inet" and .table == "fabric_guard" and
             .name == "etcd_maintenance_v4") |
      del(.handle) | .elem = (.elem // [])] == [
        {family: "inet", table: "fabric_guard", name: "etcd_maintenance_v4",
         type: "ipv4_addr", flags: ["timeout"], timeout: 900,
         "gc-interval": 60, elem: []}
      ]
  ' <<<"$live_set_json" >/dev/null ||
    die "$full_node etcd maintenance window is not exactly closed"
}

assert_systemd_service_dropin() {
  local installed_hash metadata
  "${ssh[@]}" sudo --non-interactive /usr/bin/test -f \
    "$systemd_service_dropin_path" ||
    die "$full_node reviewed system service drop-in is not a regular file"
  "${ssh[@]}" sudo --non-interactive /usr/bin/test ! -L \
    "$systemd_service_dropin_path" ||
    die "$full_node reviewed system service drop-in is an unsafe symlink"
  metadata=$("${ssh[@]}" sudo --non-interactive /usr/bin/stat \
    --format='%u:%g:%a:%h:%F' "$systemd_service_dropin_path") ||
    die "$full_node reviewed system service drop-in cannot be read"
  [[ $metadata == '0:0:644:1:regular file' ]] ||
    die "$full_node reviewed system service drop-in metadata is unsafe: $metadata"
  installed_hash=$("${ssh[@]}" sudo --non-interactive /usr/bin/sha256sum \
    "$systemd_service_dropin_path" | awk '{print $1}') ||
    die "$full_node reviewed system service drop-in cannot be hashed"
  [[ $installed_hash == "$systemd_service_dropin_hash" ]] ||
    die "$full_node system service drop-in differs from the reviewed Fedora contract"
  "${ssh[@]}" sudo --non-interactive /usr/bin/matchpathcon -V \
    "$systemd_service_dropin_path" >/dev/null ||
    die "$full_node reviewed system service drop-in has the wrong security context"
}

assert_firewall_loader_provenance() {
  local fragment dropins metadata loaded_unit exec_reload expected_exec_reload
  local installed_hash
  assert_systemd_service_dropin
  fragment=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=FragmentPath --value fabric-guard.service) ||
    die "$full_node fabric-guard fragment cannot be resolved"
  [[ $fragment == /etc/systemd/system/fabric-guard.service ]] ||
    die "$full_node fabric-guard loads an unexpected fragment: $fragment"
  dropins=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=DropInPaths --value fabric-guard.service) ||
    die "$full_node fabric-guard drop-ins cannot be resolved"
  [[ $dropins == "$systemd_service_dropin_path" ]] ||
    die "$full_node fabric-guard does not load exactly the reviewed system service drop-in: $dropins"
  metadata=$("${ssh[@]}" sudo --non-interactive /usr/bin/stat \
    --format='%u:%g:%a:%h:%F' "$fragment") ||
    die "$full_node fabric-guard fragment metadata cannot be read"
  [[ $metadata == '0:0:644:1:regular file' ]] ||
    die "$full_node fabric-guard fragment metadata is unsafe: $metadata"
  installed_hash=$("${ssh[@]}" sudo --non-interactive /usr/bin/sha256sum \
    "$guard_unit_path" | awk '{print $1}') ||
    die "$full_node fabric-guard fragment cannot be hashed"
  [[ $installed_hash == "$guard_unit_hash" ]] ||
    die "$full_node fabric-guard service differs from the exact committed unit"
  loaded_unit=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl cat \
    fabric-guard.service) || die "$full_node fabric-guard unit cannot be read"
  exec_reload=$(awk '/^ExecReload=/ { print }' <<<"$loaded_unit")
  expected_exec_reload='ExecReload=/usr/sbin/nft --check --file /etc/nftables/fabric-guard.nft
ExecReload=/usr/sbin/nft --file /etc/nftables/fabric-guard.nft'
  [[ $exec_reload == "$expected_exec_reload" ]] ||
    die "$full_node fabric-guard ExecReload vector does not load the exact installed policy"

  dropins=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=DropInPaths --value etcd.service) ||
    die "$full_node etcd drop-in provenance cannot be resolved"
  [[ $dropins == "$etcd_guard_dropin_path $systemd_service_dropin_path" ]] ||
    die "$full_node etcd does not load exactly the reviewed fabric-guard drop-in plus system service drop-in: $dropins"
  metadata=$("${ssh[@]}" sudo --non-interactive /usr/bin/stat \
    --format='%u:%g:%a:%h:%F' "$etcd_guard_dropin_path") ||
    die "$full_node etcd fabric-guard drop-in metadata cannot be read"
  [[ $metadata == '0:0:644:1:regular file' ]] ||
    die "$full_node etcd fabric-guard drop-in metadata is unsafe: $metadata"
  installed_hash=$("${ssh[@]}" sudo --non-interactive /usr/bin/sha256sum \
    "$etcd_guard_dropin_path" | awk '{print $1}') ||
    die "$full_node etcd fabric-guard drop-in cannot be hashed"
  [[ $installed_hash == "$etcd_guard_dropin_hash" ]] ||
    die "$full_node etcd fabric-guard drop-in differs from the exact committed dependency"
}

verify_installed_dropin() {
  local target=$1 expected_hash=$2 installed_hash metadata
  "${ssh[@]}" sudo --non-interactive /usr/bin/test -f "$target" ||
    die "$full_node installed systemd drop-in is not a regular file: $target"
  "${ssh[@]}" sudo --non-interactive /usr/bin/test ! -L "$target" ||
    die "$full_node installed systemd drop-in is an unsafe symlink: $target"
  metadata=$("${ssh[@]}" sudo --non-interactive /usr/bin/stat \
    --format='%u:%g:%a:%h:%F' "$target") ||
    die "$full_node installed systemd drop-in metadata cannot be read: $target"
  [[ $metadata == '0:0:644:1:regular file' ]] ||
    die "$full_node installed systemd drop-in metadata is unsafe: $target ($metadata)"
  installed_hash=$("${ssh[@]}" sudo --non-interactive /usr/bin/sha256sum \
    "$target" | awk '{print $1}') ||
    die "$full_node installed systemd drop-in cannot be hashed: $target"
  [[ $installed_hash == "$expected_hash" ]] ||
    die "$full_node installed systemd drop-in differs from Git: $target"
  if ! "${ssh[@]}" sudo --non-interactive /usr/bin/matchpathcon -V "$target" \
      >/dev/null; then
    $allow_k3s_dropin_context_repair ||
      die "$full_node installed systemd drop-in has the wrong security context: $target"
    k3s_dropin_context_repair_required=true
  fi
}

verify_live_k3s_unit() {
  local after binds_to dropins fragment part_of requires requisite
  local stop_propagated_from

  verify_installed_dropin "$k3s_firewall_dropin_path" \
    "$k3s_firewall_dropin_hash"
  verify_installed_dropin "$k3s_quorum_dropin_path" \
    "$k3s_quorum_dropin_hash"
  verify_installed_dropin "$k3s_etcd_dropin_path" "$k3s_etcd_dropin_hash"

  fragment=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=FragmentPath --value k3s.service) ||
    die "$full_node K3s service fragment cannot be resolved"
  [[ $fragment == "$k3s_unit_path" ]] ||
    die "$full_node K3s service loads an unexpected fragment: $fragment"
  dropins=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=DropInPaths --value k3s.service) ||
    die "$full_node K3s service drop-ins cannot be resolved"
  [[ $dropins == "$k3s_firewall_dropin_path $systemd_service_dropin_path $k3s_quorum_dropin_path $k3s_etcd_dropin_path" ]] ||
    die "$full_node K3s service does not load exactly the reviewed drop-ins: $dropins"
  requires=" $("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=Requires --value k3s.service) "
  after=" $("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=After --value k3s.service) "
  [[ $requires == *' etcd.service '* && $requires == *' fabric-guard.service '* &&
     $after == *' etcd.service '* && $after == *' fabric-guard.service '* ]] ||
    die "$full_node K3s service lacks the reviewed etcd/firewall dependency graph"
  [[ $requires != *' fabric-etcd-client-trust.service '* &&
     $after != *' fabric-etcd-client-trust.service '* ]] ||
    die "$full_node K3s service has an unreviewed direct client-trust dependency"
  binds_to=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=BindsTo --value k3s.service)
  part_of=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=PartOf --value k3s.service)
  requisite=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=Requisite --value k3s.service)
  stop_propagated_from=$("${ssh[@]}" sudo --non-interactive \
    /usr/bin/systemctl show --property=StopPropagatedFrom --value k3s.service)
  [[ -z $binds_to && -z $part_of && -z $requisite &&
     -z $stop_propagated_from ]] ||
    die "$full_node K3s service has an unreviewed reverse-stop dependency"
}

allow_k3s_dropin_context_repair=false
k3s_dropin_context_repair_required=false

repair_k3s_dropin_contexts() {
  local target
  $k3s_dropin_context_repair_required || return 0

  # Recheck every immutable property under the global maintenance lock before
  # making the monotonic policy-default label repair. A failed later policy
  # rollout may leave these labels corrected; it never restores a stale label.
  allow_k3s_dropin_context_repair=true
  verify_live_k3s_unit
  allow_k3s_dropin_context_repair=false
  for target in "$k3s_firewall_dropin_path" "$k3s_quorum_dropin_path" \
      "$k3s_etcd_dropin_path"; do
    "${ssh[@]}" sudo --non-interactive /usr/sbin/restorecon -F "$target" \
      >/dev/null || die "$full_node could not repair the reviewed K3s drop-in context: $target"
  done
  k3s_dropin_context_repair_required=false
  verify_live_k3s_unit
}

lease_proof_uid=
lease_proof_rv=
lease_proof_renew=

rfc3339_ns() {
  local instant=$1 nanoseconds
  [[ $instant =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z$ ]] ||
    return 1
  nanoseconds=$(date --utc --date="$instant" +%s%N) || return 1
  [[ $nanoseconds =~ ^[0-9]{19}$ ]] || return 1
  printf '%s\n' "$nanoseconds"
}

cluster_lease_tuple() {
  local lease_json renew rv uid
  lease_json=$("${ik[@]}" --request-timeout=5s -n kube-node-lease \
    get lease "$full_node" -o json) || return 1
  uid=$(jq -er '.metadata.uid' <<<"$lease_json") || return 1
  rv=$(jq -er '.metadata.resourceVersion' <<<"$lease_json") || return 1
  renew=$(jq -er '.spec.renewTime' <<<"$lease_json") || return 1
  [[ $uid =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ &&
     $rv =~ ^[^[:space:]]+$ ]] || return 1
  rfc3339_ns "$renew" >/dev/null || return 1
  printf '%s\t%s\t%s\n' "$uid" "$rv" "$renew"
}

assert_control_plane_health() {
  local etcd_job etcd_result guard_job guard_reload_result guard_result
  local k3s_job k3s_result lease_tuple node_ready
  verify_live_k3s_unit
  "${ssh[@]}" sudo --non-interactive /usr/bin/systemctl is-enabled --quiet \
    fabric-guard.service || die "$full_node fabric-guard service is not enabled"
  "${ssh[@]}" sudo --non-interactive /usr/bin/systemctl is-active --quiet \
    fabric-guard.service || die "$full_node fabric-guard service is not active"
  for unit in etcd.service k3s.service; do
    "${ssh[@]}" sudo --non-interactive /usr/bin/systemctl is-enabled --quiet \
      "$unit" || die "$full_node $unit is not enabled"
    "${ssh[@]}" sudo --non-interactive /usr/bin/systemctl is-active --quiet \
      "$unit" || die "$full_node $unit is not active"
  done
  etcd_job=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=Job --value etcd.service)
  etcd_result=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=Result --value etcd.service)
  k3s_job=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=Job --value k3s.service)
  k3s_result=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=Result --value k3s.service)
  guard_job=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=Job --value fabric-guard.service)
  guard_result=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=Result --value fabric-guard.service)
  guard_reload_result=$("${ssh[@]}" sudo --non-interactive \
    /usr/bin/systemctl show --property=ReloadResult --value \
    fabric-guard.service)
  [[ -z $guard_job && $guard_result == success &&
     -z $etcd_job && $etcd_result == success &&
     -z $k3s_job && $k3s_result == success &&
     $guard_reload_result == success ]] ||
    die "$full_node firewall/etcd/K3s service state is not quiescent and successful"
  "${ssh[@]}" sudo --non-interactive /usr/local/bin/etcdctl \
    --endpoints=https://127.0.0.1:2379 \
    --cacert=/var/lib/rancher/k3s/server/etcd-ca.pem \
    --cert=/var/lib/rancher/k3s/server/etcd-client.pem \
    --key=/var/lib/rancher/k3s/server/etcd-client-key.pem \
    --dial-timeout=2s --command-timeout=3s endpoint health >/dev/null ||
    die "$full_node local etcd endpoint is unhealthy"
  "${ssh[@]}" sudo --non-interactive /usr/bin/timeout --signal=TERM \
    --kill-after=2s 5s /usr/local/bin/k3s kubectl --request-timeout=3s \
    get --raw='/readyz?verbose' | grep -Fq 'readyz check passed' ||
    die "$full_node local API readiness failed"
  "${ssh[@]}" sudo --non-interactive /usr/bin/timeout --signal=TERM \
    --kill-after=2s 5s /usr/local/bin/k3s kubectl --request-timeout=3s \
    --server="$api_vip" get --raw='/readyz?verbose' |
    grep -Fq 'readyz check passed' || die 'Fabric API VIP readiness failed from the target'
  "${ik[@]}" --request-timeout=5s get --raw='/readyz?verbose' |
    grep -Fq 'readyz check passed' || die 'Fabric API VIP readiness failed'
  node_ready=$("${ik[@]}" --request-timeout=5s get node "$full_node" \
    -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}')
  [[ $node_ready == True ]] || die "$full_node is not Ready"
  lease_tuple=$(cluster_lease_tuple) || die "$full_node has no valid heartbeat Lease"
  [[ -n $lease_tuple ]] || die "$full_node heartbeat Lease tuple is empty"
}

assert_fresh_heartbeat() {
  local after_ns before_ns lease_after lease_before node_ready
  local renew_after renew_before rv_after rv_before uid_after uid_before
  lease_before=$(cluster_lease_tuple) ||
    die "cannot anchor $full_node heartbeat after API readiness"
  IFS=$'\t' read -r uid_before rv_before renew_before <<<"$lease_before"
  before_ns=$(rfc3339_ns "$renew_before") || die 'invalid heartbeat anchor time'
  for _attempt in {1..40}; do
    sleep 1
    if lease_after=$(cluster_lease_tuple); then
      IFS=$'\t' read -r uid_after rv_after renew_after <<<"$lease_after"
      after_ns=$(rfc3339_ns "$renew_after") || continue
      node_ready=$("${ik[@]}" --request-timeout=5s get node "$full_node" \
        -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' \
        2>/dev/null || true)
      if [[ $uid_after == "$uid_before" && $rv_after != "$rv_before" &&
            $node_ready == True ]] &&
          ((10#$after_ns > 10#$before_ns)); then
        lease_proof_uid=$uid_after
        lease_proof_rv=$rv_after
        lease_proof_renew=$renew_after
        return 0
      fi
    fi
  done
  die "$full_node did not publish a strictly newer Ready heartbeat"
}

assert_rollback_residue_absent() {
  local active_state job load_state path unit unit_file_state
  for path in \
    /var/lib/fabric-root-network-policy-rollback \
    /run/fabric-root-network-policy-rollback \
    /etc/nftables/fabric-guard.nft.fabric-rollout.next \
    /etc/nftables/fabric-guard.nft.fabric-rollback.next \
    /etc/sysctl.d/90-fabric-root-routing.conf.fabric-rollout.next \
    /etc/sysctl.d/90-fabric-root-routing.conf.fabric-rollback.next \
    /etc/systemd/system/fabric-root-network-policy-rollback.service \
    /etc/systemd/system/fabric-root-network-policy-rollback.service.d \
    /etc/systemd/system/fabric-root-network-policy-rollback.timer \
    /etc/systemd/system/fabric-root-network-policy-rollback.timer.d \
    /etc/systemd/system/fabric-guard-rollback.service \
    /etc/systemd/system/fabric-guard-rollback.service.d \
    /etc/systemd/system/fabric-guard-rollback.timer \
    /etc/systemd/system/fabric-guard-rollback.timer.d; do
    "${ssh[@]}" sudo --non-interactive /usr/bin/test ! -e "$path" ||
      die "$full_node retains stale root-policy rollback state: $path"
    "${ssh[@]}" sudo --non-interactive /usr/bin/test ! -L "$path" ||
      die "$full_node has an unsafe root-policy rollback symlink: $path"
  done
  for unit in fabric-root-network-policy-rollback.timer \
      fabric-root-network-policy-rollback.service \
      fabric-guard-rollback.timer fabric-guard-rollback.service; do
    load_state=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
      --property=LoadState --value "$unit") ||
      die "$full_node cannot inspect stale rollback LoadState: $unit"
    active_state=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
      --property=ActiveState --value "$unit") ||
      die "$full_node cannot inspect stale rollback ActiveState: $unit"
    unit_file_state=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
      --property=UnitFileState --value "$unit") ||
      die "$full_node cannot inspect stale rollback UnitFileState: $unit"
    job=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
      --property=Job --value "$unit") ||
      die "$full_node cannot inspect stale rollback Job: $unit"
    [[ $load_state == not-found && $active_state == inactive && -z $job ]] ||
      die "$full_node retains loaded, active, or queued rollback state: $unit"
    [[ -z $unit_file_state || $unit_file_state == disabled ]] ||
      die "$full_node rollback unit-file state is not absent or disabled: $unit ($unit_file_state)"
    if "${ssh[@]}" sudo --non-interactive /usr/bin/systemctl is-enabled --quiet \
        "$unit" 2>/dev/null; then
      die "$full_node retains an enabled rollback unit: $unit"
    fi
  done
}

if $verify_live_all; then
  committed_firewall_hash=$(printf '%s' "$firewall_policy" | sha256sum | awk '{print $1}')
  committed_routing_hash=$(printf '%s' "$routing_policy" | sha256sum | awk '{print $1}')
  for node_contract in \
    cp1:fabric-az1-cp1:10.66.0.10 \
    cp2:fabric-az1-cp2:10.66.0.11 \
    cp3:fabric-az1-cp3:10.66.0.12; do
    IFS=: read -r node full_node root_ip <<<"$node_contract"
    ssh=("$repo_root/scripts/fabric-ssh" "$node")

    assert_rollback_residue_absent
    assert_firewall_loader_provenance
    "${ssh[@]}" sudo --non-interactive /usr/bin/systemctl is-enabled --quiet \
      fabric-guard.service || die "$full_node fabric-guard service is not enabled"
    "${ssh[@]}" sudo --non-interactive /usr/bin/systemctl is-active --quiet \
      fabric-guard.service || die "$full_node fabric-guard service is not active"
    [[ $("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
      --property=Result --value fabric-guard.service) == success ]] ||
      die "$full_node fabric-guard service did not last complete successfully"

    installed_firewall_hash=$("${ssh[@]}" sudo --non-interactive \
      /usr/bin/sha256sum "$firewall_path" | awk '{print $1}')
    [[ $installed_firewall_hash == "$committed_firewall_hash" ]] ||
      die "$full_node installed firewall policy differs from Git"
    firewall_metadata=$("${ssh[@]}" sudo --non-interactive /usr/bin/stat \
      --format='%u:%g:%a:%h:%F' "$firewall_path")
    [[ $firewall_metadata == '0:0:644:1:regular file' ]] ||
      die "$full_node installed firewall policy metadata is unsafe: $firewall_metadata"
    "${ssh[@]}" sudo --non-interactive /usr/bin/matchpathcon -V \
      "$firewall_path" >/dev/null ||
      die "$full_node installed firewall policy has the wrong security context"

    installed_routing_hash=$("${ssh[@]}" sudo --non-interactive \
      /usr/bin/sha256sum "$routing_path" | awk '{print $1}')
    [[ $installed_routing_hash == "$committed_routing_hash" ]] ||
      die "$full_node installed routed-host policy differs from Git"
    routing_metadata=$("${ssh[@]}" sudo --non-interactive /usr/bin/stat \
      --format='%u:%g:%a:%h:%F' "$routing_path")
    [[ $routing_metadata == '0:0:644:1:regular file' ]] ||
      die "$full_node installed routed-host policy metadata is unsafe: $routing_metadata"
    "${ssh[@]}" sudo --non-interactive /usr/bin/matchpathcon -V \
      "$routing_path" >/dev/null ||
      die "$full_node installed routed-host policy has the wrong security context"

    assert_live_etcd_input_policy
    validate_service_route
    # shellcheck disable=SC2016 # Literal remote program; variables expand on the root.
    printf '%s' '#!/usr/bin/env bash
set -euo pipefail
[[ $(/usr/sbin/sysctl -n net.ipv4.ip_forward) == 1 ]]
for directory in /proc/sys/net/ipv4/conf/*; do
  scope=${directory##*/}
  for knob in accept_redirects secure_redirects send_redirects accept_source_route; do
    [[ $(/usr/sbin/sysctl -n "net/ipv4/conf/$scope/$knob") == 0 ]]
  done
done
for directory in /proc/sys/net/ipv6/conf/*; do
  scope=${directory##*/}
  [[ $(/usr/sbin/sysctl -n "net/ipv6/conf/$scope/accept_redirects") == 0 ]]
  [[ $(/usr/sbin/sysctl -n "net/ipv6/conf/$scope/accept_source_route") == -1 ]]
done
' | "${ssh[@]}" sudo --non-interactive /usr/bin/bash -s ||
      die "$full_node live routed-host sysctls differ from the exact policy"

    for stale_path in \
      /var/lib/fabric-root-network-policy-rollback \
      /run/fabric-root-network-policy-rollback \
      /run/fabric-guard.nft.next \
      /run/fabric-root-routing.conf.next; do
      "${ssh[@]}" sudo --non-interactive /usr/bin/test ! -e "$stale_path" ||
        die "$full_node retains stale root-policy rollout state: $stale_path"
      "${ssh[@]}" sudo --non-interactive /usr/bin/test ! -L "$stale_path" ||
        die "$full_node has an unsafe root-policy rollout symlink: $stale_path"
    done

    node_json=$("${ik[@]}" --request-timeout=5s get node "$full_node" \
      --output=json) ||
      die "cannot read Fabric root node $full_node"
    jq -e --arg ip "$root_ip" '
      .metadata.deletionTimestamp == null and
      .metadata.labels["fabric.samcday.com/root-consensus"] == "true" and
      ([.status.addresses[]? | select(.type == "InternalIP") | .address] == [$ip]) and
      any(.status.conditions[]?; .type == "Ready" and .status == "True")
    ' <<<"$node_json" >/dev/null ||
      die "$full_node is not the exact Ready root identity at $root_ip"
    assert_control_plane_health
    assert_fresh_heartbeat
    assert_rollback_residue_absent
  done

  "${ik[@]}" --request-timeout=5s get --raw='/readyz?verbose' |
    grep -Fxq 'readyz check passed' ||
    die 'Fabric API is not fully ready after all-root policy verification'
  echo "FABRIC_ROOT_NETWORK_POLICY_LIVE=pass revision=$head_commit payload=$policy_hash"
  exit 0
fi

assert_firewall_loader_provenance
assert_maintenance_window_closed
firewall_file_metadata_before=$("${ssh[@]}" sudo --non-interactive /usr/bin/stat \
  --format='%u:%g:%a:%h:%F' "$firewall_path") ||
  die "$full_node installed firewall policy metadata cannot be read"
[[ $firewall_file_metadata_before == '0:0:644:1:regular file' ]] ||
  die "$full_node installed firewall policy metadata is unsafe before rollout: $firewall_file_metadata_before"

allow_k3s_dropin_context_repair=true
assert_control_plane_health
allow_k3s_dropin_context_repair=false
validate_service_route
route_interface_before=$route_interface
[[ $("${ssh[@]}" /usr/sbin/sysctl -n net.ipv4.ip_forward) == 1 ]] ||
  die "$full_node does not have the K3s-required IPv4 forwarding state before rollout"

if ! lock_object=$("${ik[@]}" --request-timeout=5s -n kube-system \
  create configmap "$lock_name" --from-literal="holder=$lock_holder" -o json); then
  current_holder=$("${ik[@]}" --request-timeout=5s -n kube-system \
    get configmap "$lock_name" \
    -o jsonpath='{.data.holder}' 2>/dev/null || true)
  die "another or stale global Fabric maintenance lock exists: ${current_holder:-unknown}"
fi
lock_uid=$(jq -er '.metadata.uid' <<<"$lock_object") ||
  die "$lock_name was created but its UID is unavailable; leave it for attended inspection"
lock_rv=$(jq -er '.metadata.resourceVersion' <<<"$lock_object") ||
  die "$lock_name was created but its resourceVersion is unavailable; leave it for attended inspection"
[[ $lock_uid =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ &&
   $lock_rv =~ ^[^[:space:]]+$ &&
   $(jq -er '.metadata.name' <<<"$lock_object") == "$lock_name" &&
   $(jq -er '.metadata.namespace' <<<"$lock_object") == kube-system &&
   $(jq -er '.data.holder' <<<"$lock_object") == "$lock_holder" ]] ||
  die "$lock_name creation response is not the exact owned object; leave it for attended inspection"

rollback_work=/var/lib/fabric-root-network-policy-rollback
firewall_next=$rollback_work/firewall.next
firewall_previous=$rollback_work/firewall.previous
routing_next=$rollback_work/routing.next
routing_previous=$rollback_work/routing.previous
routing_previous_absent=$rollback_work/routing.previous-absent
routing_live_previous=$rollback_work/routing-live.previous
firewall_live_previous=$rollback_work/firewall-live.previous
firewall_live_accepted=$rollback_work/firewall-live.accepted
rollback_program_path=$rollback_work/rollback
rollback_unit=fabric-root-network-policy-rollback
rollback_service_path=/etc/systemd/system/$rollback_unit.service
rollback_timer_path=/etc/systemd/system/$rollback_unit.timer
rollout_token="$head_commit:$policy_hash:$full_node"

stop_lock_proxy() {
  local attempt
  [[ $lock_proxy_pid =~ ^[1-9][0-9]*$ ]] || return 0
  kill -TERM "$lock_proxy_pid" 2>/dev/null || true
  for ((attempt = 0; attempt < 50; attempt++)); do
    kill -0 "$lock_proxy_pid" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "$lock_proxy_pid" 2>/dev/null; then
    kill -KILL "$lock_proxy_pid" 2>/dev/null || true
  fi
  wait "$lock_proxy_pid" 2>/dev/null || true
  lock_proxy_pid=
}

delete_lock_preconditioned() {
  local attempt delete_options proxy_log proxy_socket response
  proxy_socket=$local_work/kube-api-proxy.sock
  proxy_log=$local_work/kube-api-proxy.log
  [[ ! -e $proxy_socket && ! -L $proxy_socket ]] || return 1
  "${ik[@]}" proxy --unix-socket="$proxy_socket" \
    --accept-hosts='^localhost$' \
    --accept-paths="^/api/v1/namespaces/kube-system/configmaps/$lock_name\$" \
    --reject-methods='^(GET|POST|PUT|PATCH|HEAD|OPTIONS|CONNECT|TRACE)$' \
    >"$proxy_log" 2>&1 &
  lock_proxy_pid=$!
  for ((attempt = 0; attempt < 50; attempt++)); do
    [[ -S $proxy_socket ]] && break
    kill -0 "$lock_proxy_pid" 2>/dev/null || break
    sleep 0.1
  done
  if [[ ! -S $proxy_socket ]]; then
    stop_lock_proxy
    return 1
  fi
  delete_options=$(jq -cn --arg uid "$lock_uid" --arg rv "$lock_rv" '{
    apiVersion: "v1",
    kind: "DeleteOptions",
    preconditions: {uid: $uid, resourceVersion: $rv}
  }') || {
    stop_lock_proxy
    return 1
  }
  response=$(curl --fail-with-body --silent --show-error --max-time 10 \
    --unix-socket "$proxy_socket" --request DELETE \
    --header 'Content-Type: application/json' --data-binary "$delete_options" \
    "http://localhost/api/v1/namespaces/kube-system/configmaps/$lock_name") || {
    stop_lock_proxy
    return 1
  }
  stop_lock_proxy
  jq -e --arg name "$lock_name" --arg uid "$lock_uid" '
    (.kind == "Status" and .status == "Success" and
     .details.name == $name and (.details.uid // $uid) == $uid) or
    (.kind == "ConfigMap" and .metadata.name == $name and .metadata.uid == $uid)
  ' <<<"$response" >/dev/null
}

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  trap '' HUP INT TERM
  set +e
  if ! $success && $rollback_armed; then
    # A failed or unacknowledged disarm is unsafe. Re-enable both persistent
    # triggers and atomically convert even accepted state into rollback-required.
    # shellcheck disable=SC2016 # Literal target-local recovery program.
force_rollback_program='set -euo pipefail
work=$1
service=$2
timer=$3
token=$4
state_path=$work/state
state_lock=$work/state.lock
write_state() {
  printf "%s:%s\n" "$1" "$token" >"$work/state.next"
  chmod 0600 "$work/state.next"
  mv "$work/state.next" "$state_path"
  sync --file-system "$work"
}
[[ -d $work && ! -L $work ]]
[[ $(<"$work/owner") == fabric-root-network-policy-rollout ]]
[[ $(<"$work/expected-token") == "$token" ]]
[[ $(<"$work/armed") == "$token" ]]
[[ -f $service && ! -L $service && -f $timer && ! -L $timer ]]
[[ -f $state_path && ! -L $state_path && -f $state_lock && ! -L $state_lock ]]
exec {state_fd}>>"$state_lock"
flock --exclusive "$state_fd"
state=$(<"$state_path")
systemctl daemon-reload
systemctl enable "$timer" "${service##*/}" >/dev/null
sync --file-system /etc/systemd/system
case $state in
  "armed:$token"|"accepted:$token") write_state rollback-required ;;
  "rollback-required:$token"|"rolling-back:$token"|"rolled-back:$token") ;;
  *) exit 1 ;;
esac
printf "%s\n" "$token" >"$work/force-rollback.next"
chmod 0600 "$work/force-rollback.next"
mv "$work/force-rollback.next" "$work/force-rollback"
sync --file-system "$work"
flock --unlock "$state_fd"
exec {state_fd}>&-
systemctl start --no-block "${service##*/}"
for ((attempt = 0; attempt < 300; attempt++)); do
  if [[ $(<"$state_path") == "rolled-back:$token" &&
        -f $work/rolled-back && ! -L $work/rolled-back &&
        $(<"$work/rolled-back") == "$token" &&
        $(systemctl show --property=ActiveState --value "${service##*/}") == inactive &&
        -z $(systemctl show --property=Job --value "${service##*/}") ]]; then
    printf "ROLLBACK_FORCED=%s\n" "$token"
    exit 0
  fi
  sleep 1
done
exit 1
'
    force_rollback_result=$(printf '%s' "$force_rollback_program" |
      "${ssh[@]}" sudo --non-interactive /usr/bin/bash -s -- \
        "$rollback_work" "$rollback_service_path" "$rollback_timer_path" \
        "$rollout_token" 2>/dev/null)
    if [[ $force_rollback_result == "ROLLBACK_FORCED=$rollout_token" ]]; then
      echo "rollout stopped; immediate target-local rollback was requested and $lock_name remains held by $lock_holder" >&2
    else
      echo "WARNING: rollout stopped and remote rollback acknowledgement failed; persistent rollback evidence and $lock_name remain for attended inspection" >&2
    fi
  elif ! $success && $rollback_disarmed; then
    echo "rollout stopped after rollback disarm; persistent evidence and $lock_name remain held for attended inspection" >&2
  elif ! $success; then
    echo "rollout stopped before rollback was armed; $lock_name remains held by $lock_holder for inspection" >&2
  fi
  if $success; then
    if ! delete_lock_preconditioned; then
      echo "root network policy passed but shared lock could not be released" >&2
      status=1
    fi
  fi
  stop_lock_proxy
  rm -rf -- "$local_work"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Revalidate every preflight that protects the mutation after acquiring the
# global lock; an earlier probe may have overlapped a just-finishing operation.
repair_k3s_dropin_contexts
assert_firewall_loader_provenance
assert_maintenance_window_closed
assert_control_plane_health
validate_service_route
route_interface_before=$route_interface
[[ $("${ssh[@]}" /usr/sbin/sysctl -n net.ipv4.ip_forward) == 1 ]] ||
  die "$full_node lost the K3s-required IPv4 forwarding state under the global lock"
assert_rollback_residue_absent
for remote_path in "$rollback_work" \
  "$rollback_service_path" "$rollback_service_path.d" \
  "$rollback_timer_path" "$rollback_timer_path.d" \
  /run/fabric-guard.nft.next \
  /run/fabric-guard.nft.previous \
  /run/fabric-root-routing.conf.next \
  /run/fabric-root-routing.conf.previous \
  /run/fabric-root-routing.conf.previous-absent \
  /run/fabric-root-routing.live.previous \
  "$firewall_path.fabric-rollout.next" \
  "$firewall_path.fabric-rollback.next" \
  "$routing_path.fabric-rollout.next" \
  "$routing_path.fabric-rollback.next" \
  /run/fabric-root-network-policy-rollback; do
  "${ssh[@]}" sudo --non-interactive /usr/bin/test ! -e "$remote_path" ||
    die "stale remote rollout artifact requires inspection: $remote_path"
  "${ssh[@]}" sudo --non-interactive /usr/bin/test ! -L "$remote_path" ||
    die "unsafe remote rollout symlink requires inspection: $remote_path"
done
for remote_unit in "$rollback_unit.timer" "$rollback_unit.service" \
  fabric-guard-rollback.timer fabric-guard-rollback.service; do
  load_state=$("${ssh[@]}" sudo --non-interactive /usr/bin/systemctl show \
    --property=LoadState --value "$remote_unit" 2>/dev/null || true)
  [[ -z $load_state || $load_state == not-found ]] ||
    die "a stale target-local rollback unit requires inspection: $remote_unit ($load_state)"
  if "${ssh[@]}" sudo --non-interactive /usr/bin/systemctl is-enabled --quiet \
    "$remote_unit" 2>/dev/null; then
    die "a stale enabled target-local rollback unit requires inspection: $remote_unit"
  fi
done
"${ssh[@]}" sudo --non-interactive /usr/bin/test -d /var/lib
"${ssh[@]}" sudo --non-interactive /usr/bin/test ! -L /var/lib
"${ssh[@]}" sudo --non-interactive /usr/bin/test -d /etc/sysctl.d
"${ssh[@]}" sudo --non-interactive /usr/bin/test ! -L /etc/sysctl.d
sysctl_dir_metadata=$("${ssh[@]}" sudo --non-interactive /usr/bin/stat \
  --format='%u:%g:%a:%F' /etc/sysctl.d)
[[ $sysctl_dir_metadata == 0:0:755:directory ]] ||
  die "unsafe routed-host sysctl directory on $full_node: $sysctl_dir_metadata"
"${ssh[@]}" sudo --non-interactive /usr/bin/test -x /usr/bin/flock
"${ssh[@]}" sudo --non-interactive /usr/bin/test -x /usr/bin/cmp
"${ssh[@]}" sudo --non-interactive /usr/bin/test -x /usr/bin/restorecon
"${ssh[@]}" sudo --non-interactive /usr/bin/test -x /usr/bin/matchpathcon
"${ssh[@]}" sudo --non-interactive /usr/bin/test -x /usr/bin/sync
"${ssh[@]}" sudo --non-interactive /usr/bin/test -x /usr/bin/timeout
"${ssh[@]}" sudo --non-interactive /usr/bin/test -x /usr/bin/date
"${ssh[@]}" sudo --non-interactive /usr/bin/test -x /usr/local/bin/k3s
"${ssh[@]}" sudo --non-interactive /usr/bin/test -x /usr/local/bin/etcdctl
"${ssh[@]}" sudo --non-interactive /usr/bin/matchpathcon -V \
  "$firewall_path" >/dev/null
"${ssh[@]}" sudo --non-interactive /usr/bin/mkdir --mode=0700 "$rollback_work"

printf '%s' "$firewall_policy" |
  "${ssh[@]}" sudo --non-interactive /usr/bin/tee "$firewall_next" >/dev/null
"${ssh[@]}" sudo --non-interactive /usr/bin/chmod 0600 "$firewall_next"
remote_firewall_hash=$("${ssh[@]}" sudo --non-interactive /usr/bin/sha256sum \
  "$firewall_next" | awk '{print $1}')
local_firewall_hash=$(printf '%s' "$firewall_policy" | sha256sum | awk '{print $1}')
[[ $remote_firewall_hash == "$local_firewall_hash" ]] || die 'firewall candidate changed in transport'
"${ssh[@]}" sudo --non-interactive /usr/sbin/nft --check --file "$firewall_next"
firewall_previous_metadata=$("${ssh[@]}" sudo --non-interactive /usr/bin/stat \
  --format='%u:%g:%a:%h:%F:%C' "$firewall_path")
"${ssh[@]}" sudo --non-interactive /usr/bin/cp \
  --preserve=mode,ownership,timestamps,context,xattr -- \
  "$firewall_path" "$firewall_previous"
[[ $("${ssh[@]}" sudo --non-interactive /usr/bin/stat \
  --format='%u:%g:%a:%h:%F:%C' "$firewall_previous") == \
  "$firewall_previous_metadata" ]] ||
  die 'firewall rollback backup did not preserve exact metadata and security context'
printf '%s\n' "$firewall_previous_metadata" |
  "${ssh[@]}" sudo --non-interactive /usr/bin/tee \
    "$rollback_work/firewall.previous.metadata" >/dev/null
"${ssh[@]}" sudo --non-interactive /usr/bin/chmod 0600 \
  "$rollback_work/firewall.previous.metadata"
firewall_previous_hash=$("${ssh[@]}" sudo --non-interactive /usr/bin/sha256sum \
  "$firewall_previous" | awk '{print $1}')
firewall_previous_metadata_hash=$("${ssh[@]}" sudo --non-interactive \
  /usr/bin/sha256sum "$rollback_work/firewall.previous.metadata" | awk '{print $1}')
[[ $firewall_previous_hash =~ ^[0-9a-f]{64}$ ]] ||
  die 'cannot hash the previous firewall policy'
[[ $firewall_previous_metadata_hash =~ ^[0-9a-f]{64}$ ]] ||
  die 'cannot hash the previous firewall metadata'
{
  printf '%s  firewall.previous\n' "$firewall_previous_hash"
  printf '%s  firewall.previous.metadata\n' "$firewall_previous_metadata_hash"
} |
  "${ssh[@]}" sudo --non-interactive /usr/bin/tee \
    "$rollback_work/firewall.previous.sha256" >/dev/null
"${ssh[@]}" sudo --non-interactive /usr/bin/chmod 0600 \
  "$rollback_work/firewall.previous.sha256"

printf '%s' "$routing_policy" |
  "${ssh[@]}" sudo --non-interactive /usr/bin/tee "$routing_next" >/dev/null
"${ssh[@]}" sudo --non-interactive /usr/bin/chmod 0600 "$routing_next"
remote_routing_hash=$("${ssh[@]}" sudo --non-interactive /usr/bin/sha256sum \
  "$routing_next" | awk '{print $1}')
local_routing_hash=$(printf '%s' "$routing_policy" | sha256sum | awk '{print $1}')
[[ $remote_routing_hash == "$local_routing_hash" ]] || die 'routed-host sysctl candidate changed in transport'

if "${ssh[@]}" sudo --non-interactive /usr/bin/test -e "$routing_path"; then
  "${ssh[@]}" sudo --non-interactive /usr/bin/test ! -L "$routing_path"
  "${ssh[@]}" sudo --non-interactive /usr/bin/test -f "$routing_path"
  "${ssh[@]}" sudo --non-interactive /usr/bin/matchpathcon -V \
    "$routing_path" >/dev/null
  routing_previous_metadata=$("${ssh[@]}" sudo --non-interactive /usr/bin/stat \
    --format='%u:%g:%a:%h:%F:%C' "$routing_path")
  "${ssh[@]}" sudo --non-interactive /usr/bin/cp \
    --preserve=mode,ownership,timestamps,context,xattr -- \
    "$routing_path" "$routing_previous"
  [[ $("${ssh[@]}" sudo --non-interactive /usr/bin/stat \
    --format='%u:%g:%a:%h:%F:%C' "$routing_previous") == \
    "$routing_previous_metadata" ]] ||
    die 'routed-host rollback backup did not preserve exact metadata and security context'
  printf '%s\n' "$routing_previous_metadata" |
    "${ssh[@]}" sudo --non-interactive /usr/bin/tee \
      "$rollback_work/routing.previous.metadata" >/dev/null
  "${ssh[@]}" sudo --non-interactive /usr/bin/chmod 0600 \
    "$rollback_work/routing.previous.metadata"
  routing_previous_hash=$("${ssh[@]}" sudo --non-interactive /usr/bin/sha256sum \
    "$routing_previous" | awk '{print $1}')
  routing_previous_metadata_hash=$("${ssh[@]}" sudo --non-interactive \
    /usr/bin/sha256sum "$rollback_work/routing.previous.metadata" | awk '{print $1}')
  [[ $routing_previous_hash =~ ^[0-9a-f]{64}$ ]] ||
    die 'cannot hash the previous routed-host sysctl policy'
  [[ $routing_previous_metadata_hash =~ ^[0-9a-f]{64}$ ]] ||
    die 'cannot hash the previous routed-host sysctl metadata'
  {
    printf '%s  routing.previous\n' "$routing_previous_hash"
    printf '%s  routing.previous.metadata\n' "$routing_previous_metadata_hash"
  } |
    "${ssh[@]}" sudo --non-interactive /usr/bin/tee \
      "$rollback_work/routing.previous.sha256" >/dev/null
  "${ssh[@]}" sudo --non-interactive /usr/bin/chmod 0600 \
    "$rollback_work/routing.previous.sha256"
else
  "${ssh[@]}" sudo --non-interactive /usr/bin/test ! -L "$routing_path"
  "${ssh[@]}" sudo --non-interactive /usr/bin/touch "$routing_previous_absent"
fi

# Normalize counters and runtime-assigned handles so the rollback program can
# prove that restarting the previous file recreated the exact pre-rollout
# table, rather than merely proving that nft accepted the source file.
# shellcheck disable=SC2016 # This is a literal remote program.
capture_firewall_program='#!/usr/bin/env bash
set -euo pipefail
output=$1
/usr/sbin/nft -a list table inet fabric_guard |
  /usr/bin/sed -E \
    -e "s/counter packets [0-9]+ bytes [0-9]+/counter/g" \
    -e "s/[[:space:]]+# handle [0-9]+$//" \
    -e "s/^[[:space:]]+//" \
    -e "s/[[:space:]]+$//" >"$output"
[[ -s $output && -f $output && ! -L $output ]]
chmod 0600 "$output"
'
capture_remote_firewall() {
  local output=$1
  printf '%s' "$capture_firewall_program" |
    "${ssh[@]}" sudo --non-interactive /usr/bin/bash -s -- "$output"
}

capture_remote_firewall "$firewall_live_previous"
firewall_live_previous_hash=$("${ssh[@]}" sudo --non-interactive \
  /usr/bin/sha256sum "$firewall_live_previous" | awk '{print $1}')
[[ $firewall_live_previous_hash =~ ^[0-9a-f]{64}$ ]] ||
  die 'cannot hash the previous live firewall state'
printf '%s  firewall-live.previous\n' "$firewall_live_previous_hash" |
  "${ssh[@]}" sudo --non-interactive /usr/bin/tee \
    "$rollback_work/firewall-live.previous.sha256" >/dev/null
"${ssh[@]}" sudo --non-interactive /usr/bin/chmod 0600 \
  "$rollback_work/firewall-live.previous.sha256"

# shellcheck disable=SC2016 # This is a literal remote program.
capture_live_program='#!/usr/bin/env bash
set -euo pipefail
output=$1
: >"$output"
chmod 0600 "$output"
capture() {
  local path=$1 key
  key=${path#/proc/sys/}
  printf "%s = %s\n" "$key" "$(<"$path")" >>"$output"
}
capture /proc/sys/net/ipv4/ip_forward
for directory in /proc/sys/net/ipv4/conf/*; do
  for knob in accept_redirects secure_redirects send_redirects accept_source_route; do
    capture "$directory/$knob"
  done
done
for directory in /proc/sys/net/ipv6/conf/*; do
  for knob in accept_redirects accept_source_route; do
    capture "$directory/$knob"
  done
done
'
printf '%s' "$capture_live_program" |
  "${ssh[@]}" sudo --non-interactive /usr/bin/bash -s -- "$routing_live_previous"
routing_live_previous_hash=$("${ssh[@]}" sudo --non-interactive /usr/bin/sha256sum \
  "$routing_live_previous" | awk '{print $1}')
[[ $routing_live_previous_hash =~ ^[0-9a-f]{64}$ ]] ||
  die 'cannot hash the previous live routed-host sysctl state'
printf '%s  routing-live.previous\n' "$routing_live_previous_hash" |
  "${ssh[@]}" sudo --non-interactive /usr/bin/tee \
    "$rollback_work/routing-live.previous.sha256" >/dev/null
"${ssh[@]}" sudo --non-interactive /usr/bin/chmod 0600 \
  "$rollback_work/routing-live.previous.sha256"
printf '%s\n' fabric-root-network-policy-rollout |
  "${ssh[@]}" sudo --non-interactive /usr/bin/tee "$rollback_work/owner" >/dev/null
printf '%s\n' "$rollout_token" |
  "${ssh[@]}" sudo --non-interactive /usr/bin/tee \
    "$rollback_work/expected-token" >/dev/null
printf '%s\n' "$full_node" |
  "${ssh[@]}" sudo --non-interactive /usr/bin/tee \
    "$rollback_work/k3s-node" >/dev/null
"${ssh[@]}" sudo --non-interactive /usr/bin/chmod 0600 \
  "$rollback_work/owner" "$rollback_work/expected-token" \
  "$rollback_work/k3s-node"
"${ssh[@]}" sudo --non-interactive /usr/bin/touch "$rollback_work/state.lock"
"${ssh[@]}" sudo --non-interactive /usr/bin/chmod 0600 "$rollback_work/state.lock"

# shellcheck disable=SC2016 # This is a literal remote program.
rollback_program='#!/usr/bin/env bash
set -euo pipefail
umask 077
work=/var/lib/fabric-root-network-policy-rollback
timer=fabric-root-network-policy-rollback.timer
service=fabric-root-network-policy-rollback.service
state_path=$work/state
state_lock=$work/state.lock
firewall_path=/etc/nftables/fabric-guard.nft
firewall_previous=$work/firewall.previous
routing_path=/etc/sysctl.d/90-fabric-root-routing.conf
routing_previous=$work/routing.previous
routing_previous_absent=$work/routing.previous-absent
routing_live_previous=$work/routing-live.previous
firewall_live_previous=$work/firewall-live.previous
write_state() {
  printf "%s:%s\n" "$1" "$token" >"$work/state.next"
  chmod 0600 "$work/state.next"
  mv "$work/state.next" "$state_path"
  sync --file-system "$work"
}
[[ -d $work && ! -L $work ]]
for marker in owner expected-token armed deadline k3s-node; do
  [[ -f $work/$marker && ! -L $work/$marker ]]
done
[[ $(<"$work/owner") == fabric-root-network-policy-rollout ]]
[[ $(<"$work/armed") == "$(<"$work/expected-token")" ]]
token=$(<"$work/expected-token")
k3s_node=$(<"$work/k3s-node")
case $k3s_node in
  fabric-az1-cp1|fabric-az1-cp2|fabric-az1-cp3) ;;
  *) exit 1 ;;
esac
[[ -f $state_path && ! -L $state_path && -f $state_lock && ! -L $state_lock ]]
exec {state_fd}>>"$state_lock"
flock --exclusive "$state_fd"
state=$(<"$state_path")
case $state in
  "accepted:$token"|"rolled-back:$token")
    systemctl disable "$timer" "$service" >/dev/null 2>&1 || exit 1
    sync --file-system /etc/systemd/system
    exit 0
    ;;
  "armed:$token"|"rollback-required:$token"|"rolling-back:$token") ;;
  *) exit 1 ;;
esac
deadline=$(<"$work/deadline")
[[ $deadline =~ ^[0-9]+$ ]]
now=$(date +%s)
if [[ $state == "armed:$token" ]]; then
  [[ -e $work/force-rollback || $now -ge $deadline ]]
fi
rollback_deadline=$((now + 240))
write_state rolling-back
before_rollback_deadline() {
  (( $(date +%s) < rollback_deadline ))
}
wait_unit_active() {
  local unit=$1
  while before_rollback_deadline; do
    if systemctl is-active --quiet "$unit" &&
        [[ -z $(systemctl show --property=Job --value "$unit") ]] &&
        [[ $(systemctl show --property=Result --value "$unit") == success ]]; then
      return 0
    fi
    sleep 1
  done
  return 1
}
wait_unit_reloaded() {
  local unit=$1
  while before_rollback_deadline; do
    if systemctl is-active --quiet "$unit" &&
        [[ -z $(systemctl show --property=Job --value "$unit") ]] &&
        [[ $(systemctl show --property=Result --value "$unit") == success ]] &&
        [[ $(systemctl show --property=ReloadResult --value "$unit") == success ]]; then
      return 0
    fi
    sleep 1
  done
  return 1
}
bounded_k3s() {
  /usr/bin/timeout --signal=TERM --kill-after=2s 5s \
    /usr/local/bin/k3s kubectl --request-timeout=3s "$@"
}
rfc3339_ns() {
  local instant=$1 nanoseconds
  [[ $instant =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z$ ]] ||
    return 1
  nanoseconds=$(date --utc --date="$instant" +%s%N) || return 1
  [[ $nanoseconds =~ ^[0-9]{19}$ ]] || return 1
  printf "%s\n" "$nanoseconds"
}
lease_tuple() {
  local renew rv tuple uid
  tuple=$(bounded_k3s -n kube-node-lease get lease "$k3s_node" \
    -o "jsonpath={.metadata.uid}{\"\\t\"}{.metadata.resourceVersion}{\"\\t\"}{.spec.renewTime}") ||
    return 1
  IFS="$(printf "\t")" read -r uid rv renew <<<"$tuple"
  [[ $uid =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ &&
     $rv =~ ^[^[:space:]]+$ ]] || return 1
  rfc3339_ns "$renew" >/dev/null || return 1
  printf "%s\t%s\t%s\n" "$uid" "$rv" "$renew"
}
verify_k3s_dependency() {
  local after binds_to part_of requires requisite stop_propagated_from
  [[ $(systemctl show --property=FragmentPath --value k3s.service) == /etc/systemd/system/k3s.service ]]
  [[ $(systemctl show --property=DropInPaths --value k3s.service) == "/etc/systemd/system/k3s.service.d/10-fabric-guard.conf /usr/lib/systemd/system/service.d/10-timeout-abort.conf /etc/systemd/system/k3s.service.d/20-etcd-quorum.conf /etc/systemd/system/k3s.service.d/etcd.conf" ]]
  requires=" $(systemctl show --property=Requires --value k3s.service) "
  after=" $(systemctl show --property=After --value k3s.service) "
  [[ $requires == *" etcd.service "* && $requires == *" fabric-guard.service "* ]]
  [[ $after == *" etcd.service "* && $after == *" fabric-guard.service "* ]]
  [[ $requires != *" fabric-etcd-client-trust.service "* &&
     $after != *" fabric-etcd-client-trust.service "* ]]
  binds_to=$(systemctl show --property=BindsTo --value k3s.service)
  part_of=$(systemctl show --property=PartOf --value k3s.service)
  requisite=$(systemctl show --property=Requisite --value k3s.service)
  stop_propagated_from=$(systemctl show \
    --property=StopPropagatedFrom --value k3s.service)
  [[ -z $binds_to && -z $part_of && -z $requisite &&
     -z $stop_propagated_from ]]
}
local_and_vip_api_ready() {
