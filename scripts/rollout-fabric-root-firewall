remove_staging() {
  local path=$1
  if [[ -e $path || -L $path ]]; then
    [[ -f $path && ! -L $path ]]
    rm --force -- "$path"
  fi
}
restore_file() {
  local target=$1 previous=$2 directory metadata metadata_file next rollout_next
  directory=${target%/*}
  metadata_file=$previous.metadata
  next=$target.fabric-rollback.next
  rollout_next=$target.fabric-rollout.next
  [[ -f $metadata_file && ! -L $metadata_file ]]
  metadata=$(<"$metadata_file")
  [[ $(stat --format="%u:%g:%a:%h:%F:%C" "$previous") == "$metadata" ]]
  remove_staging "$next"
  remove_staging "$rollout_next"
  cp --preserve=mode,ownership,timestamps,context,xattr -- "$previous" "$next"
  [[ $(stat --format="%u:%g:%a:%h:%F:%C" "$next") == "$metadata" ]]
  sync --file-system "$next"
  mv --force -- "$next" "$target"
  sync --file-system "$directory"
  cmp --silent "$previous" "$target"
  [[ $(stat --format="%u:%g:%a:%h:%F:%C" "$target") == "$metadata" ]]
  /usr/bin/matchpathcon -V "$target" >/dev/null
}
