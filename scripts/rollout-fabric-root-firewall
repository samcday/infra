restore_scope() {
  local family=$1 scope=$2 key default_key expected knob
  shift 2
  for knob in "$@"; do
    key=net/$family/conf/$scope/$knob
    default_key=net/$family/conf/default/$knob
    expected=${previous_sysctl[$key]-}
    if [[ -z $expected ]]; then
      expected=${previous_sysctl[$default_key]-}
    fi
    [[ -n $expected ]]
    /usr/sbin/sysctl -q -w "$key=$expected"
    [[ $(/usr/sbin/sysctl -n "$key") == "$expected" ]]
  done
}
