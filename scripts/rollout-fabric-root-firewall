[[ $(systemctl show --property=FragmentPath --value "${service##*/}") == "$service" ]]
[[ $(systemctl show --property=FragmentPath --value "${timer##*/}") == "$timer" ]]
[[ $(systemctl show --property=DropInPaths --value "${service##*/}") == /usr/lib/systemd/system/service.d/10-timeout-abort.conf ]]
[[ -z $(systemctl show --property=DropInPaths --value "${timer##*/}") ]]
[[ -f /usr/lib/systemd/system/service.d/10-timeout-abort.conf &&
   ! -L /usr/lib/systemd/system/service.d/10-timeout-abort.conf ]]
[[ $(stat --format="%u:%g:%a:%h:%F" /usr/lib/systemd/system/service.d/10-timeout-abort.conf) == "0:0:644:1:regular file" ]]
system_dropin_hash=$(sha256sum /usr/lib/systemd/system/service.d/10-timeout-abort.conf)
