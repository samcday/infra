  /usr/bin/sha256sum "$firewall_live_accepted" | awk '{print $1}')
[[ $firewall_live_accepted_hash =~ ^[0-9a-f]{64}$ ]] ||
  die 'cannot hash the exact accepted live firewall state'
printf '%s  firewall-live.accepted\n' "$firewall_live_accepted_hash" |
  "${ssh[@]}" sudo --non-interactive /usr/bin/tee \
    "$rollback_work/firewall-live.accepted.sha256" >/dev/null
"${ssh[@]}" sudo --non-interactive /usr/bin/chmod 0600 \
  "$rollback_work/firewall-live.accepted.sha256"
"${ssh[@]}" sudo --non-interactive /usr/bin/sync --file-system "$rollback_work"
"${ssh[@]}" sudo --non-interactive /usr/bin/systemctl is-enabled --quiet \
  "$rollback_unit.timer"
"${ssh[@]}" sudo --non-interactive /usr/bin/systemctl is-enabled --quiet \
  "$rollback_unit.service"
"${ssh[@]}" sudo --non-interactive /usr/bin/systemctl is-active --quiet \
  "$rollback_unit.timer"

# shellcheck disable=SC2016 # Literal target-local acknowledgement program.
disarm_ready_program='set -euo pipefail
work=$1
service=$2
timer=$3
token=$4
node=$5
proof_uid=$6
proof_rv=$7
proof_renew=$8
state_path=$work/state
state_lock=$work/state.lock
case $node in
  fabric-az1-cp1|fabric-az1-cp2|fabric-az1-cp3) ;;
  *) exit 1 ;;
esac
[[ $(<"$work/k3s-node") == "$node" ]]
[[ $proof_uid =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]
[[ $proof_rv =~ ^[^[:space:]]+$ ]]
bounded_k3s() {
  /usr/bin/timeout --signal=TERM --kill-after=2s 5s \
    /usr/local/bin/k3s kubectl --request-timeout=3s "$@"
}
rfc3339_ns() {
  local instant=$1 nanoseconds
  [[ $instant =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z$ ]] ||
    return 1
  nanoseconds=$(date --utc --date="$instant" +%s%N) || return 1
  [[ $nanoseconds =~ ^[0-9]{19}$ ]] || return 1
  printf "%s\n" "$nanoseconds"
}
prove_lease_not_regressed() {
  local current_ns proof_ns ready renew rv tuple uid
  tuple=$(bounded_k3s -n kube-node-lease get lease "$node" \
    -o "jsonpath={.metadata.uid}{\"\\t\"}{.metadata.resourceVersion}{\"\\t\"}{.spec.renewTime}") ||
    return 1
  IFS="$(printf "\t")" read -r uid rv renew <<<"$tuple"
  [[ $uid == "$proof_uid" && $rv =~ ^[^[:space:]]+$ ]] || return 1
  current_ns=$(rfc3339_ns "$renew") || return 1
  proof_ns=$(rfc3339_ns "$proof_renew") || return 1
  if ((10#$current_ns == 10#$proof_ns)); then
    [[ $rv == "$proof_rv" ]] || return 1
  else
    [[ $rv != "$proof_rv" ]] || return 1
    ((10#$current_ns > 10#$proof_ns)) || return 1
  fi
  ready=$(bounded_k3s get node "$node" \
    -o "jsonpath={.status.conditions[?(@.type==\"Ready\")].status}") || return 1
  [[ $ready == True ]]
}
verify_k3s_dependency() {
  local after binds_to part_of requires requisite stop_propagated_from
  [[ $(systemctl show --property=FragmentPath --value k3s.service) == /etc/systemd/system/k3s.service ]]
  [[ $(systemctl show --property=DropInPaths --value k3s.service) == "/etc/systemd/system/k3s.service.d/10-fabric-guard.conf /usr/lib/systemd/system/service.d/10-timeout-abort.conf /etc/systemd/system/k3s.service.d/20-etcd-quorum.conf /etc/systemd/system/k3s.service.d/etcd.conf" ]]
  requires=" $(systemctl show --property=Requires --value k3s.service) "
  after=" $(systemctl show --property=After --value k3s.service) "
  [[ $requires == *" etcd.service "* && $requires == *" fabric-guard.service "* ]]
  [[ $after == *" etcd.service "* && $after == *" fabric-guard.service "* ]]
  [[ $requires != *" fabric-etcd-client-trust.service "* &&
     $after != *" fabric-etcd-client-trust.service "* ]]
  binds_to=$(systemctl show --property=BindsTo --value k3s.service)
  part_of=$(systemctl show --property=PartOf --value k3s.service)
  requisite=$(systemctl show --property=Requisite --value k3s.service)
  stop_propagated_from=$(systemctl show \
    --property=StopPropagatedFrom --value k3s.service)
  [[ -z $binds_to && -z $part_of && -z $requisite &&
     -z $stop_propagated_from ]]
}
