# The deadline service and this candidate writer serialize on the same lock.
# Once this program releases it, the outer helper performs only observations
# until the separately locked disarm transition.
# shellcheck disable=SC2016 # This is a literal target-local program.
apply_candidate_program='#!/usr/bin/env bash
set -euo pipefail
umask 077
work=$1
token=$2
routing_path=$3
firewall_path=$4
state_path=$work/state
state_lock=$work/state.lock
[[ -d $work && ! -L $work ]]
[[ -f $state_path && ! -L $state_path && -f $state_lock && ! -L $state_lock ]]
[[ -f $work/deadline && ! -L $work/deadline ]]
[[ $(<"$work/owner") == fabric-root-network-policy-rollout ]]
[[ $(<"$work/expected-token") == "$token" ]]
[[ $(<"$work/armed") == "$token" ]]
[[ -f $work/routing.next && ! -L $work/routing.next ]]
[[ -f $work/firewall.next && ! -L $work/firewall.next ]]
exec {state_fd}>>"$state_lock"
flock --exclusive "$state_fd"
[[ $(<"$state_path") == "armed:$token" ]]
[[ ! -e $work/force-rollback && ! -L $work/force-rollback ]]
deadline=$(<"$work/deadline")
now=$(date +%s)
[[ $deadline =~ ^[0-9]+$ && $now =~ ^[0-9]+$ && $now -lt $deadline ]]
before_deadline() {
  (( $(date +%s) < deadline ))
}
wait_unit_active() {
  local unit=$1
  while before_deadline; do
    if systemctl is-active --quiet "$unit" &&
        [[ -z $(systemctl show --property=Job --value "$unit") ]] &&
        [[ $(systemctl show --property=Result --value "$unit") == success ]]; then
      return 0
    fi
    sleep 1
  done
  return 1
}
wait_unit_reloaded() {
  local unit=$1
  while before_deadline; do
    if systemctl is-active --quiet "$unit" &&
        [[ -z $(systemctl show --property=Job --value "$unit") ]] &&
        [[ $(systemctl show --property=Result --value "$unit") == success ]] &&
        [[ $(systemctl show --property=ReloadResult --value "$unit") == success ]]; then
      return 0
    fi
    sleep 1
  done
  return 1
}
install_atomic() {
  local source=$1 target=$2 mode=$3 next directory metadata expected_mode
  next=$target.fabric-rollout.next
  directory=${target%/*}
  expected_mode=${mode#0}
  [[ ! -e $next && ! -L $next ]]
  install --owner=root --group=root --mode="$mode" "$source" "$next"
  metadata=$(stat --format="%u:%g:%a:%h:%F" "$next")
  [[ $metadata == "0:0:$expected_mode:1:regular file" ]]
  cmp --silent "$source" "$next"
  sync --file-system "$next"
  mv --force -- "$next" "$target"
  /usr/bin/restorecon -F "$target"
  /usr/bin/matchpathcon -V "$target" >/dev/null
  sync --file-system "$directory"
  cmp --silent "$source" "$target"
  [[ $(stat --format="%u:%g:%a:%h:%F" "$target") == "$metadata" ]]
}
install_atomic "$work/routing.next" "$routing_path" 0644
[[ $(/usr/sbin/sysctl -n net.ipv4.ip_forward) == 1 ]]
