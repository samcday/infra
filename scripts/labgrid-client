#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
project_dir="$(cd "${script_dir}/.." && pwd)"
image="docker.io/labgrid/client:v26.0@sha256:af4bc3d2ef2930682135ba591ed09048043494b50ead25978d6f5626f46c81d3"

if [[ ! -d "${HOME}/.ssh" ]]; then
  echo "${HOME}/.ssh is required for exporter access" >&2
  exit 1
fi

podman_args=(
  --rm
  --network=host
  --security-opt=label=disable
  --env "LG_COORDINATOR=${LG_COORDINATOR:-labgrid-coordinator.tailnet.hub.samcday.com:20408}"
  --env "LG_HOSTNAME=${LG_HOSTNAME:-$(hostname -s)}"
  --env "LG_USERNAME=${LG_USERNAME:-${USER:-$(id -un)}}"
  --volume "${HOME}/.ssh:/ssh:ro"
  --volume "${project_dir}/labgrid/frankensargo/client-ssh:/root/.ssh:ro"
  --volume "${project_dir}/labgrid/frankensargo/client.yaml:/opt/labgrid-client.yaml:ro"
)

if [[ -t 0 ]]; then
  podman_args+=(--interactive)
fi
if [[ -t 1 ]]; then
  podman_args+=(--tty)
fi

exec podman run "${podman_args[@]}" "${image}" \
  labgrid-client --config /opt/labgrid-client.yaml "$@"
