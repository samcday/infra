#!/usr/bin/env bash
set -euo pipefail

export LC_ALL=C

umask 077

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck disable=SC1091
source "$script_dir/lib/fabric-secure-tempdir.sh"
repo_root=$(git -C "$script_dir" rev-parse --show-toplevel)
manifest=$repo_root/fabric/installer/fcos-live-iso.txt
asset_manifest=$repo_root/fabric/router/data-files.txt
live_profile=$repo_root/fabric/installer/node-installer-live.bu
operator_profile=$repo_root/fabric/butane/base.yaml
default_cache_dir=$repo_root/_build/fabric/installer
nodes=(fabric-az1-cp1 fabric-az1-cp2 fabric-az1-cp3)
cp1_nvme_destination=/dev/disk/by-id/nvme-eui.002538839100c827
network_keyfile_path=/etc/NetworkManager/system-connections/fabric-static.nmconnection
hostname_path=/etc/hostname
etcd_ca_path=/etc/etcd/pki/ca.pem
etcd_peer_cert_path=/etc/etcd/pki/peer.pem
router_asset_url=http://10.66.0.1/static
expected_asset_count=7
sam_ssh_key=

check_only=false
selected_node=
selected_node_seen=false
ignition_dir=
output_dir=
cache_dir=
cp1_disk=
cp2_disk=
cp3_disk=

usage() {
  cat >&2 <<'EOF'
Usage:
  build-fabric-node-isos --check

  build-fabric-node-isos \
    --node fabric-az1-cp1 \
    --ignition-dir /secure/fabric-bootstrap \
    --output-dir /secure/fabric-installers \
    --cache-dir /secure/fabric-installer-cache \
    --cp1-disk /dev/disk/by-id/nvme-eui.002538839100c827

  build-fabric-node-isos \
    --ignition-dir /secure/fabric-bootstrap \
    --output-dir /secure/fabric-installers \
    --cache-dir /secure/fabric-installer-cache \
    --cp1-disk /dev/disk/by-id/nvme-eui.002538839100c827 \
    --cp2-disk /dev/disk/by-id/ata-EXACT_CP2_DEVICE \
    --cp3-disk /dev/disk/by-id/ata-EXACT_CP3_DEVICE

Normal mode downloads and verifies the pinned Fedora CoreOS live ISO, then
builds either one selected node ISO or all three separate, secret-bearing,
confirmation-gated installer ISOs. Every disk path must come from reviewed
inventory. The admitted cp1 destination is exactly
`/dev/disk/by-id/nvme-eui.002538839100c827`; cp2 and cp3 require whole internal
ATA disks named by stable `ata-*` identities. NVMe serial aliases, other EUI
identities, and partitions are refused. Booting an ISO and typing its exact
confirmation will destroy that ISO's configured destination disk. A selected
first voter still uses the declared three-member etcd map and cannot form
quorum until a second declared member is ready.
The optional cache directory stores only the public FCOS ISO and signature; it
defaults to _build/fabric/installer inside the checkout.

Each image also carries a minimal live-only SSH profile for the canonical
operator key.  It permits only core@10.66.0.2, disables SSH forwarding, and is
not copied to the installed system.  The pre-install gate explicitly activates
the exact embedded NetworkManager profile before admitting the static address.

The --check mode validates only the public FCOS/asset manifests, pinned Fedora
signing-key identity, and minimal live-access profile.  It does not read final
Ignitions, bind hardware identities, download the FCOS ISO, or build installer
media; normal mode performs those deeper checks after inventory and secret
rendering.
EOF
}

validate_live_access_ignition() {
  local ignition=$1
  local sshd_config=$workdir/validated-live-sshd.$$.conf
  local sshd_source
  local sshd_compression

  jq -e --arg key "$sam_ssh_key" '
    (.ignition.version | startswith("3.")) and
    ((.ignition.config.merge // []) | length == 0) and
    ((.ignition.config.replace // null) == null) and
    ([.passwd.users[]?.name] == ["core"]) and
    ([.passwd.users[]?
      | select(.name == "core")
      | .sshAuthorizedKeys[]?
      | select(. == $key)] | length == 1) and
    all(.passwd.users[]?;
      (.passwordHash == null) and
      ((.sshAuthorizedKeys // []) | length == 1)) and
    ((.storage | keys | sort) == ["files"]) and
    ([.storage.files[]?.path] ==
      ["/etc/ssh/sshd_config.d/90-fabric-installer-live.conf"]) and
    all(.storage.files[]?;
      (.mode == 384) and
      (.overwrite == true) and
      (.contents.source | type == "string") and
      (.contents.source | startswith("data:"))) and
    ((.systemd | keys | sort) == ["units"]) and
    ([.systemd.units[]?.name] | sort) ==
      (["fabric-installer-live-ssh.service", "sshd.service"] | sort) and
    all(.systemd.units[]?;
      (.enabled == true) and
      ((.mask // false) == false) and
      (((.dropins // []) | length) == 0)) and
    any(.systemd.units[]?;
      .name == "sshd.service" and
      ((.contents // null) == null)) and
    any(.systemd.units[]?;
      .name == "fabric-installer-live-ssh.service" and
      .contents == ([
        "[Unit]",
        "Description=Start live installer SSH before automatic installation",
        "Wants=sshd.service",
        "After=sshd.service",
        "Before=coreos-installer.service",
        "",
        "[Service]",
        "Type=oneshot",
        "RemainAfterExit=yes",
        "ExecStart=/usr/bin/systemctl is-active --quiet sshd.service",
        "",
        "[Install]",
        "WantedBy=coreos-installer.service",
        ""
      ] | join("\n")))
  ' "$ignition" >/dev/null

  jq -e '
    walk(if type == "object" then with_entries(select(.value != null)) else . end) |
    (keys | sort) == (["ignition", "passwd", "storage", "systemd"] | sort) and
    ((.ignition | keys) == ["version"]) and
    ((.passwd | keys) == ["users"]) and
    all(.passwd.users[]?;
      ((. | keys | sort) == (["name", "sshAuthorizedKeys"] | sort))) and
    all(.storage.files[]?;
      ((. | keys | sort) == (["contents", "mode", "overwrite", "path"] | sort)) and
      ((.contents | keys | sort) == (["compression", "source"] | sort)) and
      (.contents.compression == "gzip")) and
    all(.systemd.units[]?;
      if .name == "sshd.service" then
        ((. | keys | sort) == (["enabled", "name"] | sort))
      elif .name == "fabric-installer-live-ssh.service" then
        ((. | keys | sort) == (["contents", "enabled", "name"] | sort))
      else
        false
      end)
  ' "$ignition" >/dev/null

  sshd_source=$(jq -r '
    .storage.files[]
    | select(.path == "/etc/ssh/sshd_config.d/90-fabric-installer-live.conf")
    | .contents.source
  ' "$ignition")
  sshd_compression=$(jq -r '
    .storage.files[]
    | select(.path == "/etc/ssh/sshd_config.d/90-fabric-installer-live.conf")
    | .contents.compression // ""
  ' "$ignition")
  decode_data_url "$sshd_source" "$sshd_compression" "$sshd_config"
  cmp --silent "$sshd_config" <(printf '%s\n' \
    'AuthenticationMethods publickey' \
    'PubkeyAuthentication yes' \
    'PasswordAuthentication no' \
    'KbdInteractiveAuthentication no' \
    'PermitEmptyPasswords no' \
    'PermitRootLogin no' \
    'AllowUsers core@10.66.0.2' \
    'DisableForwarding yes' \
    'AllowAgentForwarding no' \
    'AllowTcpForwarding no' \
    'GatewayPorts no' \
    'PermitTunnel no' \
    'X11Forwarding no' \
    'UseDNS no') || {
    echo 'live installer SSH policy differs from the fail-closed operator policy' >&2
    return 1
  }
}

decode_data_url() {
  local source=$1
  local compression=$2
  local destination=$3

  [[ $source == data:*,* ]] || {
    echo "refusing non-data URL while resolving embedded Ignition" >&2
    return 1
  }
  [[ -z $compression || $compression == gzip ]] || {
    echo "unsupported embedded Ignition compression: $compression" >&2
    return 1
  }

  # Ignition uses both compact percent-encoded data URLs for short files and
  # base64+gzip URLs for larger files/config fragments. Decode either form
  # without evaluating backslash escapes from untrusted config content.
  printf '%s' "$source" | python3 -c '
import base64
import gzip
import sys
from urllib.parse import unquote_to_bytes

compression, destination = sys.argv[1:]
source = sys.stdin.read()
metadata, payload = source[5:].split(",", 1)
if metadata.endswith(";base64"):
    data = base64.b64decode(payload, validate=True)
else:
    data = unquote_to_bytes(payload)
if compression == "gzip":
    data = gzip.decompress(data)
with open(destination, "wb") as output:
    output.write(data)
' "$compression" "$destination"
}

extract_embedded_ignition_file() {
  local root_config=$1
  local target_path=$2
  local destination=$3
  local walk_dir=$4
  local config
  local config_index=0
  local child_index=1
  local match_count=0
  local source
  local compression
  local match
  local child

  mkdir -m 0700 -- "$walk_dir"
  cp -- "$root_config" "$walk_dir/0.ign"

  while [[ -f $walk_dir/$config_index.ign ]]; do
    config=$walk_dir/$config_index.ign
    jq -e '.ignition.version | startswith("3.")' "$config" >/dev/null
    jq -e '.ignition.config.replace == null' "$config" >/dev/null || {
      echo "refusing an Ignition replace directive while resolving $target_path" >&2
      return 1
    }

    while IFS= read -r match; do
      source=$(printf '%s' "$match" | base64 --decode | jq -r '.source')
      compression=$(printf '%s' "$match" | base64 --decode | jq -r '.compression // ""')
      ((match_count += 1))
      ((match_count == 1)) || {
        echo "multiple embedded Ignition files target $target_path" >&2
        return 1
      }
      decode_data_url "$source" "$compression" "$destination"
    done < <(jq -r --arg path "$target_path" '
      .storage.files[]?
      | select(.path == $path)
      | {source: .contents.source, compression: (.contents.compression // "")}
      | @base64
    ' "$config")

    while IFS= read -r match; do
      ((child_index <= 64)) || {
        echo 'embedded Ignition graph exceeds 64 configs' >&2
        return 1
      }
      source=$(printf '%s' "$match" | base64 --decode | jq -r '.source')
      compression=$(printf '%s' "$match" | base64 --decode | jq -r '.compression // ""')
      child=$walk_dir/$child_index.ign
      decode_data_url "$source" "$compression" "$child"
      ((child_index += 1))
    done < <(jq -r '
      .ignition.config.merge[]?
      | {source, compression: (.compression // "")}
      | @base64
    ' "$config")

    ((config_index += 1))
  done

  ((match_count == 1)) || {
    echo "cannot find exactly one embedded Ignition file at $target_path" >&2
    return 1
  }
}

build_expected_asset_manifest() {
  local source=$1
  local destination=$2
  local filename
  local url
  local sha256
  local separator
  local record=0

  : > "$destination"
  while IFS= read -r filename; do
    [[ -n $filename ]] || continue
    ((record += 1))
    IFS= read -r url || {
      echo "missing URL for router asset record $record" >&2
      return 1
    }
    IFS= read -r sha256 || {
      echo "missing SHA-256 for router asset record $record" >&2
      return 1
    }
    separator=
    IFS= read -r separator || true

    [[ $filename =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
      echo "unsafe router asset filename in record $record: $filename" >&2
      return 1
    }
    [[ $url == https://* || $url == oci://* ]] || {
      echo "unsupported router asset source in record $record: $url" >&2
      return 1
    }
    [[ $sha256 =~ ^[0-9a-f]{64}$ ]] || {
      echo "invalid router asset SHA-256 in record $record: $filename" >&2
      return 1
    }
    [[ -z $separator ]] || {
      echo "expected a blank separator after router asset record $record" >&2
      return 1
    }
    printf '%s  %s\n' "$sha256" "$filename" >> "$destination"
  done < "$source"

  ((record == expected_asset_count)) || {
    echo "expected exactly $expected_asset_count offline router assets, found $record" >&2
    return 1
  }
}

while (($#)); do
  case $1 in
    --check)
      check_only=true
      shift
      ;;
    --node)
      (($# >= 2)) || { echo '--node requires a value' >&2; exit 2; }
      ! $selected_node_seen || { echo '--node may only be specified once' >&2; exit 2; }
      selected_node=$2
      selected_node_seen=true
      shift 2
      ;;
    --ignition-dir)
      (($# >= 2)) || { echo '--ignition-dir requires a value' >&2; exit 2; }
      ignition_dir=$2
      shift 2
      ;;
    --output-dir)
      (($# >= 2)) || { echo '--output-dir requires a value' >&2; exit 2; }
      output_dir=$2
      shift 2
      ;;
    --cache-dir)
      (($# >= 2)) || { echo '--cache-dir requires a value' >&2; exit 2; }
      cache_dir=$2
      shift 2
      ;;
    --cp1-disk)
      (($# >= 2)) || { echo '--cp1-disk requires a value' >&2; exit 2; }
      cp1_disk=$2
      shift 2
      ;;
    --cp2-disk)
      (($# >= 2)) || { echo '--cp2-disk requires a value' >&2; exit 2; }
      cp2_disk=$2
      shift 2
      ;;
    --cp3-disk)
      (($# >= 2)) || { echo '--cp3-disk requires a value' >&2; exit 2; }
      cp3_disk=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage
      exit 2
      ;;
  esac
done

for command in base64 butane cmp coreos-installer curl date find flock gpg gpgv jq openssl python3 realpath sha256sum yq; do
  command -v "$command" >/dev/null || {
    echo "missing required command: $command" >&2
    exit 1
  }
done

workdir=$(fabric_secure_tmpdir fabric-node-iso-build 67108864)
current_iso_temporary=
current_checksum_temporary=
current_published_output=
cleanup() {
  [[ -z $current_iso_temporary ]] || rm -f -- "$current_iso_temporary"
  [[ -z $current_checksum_temporary ]] || rm -f -- "$current_checksum_temporary"
  [[ -z $current_published_output ]] || rm -f -- "$current_published_output"
  rm -rf -- "$workdir"
}
trap cleanup EXIT
mkdir -m 0700 -- "$workdir/gnupg"
expected_asset_manifest=$workdir/expected-SHASUMS.txt
build_expected_asset_manifest "$asset_manifest" "$expected_asset_manifest"

mapfile -t media_record < "$manifest"
[[ ${#media_record[@]} -eq 4 ]] || {
  echo "$manifest must contain exactly filename, URL, SHA-256, and signature URL" >&2
  exit 1
}
iso_filename=${media_record[0]}
iso_url=${media_record[1]}
iso_sha256=${media_record[2]}
iso_signature_url=${media_record[3]}

[[ $iso_filename =~ ^fedora-coreos-[A-Za-z0-9._-]+-live-iso\.x86_64\.iso$ ]]
[[ $iso_url == https://builds.coreos.fedoraproject.org/*/$iso_filename ]]
[[ $iso_sha256 =~ ^[0-9a-f]{64}$ ]]
[[ $iso_signature_url == "$iso_url.sig" ]]

fedora_key=/etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-44-primary
fedora_key_fingerprint=36F612DCF27F7D1A48A835E4DBFCF71C6D9F90A6
[[ -s $fedora_key ]] || {
  echo "missing Fedora 44 primary signing key: $fedora_key" >&2
  exit 1
}
actual_fingerprint=$(gpg --quiet --homedir "$workdir/gnupg" --batch --show-keys --with-colons "$fedora_key" |
  awk -F: '$1 == "fpr" { print $10; exit }')
[[ $actual_fingerprint == "$fedora_key_fingerprint" ]] || {
  echo "unexpected Fedora 44 signing-key fingerprint: ${actual_fingerprint:-missing}" >&2
  exit 1
}

yq -e '
  ([.passwd.users[] | select(.name == "sam")] | length == 1) and
  ([.passwd.users[] | select(.name == "sam") | .ssh_authorized_keys[]] | length == 1)
' "$operator_profile" >/dev/null || {
  echo 'canonical fabric operator profile must contain exactly one sam SSH key' >&2
  exit 1
}
sam_ssh_key=$(yq -er '.passwd.users[] | select(.name == "sam") | .ssh_authorized_keys[0]' "$operator_profile")
[[ $sam_ssh_key =~ ^ssh-ed25519[[:space:]][A-Za-z0-9+/]+={0,3}$ ]] || {
  echo 'canonical fabric operator SSH key is not one comment-free Ed25519 public key' >&2
  exit 1
}
live_access_ignition=$workdir/fabric-node-installer-live.ign
butane --strict --pretty --output "$live_access_ignition" "$live_profile"
chmod 0600 -- "$live_access_ignition"
validate_live_access_ignition "$live_access_ignition"

if $check_only; then
  ! $selected_node_seen &&
    [[ -z $ignition_dir && -z $output_dir && -z $cache_dir &&
     -z $cp1_disk && -z $cp2_disk && -z $cp3_disk ]] || {
    echo '--check cannot be combined with build arguments' >&2
    exit 2
  }
  echo "validated pinned installer manifest for $iso_filename"
  echo "validated $expected_asset_count-payload offline router manifest"
  echo 'validated canonical operator key and minimal live-only SSH profile'
  exit 0
fi

[[ -n $ignition_dir && -n $output_dir ]] || {
  usage
  exit 2
}

ignition_dir=$(realpath -e -- "$ignition_dir")
output_dir=$(realpath -m -- "$output_dir")
cache_dir=$(realpath -m -- "${cache_dir:-$default_cache_dir}")
for directory in "$ignition_dir" "$output_dir"; do
  case $directory in
    "$repo_root" | "$repo_root"/*)
      echo "refusing sensitive installer input/output inside Git: $directory" >&2
      exit 1
      ;;
  esac
done

if $selected_node_seen; then
  case $selected_node in
    fabric-az1-cp1)
      [[ -n $cp1_disk && -z $cp2_disk && -z $cp3_disk ]] || {
        echo '--node fabric-az1-cp1 requires only --cp1-disk' >&2
        exit 2
      }
      disks=("$cp1_disk")
      ;;
    fabric-az1-cp2)
      [[ -z $cp1_disk && -n $cp2_disk && -z $cp3_disk ]] || {
        echo '--node fabric-az1-cp2 requires only --cp2-disk' >&2
        exit 2
      }
      disks=("$cp2_disk")
      ;;
    fabric-az1-cp3)
      [[ -z $cp1_disk && -z $cp2_disk && -n $cp3_disk ]] || {
        echo '--node fabric-az1-cp3 requires only --cp3-disk' >&2
        exit 2
      }
      disks=("$cp3_disk")
      ;;
    *)
      echo "unsupported fabric node: $selected_node" >&2
      exit 2
      ;;
  esac
  build_nodes=("$selected_node")
else
  [[ -n $cp1_disk && -n $cp2_disk && -n $cp3_disk ]] || {
    usage
    exit 2
  }
  build_nodes=("${nodes[@]}")
  disks=("$cp1_disk" "$cp2_disk" "$cp3_disk")
  [[ $cp1_disk != "$cp2_disk" && $cp1_disk != "$cp3_disk" && $cp2_disk != "$cp3_disk" ]] || {
    echo 'the three installer destinations must be distinct stable disk identities' >&2
    exit 1
  }
fi

disk_kinds=()
disk_wwns=()
for index in "${!disks[@]}"; do
  node=${build_nodes[$index]}
  disk=${disks[$index]}
  [[ $disk != *-part[0-9]* ]] || {
    echo "refusing an installer destination partition: $disk" >&2
    exit 1
  }

  if [[ $disk =~ ^/dev/disk/by-id/ata-[A-Za-z0-9._:+-]+$ ]]; then
    [[ $node != fabric-az1-cp1 ]] || {
      echo "fabric-az1-cp1 is bound to $cp1_nvme_destination" >&2
      exit 1
    }
    disk_kinds+=(ata)
    disk_wwns+=('')
  elif [[ $disk =~ ^/dev/disk/by-id/nvme-eui\.([0-9a-f]{16})$ ]]; then
    disk_eui=${BASH_REMATCH[1]}
    [[ $disk_eui != 0000000000000000 && $disk_eui != ffffffffffffffff ]] || {
      echo "refusing a placeholder NVMe EUI installer destination: $disk" >&2
      exit 1
    }
    [[ $node == fabric-az1-cp1 && $disk == "$cp1_nvme_destination" ]] || {
      echo "NVMe destination is not admitted for $node: $disk" >&2
      exit 1
    }
    disk_kinds+=(nvme)
    disk_wwns+=("eui.$disk_eui")
  else
    echo "refusing an unstable or unsupported installer destination: $disk" >&2
    exit 1
  fi
done

mkdir -p -- "$cache_dir"
iso=$cache_dir/$iso_filename
signature=$iso.sig
exec {cache_lock_fd}> "$cache_dir/.download.lock"
flock "$cache_lock_fd"

download() {
  local url=$1
  local destination=$2
  local temporary=$destination.tmp.$$

  [[ -f $destination ]] && return
  rm -f -- "$temporary"
  curl --retry 3 --fail --location --output "$temporary" "$url"
  mv -- "$temporary" "$destination"
}

download "$iso_url" "$iso"
echo "$iso_sha256  $iso" | sha256sum --check -
download "$iso_signature_url" "$signature"
fedora_keyring=$workdir/fedora-44-primary.gpg
gpg --quiet --homedir "$workdir/gnupg" --batch --yes --dearmor --output "$fedora_keyring" "$fedora_key"
gpgv --keyring "$fedora_keyring" "$signature" "$iso"
flock -u "$cache_lock_fd"

mkdir -p -- "$output_dir"
chmod 0700 -- "$output_dir"

for node in "${build_nodes[@]}"; do
  output=$output_dir/$node-installer.iso
  checksum=$output.sha256
  [[ ! -e $output && ! -e $output.tmp && ! -e $checksum && ! -e $checksum.tmp ]] || {
    echo "refusing to overwrite existing installer output or checksum: $output" >&2
    exit 1
  }
done

asset_manifest_b64=$(base64 --wrap=0 "$expected_asset_manifest")
mapfile -t asset_names < <(awk '{ print $2 }' "$expected_asset_manifest")
printf -v asset_names_shell '%q ' "${asset_names[@]}"

for index in "${!build_nodes[@]}"; do
  node=${build_nodes[$index]}
  disk=${disks[$index]}
  disk_kind=${disk_kinds[$index]}
  disk_wwn=${disk_wwns[$index]}
  ignition=$ignition_dir/$node.ign
  output=$output_dir/$node-installer.iso
  temporary=$output.tmp
  checksum=$output.sha256
  checksum_temporary=$checksum.tmp
  current_iso_temporary=$temporary
  current_checksum_temporary=$checksum_temporary
  current_published_output=
  pre_install=$workdir/$node-pre-install.sh
  post_install=$workdir/$node-post-install.sh
  installer_config=$workdir/$node-installer.yaml
  network_keyfile=$workdir/$node-fabric-static.nmconnection
  embedded_hostname_file=$workdir/$node-hostname
  embedded_etcd_ca_file=$workdir/$node-etcd-ca.pem
  embedded_etcd_peer_cert_file=$workdir/$node-etcd-peer.pem

  [[ -f $ignition ]] || { echo "missing Ignition: $ignition" >&2; exit 1; }
  [[ -z $(find "$ignition" -maxdepth 0 -perm /077 -print) ]] || {
    echo "Ignition must not be group/world accessible: $ignition" >&2
    exit 1
  }
  jq -e '.ignition.version | startswith("3.")' "$ignition" >/dev/null

  extract_embedded_ignition_file \
    "$ignition" \
    "$network_keyfile_path" \
    "$network_keyfile" \
    "$workdir/$node-ignition-walk"
  chmod 0600 -- "$network_keyfile"
  extract_embedded_ignition_file \
    "$ignition" \
    "$hostname_path" \
    "$embedded_hostname_file" \
    "$workdir/$node-hostname-ignition-walk"
  embedded_hostname=$(tr -d '\n' < "$embedded_hostname_file")
  [[ $embedded_hostname == "$node" ]] || {
    echo "Ignition hostname does not match its installer node: $embedded_hostname != $node" >&2
    exit 1
  }
  extract_embedded_ignition_file \
    "$ignition" \
    "$etcd_ca_path" \
    "$embedded_etcd_ca_file" \
    "$workdir/$node-etcd-ca-ignition-walk"
  extract_embedded_ignition_file \
    "$ignition" \
    "$etcd_peer_cert_path" \
    "$embedded_etcd_peer_cert_file" \
    "$workdir/$node-etcd-peer-ignition-walk"

  mapfile -t mac_records < <(awk -F= '$1 == "mac-address" { print tolower($2) }' "$network_keyfile")
  ((${#mac_records[@]} == 1)) || {
    echo "expected one wired MAC in $ignition, found ${#mac_records[@]}" >&2
    exit 1
  }
  mac=${mac_records[0]}
  [[ $mac =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]] || {
    echo "invalid wired MAC recovered from $ignition" >&2
    exit 1
  }
  [[ ${mac:1:1} == [048c] && $mac != 00:00:00:00:00:00 ]] || {
    echo "wired MAC recovered from $ignition is not a usable globally administered unicast address: $mac" >&2
    exit 1
  }
  mapfile -t address_records < <(awk -F= '$1 == "address1" { print $2 }' "$network_keyfile")
  ((${#address_records[@]} == 1)) || {
    echo "expected one static IPv4 record in $ignition, found ${#address_records[@]}" >&2
    exit 1
  }
  mapfile -t connection_uuid_records < <(awk -F= '$1 == "uuid" { print tolower($2) }' "$network_keyfile")
  ((${#connection_uuid_records[@]} == 1)) || {
    echo "expected one NetworkManager UUID in $ignition, found ${#connection_uuid_records[@]}" >&2
    exit 1
  }
  expected_connection_uuid=${connection_uuid_records[0]}
  [[ $expected_connection_uuid =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || {
    echo "invalid NetworkManager UUID recovered from $ignition" >&2
    exit 1
  }
  node_number=${node##*cp}
  [[ $node_number =~ ^[123]$ ]] || {
    echo "cannot derive fabric address from node name: $node" >&2
    exit 1
  }
  expected_ip=10.66.0.$((node_number + 9))
  expected_cidr=$expected_ip/24
  [[ ${address_records[0]} == "$expected_cidr,10.66.0.1" ]] || {
    echo "Ignition static address does not match $node: ${address_records[0]}" >&2
    exit 1
  }
  openssl verify -CAfile "$embedded_etcd_ca_file" "$embedded_etcd_peer_cert_file" >/dev/null
  openssl x509 -in "$embedded_etcd_peer_cert_file" -noout -checkhost "$node.fabric.internal" >/dev/null
  openssl x509 -in "$embedded_etcd_peer_cert_file" -noout -checkip "$expected_ip" >/dev/null
  certificate_not_before_record=$(openssl x509 -in "$embedded_etcd_peer_cert_file" -noout -startdate)
  certificate_not_after_record=$(openssl x509 -in "$embedded_etcd_peer_cert_file" -noout -enddate)
  [[ $certificate_not_before_record == notBefore=* && $certificate_not_after_record == notAfter=* ]]
  certificate_not_before_epoch=$(date --date="${certificate_not_before_record#notBefore=}" +%s)
  certificate_not_after_epoch=$(date --date="${certificate_not_after_record#notAfter=}" +%s)
  ((certificate_not_before_epoch < certificate_not_after_epoch)) || {
    echo "invalid embedded etcd certificate validity window for $node" >&2
    exit 1
  }

  confirmation=INSTALL:$node:${disk##*/}
  cat > "$pre_install" <<EOF
#!/usr/bin/env bash
set -euo pipefail
exec </dev/console >/dev/console 2>&1

node='$node'
target='$disk'
expected_disk_kind='$disk_kind'
expected_disk_wwn='$disk_wwn'
expected_mac='$mac'
expected_ip='$expected_ip'
expected_cidr='$expected_cidr'
expected_connection_uuid='$expected_connection_uuid'
expected_confirmation='$confirmation'
router_asset_url='$router_asset_url'
expected_asset_manifest_b64='$asset_manifest_b64'
asset_names=($asset_names_shell)
minimum_disk_bytes=68719476736
certificate_not_before_epoch=$certificate_not_before_epoch
certificate_not_after_epoch=$certificate_not_after_epoch

fail() {
  printf 'ADMISSION FAILED: %s\n' "\$*" >&2
  exit 1
}

printf '\nDANGER: armed fabric consensus installer\n'
printf 'Node:        %s\n' "\$node"
printf 'Destination: %s\n' "\$target"
printf 'Wired MAC:   %s\n' "\$expected_mac"
printf 'Static IP:   %s\n\n' "\$expected_cidr"

[[ \$expected_mac =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ &&
   \${expected_mac:1:1} == [048c] && \$expected_mac != 00:00:00:00:00:00 ]] ||
  fail 'embedded expected MAC is not a usable globally administered unicast address'
[[ -d /sys/firmware/efi/efivars ]] || fail 'installer was not booted in UEFI mode'
[[ -c /dev/tpmrm0 ]] || fail 'TPM2 resource-manager device /dev/tpmrm0 is absent'
[[ \$(cat /sys/class/tpm/tpm0/tpm_version_major 2>/dev/null) == 2 ]] ||
  fail 'the admitted TPM is not reported as TPM 2.0'
systemd-analyze has-tpm2 | grep -qx yes || fail 'systemd cannot use this TPM2 stack'
systemd-cryptenroll --tpm2-device=list | grep -Fq /dev/tpmrm0 ||
  fail 'systemd-cryptenroll cannot enumerate /dev/tpmrm0'
current_epoch=\$(date +%s)
((current_epoch >= certificate_not_before_epoch && current_epoch < certificate_not_after_epoch)) ||
  fail 'UTC clock falls outside the embedded etcd leaf-certificate validity window'

[[ -L \$target ]] || fail 'stable destination link is absent'
resolved=\$(readlink -e -- "\$target") || fail 'stable destination link does not resolve'
disk_type=\$(lsblk --nodeps -dnro TYPE -- "\$resolved") ||
  fail 'destination type cannot be inspected'
[[ \$disk_type == disk ]] || {
  fail "destination is not a whole disk: \$resolved"
}
removable=\$(lsblk --nodeps -dnro RM -- "\$resolved") ||
  fail 'destination removable state cannot be inspected'
[[ \$removable == 0 ]] || fail 'destination is reported as removable media'
udev_properties=\$(udevadm info --query=property --name "\$resolved") ||
  fail 'destination udev identity cannot be inspected'
case \$expected_disk_kind in
  ata)
    [[ -z \$expected_disk_wwn ]] || fail 'embedded ATA identity has an unexpected WWN constraint'
    grep -Fxq 'ID_BUS=ata' <<< "\$udev_properties" ||
      fail "destination is not reported as an ATA device: \$resolved"
    ;;
  nvme)
    [[ \$expected_disk_wwn =~ ^eui\.[0-9a-f]{16}\$ &&
       \$expected_disk_wwn != eui.0000000000000000 &&
       \$expected_disk_wwn != eui.ffffffffffffffff ]] ||
      fail 'embedded NVMe EUI identity is invalid'
    grep -Fxq "ID_WWN=\$expected_disk_wwn" <<< "\$udev_properties" ||
      fail "destination NVMe EUI does not match \$expected_disk_wwn"
    nvme_nsid=
    nvme_nsid_records=0
    while IFS= read -r property; do
      case \$property in
        ID_NSID=*)
          nvme_nsid=\${property#ID_NSID=}
          ((nvme_nsid_records += 1))
          ;;
      esac
    done <<< "\$udev_properties"
    ((nvme_nsid_records == 1)) && [[ \$nvme_nsid =~ ^[1-9][0-9]*\$ ]] ||
      fail 'destination does not expose one positive NVMe namespace ID'
    disk_transport=\$(lsblk --nodeps -dnro TRAN -- "\$resolved") ||
      fail 'destination transport cannot be inspected'
    [[ \$disk_transport == nvme ]] ||
      fail "destination is not reported on the NVMe transport: \$resolved"
    ;;
  *)
    fail 'embedded destination kind is invalid'
    ;;
esac
[[ \$(blockdev --getro "\$resolved") == 0 ]] || fail 'destination is read-only'
disk_bytes=\$(blockdev --getsize64 "\$resolved")
((disk_bytes >= minimum_disk_bytes)) ||
  fail "destination is smaller than the 64 GiB floor: \$disk_bytes bytes"
if lsblk -nrpo MOUNTPOINTS -- "\$resolved" | grep -q '[^[:space:]]'; then
  fail 'destination or one of its partitions is mounted'
fi
while IFS= read -r block_path; do
  block_name=\${block_path##*/}
  if find "/sys/class/block/\$block_name/holders" -mindepth 1 -maxdepth 1 -print -quit |
      grep -q .; then
    fail "destination component has active holders: \$block_path"
  fi
done < <(lsblk -nrpo NAME -- "\$resolved")

command -v ethtool >/dev/null || fail 'ethtool is unavailable; permanent NIC identity cannot be verified'
interface=
for interface_path in /sys/class/net/*; do
  candidate_interface=\${interface_path##*/}
  [[ \$candidate_interface == lo ]] && continue
  permanent_record=\$(LC_ALL=C ethtool -P "\$candidate_interface" 2>/dev/null) || continue
  permanent_record=\${permanent_record,,}
  if [[ \$permanent_record =~ ^permanent[[:space:]]+address:[[:space:]]+(([0-9a-f]{2}:){5}[0-9a-f]{2})$ &&
        \${BASH_REMATCH[1]} == "\$expected_mac" ]]; then
    [[ -z \$interface ]] || fail 'expected permanent MAC appears on multiple interfaces'
    interface=\$candidate_interface
  fi
done
[[ -n \$interface ]] ||
  fail 'expected permanent wired MAC is absent or cannot be read with ethtool -P'
[[ -r /sys/class/net/\$interface/address ]] ||
  fail "current MAC for \$interface is absent or unreadable"
current_mac=\$(<"/sys/class/net/\$interface/address")
current_mac=\${current_mac,,}
[[ \$current_mac == "\$expected_mac" ]] ||
  fail "permanent MAC matched \$interface, but its current address is \$current_mac"
command -v nmcli >/dev/null || fail 'nmcli is unavailable; the exact static profile cannot be activated'
systemctl is-active --quiet NetworkManager.service ||
  systemctl start NetworkManager.service ||
  fail 'NetworkManager could not be started'
nmcli connection reload || fail 'NetworkManager could not reload embedded profiles'
if ! nmcli --wait 30 connection up uuid "\$expected_connection_uuid" ifname "\$interface" >/dev/null; then
  nmcli --fields GENERAL.STATE,GENERAL.CONNECTION,GENERAL.CON-UUID,IP4.ADDRESS,IP4.GATEWAY \
    device show "\$interface" >&2 || true
  fail "exact static profile \$expected_connection_uuid could not activate on \$interface"
fi
active_connection_uuid=\$(nmcli --get-values GENERAL.CON-UUID device show "\$interface") ||
  fail "NetworkManager could not report the active profile UUID on \$interface"
[[ \$active_connection_uuid == "\$expected_connection_uuid" ]] ||
  fail "NetworkManager activated unexpected profile \$active_connection_uuid on \$interface"
network_ready=false
for _ in {1..30}; do
  if ip -4 -o address show dev "\$interface" |
      awk '{ print \$4 }' | grep -Fxq "\$expected_cidr" &&
      ip -4 route get 10.66.0.1 |
      grep -Eq "dev \$interface( |\$).*src \$expected_ip( |\$)"; then
    network_ready=true
    break
  fi
  sleep 1
done
if ! \$network_ready; then
  nmcli --fields GENERAL.STATE,GENERAL.CONNECTION,GENERAL.CON-UUID,IP4.ADDRESS,IP4.GATEWAY \
    device show "\$interface" >&2 || true
  fail "expected static address and router route did not become active on \$interface"
fi

if systemctl start sshd.service; then
  for _ in {1..20}; do
    [[ -s /etc/ssh/ssh_host_ed25519_key.pub ]] && break
    sleep 0.25
  done
  if [[ -s /etc/ssh/ssh_host_ed25519_key.pub ]]; then
    printf 'Live SSH:   core@%s from 10.66.0.2; host key %s\n' \
      "\$expected_ip" "\$(ssh-keygen -l -E sha256 -f /etc/ssh/ssh_host_ed25519_key.pub)"
  else
    printf 'Live SSH:   sshd started but its ED25519 host key is unavailable\n' >&2
  fi
else
  printf 'Live SSH:   sshd failed to start; console confirmation remains available\n' >&2
fi

expected_manifest=\$(mktemp)
actual_manifest=\$(mktemp)
cleanup() {
  rm -f -- "\$expected_manifest" "\$actual_manifest"
}
trap cleanup EXIT
printf '%s' "\$expected_asset_manifest_b64" | base64 --decode > "\$expected_manifest"
curl --fail --silent --show-error --connect-timeout 5 --max-time 15 --retry 2 \
  --output "\$actual_manifest" "\$router_asset_url/SHASUMS.txt" ||
  fail 'cannot fetch the router offline-asset manifest'
cmp --silent "\$expected_manifest" "\$actual_manifest" ||
  fail 'router offline-asset manifest does not match the installer expectation'
for asset_name in "\${asset_names[@]}"; do
  curl --fail --silent --show-error --connect-timeout 5 --max-time 15 \
    --head --output /dev/null "\$router_asset_url/\$asset_name" ||
    fail "router asset is not readable: \$asset_name"
done

lsblk -dn -o PATH,SIZE,MODEL,SERIAL,TRAN -- "\$resolved"
printf 'TPM2:       admitted by systemd and systemd-cryptenroll\n'
printf 'UTC clock:  %s (inside embedded etcd certificate validity)\n' "\$(date --utc --iso-8601=seconds)"
printf 'Router:     exact $expected_asset_count-payload manifest reachable via %s\n' "\$interface"
printf '\nCompare node, IP, MAC, disk path, model, and serial with the chassis label.\n'
printf 'Type exactly: %s\n> ' "\$expected_confirmation"
IFS= read -r reply
[[ \$reply == "\$expected_confirmation" ]] || {
  echo 'confirmation mismatch; refusing installation'
  exit 1
}
echo 'confirmation accepted; destructive offline installation begins now'
EOF
  chmod 0700 -- "$pre_install"

  cat > "$post_install" <<EOF
#!/usr/bin/env bash
set -euo pipefail
exec </dev/console >/dev/console 2>&1

printf '\nINSTALL SUCCEEDED: %s is installed on %s.\n' '$node' '$disk'
printf 'Powering off now. Remove and rewrite the armed USB installer before booting again.\n'
sync
systemctl --no-block poweroff
# Keep the install target from completing into the live-media login/reboot path
# while systemd executes the requested poweroff.
while :; do
  sleep 60
done
EOF
  chmod 0700 -- "$post_install"

  cat > "$installer_config" <<'EOF'
offline: true
EOF

  coreos-installer iso customize \
    --live-ignition "$live_access_ignition" \
    --dest-device "$disk" \
    --dest-ignition "$ignition" \
    --installer-config "$installer_config" \
    --network-keyfile "$network_keyfile" \
    --pre-install "$pre_install" \
    --post-install "$post_install" \
    --live-karg-append coreos.inst.skip_reboot \
    --output "$temporary" \
    "$iso"

  # coreos-installer reports that a configured destination installs without
  # its own interactive prompt.  Our destructive gate is the generated
  # pre-install unit, so re-open the completed ISO and prove that the unit,
  # exact destination Ignition, device identity, and network keyfile all made
  # it into the boot media before publishing the temporary output.
  verified_live_ignition=$workdir/$node-verified-live.ign
  verified_destination_ignition=$workdir/$node-verified-destination.ign
  verified_pre_install=$workdir/$node-verified-pre-install.sh
  verified_post_install=$workdir/$node-verified-post-install.sh
  verified_installer_config=$workdir/$node-verified-installer.yaml
  verified_customize_config=$workdir/$node-verified-customize.yaml
  verified_live_access_ignition=$workdir/$node-verified-live-access.ign
  verified_network_dir=$workdir/$node-verified-network

  coreos-installer iso ignition show "$temporary" > "$verified_live_ignition"
  chmod 0600 -- "$verified_live_ignition"
  failed_live_checks=$(jq -r --arg node "$node" '
    ([
      "# Generated by coreos-installer {iso|pxe} customize",
      "",
      "[Unit]",
      ("Description=Pre-Install Script (" + $node + "-pre-install.sh)"),
      "Documentation=https://coreos.github.io/coreos-installer/customizing-install/",
      "After=coreos-installer-pre.target",
      "Before=coreos-installer.service",
      "",
      "[Service]",
      "Type=oneshot",
      ("ExecStart=/usr/local/bin/pre-install-" + $node + "-pre-install.sh"),
      "RemainAfterExit=true",
      "StandardOutput=kmsg+console",
      "StandardError=kmsg+console",
      "",
      "[Install]",
      "RequiredBy=coreos-installer.service"
    ] | join("\n")) as $expected_pre_unit |
    ([
      "# Generated by coreos-installer {iso|pxe} customize",
      "",
      "[Unit]",
      ("Description=Post-Install Script (" + $node + "-post-install.sh)"),
      "Documentation=https://coreos.github.io/coreos-installer/customizing-install/",
      "After=coreos-installer.service",
      "Before=coreos-installer.target",
      "",
      "[Service]",
      "Type=oneshot",
      ("ExecStart=/usr/local/bin/post-install-" + $node + "-post-install.sh"),
      "RemainAfterExit=true",
      "StandardOutput=kmsg+console",
      "StandardError=kmsg+console",
      "",
      "[Install]",
      "RequiredBy=coreos-installer.target"
    ] | join("\n")) as $expected_post_unit |
    {
      exact_live_access_merge:
        (((.ignition.config.merge // []) | length) == 1) and
        ((.ignition.config.merge[0] | keys | sort) ==
          (["compression", "source"] | sort)) and
        (.ignition.config.merge[0].source | type == "string") and
        (.ignition.config.merge[0].source | startswith("data:")) and
        ((.ignition.config.merge[0].compression // "") | IN("", "gzip")) and
        ((.ignition.config.merge[0].verification // null) == null),
      no_ignition_replace: ((.ignition.config.replace // null) == null),
      exact_storage_shape: ((.storage | keys | sort) == ["files"]),
      exact_file_count: ((.storage.files | length) == 5),
      exact_systemd_shape: ((.systemd | keys | sort) == ["units"]),
      exact_unit_count: ((.systemd.units | length) == 2),
      safe_unit_object_shapes: all(.systemd.units[];
        (((. | keys) - ["contents", "dropins", "enabled", "mask", "name"] | length) == 0) and
        ((.mask // false) == false) and
        (((.dropins // []) | length) == 0)),
      exact_pre_install_unit: any(.systemd.units[];
        .name == ("pre-install-" + $node + "-pre-install.sh.service") and
        .enabled == true and
        .contents == $expected_pre_unit),
      exact_post_install_unit: any(.systemd.units[];
        .name == ("post-install-" + $node + "-post-install.sh.service") and
        .enabled == true and
        .contents == $expected_post_unit)
    }
    | to_entries[]
    | select(.value != true)
    | .key
  ' "$verified_live_ignition")
  if [[ -n $failed_live_checks ]]; then
    echo "customized ISO has unexpected live-Ignition structure: $node" >&2
    printf '%s\n' "$failed_live_checks" >&2
    exit 1
  fi

  live_access_source=$(jq -r '.ignition.config.merge[0].source' "$verified_live_ignition")
  live_access_compression=$(jq -r '.ignition.config.merge[0].compression // ""' "$verified_live_ignition")
  decode_data_url \
    "$live_access_source" \
    "$live_access_compression" \
    "$verified_live_access_ignition"
  chmod 0600 -- "$verified_live_access_ignition"
  cmp --silent \
    <(jq --sort-keys --compact-output \
      'walk(if type == "object" then with_entries(select(.value != null)) else . end)' \
      "$live_access_ignition") \
    <(jq --sort-keys --compact-output \
      'walk(if type == "object" then with_entries(select(.value != null)) else . end)' \
      "$verified_live_access_ignition") || {
    echo "customized ISO live-access Ignition differs from its source: $node" >&2
    exit 1
  }
  validate_live_access_ignition "$verified_live_access_ignition"

  extract_embedded_ignition_file \
    "$verified_live_ignition" \
    "/usr/local/bin/pre-install-$node-pre-install.sh" \
    "$verified_pre_install" \
    "$workdir/$node-verified-pre-walk"
  extract_embedded_ignition_file \
    "$verified_live_ignition" \
    "/usr/local/bin/post-install-$node-post-install.sh" \
    "$verified_post_install" \
    "$workdir/$node-verified-post-walk"
  extract_embedded_ignition_file \
    "$verified_live_ignition" \
    /etc/coreos/dest.ign \
    "$verified_destination_ignition" \
    "$workdir/$node-verified-destination-walk"
  extract_embedded_ignition_file \
    "$verified_live_ignition" \
    "/etc/coreos/installer.d/0000-${installer_config##*/}" \
    "$verified_installer_config" \
    "$workdir/$node-verified-installer-walk"
  extract_embedded_ignition_file \
    "$verified_live_ignition" \
    /etc/coreos/installer.d/0001-customize.yaml \
    "$verified_customize_config" \
    "$workdir/$node-verified-customize-walk"

  cmp --silent "$pre_install" "$verified_pre_install" || {
    echo "customized ISO pre-install gate differs from its source: $node" >&2
    exit 1
  }
  cmp --silent "$post_install" "$verified_post_install" || {
    echo "customized ISO post-install gate differs from its source: $node" >&2
    exit 1
  }
  cmp --silent "$ignition" "$verified_destination_ignition" || {
    echo "customized ISO destination Ignition differs from its source: $node" >&2
    exit 1
  }
  cmp --silent "$installer_config" "$verified_installer_config" || {
    echo "customized ISO offline installer config differs from its source: $node" >&2
    exit 1
  }
  cmp --silent \
    <(printf '%s\n' \
      'ignition-file: /etc/coreos/dest.ign' \
      'copy-network: true' \
      "dest-device: $disk") \
    "$verified_customize_config" || {
    echo "customized ISO device or copy-network config is unexpected: $node" >&2
    exit 1
  }

  mkdir -m 0700 -- "$verified_network_dir"
  coreos-installer iso network extract \
    --directory "$verified_network_dir" \
    "$temporary" >/dev/null
  mapfile -d '' verified_network_entries < <(
    find "$verified_network_dir" -mindepth 1 -maxdepth 1 -print0
  )
  ((${#verified_network_entries[@]} == 1)) || {
    echo "customized ISO does not contain exactly one network entry: $node" >&2
    exit 1
  }
  verified_network_entry=${verified_network_entries[0]}
  [[ -f $verified_network_entry && ! -L $verified_network_entry &&
     ${verified_network_entry##*/} == "${network_keyfile##*/}" ]] || {
    echo "customized ISO network entry is not the exact regular keyfile: $node" >&2
    exit 1
  }
  cmp --silent "$network_keyfile" "$verified_network_entry" || {
    echo "customized ISO network keyfile differs from its source: $node" >&2
    exit 1
  }

  chmod 0600 -- "$temporary"
  output_sha256=$(sha256sum "$temporary" | awk '{ print $1 }')
  printf '%s  %s\n' "$output_sha256" "${output##*/}" > "$checksum_temporary"
  chmod 0600 -- "$checksum_temporary"

  current_published_output=$output
  mv -- "$temporary" "$output"
  current_iso_temporary=
  mv -- "$checksum_temporary" "$checksum"
  current_checksum_temporary=
  current_published_output=
  echo "verified embedded install gate and exact inputs for $node" >&2
  printf '%s  %s\n' "$output_sha256" "$output"
done

echo "wrote ${#build_nodes[@]} confirmation-gated secret installer ISO(s) to $output_dir" >&2
