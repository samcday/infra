#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Use the fabric Kubernetes context from the tracked infra kubeconfig.

Usage:
  fk <kubectl arguments...>
  fk k9s [k9s arguments...]

The kubeconfig reaches the pinned Fabric API directly through the redundant
Tailnet subnet routes, while its exec helper maintains a bounded operator
credential. No K3s administrator kubeconfig or CA private key leaves a root.
EOF
}

[[ $# -gt 0 ]] || {
  usage >&2
  exit 2
}

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repo_root=$(cd -- "$script_dir/.." && pwd -P)
export FABRIC_INFRA_ROOT=$repo_root
if [[ $1 == k9s ]]; then
  shift
  exec k9s --kubeconfig "$repo_root/kubeconfig" --context fabric "$@"
fi
exec kubectl --kubeconfig="$repo_root/kubeconfig" --context=fabric "$@"
