#!/usr/bin/env bash
set -euo pipefail

export LC_ALL=C
umask 077

script_path=$(realpath -e -- "${BASH_SOURCE[0]}")
script_dir=$(dirname -- "$script_path")
repo_root=$(realpath -e -- "$script_dir/..")

usage() {
  cat >&2 <<'EOF'
Usage:
  revoke-fabric-worker-bootie-access --check

  sudo revoke-fabric-worker-bootie-access \
    --node fabric-az1-svc1 \
    --root-address 10.66.0.10 \
    --known-hosts /trusted/fabric-root-known-hosts \
    --identity /trusted/id_ed25519 \
    --access-dir /dev/shm/fabric-az1-svc1-bootie-access \
    --confirm REVOKE:fabric-az1-svc1-bootie

Run only after the worker station is stopped. This removes its temporary
ServiceAccount/RBAC, clears one-use credentials, and zeroes the local token.
An aborted arm returns to discovery.  After an install response, the exact
placeholder UID and bootstrap state remain as a non-secret finalization receipt
until finalize-fabric-worker-bootstrap proves the joined worker healthy.
EOF
}

die() {
  printf 'revoke-fabric-worker-bootie-access: %s\n' "$*" >&2
  exit 1
}

repo_git() {
  git -c "safe.directory=$repo_root" -C "$repo_root" "$@"
}

delete_response_matches_uid() {
  local uid=$1
  jq -e --arg uid "$uid" '
    (.kind == "Status" and .status == "Success") or
    (.metadata.uid == $uid)
  ' >/dev/null
}

validate_worker_rbac() {
  local manifest=$1 expected_node=$2 expected_namespace=$3 expected_name=$4
  local rendered
  rendered=$(yq eval-all --output-format=json '.' "$manifest") || return 1
  jq --slurp --exit-status \
    --arg node "$expected_node" --arg namespace "$expected_namespace" \
    --arg name "$expected_name" '
      length == 4 and
      ([.[].kind] | sort) ==
        ["ClusterRole", "ClusterRoleBinding", "Namespace", "ServiceAccount"] and
      ([.[] | select(.kind == "Namespace")] | length) == 1 and
      ([.[] | select(.kind == "ServiceAccount")] | length) == 1 and
      ([.[] | select(.kind == "ClusterRole")] | length) == 1 and
      ([.[] | select(.kind == "ClusterRoleBinding")] | length) == 1 and
      ([.[] | select(.kind == "Namespace")][0] |
        .apiVersion == "v1" and .metadata.name == $namespace) and
      ([.[] | select(.kind == "ServiceAccount")][0] |
        .apiVersion == "v1" and .metadata.name == $name and
        .metadata.namespace == $namespace and .automountServiceAccountToken == false) and
      ([.[] | select(.kind == "ClusterRole")][0] |
        .apiVersion == "rbac.authorization.k8s.io/v1" and
        .metadata.name == $name and (.rules | length) == 1 and
        (.rules[0].apiGroups == [""]) and
        (.rules[0].resources == ["nodes"]) and
        (.rules[0].resourceNames == [$node]) and
        ((.rules[0].verbs | sort) == ["get", "patch"])) and
      ([.[] | select(.kind == "ClusterRoleBinding")][0] |
        .apiVersion == "rbac.authorization.k8s.io/v1" and
        .metadata.name == $name and
        .roleRef == {apiGroup:"rbac.authorization.k8s.io", kind:"ClusterRole", name:$name} and
        .subjects == [{kind:"ServiceAccount", name:$name, namespace:$namespace}])
    ' <<< "$rendered" >/dev/null
}

check_only=false
node=
root_address=
known_hosts=
identity=
access_dir=
confirmation=
while (($#)); do
  case $1 in
    --check) check_only=true; shift ;;
    --node) (($# >= 2)) || die '--node requires a value'; node=$2; shift 2 ;;
    --root-address) (($# >= 2)) || die '--root-address requires a value'; root_address=$2; shift 2 ;;
    --known-hosts) (($# >= 2)) || die '--known-hosts requires a value'; known_hosts=$2; shift 2 ;;
    --identity) (($# >= 2)) || die '--identity requires a value'; identity=$2; shift 2 ;;
    --access-dir) (($# >= 2)) || die '--access-dir requires a value'; access_dir=$2; shift 2 ;;
    --confirm) (($# >= 2)) || die '--confirm requires a value'; confirmation=$2; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

if $check_only; then
  [[ -z $node && -z $root_address && -z $known_hosts && -z $identity &&
     -z $access_dir && -z $confirmation ]] ||
    die '--check cannot be combined with revoke arguments'
  bash -n "$script_path"
  [[ $(repo_git rev-parse --show-toplevel) == "$repo_root" ]] ||
    die 'script path does not resolve to the repository root'
  check_name=fabric-worker-bootie-svc1
  check_node=fabric-az1-svc1
  validate_worker_rbac <(
    sed -e "s/@FABRIC_WORKER_BOOTIE_NAMESPACE@/$check_name/g" \
      -e "s/@FABRIC_WORKER_BOOTIE_NAME@/$check_name/g" \
      -e "s/@FABRIC_WORKER_NODE@/$check_node/g" \
      "$repo_root/fabric/bootie/worker-rbac.yaml.in"
  ) "$check_node" "$check_name" "$check_name" ||
    die 'offline worker RBAC render check failed'
  check_uid=11111111-1111-1111-1111-111111111111
  delete_response_matches_uid "$check_uid" <<<'{"kind":"Status","status":"Success"}'
  delete_response_matches_uid "$check_uid" <<<"{\"metadata\":{\"uid\":\"$check_uid\"}}"
  if delete_response_matches_uid "$check_uid" \
      <<<'{"metadata":{"uid":"22222222-2222-2222-2222-222222222222"}}'; then
    die 'delete-response UID check accepted the wrong object'
  fi
  printf 'validated worker Bootie access revoker syntax\n'
  exit 0
fi

((EUID == 0)) || die 'run this credential-revocation mutation as root'
case $node in
  fabric-az1-svc1) short_node=svc1 ;;
  fabric-az1-svc2) short_node=svc2 ;;
  *) usage; die '--node must be fabric-az1-svc1 or fabric-az1-svc2' ;;
esac
case $root_address in
  10.66.0.10 | 10.66.0.11 | 10.66.0.12) ;;
  *) die '--root-address must be a live commissioned root' ;;
esac
[[ $confirmation == "REVOKE:$node-bootie" ]] ||
  die "exact --confirm REVOKE:$node-bootie is required"
[[ -n $known_hosts && -n $identity && -n $access_dir ]] || { usage; exit 2; }

for command in bash chmod date find git grep install ip jq mktemp mv podman \
  realpath rmdir sed sleep ssh ss stat systemctl yq; do
  command -v "$command" >/dev/null || die "missing required command: $command"
done
known_hosts=$(realpath -e -- "$known_hosts")
identity=$(realpath -e -- "$identity")
access_dir=$(realpath -e -- "$access_dir")
[[ -f $known_hosts && ! -L $known_hosts && $(stat -Lc '%a' "$known_hosts") == 600 ]] ||
  die 'known_hosts must be a non-symlink mode-0600 file'
[[ -f $identity && ! -L $identity && $(stat -Lc '%a' "$identity") == 600 ]] ||
  die 'SSH identity must be a non-symlink mode-0600 file'
[[ -d $access_dir && ! -L $access_dir &&
   $(stat --file-system --format=%T -- "$access_dir") == tmpfs &&
   $(stat -Lc '%u:%g:%a' "$access_dir") == 0:0:700 ]] ||
  die 'access directory must be root-owned mode-0700 tmpfs'
for access_file in kubeconfig token identity.json; do
  [[ -f $access_dir/$access_file && ! -L $access_dir/$access_file &&
     $(stat -Lc '%u:%g:%a:%h' "$access_dir/$access_file") == 0:0:600:1 ]] ||
    die "scoped access file is unsafe: $access_file"
done

bootie_name=fabric-worker-bootie-$short_node
bootie_namespace=$bootie_name
jq -e --arg node "$node" --arg root "$root_address" \
  --arg namespace "$bootie_namespace" --arg serviceaccount "$bootie_name" '
    .schema == 1 and .node == $node and .rootAddress == $root and
    (.nodeUid | type == "string" and length > 0) and
    (.repoCommit | test("^[0-9a-f]{40}$")) and
    .namespace == $namespace and .serviceAccount == $serviceaccount and
    (.rbacObjects | length) == 4 and
    ([.rbacObjects[].kind] | sort) ==
      ["ClusterRole", "ClusterRoleBinding", "Namespace", "ServiceAccount"] and
    all(.rbacObjects[];
      (.uid | test("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")) and
      .name == $serviceaccount and
      (if .kind == "ServiceAccount" then .namespace == $namespace else .namespace == "" end))
' "$access_dir/identity.json" >/dev/null || die 'access identity does not match revocation request'
node_uid=$(jq -r '.nodeUid' "$access_dir/identity.json")
repo_commit=$(jq -r '.repoCommit' "$access_dir/identity.json")

unit_name=$bootie_name-station.service
if systemctl is-active --quiet "$unit_name"; then die "$unit_name is still active"; fi
container_rc=0
podman container exists "$bootie_name" >/dev/null 2>&1 || container_rc=$?
case $container_rc in
  0) die "$bootie_name container still exists" ;;
  1) ;;
  *) die "could not prove $bootie_name container absence" ;;
esac
tcp_listeners=$(ip netns exec fabric-observer ss -H -lnt \
  '( sport = :80 or sport = :9000 )') ||
  die 'could not inspect Bootie or FastCGI listeners in fabric-observer'
if grep -q . <<< "$tcp_listeners"; then
  die 'Bootie or FastCGI listener remains in fabric-observer'
fi
udp_listeners=$(ip netns exec fabric-observer ss -H -lnu \
  '( sport = :67 or sport = :69 )') ||
  die 'could not inspect DHCP or TFTP listeners in fabric-observer'
if grep -q . <<< "$udp_listeners"; then
  die 'DHCP or TFTP listener remains in fabric-observer'
fi

ssh_options=(
  -F /dev/null -o BatchMode=yes -o ClearAllForwardings=yes -o ConnectTimeout=5
  -o ControlMaster=no -o ControlPath=none -o ForwardAgent=no
  -o GlobalKnownHostsFile=/dev/null -o IdentitiesOnly=yes
  -o PermitLocalCommand=no -o ProxyCommand=none -o ProxyJump=none
  -o RequestTTY=no -o StrictHostKeyChecking=yes -o UpdateHostKeys=no
  -o "UserKnownHostsFile=$known_hosts" -i "$identity"
)
ssh_root() {
  local remote_command
  printf -v remote_command '%q ' "$@"
  remote_command=${remote_command% }
  # shellcheck disable=SC2029
  ip netns exec fabric-observer ssh "${ssh_options[@]}" "sam@$root_address" "$remote_command"
}
root_kubectl() {
  ssh_root sudo --non-interactive /usr/local/bin/k3s kubectl \
    --kubeconfig /etc/rancher/k3s/k3s.yaml --request-timeout=10s "$@"
}
root_uid_delete() {
  local uri=$1 delete_options=$2
  printf '%s' "$delete_options" |
    ssh_root sudo --non-interactive /usr/bin/curl \
      --silent --show-error --fail-with-body --connect-timeout 5 --max-time 10 \
      --cacert /var/lib/rancher/k3s/server/tls/server-ca.crt \
      --cert /var/lib/rancher/k3s/server/tls/client-admin.crt \
      --key /var/lib/rancher/k3s/server/tls/client-admin.key \
      --request DELETE --header Content-Type:application/json --data-binary @- \
      "https://127.0.0.1:6443$uri"
}
[[ $(root_kubectl get --raw=/readyz) == ok ]] || die 'selected root API is not ready'

work=$(mktemp -d -- /dev/shm/.fabric-worker-bootie-revoke.XXXXXXXX)
chmod 0700 "$work"
trap 'find "$work" -mindepth 1 -delete 2>/dev/null || true; rmdir "$work" 2>/dev/null || true' EXIT
rbac=$work/rbac.yaml
repo_git cat-file -e "$repo_commit^{commit}" 2>/dev/null ||
  die 'issued repository commit is unavailable for trusted RBAC reconstruction'
repo_git show "$repo_commit:fabric/bootie/worker-rbac.yaml.in" > "$rbac" ||
  die 'issued repository commit lacks the worker RBAC template'
chmod 0600 "$rbac"
sed -i \
  -e "s/@FABRIC_WORKER_BOOTIE_NAMESPACE@/$bootie_namespace/g" \
  -e "s/@FABRIC_WORKER_BOOTIE_NAME@/$bootie_name/g" \
  -e "s/@FABRIC_WORKER_NODE@/$node/g" "$rbac"
! grep -q '@FABRIC_' "$rbac" || die 'rendered worker RBAC retains a placeholder'
validate_worker_rbac "$rbac" "$node" "$bootie_namespace" "$bootie_name" ||
  die 'trusted worker RBAC reconstruction is not the exact four-object scope'
rbac_objects=$work/rbac-objects.json
yq eval-all --output-format=json '.' "$rbac" |
  jq --slurp '.' > "$rbac_objects"
chmod 0600 "$rbac_objects"

# Validate every still-present object against both the immutable issued UID
# receipt and the structurally checked committed manifest before deleting any
# of them.  This makes revocation resumable without ever adopting or deleting
# a same-name replacement.
for rbac_index in {0..3}; do
  recorded_kind=$(jq -r ".rbacObjects[$rbac_index].kind" "$access_dir/identity.json")
  recorded_name=$(jq -r ".rbacObjects[$rbac_index].name" "$access_dir/identity.json")
  recorded_namespace=$(jq -r ".rbacObjects[$rbac_index].namespace" "$access_dir/identity.json")
  recorded_uid=$(jq -r ".rbacObjects[$rbac_index].uid" "$access_dir/identity.json")
  expected_object=$(jq -c --arg kind "$recorded_kind" \
    '[.[] | select(.kind == $kind)] | if length == 1 then .[0] else error("kind count") end' \
    "$rbac_objects") || die "trusted RBAC lacks exactly one $recorded_kind"
  [[ $(jq -r '.metadata.name' <<< "$expected_object") == "$recorded_name" &&
     $(jq -r '.metadata.namespace // ""' <<< "$expected_object") == "$recorded_namespace" ]] ||
    die 'issued RBAC receipt differs from its committed reviewed manifest'
  case $recorded_kind in
    Namespace) recorded_ref=namespace/$recorded_name; recorded_ns_args=() ;;
    ServiceAccount)
      recorded_ref=serviceaccount/$recorded_name
      recorded_ns_args=(--namespace "$recorded_namespace")
      ;;
    ClusterRole) recorded_ref=clusterrole/$recorded_name; recorded_ns_args=() ;;
    ClusterRoleBinding)
      recorded_ref=clusterrolebinding/$recorded_name
      recorded_ns_args=()
      ;;
    *) die "unexpected issued RBAC kind: $recorded_kind" ;;
  esac
  live_object=$(root_kubectl "${recorded_ns_args[@]}" get "$recorded_ref" \
    --ignore-not-found --output=json) || die "could not inspect issued $recorded_ref"
  if [[ -n $live_object ]]; then
    jq -e --arg kind "$recorded_kind" --arg name "$recorded_name" \
      --arg namespace "$recorded_namespace" --arg uid "$recorded_uid" \
      --arg node "$node" '
        .kind == $kind and .metadata.name == $name and .metadata.uid == $uid and
        ((.metadata.namespace // "") == $namespace) and
        .metadata.labels["fabric.samcday.com/bootstrap-node"] == $node and
        .metadata.labels["fabric.samcday.com/purpose"] == "worker-bootstrap"
      ' <<< "$live_object" >/dev/null ||
      die "same-name $recorded_ref no longer has the issued UID; refusing deletion"
    printf '%s' "$live_object" > "$work/live-rbac-$rbac_index.json"
    chmod 0600 "$work/live-rbac-$rbac_index.json"
  fi
done
for rbac_index in 3 2 1 0; do
  [[ -f $work/live-rbac-$rbac_index.json ]] || continue
  recorded_kind=$(jq -r '.kind' "$work/live-rbac-$rbac_index.json")
  recorded_name=$(jq -r '.metadata.name' "$work/live-rbac-$rbac_index.json")
  recorded_namespace=$(jq -r '.metadata.namespace // ""' "$work/live-rbac-$rbac_index.json")
  recorded_uid=$(jq -r '.metadata.uid' "$work/live-rbac-$rbac_index.json")
  case $recorded_kind in
    Namespace)
      recorded_ref=namespace/$recorded_name
      recorded_ns_args=()
      recorded_uri=/api/v1/namespaces/$recorded_name
      ;;
    ServiceAccount)
      recorded_ref=serviceaccount/$recorded_name
      recorded_ns_args=(--namespace "$recorded_namespace")
      recorded_uri=/api/v1/namespaces/$recorded_namespace/serviceaccounts/$recorded_name
      ;;
    ClusterRole)
      recorded_ref=clusterrole/$recorded_name
      recorded_ns_args=()
      recorded_uri=/apis/rbac.authorization.k8s.io/v1/clusterroles/$recorded_name
      ;;
    ClusterRoleBinding)
      recorded_ref=clusterrolebinding/$recorded_name
      recorded_ns_args=()
      recorded_uri=/apis/rbac.authorization.k8s.io/v1/clusterrolebindings/$recorded_name
      ;;
  esac
  delete_options=$(jq -cn --arg uid "$recorded_uid" '{
    apiVersion:"v1", kind:"DeleteOptions",
    preconditions:{uid:$uid}, propagationPolicy:"Background"
  }')
  delete_response=
  if delete_response=$(root_uid_delete "$recorded_uri" "$delete_options" 2>/dev/null); then
    # Immediate deletion may return the deleted object without a
    # deletionTimestamp; the UID precondition and returned UID still bind the
    # response to the exact issued object.  The absence loop below remains the
    # authoritative completion proof.
    delete_response_matches_uid "$recorded_uid" <<< "$delete_response" ||
      die "UID-preconditioned delete returned an unexpected response for $recorded_ref"
  else
    # A concurrent disappearance is already revoked.  A same-name replacement
    # remains visible and must fail closed; the UID precondition never deletes it.
    remaining=$(root_kubectl "${recorded_ns_args[@]}" get "$recorded_ref" \
      --ignore-not-found --output=json) || die "could not recheck $recorded_ref after raw delete"
    [[ -z $remaining ]] ||
      die "UID-preconditioned API delete refused or failed for $recorded_ref"
  fi
  for _attempt in {1..40}; do
    remaining=$(root_kubectl "${recorded_ns_args[@]}" get "$recorded_ref" \
      --ignore-not-found --output=json) || die "could not verify deletion of $recorded_ref"
    [[ -z $remaining ]] && break
    jq -e --arg uid "$recorded_uid" '
      .metadata.uid == $uid and (.metadata.deletionTimestamp | type == "string")
    ' <<< "$remaining" >/dev/null ||
      die "a same-name replacement appeared while deleting $recorded_ref"
    sleep 0.25
  done
  [[ -z $remaining ]] || die "issued $recorded_ref remains terminating after UID-safe deletion"
done

finalize_required=false
revoked_state=absent
if node_json=$(root_kubectl get node "$node" --output=json 2>/dev/null); then
  mac=$(jq -r '.mac' "$access_dir/identity.json")
  mac_label=${mac//:/-}
  jq -e --arg node "$node" --arg uid "$node_uid" --arg mac "$mac_label" '
    .metadata.name == $node and .metadata.uid == $uid and
    .metadata.labels["samcday.com/mac"] == $mac and
    .metadata.labels["fabric.samcday.com/bootstrap-placeholder"] == "true" and
    (.metadata.labels | has("node-role.kubernetes.io/worker") | not) and
    ([.spec.taints[]? | select(.key == "fabric.samcday.com/platform")] == [{
      effect: "NoSchedule", key: "fabric.samcday.com/platform", value: "true"
    }])
  ' <<< "$node_json" >/dev/null ||
    die 'worker Node identity changed; refusing bootstrap metadata mutation'
  placeholder=$(jq -r '.metadata.labels["fabric.samcday.com/bootstrap-placeholder"] // ""' <<< "$node_json")
  machine_id=$(jq -r '.status.nodeInfo.machineID // ""' <<< "$node_json")
  revoked_state=$(jq -r '.metadata.annotations["fabric.samcday.com/bootstrap-state"] // ""' \
    <<< "$node_json")
  discovery=$(jq -r '.metadata.labels["samcday.com/discovery"] // ""' <<< "$node_json")
  platform_label_present=$(jq -r \
    '.metadata.labels | has("fabric.samcday.com/platform")' <<< "$node_json")
  platform_label=$(jq -r '.metadata.labels["fabric.samcday.com/platform"] // ""' \
    <<< "$node_json")
  case $revoked_state in
    discovery)
      [[ $placeholder == true && $discovery == true && $platform_label_present == false &&
         -z $machine_id ]] ||
        die 'discovery placeholder is not the exact unjoined safe state'
      ;;
    install-armed)
      [[ $placeholder == true && $discovery == false && $platform_label_present == false &&
         -z $machine_id ]] ||
        die 'armed placeholder changed before attended rollback'
      ;;
    install-response-issued)
      [[ $placeholder == true && $discovery == false &&
         ($platform_label_present == false || $platform_label == true) ]] ||
        die 'install-response worker lost its bootstrap identity'
      finalize_required=true
      ;;
    *) die "worker has an unexpected bootstrap state: $revoked_state" ;;
  esac
  patch=$(jq -cn --arg node "$node" --arg uid "$node_uid" \
    --arg rv "$(jq -r '.metadata.resourceVersion' <<< "$node_json")" \
    --arg state "$revoked_state" '
      [{"op":"test","path":"/metadata/resourceVersion","value":$rv},
       {"op":"test","path":"/metadata/name","value":$node},
       {"op":"test","path":"/metadata/uid","value":$uid},
       {"op":"test","path":"/metadata/annotations/fabric.samcday.com~1bootstrap-state","value":$state}] +
      (if $state == "install-armed" then
         [{"op":"test","path":"/metadata/labels/samcday.com~1discovery","value":"false"},
          {"op":"replace","path":"/metadata/labels/samcday.com~1discovery","value":"true"},
          {"op":"replace","path":"/metadata/annotations/fabric.samcday.com~1bootstrap-state","value":"discovery"}]
       else [] end)
    ')
  for annotation in samcday.com/boot-device samcday.com/ignition-mode \
    samcday.com/ignition-token samcday.com/install; do
    if jq -e --arg key "$annotation" '.metadata.annotations | has($key)' \
      <<< "$node_json" >/dev/null; then
      escaped=${annotation//~/~0}
      escaped=${escaped//\//~1}
      patch=$(jq -c --arg path "/metadata/annotations/$escaped" \
        '. + [{"op":"remove","path":$path}]' <<< "$patch")
    fi
  done
  root_kubectl patch node "$node" --type=json --patch "$patch" >/dev/null ||
    die 'atomic worker credential cleanup was rejected or raced'
  node_json=$(root_kubectl get node "$node" --output=json)
  jq -e '
    (.metadata.labels | has("node-role.kubernetes.io/worker") | not) and
    ([.spec.taints[]? | select(.key == "fabric.samcday.com/platform")] == [{
      effect: "NoSchedule", key: "fabric.samcday.com/platform", value: "true"
    }]) and
    ((.metadata.annotations["samcday.com/boot-device"] // "") == "") and
    ((.metadata.annotations["samcday.com/ignition-mode"] // "") == "") and
    ((.metadata.annotations["samcday.com/ignition-token"] // "") == "") and
    ((.metadata.annotations["samcday.com/install"] // "") == "")
  ' <<< "$node_json" >/dev/null || die 'worker retains a stale one-use annotation'
  if [[ $revoked_state == discovery || $revoked_state == install-armed ]]; then
    jq -e '
      .metadata.labels["fabric.samcday.com/bootstrap-placeholder"] == "true" and
      .metadata.labels["samcday.com/discovery"] == "true" and
      (.metadata.labels | has("fabric.samcday.com/platform") | not) and
      .metadata.annotations["fabric.samcday.com/bootstrap-state"] == "discovery"
    ' <<< "$node_json" >/dev/null || die 'unjoined worker did not return to discovery'
  else
    jq -e '
      .metadata.labels["fabric.samcday.com/bootstrap-placeholder"] == "true" and
      .metadata.labels["samcday.com/discovery"] == "false" and
      ((.metadata.labels | has("fabric.samcday.com/platform") | not) or
        .metadata.labels["fabric.samcday.com/platform"] == "true") and
      .metadata.annotations["fabric.samcday.com/bootstrap-state"] == "install-response-issued"
    ' <<< "$node_json" >/dev/null || die 'worker lost its post-response finalization receipt'
  fi
fi
for resource in "namespace/$bootie_namespace" "clusterrole/$bootie_name" \
  "clusterrolebinding/$bootie_name"; do
  if root_kubectl get "$resource" >/dev/null 2>&1; then die "$resource remains after revocation"; fi
done

install -m 0600 /dev/null "$access_dir/token"
identity_tmp=$(mktemp -- "$access_dir/.identity.json.XXXXXXXX")
chmod 0600 "$identity_tmp"
jq --arg revoked "$(date --utc --iso-8601=seconds)" \
  --arg state "$revoked_state" --argjson finalize "$finalize_required" \
  '. + {revokedAt: $revoked, stateAtRevocation: $state, finalizeRequired: $finalize}' \
  "$access_dir/identity.json" > "$identity_tmp"
[[ $(stat -Lc '%u:%g:%a:%h' "$identity_tmp") == 0:0:600:1 ]] ||
  die 'temporary revoked identity file is unsafe'
mv -f -- "$identity_tmp" "$access_dir/identity.json"

printf 'revoked %s Bootie access and zeroed %s/token\n' "$node" "$access_dir"
if [[ $finalize_required == true ]]; then
  printf 'The non-secret UID receipt remains; run finalize-fabric-worker-bootstrap after Ready.\n'
else
  printf 'The Node remains in discovery; issue a fresh bounded token for any later ceremony.\n'
fi
