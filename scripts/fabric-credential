#!/usr/bin/env bash
set -euo pipefail
umask 077

die() {
  printf 'fabric-credential: %s\n' "$*" >&2
  exit 1
}

[[ $# -eq 0 ]] || die 'this exec credential helper accepts no arguments'
for command in awk date flock grep jq mkdir mktemp mv openssl rm sha256sum stat; do
  command -v "$command" >/dev/null 2>&1 || die "required command not found: $command"
done

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repo_root=$(cd -- "$script_dir/.." && pwd -P)
client_ca=$repo_root/fabric/access/client-ca.crt
[[ -f $client_ca && ! -L $client_ca ]] ||
  die "fabric client CA is missing or unsafe: $client_ca"

runtime_parent=${XDG_RUNTIME_DIR:-$HOME/.cache/infra-runtime}
if [[ ! -e $runtime_parent ]]; then
  mkdir -p -- "$runtime_parent"
  chmod 0700 -- "$runtime_parent"
fi
[[ -d $runtime_parent && ! -L $runtime_parent ]] ||
  die "runtime parent is missing or unsafe: $runtime_parent"
runtime_owner_mode=$(stat -Lc '%u:%a' -- "$runtime_parent")
[[ $runtime_owner_mode == "$(id -u):700" ]] ||
  die "runtime parent must be owned by the caller with mode 0700: $runtime_parent"

cache_dir=$runtime_parent/infra-fabric-operator
mkdir -p -- "$cache_dir"
chmod 0700 -- "$cache_dir"
[[ -d $cache_dir && ! -L $cache_dir ]] || die 'credential cache is unsafe'
cache_owner_mode=$(stat -Lc '%u:%a' -- "$cache_dir")
[[ $cache_owner_mode == "$(id -u):700" ]] ||
  die 'credential cache must be owned by the caller with mode 0700'

exec {lock_fd}>"$cache_dir/lock"
chmod 0600 -- "$cache_dir/lock"
flock --exclusive "$lock_fd"

client_cert=$cache_dir/client.pem
client_key=$cache_dir/client-key.pem
expected_subject='subject=O=system:masters,CN=sam-fabric-operator'
issue_work=
cleanup() {
  [[ -z $issue_work ]] || rm -rf -- "$issue_work"
}
trap cleanup EXIT

credential_valid() {
  local certificate_key private_key subject
  [[ -f $client_cert && ! -L $client_cert && -f $client_key && ! -L $client_key ]] || return 1
  [[ $(stat -Lc '%u:%a' -- "$client_cert") == "$(id -u):600" ]] || return 1
  [[ $(stat -Lc '%u:%a' -- "$client_key") == "$(id -u):600" ]] || return 1
  openssl x509 -in "$client_cert" -noout -checkend 60 >/dev/null 2>&1 || return 1
  openssl verify -CAfile "$client_ca" "$client_cert" >/dev/null 2>&1 || return 1
  subject=$(openssl x509 -in "$client_cert" -noout -subject -nameopt RFC2253) || return 1
  [[ $subject == "$expected_subject" ]] || return 1
  openssl x509 -in "$client_cert" -noout -text |
    grep -Fq 'TLS Web Client Authentication' || return 1
  if openssl x509 -in "$client_cert" -noout -text |
    grep -Fq 'X509v3 Subject Alternative Name'; then
    return 1
  fi
  certificate_key=$(openssl x509 -in "$client_cert" -pubkey -noout |
    openssl pkey -pubin -outform DER 2>/dev/null | sha256sum | awk '{print $1}') || return 1
  private_key=$(openssl pkey -in "$client_key" -pubout -outform DER 2>/dev/null |
    sha256sum | awk '{print $1}') || return 1
  [[ $certificate_key == "$private_key" ]]
}

issue_credential() {
  local certificate lifetime node not_after not_after_text not_before
  local not_before_text now remaining remote_script
  issue_work=$(mktemp -d "$cache_dir/.issue.XXXXXXXX")

  openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 \
    -out "$issue_work/client-key.pem" 2>/dev/null
  openssl req -new -sha256 \
    -key "$issue_work/client-key.pem" \
    -subj '/CN=sam-fabric-operator/O=system:masters' \
    -out "$issue_work/client.csr"
  [[ $(openssl req -in "$issue_work/client.csr" -noout -subject -nameopt RFC2253) == \
    "$expected_subject" ]] || die 'generated operator CSR has an unexpected subject'
  if openssl req -in "$issue_work/client.csr" -noout -text |
    grep -Fq 'X509v3 Subject Alternative Name'; then
    die 'generated operator CSR unexpectedly contains subjectAltName'
  fi

  read -r -d '' remote_script <<'EOF' || true
set -euo pipefail
umask 077
work=$(mktemp -d /run/fabric-operator-sign.XXXXXXXX)
cleanup() { rm -rf -- "$work"; }
trap cleanup EXIT
cat >"$work/request.csr"
/usr/bin/openssl req -in "$work/request.csr" -noout -verify >/dev/null
subject=$(/usr/bin/openssl req -in "$work/request.csr" -noout -subject -nameopt RFC2253)
[[ $subject == 'subject=O=system:masters,CN=sam-fabric-operator' ]]
/usr/bin/openssl req -in "$work/request.csr" -pubkey -noout >"$work/public.pem"
key_description=$(/usr/bin/openssl pkey -pubin -in "$work/public.pem" -text -noout)
grep -Fq 'Public-Key: (256 bit)' <<<"$key_description"
grep -Fq 'ASN1 OID: prime256v1' <<<"$key_description"
cat >"$work/extensions.cnf" <<'EXTENSIONS'
[operator]
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature
extendedKeyUsage=clientAuth
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid
EXTENSIONS
not_before=$(/usr/bin/date --utc --date='-1 minute' +%Y%m%d%H%M%SZ)
not_after=$(/usr/bin/date --utc --date='+15 minutes' +%Y%m%d%H%M%SZ)
serial=0x$(/usr/bin/openssl rand -hex 16)
/usr/bin/openssl x509 -req \
  -in "$work/request.csr" \
  -CA /var/lib/rancher/k3s/server/tls/client-ca.crt \
  -CAkey /var/lib/rancher/k3s/server/tls/client-ca.key \
  -set_serial "$serial" \
  -not_before "$not_before" \
  -not_after "$not_after" \
  -sha256 \
  -clrext \
  -extfile "$work/extensions.cnf" \
  -extensions operator
EOF

  certificate=
  for node in cp2 cp1 cp3; do
    if certificate=$("$script_dir/fabric-ssh" "$node" \
      sudo --non-interactive /usr/bin/bash -c "$remote_script" \
      <"$issue_work/client.csr"); then
      break
    fi
    certificate=
  done
  [[ -n $certificate ]] || die 'no fabric root signed the bounded operator CSR'
  printf '%s\n' "$certificate" >"$issue_work/client.pem"
  chmod 0600 -- "$issue_work/client.pem" "$issue_work/client-key.pem"

  openssl verify -CAfile "$client_ca" "$issue_work/client.pem" >/dev/null ||
    die 'issued operator certificate does not verify against the pinned client CA'
  [[ $(openssl x509 -in "$issue_work/client.pem" -noout -subject -nameopt RFC2253) == \
    "$expected_subject" ]] || die 'issued operator certificate has an unexpected subject'
  not_before_text=$(openssl x509 -in "$issue_work/client.pem" -noout -startdate)
  not_after_text=$(openssl x509 -in "$issue_work/client.pem" -noout -enddate)
  not_before=$(date --utc --date="${not_before_text#notBefore=}" +%s)
  not_after=$(date --utc --date="${not_after_text#notAfter=}" +%s)
  now=$(date --utc +%s)
  lifetime=$((not_after - not_before))
  remaining=$((not_after - now))
  ((lifetime >= 900 && lifetime <= 1020)) ||
    die "operator certificate lifetime is outside the 15-minute bound (${lifetime}s)"
  ((remaining >= 840 && remaining <= 960)) ||
    die "operator certificate remaining lifetime is outside its bound (${remaining}s)"

  mv -f -- "$issue_work/client-key.pem" "$client_key"
  mv -f -- "$issue_work/client.pem" "$client_cert"
  rm -rf -- "$issue_work"
  issue_work=
}

credential_valid || issue_credential
credential_valid || die 'bounded operator credential failed post-issuance validation'
"$script_dir/fabric-kube-tunnel" ensure

expiration_text=$(openssl x509 -in "$client_cert" -noout -enddate)
expiration=$(date --utc --date="${expiration_text#notAfter=}" +%Y-%m-%dT%H:%M:%SZ)
jq -n \
  --rawfile certificate "$client_cert" \
  --rawfile key "$client_key" \
  --arg expiration "$expiration" \
  '{
    apiVersion: "client.authentication.k8s.io/v1",
    kind: "ExecCredential",
    status: {
      expirationTimestamp: $expiration,
      clientCertificateData: $certificate,
      clientKeyData: $key
    }
  }'
