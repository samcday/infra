tenant_ctl() {
  "$ctl" --endpoints="$endpoints" \
    --cacert=/credential/ca.crt --cert=/credential/tls.crt --key=/credential/tls.key \
    --dial-timeout=3s --command-timeout=5s "$@"
}

cleanup_lease() {
  if [ -n "$lease_id" ]; then
    tenant_ctl lease revoke "$lease_id" >/dev/null 2>&1 || true
  fi
}
trap cleanup_lease EXIT HUP INT TERM

wget -q -T 15 -O "$archive" \
  http://10.66.1.1/static/etcd-v3.6.13-linux-amd64.tar.gz
printf '%s  %s\n' b4928654aed84d90952620c7144555e4186d795e1e7414e65fe0cf6265fd0465 "$archive" |
  sha256sum -c - >/dev/null
tar -xzf "$archive" -C /work etcd-v3.6.13-linux-amd64/etcdctl
version_output=$($ctl version)
[ "$(printf '%s\n' "$version_output" | sed -n '1p')" = 'etcdctl version: 3.6.13' ]
[ "$(printf '%s\n' "$version_output" | sed -n '2p')" = 'API version: 3.6' ]
[ "$(printf '%s\n' "$version_output" | awk 'NF { n++ } END { print n + 0 }')" -eq 2 ]
printf 'ETCDCTL_PIN=pass node=%s version=3.6.13\n' "$node"

for address in 10.66.0.10 10.66.0.11 10.66.0.12; do
  nc -n -z -w 3 "$address" 2379 >/dev/null 2>&1
  nc -n -z -w 3 "$address" 2381 >/dev/null 2>&1
  if nc -n -z -w 3 "$address" 2380 >/dev/null 2>&1; then
    exit 20
  fi
done
printf 'TCP_BOUNDARY=pass node=%s roots=3 client=reachable metrics=reachable peer=blocked\n' "$node"

for endpoint in \
  https://fabric-az1-cp1.fabric.internal:2379 \
  https://fabric-az1-cp2.fabric.internal:2379 \
  https://fabric-az1-cp3.fabric.internal:2379; do
  set +e
  "$ctl" --endpoints="$endpoint" --cacert=/credential/ca.crt \
    --dial-timeout=3s --command-timeout=5s get "$inside_key" --limit=1 \
    >/work/no-client-cert.stdout 2>/work/no-client-cert.stderr
  no_cert_status=$?
  set -e
  [ "$no_cert_status" -ne 0 ]
  if grep -Fiq 'permission denied' /work/no-client-cert.stderr; then
    exit 21
  fi
  "$ctl" --endpoints="$endpoint" \
    --cacert=/credential/ca.crt --cert=/credential/tls.crt --key=/credential/tls.key \
