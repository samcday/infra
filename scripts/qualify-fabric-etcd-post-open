PROBE_SCRIPT

cleanup() {
  local status=$? index name state cleanup_failed=false tables
  trap - EXIT HUP INT TERM
  trap '' HUP INT TERM
  set +e

  if ! stop_cluster_lock_proxy; then
    cleanup_failed=true
    printf 'ERROR: filtered Kubernetes API lock proxy could not be cleaned up\n' >&2
  fi

  if [[ $mode == run ]]; then
    for index in "${!service_nodes[@]}"; do
      name="fabric-etcd-post-open-${service_suffixes[$index]}"
      if ${pod_created[$index]} || ${pod_creation_attempted[$index]}; then
        if remove_owned_object pod "$name" "${pod_uids[$index]}"; then
          pod_created[index]=false
          pod_creation_attempted[index]=false
        else
          cleanup_failed=true
          printf 'ERROR: UID-aware cleanup failed for Pod %s\n' "$name" >&2
        fi
      fi
    done
    if $network_policy_created || $network_policy_creation_attempted; then
      if remove_owned_object networkpolicy "$network_policy_name" "$network_policy_uid"; then
        network_policy_created=false
        network_policy_creation_attempted=false
      else
        cleanup_failed=true
        printf 'ERROR: UID-aware cleanup failed for NetworkPolicy %s\n' \
          "$network_policy_name" >&2
      fi
    fi
    if $router_table_owned; then
      tables=$(router_tables 2>/dev/null)
      if grep -Fxq "table inet $router_probe_table" <<<"${tables:-}"; then
        router_ssh /usr/sbin/nft delete table inet "$router_probe_table" \
          >/dev/null 2>&1 || cleanup_failed=true
      fi
      tables=$(router_tables 2>/dev/null) || cleanup_failed=true
      if grep -Fxq "table inet $router_probe_table" <<<"${tables:-}"; then
        cleanup_failed=true
      else
        router_table_owned=false
      fi
    fi
    if ! state=$(object_state networkpolicy "$network_policy_name" \
        "$evidence_dir/networkpolicy-final-get.stderr") || [[ $state != absent ]]; then
      cleanup_failed=true
    fi
    for index in "${!service_nodes[@]}"; do
      name="fabric-etcd-post-open-${service_suffixes[$index]}"
      if ! state=$(object_state pod "$name" "$evidence_dir/$name-final-get.stderr") ||
          [[ $state != absent ]]; then
        cleanup_failed=true
      fi
    done
    observer_verify >"$evidence_dir/restoration-observer.txt" 2>&1 || cleanup_failed=true

    if $cluster_lock_held; then
      if $complete && ((status == 0)) && ! $cleanup_failed; then
        if ! release_cluster_network_lock >/dev/null 2>&1; then
          cleanup_failed=true
          printf 'ERROR: exact global Fabric maintenance lock could not be conditionally released\n' >&2
        fi
      else
        printf 'Global Fabric maintenance lock remains held by %s for inspection\n' \
          "$cluster_lock_holder" >&2
      fi
    fi
  fi

  if $cleanup_failed; then
    status=1
    printf 'ERROR: post-open ephemeral cleanup did not verify\n' >&2
  fi
  if [[ $mode == check && $status -eq 0 ]]; then
    rm -rf -- "$evidence_dir"
  elif $complete && ((status == 0)); then
    printf 'FABRIC_ETCD_POST_OPEN_QUALIFICATION=pass\n'
    printf 'EVIDENCE_DIR=%s\n' "$evidence_dir"
  else
    printf 'Post-open qualification did not complete; protected evidence remains at %s\n' \
      "$evidence_dir" >&2
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

validate_committed_inputs
prepare_router_ssh
observer_verify || die 'Fabric observer isolation verification failed'
assert_router_probe_table_absent
validate_router_post_phase "$evidence_dir/router-preflight.txt"
verify_api_health preflight
verify_fabric_root_continuity preflight
for index in "${!root_nodes[@]}"; do
  root_guard_snapshot "$index" "$evidence_dir/root-$((index + 1))-guard.preflight"
  validate_root_guard "$index" "$evidence_dir/root-$((index + 1))-guard.preflight"
done
validate_service_nodes
validate_flux_runtime
validate_admission_contract
validate_etcd_resources before
assert_ephemeral_absent
capture_default_deny "$default_deny_before"

if [[ $mode == check ]]; then
  note 'Read-only preflight passed: Fabric etcdetcetc is Ready behind the exact opened boundary.'
  note "Probe image: $probe_image"
  note "Checksum-pinned etcdctl: $etcd_version ($etcd_archive_sha256)"
  note "Exact live confirmation: $expected_confirmation"
  complete=true
  exit 0
fi

acquire_network_lock
acquire_cluster_network_lock
observer_verify || die 'Fabric observer isolation changed after lock acquisition'
assert_router_probe_table_absent
validate_router_post_phase "$evidence_dir/router-before.txt"
verify_api_health before
verify_fabric_root_continuity before
validate_service_nodes
validate_flux_runtime
validate_admission_contract
validate_etcd_resources before-locked
[[ $tenant_uid == "$initial_tenant_uid" && $cluster_uid == "$initial_cluster_uid" ]] ||
  die 'permanent etcdetcetc identities changed while acquiring locks'
assert_ephemeral_absent
capture_default_deny "$default_deny_before"

router_snapshot "$router_before"
normalize_router_fw4 "$router_before" "$router_before_semantic"
write_counter_spec
for index in "${!root_nodes[@]}"; do
  root_guard_snapshot "$index" "$evidence_dir/root-$((index + 1))-guard.before"
  validate_root_guard "$index" "$evidence_dir/root-$((index + 1))-guard.before"
done
install_router_probe_table
create_network_policy
validate_network_policy
for index in "${!service_nodes[@]}"; do
  create_probe_pod "$index"
done
for index in "${!service_nodes[@]}"; do
  wait_probe_pod "$index"
done

validate_router_probe_counters
router_snapshot "$router_after"
normalize_router_fw4 "$router_after" "$router_after_semantic"
cmp -s -- "$router_before_semantic" "$router_after_semantic" ||
  die 'live router fw4 semantics changed during post-open acceptance'
"$repo_root/scripts/compare-fabric-nft-counters" \
  --before "$router_before" --after "$router_after" --spec "$counter_spec" \
  >"$counter_result"
allow_delta=$(jq -er \
  '.results[] | select(.logical_name == "etcd_client_allow") | .delta.packets' \
  "$counter_result") || die 'router result lacks etcd client allow delta'
reject_delta=$(jq -er \
  '.results[] | select(.logical_name == "etcd_internal_reject") | .delta.packets' \
  "$counter_result") || die 'router result lacks etcd internal reject delta'
metrics_delta=$(jq -er \
  '.results[] | select(.logical_name == "root_metrics_allow") | .delta.packets' \
  "$counter_result") || die 'router result lacks root metrics allow delta'
[[ $allow_delta =~ ^[0-9]+$ && $allow_delta -ge 6 ]] ||
  die "router etcd client allow saw only $allow_delta packets; expected at least six"
[[ $reject_delta =~ ^[0-9]+$ && $reject_delta -ge 6 ]] ||
  die "router peer-port reject saw only $reject_delta packets; expected at least six"
[[ $metrics_delta =~ ^[0-9]+$ && $metrics_delta -ge 6 ]] ||
  die "router metrics allow saw only $metrics_delta packets; expected at least six"

for index in "${!root_nodes[@]}"; do
  root_guard_snapshot "$index" "$evidence_dir/root-$((index + 1))-guard.after"
  validate_root_guard "$index" "$evidence_dir/root-$((index + 1))-guard.after"
done
compare_root_guards

remove_ephemeral_objects
capture_default_deny "$default_deny_after"
cmp -s -- "$default_deny_before" "$default_deny_after" ||
  die 'permanent smoke default-deny changed during post-open acceptance'
validate_router_post_phase "$evidence_dir/router-final.txt"
observer_verify || die 'Fabric observer isolation changed during acceptance cleanup'
verify_api_health after
verify_fabric_root_continuity after
validate_flux_runtime
validate_admission_contract
validate_etcd_resources after

jq -n \
  --arg revision "$head" --arg image "$probe_image" \
  --arg archiveSha256 "$etcd_archive_sha256" --arg tenantUid "$initial_tenant_uid" \
  --arg prefix "$tenant_prefix" --argjson routerAllowDelta "$allow_delta" \
  --argjson routerRejectDelta "$reject_delta" --argjson routerMetricsDelta "$metrics_delta" \
  --argjson cp1Packets "${root_packet_deltas[0]}" \
  --argjson cp2Packets "${root_packet_deltas[1]}" \
  --argjson cp3Packets "${root_packet_deltas[2]}" '
    {
      version: 1, result: "pass", revision: $revision,
      scope: "fabric-etcdetcetc-post-open",
      probeImage: $image,
      etcdctl: {version: "3.6.13", archiveSha256: $archiveSha256},
      tenant: {namespace: "etcdetcetc-smoke", name: "fabric-smoke", uid: $tenantUid,
        prefix: $prefix, credentialCopy: false},
      probes: {"fabric-az1-svc1": "pass", "fabric-az1-svc2": "pass"},
      boundary: {
        clientPort: "reachable", metricsPort: "reachable", peerPort: "blocked",
        noClientCertificate: "rejected",
        routerAllowPacketsDelta: $routerAllowDelta,
        routerRejectPacketsDelta: $routerRejectDelta,
        routerMetricsPacketsDelta: $routerMetricsDelta,
        rootAllowPacketsDelta: {cp1: $cp1Packets, cp2: $cp2Packets, cp3: $cp3Packets}
      },
      rbac: {inside: "put-get-delete", outsideRead: "PermissionDenied",
        outsideWrite: "PermissionDenied", ambiguousWriteCleanup: "ttl-lease"},
      ephemeralCleanup: "uid-verified", namespaceCreated: false,
      defaultDeny: "unchanged", fabricRootContinuity: "pass"
    }
  ' >"$evidence_dir/result.json"
chmod 0600 -- "$evidence_dir/result.json"

complete=true
