{
  "extends": [
    "config:recommended"
  ],
  "flux": {
    "managerFilePatterns": [
      "/hub/cluster/.*\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/hub/cluster/.*\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/hub/cluster/.*\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "ingress-nginx"
      ],
      "changelogUrl": "https://github.com/kubernetes/ingress-nginx/blob/main/charts/ingress-nginx/changelog/helm-chart-{{{newVersion}}}.md"
    }
  ]
}
