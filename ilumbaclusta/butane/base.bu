                [updates]
                enabled = false
          overwrite: true
        - path: /var/lib/extensions/kubernetes-1.33.raw
          contents:
            source: http://10.0.3.1/static/kubernetes-1.33-1.33.3-1.fc42-42-x86-64.raw
systemd:
    units:
        - name: systemd-sysext.service
          enabled: true
