variant: fcos
version: 1.5.0
boot_device:
    luks:
        tang:
            - url: http://10.0.3.1:9090
              thumbprint: DUFdADOc0Z3G6HqJPeVw-OtS9XTi-Io1jRPxZjXPh5s
        discard: true
kernel_arguments:
    should_exist:
        - mitigations=auto,nosmt=off
    should_not_exist:
        - mitigations=auto,nosmt
passwd:
    users:
        - name: sam
          groups:
            - adm
            - wheel
            - sudo
            - systemd-journal
          ssh_authorized_keys:
            - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFwawprQXEkGl38Q7T0PNseL0vpoyr4TbATMkEaZJTWQ
storage:
    files:
        - path: /etc/zincati/config.d/90-disable.toml
          contents:
            inline: |
                [updates]
                enabled = false
          overwrite: true
systemd:
    units:
        - name: systemd-sysext.service
          enabled: true
