set -uexo pipefail

uci -q batch << EOI
set system.@system[0].zonename='Australia/Brisbane'
set system.@system[0].hostname='simonet-router'
commit system
set network.lan.ipaddr='10.0.5.1'
commit network
set dhcp.@dnsmasq[0].local='/simonet.internal/'
set dhcp.@dnsmasq[0].domain='simonet.internal'
add_list dhcp.@dnsmasq[0].rebind_domain='samcday.com'
commit dhcp
EOI

chsh -s /bin/bash || true

service dnsmasq restart || true
